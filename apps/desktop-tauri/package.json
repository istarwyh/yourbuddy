{
  "name": "@deepseek-ai/dsh-desktop-tauri",
  "productName": "DeepSeek Harness",
  "description": "Tauri desktop shell: bundled harness source + mirror-fetched Node/pnpm deps",
  "version": "0.2.0-rc.1-0.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "bundle:source": "node scripts/bundle-harness-source.mjs",
    "sync:dsh": "node scripts/sync-dsh-upstream.mjs",
    "refresh:product-plugins": "node scripts/refresh-product-plugins.mjs",
    "prepare:release": "node scripts/prepare-release.mjs",
    "prepare:offline-store": "node scripts/prepare-harness-offline-store.mjs",
    "prepare:toolchain": "node scripts/prepare-managed-toolchain.mjs",
    "sync:product-plugin": "node scripts/sync-product-plugin.mjs",
    "prepare:dist": "node scripts/prepare-dist.mjs",
    "prepare:bootstrap-shell": "node scripts/prepare-bootstrap-shell.mjs",
    "dev": "tauri dev",
    "dev:local": "cross-env DSH_DESKTOP_LAUNCH=local tauri dev",
    "test:update-manifest": "node --test scripts/generate-updater-manifest.test.mjs",
    "test:release-version": "node --test scripts/verify-release-version.test.mjs scripts/prepare-release-candidate.test.mjs",
    "test:bundle": "node --test scripts/bundle-harness-source.test.mjs",
    "test:oil-publisher": "node --test product/oil-creator/skills/video-publisher/scripts/tests/*.test.mjs product/oil-creator/skills/video-publisher/scripts/v2/tests/*.test.mjs",
    "test:product-refresh": "pnpm run test:oil-publisher && cross-env NODE_OPTIONS=--use-openssl-ca node --test scripts/better-sidebar-browser.test.mjs scripts/better-sidebar-file-open.test.mjs scripts/better-sidebar-external-link.test.mjs scripts/better-sidebar-media-route.test.mjs scripts/codex-auth-settings-section.test.mjs scripts/desktop-lifecycle-bridge.test.mjs scripts/desktop-shell-permissions.test.mjs scripts/harbor-host-path-translation.test.mjs scripts/node-extra-ca.test.mjs scripts/oil-creator-credentials.test.mjs scripts/product-plugin-compatibility.test.mjs scripts/refresh-product-plugins.test.mjs scripts/sync-product-plugin.test.mjs scripts/verify-product-release.test.mjs",
    "test:prepare-release": "node --test scripts/dsh-release-policy.test.mjs scripts/prepare-release.test.mjs scripts/sync-dsh-upstream.test.mjs",
    "test:offline": "node --test scripts/prepare-harness-offline-store.test.mjs scripts/prepare-managed-toolchain.test.mjs scripts/prepare-yourbuddy-runtime.test.mjs",
    "test:overlay": "node --test overlay/desktop-notify/index.test.mjs",
    "test:startup": "node --test scripts/harness-startup.test.mjs",
    "build": "tauri build",
    "build:win": "tauri build --bundles nsis"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.6",
    "cross-env": "^7.0.3",
    "playwright": "^1.49.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.7.1"
  }
}
