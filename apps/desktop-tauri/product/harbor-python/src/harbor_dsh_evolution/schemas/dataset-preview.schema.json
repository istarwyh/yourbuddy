{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-self-evolving.dev/schemas/dataset-preview.schema.json",
  "title": "Dataset Preview",
  "type": "object",
  "required": ["schema_version", "dataset_id", "version", "source_digest", "task_count", "tasks"],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source_digest": { "type": "string", "minLength": 1 },
    "task_count": { "type": "integer", "minimum": 0 },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "instruction_file", "instruction", "instruction_truncated", "query", "metadata"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string" },
          "instruction_file": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string" },
          "instruction_truncated": { "type": "boolean" },
          "query": { "type": "string" },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
