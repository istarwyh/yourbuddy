{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/candidate-manifest.schema.json",
  "title": "Harbor DSH Candidate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "version", "digest", "created_at", "runtime", "files", "metadata"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policy", "transport"],
          "properties": {
            "kind": { "const": "deepseek-harness" },
            "policy": { "const": "unbound" },
            "transport": { "const": "acp" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "policy", "transport", "descriptor", "entrypoint", "config_path", "agent_entry_id", "node_version", "lockfile", "descriptor_digest", "entrypoint_digest", "lockfile_digest"],
          "properties": {
            "kind": { "const": "deepseek-harness" },
            "policy": { "const": "candidate-locked" },
            "transport": { "const": "acp" },
            "descriptor": { "const": "candidate-runtime.json" },
            "entrypoint": { "type": "string", "minLength": 1 },
            "config_path": { "type": "string", "minLength": 1 },
            "agent_entry_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "node_version": { "type": "string", "pattern": "^(?:2[2-9]|[3-9][0-9]|[1-9][0-9]{2,})\\.[0-9]+\\.[0-9]+$" },
            "lockfile": { "const": "package-lock.json" },
            "descriptor_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "entrypoint_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "lockfile_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "metadata": { "type": "object" }
  }
}
