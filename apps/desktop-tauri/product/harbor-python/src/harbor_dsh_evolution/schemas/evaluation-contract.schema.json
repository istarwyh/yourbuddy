{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/evaluation-contract.schema.json",
  "title": "Evaluation Contract",
  "type": "object",
  "required": ["contract_id", "version", "primary_metric", "metrics"],
  "properties": {
    "schema_version": { "const": 1 },
    "contract_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "primary_metric": { "type": "string", "minLength": 1 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "direction"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "direction": { "enum": ["maximize", "minimize"] },
          "description": { "type": "string" }
        }
      }
    },
    "groups": { "type": "array", "items": { "type": "object" } },
    "hard_requirements": { "type": "array", "items": { "type": "object" } }
  }
}
