{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/promotion-policy.schema.json",
  "title": "Promotion Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "primary_metric", "primary_direction", "min_improvement", "minimums", "maximums", "non_regression", "execution_environment"],
  "properties": {
    "schema_version": { "const": 2 },
    "policy_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "primary_metric": { "type": "string", "minLength": 1 },
    "primary_direction": { "enum": ["maximize", "minimize"] },
    "min_improvement": { "type": "number", "minimum": 0 },
    "minimums": { "type": "object", "additionalProperties": { "type": "number" } },
    "maximums": { "type": "object", "additionalProperties": { "type": "number" } },
    "non_regression": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "non_regression_tolerance": { "type": "number", "minimum": 0 },
    "metric_directions": { "type": "object", "additionalProperties": { "enum": ["maximize", "minimize"] } },
    "hard_requirements": { "type": "array", "items": { "enum": ["exception_free", "artifact_schema_valid", "doctor_error_free"] }, "uniqueItems": true },
    "diagnostic_only": { "type": "boolean" },
    "execution_environment": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "require_image_identity"],
          "properties": {
            "strategy": { "const": "docker-required" },
            "require_image_identity": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "host_risk_accepted", "acceptance_rationale"],
          "properties": {
            "strategy": { "const": "allow-unrestricted-host" },
            "host_risk_accepted": { "const": true },
            "acceptance_rationale": { "type": "string", "minLength": 20 }
          }
        }
      ]
    }
  }
}
