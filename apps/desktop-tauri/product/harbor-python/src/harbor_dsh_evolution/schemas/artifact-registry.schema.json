{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/artifact-registry.schema.json",
  "title": "Artifact Registry v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifacts"],
  "properties": {
    "schema_version": { "const": 2 },
    "job_kind": { "enum": ["candidate-evaluation", "historical-generation-evaluation"] },
    "artifact_profile": { "enum": ["diagnostic", "experiment", "governed"] },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "artifact", "path", "reward_affecting", "status"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "schema": { "type": "string", "pattern": "^v[0-9]+$" },
          "reward_affecting": { "type": "boolean" },
          "status": { "enum": ["registered", "unavailable"] }
        }
      }
    }
  }
}
