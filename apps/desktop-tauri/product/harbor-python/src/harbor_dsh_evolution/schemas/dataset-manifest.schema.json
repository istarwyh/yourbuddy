{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/dataset-manifest.schema.json",
  "title": "Harbor Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "version", "source_digest", "created_at", "task_count", "tasks", "file_count"],
  "properties": {
    "schema_version": { "const": 1 },
    "dataset_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "source_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "created_at": { "type": "string", "format": "date-time" },
    "task_count": { "type": "integer", "minimum": 1 },
    "file_count": { "type": "integer", "minimum": 1 },
    "tasks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "instruction"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "instruction": { "type": "string", "minLength": 1 },
          "verifier": { "type": "string", "minLength": 1 },
          "environment": { "type": "string", "minLength": 1 },
          "query": { "type": "string" },
          "evaluator_ref": { "type": "string", "minLength": 1 },
          "metadata": { "type": "object" }
        }
      }
    }
  }
}
