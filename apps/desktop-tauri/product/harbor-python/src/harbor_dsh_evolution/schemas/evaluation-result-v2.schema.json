{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/evaluation-result-v2.schema.json",
  "title": "Harbor DSH Evaluation Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "criteria", "aggregate", "effective_evaluator"],
  "properties": {
    "schema_version": { "const": 2 },
    "protocol": { "const": "evaluation-result/v2" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "score", "reason", "recommendation", "evidence_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["scored", "not-applicable", "insufficient-evidence", "evaluation-error"] },
          "score": { "type": ["number", "null"], "enum": [0, 0.5, 1, null] },
          "reason": { "type": "string", "minLength": 1 },
          "recommendation": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "allOf": [
          { "if": { "properties": { "status": { "const": "scored" } } }, "then": { "properties": { "score": { "enum": [0, 0.5, 1] } } } },
          { "if": { "properties": { "status": { "enum": ["not-applicable", "insufficient-evidence", "evaluation-error"] } } }, "then": { "properties": { "score": { "type": "null" } } } }
        ]
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "value", "scored_criteria", "total_criteria", "coverage"],
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "scored_criteria": { "type": "integer", "minimum": 0 },
        "total_criteria": { "type": "integer", "minimum": 1 },
        "coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "effective_evaluator": { "$ref": "#/$defs/effectiveEvaluator" }
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "portable_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "portable_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "portable_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "portable_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "interface": { "type": "string", "minLength": 1 },
        "entry": { "type": "string", "minLength": 1 },
        "callable": { "type": "string", "minLength": 1 },
        "bundle_complete": { "type": "boolean" }
      }
    },
    "effectiveEvaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "protocol", "configured", "materialized", "executed", "identity_match"],
      "properties": {
        "schema_version": { "const": 1 },
        "protocol": { "const": "effective-evaluator/v1" },
        "configured": { "$ref": "#/$defs/identity" },
        "materialized": { "oneOf": [{ "$ref": "#/$defs/runtimeIdentity" }, { "type": "null" }] },
        "executed": { "oneOf": [{ "$ref": "#/$defs/runtimeIdentity" }, { "type": "null" }] },
        "identity_match": { "type": "boolean" },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error_type"],
          "properties": {
            "status": { "enum": ["not-run", "attempted", "succeeded", "failed"] },
            "error_type": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
