{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/evaluator-observations.schema.json",
  "title": "Evaluator Observations v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "ground_truth_digest", "evaluator", "rubric", "judge", "template", "repeat_policy", "observations"],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": { "const": "evaluator-observations/v1" },
    "ground_truth_digest": { "$ref": "#/$defs/digest" },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "portable_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "portable_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "rubric": { "$ref": "#/$defs/versioned_identity" },
    "template": { "$ref": "#/$defs/versioned_identity" },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "version"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "repeat_policy": {
      "type": "object",
      "required": ["repeats"],
      "properties": {
        "repeats": { "type": "integer", "minimum": 1 },
        "seed_policy": { "type": "string" }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "repeat", "criteria"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "repeat": { "type": "integer", "minimum": 1 },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "score"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "score": { "enum": [0, 0.5, 1] }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "versioned_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
