{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/istarwyh/harbor-self-evolving/schemas/evaluation-stack.schema.json",
  "title": "Evaluation Stack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stack_id", "version", "components", "judge", "evaluation_contract"],
  "properties": {
    "schema_version": { "const": 1 },
    "stack_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration", "renderer", "evaluator", "rubric", "diagnoser", "optimizer", "runner", "reporter"],
      "properties": {
        "integration": { "$ref": "#/$defs/component" }, "renderer": { "$ref": "#/$defs/component" },
        "evaluator": { "$ref": "#/$defs/component" }, "rubric": { "$ref": "#/$defs/component" },
        "diagnoser": { "$ref": "#/$defs/component" }, "optimizer": { "$ref": "#/$defs/component" },
        "runner": { "$ref": "#/$defs/component" }, "reporter": { "$ref": "#/$defs/component" }
      }
    },
    "judge": {
      "type": "object", "additionalProperties": true,
      "required": ["provider", "model", "version"],
      "properties": { "provider": { "type": "string" }, "model": { "type": "string" }, "version": { "type": "string" }, "parameters": { "type": "object" } }
    },
    "evaluation_contract": { "$ref": "evaluation-contract.schema.json" },
    "contracts": { "type": "object", "additionalProperties": { "type": "string" } },
    "labels": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "$defs": {
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "entry"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "entry": { "type": "string", "minLength": 1 }, "semantic": { "type": "boolean" } }
    }
  }
}
