{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-self-evolving.dev/schemas/metric-template.schema.json",
  "title": "Harbor Metric Template v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol", "template_id", "version", "criteria", "aggregation"],
  "properties": {
    "schema_version": { "const": 1 },
    "protocol": { "const": "metric-template/v1" },
    "template_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "direction", "scale", "required", "applicability", "evidence_requirements", "status_policy", "quality_affecting"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
          "label": { "type": "string", "minLength": 1 },
          "direction": { "enum": ["maximize", "minimize"] },
          "scale": { "const": [0, 0.5, 1] },
          "required": { "type": "boolean" },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_kinds"],
            "properties": {
              "task_kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
              "when": { "type": "string" }
            }
          },
          "evidence_requirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "status_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["not_applicable", "insufficient_evidence", "evaluation_error"],
            "properties": {
              "not_applicable": { "const": "exclude" },
              "insufficient_evidence": { "const": "abstain" },
              "evaluation_error": { "const": "invalidate" }
            }
          },
          "quality_affecting": { "type": "boolean" },
          "weight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "minimum_required_coverage"],
      "properties": {
        "method": { "enum": ["weighted-mean", "mean"] },
        "minimum_required_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
