{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbor-self-evolving.dev/schemas/evaluator.schema.json",
  "title": "Harbor DSH Evaluator Interface v1/v2",
  "type": "object",
  "required": ["schema_version", "interface", "evaluator_id", "version", "kind", "protocol", "implementation", "editable_files", "criteria", "aggregate"],
  "properties": {
    "schema_version": { "enum": [1, 2] },
    "interface": { "enum": ["harbor-dsh-evaluator/v1", "harbor-dsh-evaluator/v2"] },
    "evaluator_id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["script", "llm-as-judge"] },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": { "enum": ["evaluation-input/v1", "evaluation-input/v2"] },
        "output": { "enum": ["evaluation-result/v1", "evaluation-result/v2"] }
      }
    },
    "metric_template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "protocol"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "protocol": { "const": "metric-template/v1" }
      }
    },
    "implementation": {
      "type": "object",
      "required": ["entry", "language", "callable"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "language": { "type": "string", "minLength": 1 },
        "callable": { "type": "string", "minLength": 1 }
      }
    },
    "input_builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "callable"],
      "properties": {
        "entry": { "type": "string", "minLength": 1 },
        "callable": { "type": "string", "minLength": 1 }
      }
    },
    "editable_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/editableFile" }
    },
    "bundle_files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bundleFile" }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "method"],
      "properties": {
        "metric_id": { "type": "string", "minLength": 1 },
        "method": { "const": "mean" },
        "minimum_coverage": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "judge": {
      "type": "object",
      "description": "Non-secret runtime identity/configuration for an llm-as-judge implementation. Credentials must be supplied through environment variables or secret files."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": 1 } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "interface": { "const": "harbor-dsh-evaluator/v1" },
          "protocol": {
            "properties": {
              "input": { "const": "evaluation-input/v1" },
              "output": { "const": "evaluation-result/v1" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "schema_version": { "const": 2 } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "interface": { "const": "harbor-dsh-evaluator/v2" },
          "protocol": {
            "properties": {
              "input": { "const": "evaluation-input/v2" },
              "output": { "const": "evaluation-result/v2" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "editableFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "language", "affects"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "enum": ["implementation", "prompt", "rubric", "config"] },
        "language": { "type": "string", "minLength": 1 },
        "affects": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["evaluator", "rubric"] },
          "uniqueItems": true
        }
      }
    },
    "bundleFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "values"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "values": { "const": [0, 0.5, 1] },
        "required": { "type": "boolean" },
        "direction": { "enum": ["maximize", "minimize"] },
        "applicability": { "type": "object", "required": ["task_kinds"], "properties": { "task_kinds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "when": { "type": "string" } } },
        "evidence_requirements": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "status_policy": { "type": "object" },
        "quality_affecting": { "type": "boolean" },
        "weight": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
