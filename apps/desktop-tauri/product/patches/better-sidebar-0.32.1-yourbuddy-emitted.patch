: String(error) })\n    })\n    return () => { cancelled = true }\n  }, [chunk, pick, attempt])\n\n  if (state.status === 'loading') {\n    return <div className={css.editorPlaceholder}>{t('loading')}</div>\n  }\n  if (state.status === 'error') {\n    return (\n      <div className={css.editorError}>\n        <span>{state.message}</span>\n        <button\n          type=\"button\"\n          className={css.terminalRetry}\n          onClick={() => { setAttempt(current => current + 1) }}\n        >\n          {t('terminalRetry')}\n        </button>\n      </div>\n    )\n  }\n  return createElement(state.Comp, props)\n}\n\n/**\n * Build a descriptor-compatible lazy wrapper for a chunk-resident component.\n * The returned function is the descriptor `component` itself: it returns an\n * element and never calls hooks, so both invocation styles (plain function\n * call and createElement/JSX render) work. `pick` must be a module-level\n * function (stable identity) — an inline lambda would re-trigger the load\n * effect on every render.\n * @param chunk - the chunk name (see chunk-loader.ts).\n * @param pick - select the component from the chunk's exports.\n */\nexport function lazyChunkComponent<P extends object>(\n  chunk: ChunkName,\n  pick: (mod: ChunkExports) => ComponentType<P> | undefined,\n): (props: P) => ReactNode {\n  return (props: P) => createElement(\n    LazyChunkView as ComponentType<LazyChunkViewProps<P>>,\n    { chunk, pick, props },\n  )\n}\n","/**\n * The chunk-resident markdown renderer (mermaid lazy chunk): a light stub\n * module so core-bundle consumers (the changes tab's reading mode) can mount\n * the mermaid-aware renderer without statically pulling MarkdownHtml's\n * DOMPurify/HTML-analysis machinery into the core bundle. The chunk itself\n * (src/client/chunks/mermaid) loads on first render via /sidebar/bundle.\n */\nimport type { ComponentType } from 'react'\nimport { lazyChunkComponent } from './lazy-chunk.tsx'\nimport type { MermaidMarkdownProps } from './mermaid-blocks.ts'\n\n/** Shared with the legacy no-HTML preview path in TextEditor (re-exported). */\nexport const LazyMermaidMarkdown = lazyChunkComponent<MermaidMarkdownProps>(\n  'mermaid',\n  (mod) => mod.MermaidMarkdown as ComponentType<MermaidMarkdownProps> | undefined,\n)\n","/**\n * The markdown preview's raw-HTML renderer. `markdown-html.ts` lifts HTML\n * runs out of the markdown stream; this module renders them as sanitized DOM\n * alongside the markdown runs (which keep flowing through the shared\n * `MarkdownText`), nests markdown into unclosed block elements the way\n * GitHub's linear HTML output does (`<details>` … fence … `</details>`), and\n * runs an inline pass that turns literal tag text inside rendered markdown\n * (table cells with `<br/>`, `<sub>`, `<img>`) back into elements.\n *\n * Security posture: every HTML string (block leaves, inline text, wrapper\n * open-tag attributes) goes through DOMPurify with an explicit denylist on\n * top of its defaults (no script/style/iframe/forms), anchors are forced to\n * open in a new tab with noopener, and local media goes through the\n * session-scoped `/sidebar/file` media route — `src` attributes via\n * `resolveLocalMediaDest` (the same trust fence). Markdown-syntax images are\n * resolved by the owning surface's `pathImages` vocabulary\n * (`markdown-images.ts`); that is what keeps them same-origin in the desktop\n * shell.\n */\nimport { useLayoutEffect, useMemo, useRef } from 'react'\nimport { createElement, type ReactNode } from 'react'\nimport DOMPurify from 'dompurify'\nimport { MarkdownText } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { MarkdownPathImages } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { markdownTextProps, type MarkdownCopyLabels } from './markdown-labels.tsx'\nimport { resolveLocalMediaDest } from './markdown-images.ts'\nimport { rewriteLocalMarkdownLinks } from './markdown-navigation.ts'\nimport {\n  analyzeHtmlSegment,\n  type AnalyzedMarkdownHtml,\n} from './markdown-html.ts'\nimport { splitMermaidBlocks } from './mermaid-blocks.ts'\nimport type { SessionScope } from './api.ts'\nimport css from './sidebar.module.css'\n\n/** The chunk-resident markdown renderer (mermaid lazy chunk), shared with the\n *  legacy no-HTML preview path in TextEditor. Defined in mermaid-lazy.tsx (a\n *  light module) so core-bundle consumers can import the stub without\n *  dragging DOMPurify along. */\nexport { LazyMermaidMarkdown } from './mermaid-lazy.tsx'\nimport { LazyMermaidMarkdown } from './mermaid-lazy.tsx'\n\n/** Everything the sanitizers need to resolve local media + scope the route. */\nexport interface MarkdownHtmlMedia {\n  scope: SessionScope\n  path: string\n  /** The PAGE base, reverse-proxy prefix included (`hostHttpBase()`). */\n  baseUrl: string\n  /** The owner's local-path image vocabulary for markdown runs. */\n  pathImages?: MarkdownPathImages | undefined\n}\n\n/** Tag-like text in a rendered text node — the inline pass gate. */\nconst TAGLIKE_TEXT_RE = /<\\/?[a-zA-Z][a-zA-Z0-9-]*[\\s/>]/\n\n/**\n * A text node that is nothing but one close tag (`</a>`) at its edges. The host\n * renderer emits one text node per raw-HTML token, so an author's\n * `<a id=\"x\"></a>` arrives as two sibling nodes: the open tag (which this pass\n * swaps for a sanitized element) and this stray close tag. DOMPurify drops a\n * lone close tag, so it can never be swapped — and unlike prose it carries no\n * text a reader should see, so the pass deletes it instead of printing it.\n */\nconst ORPHAN_CLOSE_TAG_RE = /^<\\/[a-zA-Z][a-zA-Z0-9-]*\\s*>$/\n\n/** Explicit denylist on top of DOMPurify's defaults: no active content, no\n *  form chrome, no document-level elements inside a preview. */\nconst PURIFY_FORBID_TAGS = [\n  'script', 'style', 'iframe', 'object', 'embed', 'form', 'input', 'button',\n  'select', 'textarea', 'meta', 'link', 'base', 'frame', 'frameset', 'applet',\n]\nconst PURIFY_FORBID_ATTR = ['srcdoc', 'formaction']\n\n/**\n * Post-sanitize hardening on a detached element tree: anchors open in a new\n * tab (never navigate the GUI), and local media sources go through the media\n * route so they render instead of being dropped by protocol allowlists.\n */\nfunction postProcessSanitized(root: Element, media: MarkdownHtmlMedia): void {\n  for (const anchor of root.querySelectorAll('a[href]')) {\n    anchor.setAttribute('target', '_blank')\n    anchor.setAttribute('rel', 'noopener noreferrer')\n  }\n  for (const element of root.querySelectorAll('img, video, audio, source')) {\n    const src = element.getAttribute('src')\n    if (src === null) continue\n    element.setAttribute('src', resolveLocalMediaDest(src, media.scope, media.path, media.baseUrl))\n  }\n}\n\n/**\n * Rewrite authored `file:` media URLs before DOMPurify sees them. The\n * sanitizer's URI allowlist drops a raw `file:` scheme (it is not a browser\n * subresource the GUI can load), so a raw-HTML `<img src=\"file:///…\">` would\n * lose its src entirely. The file URL is a local path in another spelling:\n * map it through the same media route as a relative src first, then sanitize\n * the resulting http URL. Sources without a file URL are returned untouched.\n */\nfunction rewriteFileUrlMedia(source: string, media: MarkdownHtmlMedia): string {\n  if (!/file:/i.test(source)) return source\n  const template = document.createElement('template')\n  template.innerHTML = source\n  for (const element of template.content.querySelectorAll('img, video, audio, source')) {\n    for (const attribute of ['src', 'poster']) {\n      const value = element.getAttribute(attribute)\n      if (value === null || !/^file:/i.test(value.trim())) continue\n      element.setAttribute(attribute, resolveLocalMediaDest(value, media.scope, media.path, media.baseUrl))\n    }\n  }\n  return template.innerHTML\n}\n\n/** Sanitize one balanced HTML span into markup for dangerouslySetInnerHTML. */\nfunction sanitizeHtmlBlock(source: string, media: MarkdownHtmlMedia): string {\n  const holder = document.createElement('div')\n  holder.innerHTML = DOMPurify.sanitize(rewriteFileUrlMedia(source, media), {\n    FORBID_TAGS: PURIFY_FORBID_TAGS,\n    FORBID_ATTR: PURIFY_FORBID_ATTR,\n  })\n  postProcessSanitized(holder, media)\n  return holder.innerHTML\n}\n\n/**\n * Sanitize literal tag text from a rendered markdown text node. Returns null\n * when nothing real survived (pure prose like `a < b` — the DOMPurify output\n * has no element children), so the caller leaves the text node untouched.\n * A node that is nothing but a close tag never reaches here — the caller drops\n * it (see {@link ORPHAN_CLOSE_TAG_RE}).\n */\nfunction sanitizeInlineHtml(text: string, media: MarkdownHtmlMedia): string | null {\n  const holder = document.createElement('span')\n  holder.innerHTML = DOMPurify.sanitize(rewriteFileUrlMedia(text, media), {\n    FORBID_TAGS: PURIFY_FORBID_TAGS,\n    FORBID_ATTR: PURIFY_FORBID_ATTR,\n  })\n  if (holder.firstElementChild === null) return null\n  postProcessSanitized(holder, media)\n  return holder.innerHTML\n}\n\n/**\n * React props for a sanitized element: `class`/`for` map to their React names,\n * `style` is dropped (React needs an object; wrappers with inline styles are\n * vanishingly rare and not worth a CSS parser), and event handlers / invalid\n * attribute names never survive DOMPurify's defaults but are filtered anyway.\n */\nfunction propsFromElement(element: Element): Record<string, string> {\n  const props: Record<string, string> = {}\n  for (const attr of element.attributes) {\n    if (/^on/i.test(attr.name) || !/^[a-zA-Z][a-zA-Z0-9:._-]*$/.test(attr.name)) continue\n    if (attr.name === 'style') continue\n    props[attr.name === 'class' ? 'className' : attr.name === 'for' ? 'htmlFor' : attr.name] = attr.value\n  }\n  return props\n}\n\n/**\n * Sanitize a wrapper open tag (`<details open>`) into React props. Returns\n * null when DOMPurify dropped the whole tag (denied element) — the renderer\n * then treats the wrapper as transparent.\n */\nfunction sanitizeTagProps(tag: string, attrs: string): Record<string, string> | null {\n  const probe = DOMPurify.sanitize(`<${tag}${attrs}></${tag}>`, {\n    FORBID_TAGS: PURIFY_FORBID_TAGS,\n    FORBID_ATTR: PURIFY_FORBID_ATTR,\n  })\n  const holder = document.createElement('div')\n  holder.innerHTML = probe\n  const element = holder.firstElementChild\n  if (element === null || element.tagName.toLowerCase() !== tag) return null\n  return propsFromElement(element)\n}\n\n/**\n * Split a sanitized HTML leaf whose first element is a `<summary>` into that\n * summary's props/inner markup plus the remainder. HTML's content model makes\n * the summary a disclosure widget **only** as a direct child of `<details>`,\n * but every balanced leaf renders inside a block wrapper — so a README's\n * `<details>` + `<summary>` would otherwise show the browser's own default\n * label (\"Details\") and demote the authored text to body content. Returns\n * null when the leaf's first element is anything else (or non-whitespace text\n * precedes it), leaving the plain leaf path untouched. Media and anchors\n * inside the hoisted summary go through the same hardening as any leaf.\n */\nfunction splitLeadingSummary(\n  html: string,\n  media: MarkdownHtmlMedia,\n): { props: Record<string, string>; inner: string; rest: string } | null {\n  const holder = document.createElement('div')\n  holder.innerHTML = html\n  const first = holder.firstElementChild\n  if (first === null || first.tagName.toLowerCase() !== 'summary') return null\n  for (const node of holder.childNodes) {\n    if (node === first) break\n    if ((node.textContent ?? '').trim() !== '') return null\n  }\n  postProcessSanitized(first, media)\n  const props = propsFromElement(first)\n  const inner = first.innerHTML\n  first.remove()\n  return { props, inner, rest: holder.innerHTML }\n}\n\n/**\n * The inline pass: walk the rendered markdown's text nodes and swap any that\n * contain tag-like text for a sanitized `<span data-html-inline>`. Rendered\n * code (inline `code`, `pre`, the host `.md-code-block`, mermaid mounts, and\n * spans this pass already produced) is skipped. The same commit-then-operate\n * pattern the mermaid swap uses: React keeps owning the host tree, only leaf\n * text nodes are replaced, and a text change re-renders the subtree fresh.\n */\nfunction runInlineHtmlPass(container: HTMLElement, media: MarkdownHtmlMedia): void {\n  const walker = document.createTreeWalker(container, NodeFilter.SHOW_TEXT, {\n    acceptNode: (node) => {\n      const parent = (node as Text).parentElement\n      if (parent === null) return NodeFilter.FILTER_REJECT\n      if (parent.closest('code, pre, .md-code-block, [data-mermaid-processed], [data-html-inline]')) {\n        return NodeFilter.FILTER_REJECT\n      }\n      return TAGLIKE_TEXT_RE.test((node as Text).data)\n        ? NodeFilter.FILTER_ACCEPT\n        : NodeFilter.FILTER_REJECT\n    },\n  })\n  const targets: Text[] = []\n  for (let node = walker.nextNode(); node !== null; node = walker.nextNode()) targets.push(node as Text)\n  for (const node of targets) {\n    // A lone close tag is not prose and cannot be sanitized into an element:\n    // drop it so `</a>` never renders as text (the matching open tag already\n    // became its element, so anchors keep their id and stay invisible).\n    if (ORPHAN_CLOSE_TAG_RE.test(node.data.trim())) {\n      node.remove()\n      continue\n    }\n    const html = sanitizeInlineHtml(node.data, media)\n    if (html === null) continue\n    const span = document.createElement('span')\n    span.setAttribute('data-html-inline', '')\n    span.innerHTML = html\n    node.replaceWith(span)\n  }\n}\n\ninterface MarkdownSegmentProps {\n  text: string\n  hasMermaid: boolean\n  media: MarkdownHtmlMedia\n  codeLabels: MarkdownCopyLabels\n}\n\n/**\n * One markdown run of a split document: the shared MarkdownText pass (or the\n * mermaid chunk renderer when the run contains a mermaid fence), plus the\n * inline HTML pass. The pass runs after every text change and is re-armed by\n * a MutationObserver so it also catches content that appears late (the lazy\n * mermaid chunk mounting, shiki highlighting settling) — it is idempotent and\n * skips its own output, so mutation feedback settles after one extra pass.\n */\nfunction MarkdownSegment({ text, hasMermaid, media, codeLabels }: MarkdownSegmentProps): ReactNode {\n  const pathImages = media.pathImages\n  const containerRef = useRef<HTMLDivElement>(null)\n  useLayoutEffect(() => {\n    const container = containerRef.current\n    if (container === null) return\n    runInlineHtmlPass(container, media)\n    let timer: number | undefined\n    /** A pass was skipped because the page was hidden; flush it on return. */\n    let dirty = false\n    const runPass = (): void => {\n      // Only `hidden` pauses the pass; jsdom reports a non-visible state too,\n      // and the initial pass already ran there.\n      if (document.visibilityState === 'hidden') {\n        dirty = true\n        return\n      }\n      dirty = false\n      runInlineHtmlPass(container, media)\n    }\n    const observer = new MutationObserver(() => {\n      if (timer !== undefined) return\n      // Coalesce a burst of mutations (shiki settling, diagram swaps, inline\n      // HTML injection) into one pass: the scan walks every text node in the\n      // document, so a pass per mutation turns a diagram-heavy render into a\n      // stream of full-document scans.\n      timer = window.setTimeout(() => {\n        timer = undefined\n        runPass()\n      }, 80)\n    })\n    const onVisibilityChange = (): void => {\n      if (document.visibilityState === 'hidden' || !dirty) return\n      if (timer !== undefined) {\n        window.clearTimeout(timer)\n        timer = undefined\n      }\n      runPass()\n    }\n    document.addEventListener('visibilitychange', onVisibilityChange)\n    observer.observe(container, { childList: true, subtree: true })\n    return () => {\n      observer.disconnect()\n      document.removeEventListener('visibilitychange', onVisibilityChange)\n      if (timer !== undefined) window.clearTimeout(timer)\n    }\n  }, [text, media])\n  return (\n    <div ref={containerRef}>\n      {hasMermaid\n        ? <LazyMermaidMarkdown text={text} codeLabels={codeLabels} pathImages={pathImages} />\n        : <MarkdownText {...markdownTextProps(text, codeLabels, pathImages)} />}\n    </div>\n  )\n}\n\n/** A sanitized, balanced HTML span rendered as its own block. */\nfunction HtmlLeaf({ html }: { html: string }): ReactNode {\n  return (\n    <div className={css.editorHtmlBlock} data-dsh-html-segment dangerouslySetInnerHTML={{ __html: html }} />\n  )\n}\n\n/** One fully-prepared HTML run: sanitized leaves + wrapper opens/closes. */\ntype PreparedHtmlPart =\n  | { kind: 'html'; html: string }\n  | { kind: 'open'; tag: string; props: Record<string, string> | null }\n  | { kind: 'close' }\n  /** A `<summary>` hoisted out of a leaf so it can be a `<details>` direct child. */\n  | { kind: 'summary'; props: Record<string, string>; inner: string }\n\ntype PreparedSegment =\n  | { kind: 'markdown'; text: string; hasMermaid: boolean }\n  | { kind: 'html'; parts: PreparedHtmlPart[] }\n\ninterface MarkdownDocumentProps {\n  info: AnalyzedMarkdownHtml\n  media: MarkdownHtmlMedia\n  codeLabels: MarkdownCopyLabels\n}\n\n/**\n * The split-document renderer: markdown runs render through MarkdownSegment,\n * HTML runs render as sanitized leaves, and unclosed block elements lower the\n * following runs into themselves until their close part pops the frame (the\n * renderer's frame stack persists across segments). Stray closes at the top\n * level render nothing (the sanitizer/parser would drop them anyway), and\n * frames still open at the end of the document are closed like a browser\n * parser would. Sanitization runs once per prepared change, in a memo.\n */\nexport function MarkdownDocument({ info, media, codeLabels }: MarkdownDocumentProps): ReactNode {\n  const prepared = useMemo<PreparedSegment[]>(() => info.segments.map((segment): PreparedSegment => {\n    if (segment.kind === 'markdown') {\n      const defs = info.referenceDefinitions\n      const raw = defs === '' ? segment.text : `${segment.text}\\n\\n${defs}`\n      // Local image destinations stay as authored: the enclosing surface's\n      // `pathImages` vocabulary resolves them at render time (see\n      // markdown-images.ts — a rewritten URL could not be vouched for from the\n      // desktop shell's `dsh-app://` page). The link pass runs here so a\n      // heading fragment survives the host parser and every local link the\n      // plugin does not claim stays inert; image-referenced definitions are\n      // left alone by that pass so the renderer can still resolve them.\n      const text = rewriteLocalMarkdownLinks(raw, media.path, media.scope.cwd)\n      return {\n        kind: 'markdown',\n        text,\n        hasMermaid: splitMermaidBlocks(text).some((block) => block.kind === 'mermaid'),\n      }\n    }\n    const parts: PreparedHtmlPart[] = []\n    /** Tag of the wrapper the previous part opened — the only place a\n     *  following leaf can hoist a `<summary>` out of its block wrapper. */\n    let openTag: string | null = null\n    for (const part of analyzeHtmlSegment(segment.text).parts) {\n      if (part.kind === 'html') {\n        const html = sanitizeHtmlBlock(part.html, media)\n        const summary = openTag === 'details' ? splitLeadingSummary(html, media) : null\n        if (summary === null) {\n          parts.push({ kind: 'html', html })\n        } else {\n          parts.push({ kind: 'summary', props: summary.props, inner: summary.inner })\n          // Anything after the summary keeps the plain block-leaf treatment.\n          if (summary.rest.trim() !== '') parts.push({ kind: 'html', html: summary.rest })\n        }\n        openTag = null\n        continue\n      }\n      if (part.kind === 'open') {\n        const props = sanitizeTagProps(part.tag, part.attrs)\n        parts.push({ kind: 'open', tag: part.tag, props })\n        // A denied wrapper renders transparent, so its children have no element\n        // to be a direct child of — never hoist a summary into that case.\n        openTag = props === null ? null : part.tag\n        continue\n      }\n      parts.push({ kind: 'close' })\n      openTag = null\n    }\n    return { kind: 'html', parts }\n  // `media` is a memoized object in the host (TextEditor); identity tracks\n  // scope/path/baseUrl changes so sanitization re-runs exactly when needed.\n  }), [info, media])\n\n  const nodes: ReactNode[] = []\n  const frames: { tag: string; props: Record<string, string> | null; children: ReactNode[] }[] = []\n  const emit = (node: ReactNode): void => {\n    const frame = frames[frames.length - 1]\n    if (frame !== undefined) frame.children.push(node)\n    else nodes.push(node)\n  }\n  let key = 0\n  for (const segment of prepared) {\n    if (segment.kind === 'markdown') {\n      emit(<MarkdownSegment key={`md-${key += 1}`} text={segment.text} hasMermaid={segment.hasMermaid} media={media} codeLabels={codeLabels} />)\n      continue\n    }\n    for (const part of segment.parts) {\n      if (part.kind === 'html') {\n        if (part.html.trim() === '') continue\n        emit(<HtmlLeaf key={`html-${key += 1}`} html={part.html} />)\n      } else if (part.kind === 'summary') {\n        // Emitted as a real element (not a block leaf) so it stays a direct\n        // child of the enclosing <details> — the content-model requirement for\n        // it to act as the disclosure widget, with the authored label.\n        emit(createElement('summary', { ...part.props, key: `summary-${key += 1}`, dangerouslySetInnerHTML: { __html: part.inner } }))\n      } else if (part.kind === 'open') {\n        frames.push({ tag: part.tag, props: part.props, children: [] })\n      } else {\n        const frame = frames.pop()\n        if (frame === undefined) continue\n        if (frame.props === null) {\n          for (const child of frame.children) emit(child)\n        } else {\n          emit(createElement(frame.tag, { ...frame.props, key: `wrap-${key += 1}` }, ...frame.children))\n        }\n      }\n    }\n  }\n  while (frames.length > 0) {\n    const frame = frames.pop()!\n    if (frame.props === null) {\n      for (const child of frame.children) emit(child)\n    } else {\n      emit(createElement(frame.tag, { ...frame.props, key: `wrap-${key += 1}` }, ...frame.children))\n    }\n  }\n  return <>{nodes}</>\n}\n","/**\n * The one size constant both halves need, kept dependency-free on purpose.\n *\n * This replaces the retired `readLimit` deployment knob (`config.ts`). The old\n * cap answered \"how many bytes may the host hand the client\" by truncating the\n * document — which produced an editor that could neither be trusted nor saved\n * (issue #732: saving a partial document destroys the tail). Transfer size is\n * no longer a thing this plugin limits at all: upload, download, the HTML\n * preview route and the archive route all stream, so a 10 GB file is simply a\n * 10 GB file.\n *\n * What is still bounded is what an EDITOR can hold. CodeMirror keeps the whole\n * document in the browser, so a file above this size gets a read-only paged\n * preview (see `paged-text.tsx` / `jsonl-preview.tsx`) instead of an edit\n * buffer. VS Code draws the same line at a different number — its\n * `getLargeFileConfirmationLimit()` is 50 MB on the web build — and the shape\n * of the answer (threshold → degraded read-only view) is deliberately the same.\n *\n * Imported by BOTH halves, so this module must stay free of node builtins and\n * of anything that reaches them.\n */\n\n/**\n * Text files at or below this size load whole and are editable; anything above\n * gets the read-only paged preview.\n */\nexport const MAX_EDITABLE_BYTES = 5 * 1024 * 1024\n\n/**\n * Bytes one `fs.readPage` request returns. Pages are trimmed back to the last\n * newline so a page is normally a whole number of lines (and therefore, for\n * JSONL, a whole number of records); a single line longer than this is\n * returned untrimmed and stitched back together by the client.\n *\n * Sized so that even a file of very short lines lands in the low thousands of\n * rendered rows per page — the preview renders a page's rows as plain elements,\n * and the page size is the only thing bounding that.\n */\nexport const PAGE_BYTES = 128 * 1024\n\n/**\n * Hard ceiling on one editor save request body.\n *\n * This is a SERVER-SIDE SANITY GUARD, not a product limit: the editor cannot\n * produce more than {@link MAX_EDITABLE_BYTES} of text, so the UI can never\n * reach it. It exists because the save route receives a raw body and the\n * encoding transform (`restoreEol` + `encodeText`) needs the whole document as\n * a string.\n */\nexport const WRITE_BODY_GUARD_BYTES = 8 * 1024 * 1024\n\n/**\n * Format a byte count for the \"this file is too large to edit\" notice. Kept\n * here beside the constant so the host and the client round identically.\n *\n * @param bytes - the file's size.\n * @returns e.g. `12.4 MB`, `512 KB`, `900 B`.\n */\nexport function formatByteSize(bytes: number): string {\n  if (!Number.isFinite(bytes) || bytes < 0) return '0 B'\n  if (bytes < 1024) return `${Math.round(bytes)} B`\n  const units = ['KB', 'MB', 'GB', 'TB']\n  let value = bytes / 1024\n  let unit = 0\n  while (value >= 1024 && unit < units.length - 1) {\n    value /= 1024\n    unit += 1\n  }\n  return `${value >= 10 ? Math.round(value) : value.toFixed(1)} ${units[unit]}`\n}\n\n/**\n * The human-facing form of {@link MAX_EDITABLE_BYTES}, for copy that names the\n * editing threshold.\n */\nexport const MAX_EDITABLE_LABEL = '5 MB'\n","/**\n * JSONL (newline-delimited JSON) parsing for the preview.\n *\n * The editor's CodeMirror surface keeps using `@codemirror/lang-json` for\n * `.json`; JSONL gets its own per-line language (see `lang-jsonl.ts`) because\n * the stock JSON grammar treats a second top-level value as an error. For the\n * PREVIEW the grammar is irrelevant: one line IS one record, so the preview\n * parses each line on its own and never has to reason about the document as a\n * single JSON value.\n *\n * Kept dependency-free and pure so the record handling is unit-testable\n * without a DOM.\n */\nimport { extOf } from './paths.ts'\n\n/** Whether a path is newline-delimited JSON (one record per line). */\nexport function isJsonlPath(path: string): boolean {\n  const ext = extOf(path)\n  return ext === 'jsonl' || ext === 'ndjson'\n}\n\n/** One parsed line. */\nexport type JsonlRecord =\n  | { ok: true; value: unknown }\n  | { ok: false; error: string }\n\n/** A record that is an object or array can render as a `JsonTree`. */\nexport function isTreeRecord(value: unknown): value is object | unknown[] {\n  return typeof value === 'object' && value !== null\n}\n\n/**\n * Parse one JSONL line.\n *\n * A blank line is NOT a record — JSONL writers commonly end the file with one\n * newline, and the host's pages are line-aligned, so a trailing blank must not\n * render as a broken record. It is reported as `{ok: false}` with an empty\n * error so the caller can skip it instead.\n *\n * @param line - one line of the file, without its newline.\n * @returns the parsed value, or the failure reason.\n */\nexport function parseRecord(line: string): JsonlRecord {\n  const trimmed = line.trim()\n  if (trimmed === '') return { ok: false, error: '' }\n  try {\n    const value: unknown = JSON.parse(trimmed)\n    return { ok: true, value }\n  } catch (error: unknown) {\n    return { ok: false, error: error instanceof Error ? error.message : String(error) }\n  }\n}\n\n/** How many characters of a collapsed record's summary are kept. */\nconst SUMMARY_MAX = 200\n\n/**\n * One-line summary of a record for its collapsed row.\n *\n * Objects and arrays become `{a: 1, b: \"x\", rest: …}` rather than raw JSON:\n * a collapsed row has to be scannable, and a raw `JSON.stringify` of a session\n * event is a wall of punctuation. Nesting beyond the first level is elided —\n * the expanded `JsonTree` is where detail lives.\n *\n * @param value - the parsed record.\n * @returns a single-line summary, never longer than {@link SUMMARY_MAX}.\n */\nexport function summarizeRecord(value: unknown): string {\n  if (value === null) return 'null'\n  if (Array.isArray(value)) return `[${value.length} items]`\n  if (typeof value === 'object') {\n    const entries = Object.entries(value as Record<string, unknown>)\n    if (entries.length === 0) return '{}'\n    const rendered = entries.map(([key, item]) => `${key}: ${preview(item)}`)\n    const shown: string[] = []\n    for (const part of rendered) {\n      const candidate = shown.length === 0 ? part : `${shown.join(', ')}, ${part}`\n      // Room for the closing brace and, when properties were dropped, '…'.\n      if (candidate.length + 4 > SUMMARY_MAX) break\n      shown.push(part)\n    }\n    if (shown.length === 0) {\n      // Even the FIRST property does not fit (one enormous string value): clamp\n      // it rather than returning a summary that names nothing at all.\n      return `{${rendered[0]!.slice(0, SUMMARY_MAX - 6)}…}`\n    }\n    return `{${shown.join(', ')}${shown.length < rendered.length ? ', …' : ''}}`\n  }\n  // A scalar has no structure to elide, so the JSON literal is already the\n  // best summary — clamped when the string itself is enormous.\n  const literal = JSON.stringify(value) ?? String(value)\n  return literal.length <= SUMMARY_MAX ? literal : `${literal.slice(0, SUMMARY_MAX - 1)}…`\n}\n\n/** The first-level preview of one property value. */\nfunction preview(value: unknown): string {\n  if (value === null) return 'null'\n  if (Array.isArray(value)) return `[…${value.length}]`\n  if (typeof value === 'object') return '{…}'\n  return JSON.stringify(value) ?? String(value)\n}\n","/**\n * Byte-offset paging over one text file, shared by every over-limit preview\n * (the generic read-only text reader and the JSONL record list).\n *\n * Why paging at all: the editor answers \"this file is too big to edit\" by\n * refusing to show it (VS Code pops a placeholder and offers \"Open Anyway\").\n * That is safe but useless for the files people actually want to LOOK at —\n * session logs, eval dumps, dataset rows — so instead of refusing, this reads\n * the file in windows.\n *\n * The model is APPEND-ONLY, which is what VS Code's output/log viewer does\n * (its `readFile(resource, { position: endOffset })` tail reads append into the\n * model). Pages accumulate in file order, so:\n *\n * - scrolling to the bottom appends the next page instead of replacing the\n *   current one — the reader keeps everything they have already scrolled past;\n * - \"load all\" is just \"append until EOF\", one sequential request at a time.\n *   It HAS to be sequential: each request's `offset` is the previous response's\n *   `nextOffset`, so the offsets cannot be computed ahead of time.\n *\n * That is also why there is no page count and no jump-to-the-end: a byte offset\n * is only knowable for the pages already read. A random-access index would mean\n * scanning the whole file on open — exactly the cost paging exists to avoid.\n *\n * Memory is therefore proportional to what the user has actually read, and the\n * VIEW caps that (see `MAX_PREVIEW_ROWS` in LargeFileView): this hook will\n * append for as long as it is asked to.\n */\nimport { useCallback, useEffect, useMemo, useRef, useState } from 'react'\nimport { api, type SessionScope } from './api.ts'\n\n/** Everything one read produced, in the shape the preview renders from. */\ninterface PagerState {\n  /** Decoded page texts, in file order (`pages[0]` is the first window). */\n  pages: string[]\n  /** Absolute 1-based number of the first line each page holds. */\n  lineStarts: number[]\n  /** Lines in each page (parallel to `pages`; summed for the row cap). */\n  lineCounts: number[]\n  /** Where the next page starts — also the count of bytes read so far. */\n  nextOffset: number\n  /** The file's size in bytes, as the first response reported it. */\n  size: number\n  atEnd: boolean\n  encoding: string\n}\n\n/** The empty state (also what a file switch resets to). */\nconst EMPTY: PagerState = {\n  pages: [],\n  lineStarts: [],\n  lineCounts: [],\n  nextOffset: 0,\n  size: 0,\n  atEnd: false,\n  encoding: 'utf8',\n}\n\n/** The paging state one preview renders from. */\nexport interface TextPager {\n  /** A single page append is in flight. */\n  loading: boolean\n  /** The \"load all\" loop is running (its per-page appends also set `loading`). */\n  loadingAll: boolean\n  /** Wire/transport failure of the last append; cleared once one succeeds. */\n  error: string | null\n  /** Loaded page texts, in file order. Append-only — nothing is ever dropped. */\n  pages: readonly string[]\n  /** Absolute 1-based first line of each page (parallel to `pages`). */\n  lineStarts: readonly number[]\n  /** Total decoded lines across the loaded pages (the row cap's input). */\n  totalLines: number\n  /** Bytes read so far (`nextOffset` — the same number, named for the UI). */\n  loadedBytes: number\n  /** The file's size in bytes (0 until the first response arrives). */\n  size: number\n  /** True once the file's last page has been read. */\n  atEnd: boolean\n  /** True when `maxLines` is what stopped the reading (not EOF). */\n  atCap: boolean\n  /** Append the next page, unless nothing may be appended any more. */\n  loadMore: () => void\n  /**\n   * Read every remaining page, one at a time, until EOF, the `maxLines`\n   * ceiling, or a failure.\n   */\n  loadAll: () => void\n  /** Throw away everything and re-read from the first page (the refresh). */\n  reload: () => void\n  /** The file's detected encoding, as the first page reported it. */\n  encoding: string\n}\n\n/**\n * Page through one file, appending.\n *\n * @param scope - the session scope.\n * @param path - the file to read ('' parks the hook).\n * @param enabled - false issues no request and keeps the previous state (a\n *  viewer that is merely hidden must not keep reading).\n * @param revision - bump to restart from the first page (the host's refresh).\n * @param maxLines - ceiling on accumulated lines. The hook stops appending\n *  once it is reached, and reports `atCap`. It lives HERE rather than in the\n *  caller because the accounting has to be synchronous: while `loadAll` walks\n *  pages in an `await` loop, a caller reading its own RENDERED row count would\n *  decide from a stale number and overshoot the ceiling by however many pages\n *  React had not re-rendered yet.\n * @returns the accumulator and its commands.\n */\nexport function useTextPager(\n  scope: SessionScope,\n  path: string,\n  enabled: boolean,\n  revision: number,\n  maxLines = Number.POSITIVE_INFINITY,\n): TextPager {\n  const [state, setState] = useState<PagerState>(EMPTY)\n  const [loading, setLoading] = useState(false)\n  const [loadingAll, setLoadingAll] = useState(false)\n  const [error, setError] = useState<string | null>(null)\n  const [reloadSeq, setReloadSeq] = useState(0)\n\n  /** One append at a time: every request needs the previous `nextOffset`. */\n  const inFlight = useRef(false)\n  /** Guards a late response from the file/revision we have already left. */\n  const generationRef = useRef(0)\n  /**\n   * The cursor, as REFS rather than reads of the rendered state.\n   *\n   * This is load-bearing, not a micro-optimisation: `loadAll` walks pages in a\n   * tight `await` loop, and a `setState` from the previous page is not rendered\n   * yet when the next iteration starts. Reading the offset out of state there\n   * re-requests the SAME page forever (found by the spec — it OOMs the worker in\n   * about ten seconds). The refs are written synchronously with the response,\n   * so the loop always advances.\n   */\n  const nextOffsetRef = useRef(0)\n  const atEndRef = useRef(false)\n  const totalLinesRef = useRef(0)\n  const loadingAllRef = useRef(false)\n  /** Mirror of the ceiling, so the identity-stable callbacks read it fresh. */\n  const maxLinesRef = useRef(maxLines)\n  maxLinesRef.current = maxLines\n\n  /** Whether anything may still be appended: neither EOF nor the ceiling. */\n  const canAppend = (): boolean =>\n    !atEndRef.current && totalLinesRef.current < maxLinesRef.current\n\n  const reset = useCallback((): void => {\n    generationRef.current += 1\n    inFlight.current = false\n    loadingAllRef.current = false\n    nextOffsetRef.current = 0\n    atEndRef.current = false\n    totalLinesRef.current = 0\n    setState(EMPTY)\n    setLoading(false)\n    setLoadingAll(false)\n    setError(null)\n  }, [])\n\n  // A new file restarts from the first page; so does the host's refresh — the\n  // file may have moved on disk, and a stale byte offset would splice two\n  // different revisions of the document together.\n  useEffect(() => {\n    reset()\n    setReloadSeq(sequence => sequence + 1)\n  }, [reset, path, scope.sessionId, scope.cwd, revision])\n\n  /**\n   * Read the page at the current `nextOffset` and append it.\n   *\n   * @returns whether the caller's loop may continue (false on a failure, on a\n   *  superseded generation, or when another append is already in flight).\n   */\n  const appendOnce = useCallback((): Promise<boolean> => {\n    if (inFlight.current) return Promise.resolve(false)\n    if (!canAppend()) return Promise.resolve(false)\n    const generation = generationRef.current\n    const offset = nextOffsetRef.current\n    inFlight.current = true\n    setLoading(true)\n    setError(null)\n    return api.fsReadPage(scope, path, offset).then((result) => {\n      if (generation !== generationRef.current) return false\n      inFlight.current = false\n      // Written BEFORE the state update: the next iteration of `loadAll` runs\n      // off these, and `setState` has not rendered yet at that point.\n      nextOffsetRef.current = result.nextOffset\n      atEndRef.current = result.eof\n      const lines = splitLines(result.text).length\n      totalLinesRef.current += lines\n      setState((previous) => {\n        const previousStart = previous.lineStarts[previous.lineStarts.length - 1] ?? 1\n        const previousLines = previous.lineCounts[previous.lineCounts.length - 1] ?? 0\n        return {\n          pages: [...previous.pages, result.text],\n          lineStarts: [\n            ...previous.lineStarts,\n            previous.pages.length === 0 ? 1 : previousStart + previousLines,\n          ],\n          lineCounts: [...previous.lineCounts, lines],\n          nextOffset: result.nextOffset,\n          size: result.size,\n          atEnd: result.eof,\n          encoding: result.encoding,\n        }\n      })\n      setLoading(false)\n      return canAppend()\n    }).catch((reason: unknown) => {\n      inFlight.current = false\n      if (generation !== generationRef.current) return false\n      setLoading(false)\n      setError(reason instanceof Error ? reason.message : String(reason))\n      return false\n    })\n  }, [scope, path])\n\n  const loadMore = useCallback((): void => {\n    if (!canAppend()) return\n    void appendOnce()\n  }, [appendOnce])\n\n  const loadAll = useCallback((): void => {\n    if (loadingAllRef.current) return\n    loadingAllRef.current = true\n    setLoadingAll(true)\n    void (async () => {\n      try {\n        // Sequential on purpose: each page's offset IS the previous page's\n        // `nextOffset`, so there is nothing to parallelise.\n        for (;;) {\n          // Both guards read REFS, which `appendOnce` writes synchronously with\n          // the response — the rendered state lags an `await` behind.\n          if (!canAppend()) break\n          // Sequential by construction, not by style: the next request's\n          // offset IS this response's `nextOffset`.\n          const advanced = await appendOnce()\n          if (!advanced) break\n        }\n      } finally {\n        loadingAllRef.current = false\n        setLoadingAll(false)\n      }\n    })()\n  }, [appendOnce])\n\n  const reload = useCallback(() => {\n    reset()\n    setReloadSeq(sequence => sequence + 1)\n  }, [reset])\n\n  // The first page, and the first page only: later appends are driven by the\n  // view's scroll and load-all. `pages.length` returning to 0 is what a reset\n  // looks like from here, so a file/revision change re-seeds automatically.\n  useEffect(() => {\n    void reloadSeq\n    if (!enabled || path === '') return\n    if (state.pages.length > 0 || state.atEnd) return\n    if (inFlight.current || !canAppend()) return\n    void appendOnce()\n    // The guards are the two `state` FIELDS, not `state`: the effect must fire\n    // on \"nothing loaded yet\", not on every append.\n  }, [enabled, path, reloadSeq, state.pages.length, state.atEnd, appendOnce])\n\n  return useMemo<TextPager>(() => ({\n    loading,\n    loadingAll,\n    error,\n    pages: state.pages,\n    lineStarts: state.lineStarts,\n    totalLines: state.lineCounts.reduce((sum, count) => sum + count, 0),\n    loadedBytes: state.nextOffset,\n    size: state.size,\n    atEnd: state.atEnd,\n    atCap: !state.atEnd && state.lineCounts.reduce((sum, count) => sum + count, 0) >= maxLines,\n    loadMore,\n    loadAll,\n    reload,\n    encoding: state.encoding,\n  }), [loading, loadingAll, error, state, maxLines, loadMore, loadAll, reload])\n}\n\n/**\n * One page's text as rows. The host trims every page to a line break, so the\n * '' a trailing newline produces is dropped — except on an empty page, which is\n * no rows rather than one empty one.\n */\nexport function splitLines(text: string): string[] {\n  if (text === '') return []\n  const lines = text.split('\\n')\n  if (lines.length > 1 && lines[lines.length - 1] === '') lines.pop()\n  return lines\n}\n","/**\n * The read-only paged preview for a file above the editable threshold.\n *\n * Two row shapes share one accumulator ({@link useTextPager}):\n *\n * - `jsonl` — one row per record, collapsed to a one-line summary and\n *   expandable into the host's `JsonTree`. A page is line-aligned, so a page is\n *   exactly a run of whole records.\n * - everything else — one row per line, monospace, no wrapping (horizontal\n *   scroll), which is the log-viewer shape.\n *\n * Scrolling is APPEND-ONLY, like VS Code's output/log view: reaching the bottom\n * pulls the next window and keeps everything already read on screen. There is\n * also an explicit \"load all\" in the notice bar, for a reader who wants the\n * whole thing up front rather than scroll-hunting for it.\n *\n * The one thing VS Code does not need and this does: a ROW CAP. Its `TextModel`\n * and its view are virtualized, so it can append a gigabyte into the model and\n * still keep the DOM small; this renders real elements. {@link MAX_PREVIEW_ROWS}\n * is therefore where appending stops and the reader is pointed at the download —\n * a visible ceiling beats a frozen tab, and it sits far above any log a person\n * reads in a side panel.\n *\n * Nothing here fetches the document: the file is above the editor's limit\n * precisely because holding it whole is what we are avoiding.\n */\nimport { memo, useCallback, useEffect, useMemo, useRef, useState, type ReactNode, type UIEvent } from 'react'\nimport clsx from 'clsx'\nimport { IconRefreshOutlineRegular, JsonTree, type JsonTreeLabels } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { SessionScope } from './api.ts'\nimport { downloadUrl } from './api.ts'\nimport { formatByteSize, MAX_EDITABLE_BYTES, MAX_EDITABLE_LABEL } from '../editor-limits.ts'\nimport { isJsonlPath, isTreeRecord, parseRecord, summarizeRecord } from './jsonl.ts'\nimport { splitLines, useTextPager } from './text-pages.ts'\nimport { t } from './locales.ts'\nimport css from './sidebar.module.css'\n\n/**\n * How many rows the preview will append before it stops and points at the\n * download instead.\n *\n * This is a DOM budget, not a byte budget: the rows are real elements, and one\n * page of short JSONL lines is a few thousand of them. 50k keeps the worst case\n * (a JSONL log read end to end) at a couple of seconds of layout while still\n * covering any file a person reads in a side panel — the 6 MB reference log\n * lands around 35k records, comfortably inside it.\n */\nexport const MAX_PREVIEW_ROWS = 50_000\n\n/** Distance from the bottom (px) at which the next page is pulled. */\nconst APPEND_THRESHOLD_PX = 320\n\n/** Copy the host's `JsonTree` needs; this plugin owns the wording. */\nfunction jsonLabels(): JsonTreeLabels {\n  return {\n    // The tree's primitive/compact copy actions are the same gesture as the\n    // code block's copy, so they reuse that wording rather than inventing a\n    // second vocabulary for the same button.\n    copyValue: t('copy'),\n    copyJson: t('copy'),\n    copyPath: t('jsonCopyPath'),\n    copyPrettyJson: t('jsonCopyPrettyJson'),\n    copyCompactJson: t('jsonCopyCompactJson'),\n    copied: t('copied'),\n    copyFailed: t('jsonCopyFailed'),\n    collapseNode: t('jsonCollapseNode'),\n    expandNode: t('jsonExpandNode'),\n    copyButtonTitle: (action) => t('jsonCopyButtonTitle', { action }),\n  }\n}\n\n/**\n * The read-only preview of one over-limit file.\n *\n * @param props.scope - the session scope.\n * @param props.path - the file being previewed.\n * @param props.size - the file's size in bytes (from the read that refused it).\n * @param props.visible - whether the tab is on screen; a parked tab stops reading.\n * @param props.revision - bumped by the host's refresh to restart from page one.\n * @param props.maxRows - row ceiling (defaults to {@link MAX_PREVIEW_ROWS}).\n * @returns the preview.\n */\nexport function LargeFileView(props: {\n  scope: SessionScope\n  path: string\n  size: number\n  visible: boolean\n  revision: number\n  maxRows?: number\n}): ReactNode {\n  const { scope, path, size, visible, revision } = props\n  const maxRows = props.maxRows ?? MAX_PREVIEW_ROWS\n  // The row ceiling is the HOOK's argument, not something this component\n  // enforces from its own rendered row count: while `loadAll` walks pages, a\n  // render-fresh count lags by however many pages React has not flushed.\n  const pager = useTextPager(scope, path, visible, revision, maxRows)\n  const records = isJsonlPath(path)\n  const bodyRef = useRef<HTMLDivElement | null>(null)\n  /** Absolute record/line numbers the reader expanded (survives appends). */\n  const [expanded, setExpanded] = useState<ReadonlySet<number>>(new Set())\n  const labels = useMemo(() => jsonLabels(), [])\n\n  /**\n   * Whether this file is over the EDITABLE threshold — a different question\n   * from \"is this view paged\".\n   *\n   * A small `.jsonl` opens straight into this record list as its PREVIEW, and\n   * announcing \"the file is too large, paged preview only\" over a 2 KB file\n   * would be a lie. The threshold decides, not the component.\n   */\n  const tooLarge = size > MAX_EDITABLE_BYTES\n\n  const rows = useMemo(() => pager.pages.map(splitLines), [pager.pages])\n  const totalRows = useMemo(() => rows.reduce((sum, page) => sum + page.length, 0), [rows])\n\n  /** Pull the next page unless there is nothing left to pull. */\n  const maybeLoadMore = useCallback((): void => {\n    if (pager.atEnd || pager.atCap || pager.loadingAll) return\n    pager.loadMore()\n  }, [pager])\n\n  // Fill the viewport: a page that does not reach the bottom leaves nothing to\n  // scroll, so the scroll handler would never fire and the reader would sit in\n  // front of a half-empty pane. Re-checking after each append makes a short file\n  // load in as many pages as it takes to overflow — and stop at EOF.\n  useEffect(() => {\n    const el = bodyRef.current\n    if (el === null || !visible) return\n    if (el.scrollHeight <= el.clientHeight + 8) maybeLoadMore()\n  }, [visible, pager.pages.length, pager.atEnd, pager.atCap, maybeLoadMore])\n\n  const onScroll = (event: UIEvent<HTMLDivElement>): void => {\n    const el = event.currentTarget\n    if (el.scrollHeight - el.scrollTop - el.clientHeight <= APPEND_THRESHOLD_PX) maybeLoadMore()\n  }\n\n  const toggle = useCallback((number: number): void => {\n    setExpanded((previous) => {\n      const next = new Set(previous)\n      if (next.has(number)) next.delete(number)\n      else next.add(number)\n      return next\n    })\n  }, [])\n\n  const firstNumber = pager.lineStarts[0] ?? 1\n  const lastNumber = Math.max(firstNumber, firstNumber + totalRows - 1)\n  /** The footer only means something while there is more to come, or once more\n   *  than one window has arrived (a single-page file needs no commentary). */\n  const showFooter = !pager.atEnd || pager.pages.length > 1\n\n  return (\n    <div className={css.largeFile}>\n      {tooLarge && (\n        <div className={css.largeFileNotice}>\n          <span>{t('previewOnlyNotice', { size: formatByteSize(size), limit: MAX_EDITABLE_LABEL })}</span>\n          <button\n            type=\"button\"\n            className={css.largeFileNoticeAction}\n            disabled={pager.atEnd || pager.atCap || pager.loadingAll}\n            title={pager.atCap ? t('previewRowLimit', { rows: maxRows }) : undefined}\n            onClick={pager.loadAll}\n          >\n            {pager.loadingAll\n              ? t('loadAllProgress', {\n                loaded: formatByteSize(pager.loadedBytes),\n                total: formatByteSize(size),\n              })\n              : t('loadAll')}\n          </button>\n          <a className={css.largeFileDownload} href={downloadUrl(scope, path)} download>\n            {t('downloadToView')}\n          </a>\n        </div>\n      )}\n      {pager.atCap && (\n        <div className={css.editorBanner}>{t('previewRowLimit', { rows: maxRows })}</div>\n      )}\n      <div\n        className={clsx(css.largeFileBody, records && css.largeFileRecords)}\n        ref={bodyRef}\n        onScroll={onScroll}\n      >\n        {pager.error !== null && <div className={css.editorError}>{pager.error}</div>}\n        {pager.error === null && pager.loading && pager.pages.length === 0 && (\n          <div className={css.editorPlaceholder}>{t('loading')}</div>\n        )}\n        {pager.error === null && pager.pages.length > 0 && records && (\n          <ol className={css.largeFileList} start={firstNumber}>\n            {rows.flatMap((lines, pageIndex) => {\n              const start = pager.lineStarts[pageIndex] ?? 1\n              return lines.map((line, rowIndex) => {\n                const number = start + rowIndex\n                return (\n                  <RecordRow\n                    key={number}\n                    number={number}\n                    line={line}\n                    expanded={expanded.has(number)}\n                    labels={labels}\n                    onToggle={toggle}\n                  />\n                )\n              })\n            })}\n          </ol>\n        )}\n        {pager.error === null && pager.pages.length > 0 && !records && (\n          <div className={css.largeFileLines}>\n            {rows.flatMap((lines, pageIndex) => {\n              const start = pager.lineStarts[pageIndex] ?? 1\n              return lines.map((line, rowIndex) => (\n                <div className={css.largeFileLine} key={`${pageIndex}:${rowIndex}`}>\n                  <span className={css.largeFileLineNo} aria-hidden=\"true\">{start + rowIndex}</span>\n                  <span className={css.largeFileLineText}>{line === '' ? '\\u00a0' : line}</span>\n                </div>\n              ))\n            })}\n          </div>\n        )}\n        {pager.error === null && pager.atEnd && totalRows === 0 && !pager.loading && (\n          <div className={css.editorPlaceholder}>{t('largeFileEmpty')}</div>\n        )}\n      </div>\n      {showFooter && (\n        <div className={css.largeFilePager}>\n          <span className={css.largeFilePageLabel}>\n            {records\n              ? t('jsonlRecordRange', { from: firstNumber, to: lastNumber })\n              : t('pagedLineRange', { from: firstNumber, to: lastNumber })}\n            {' · '}\n            {`${formatByteSize(pager.loadedBytes)} / ${formatByteSize(size)}`}\n          </span>\n          {pager.loading && !pager.loadingAll && <span className={css.largeFilePageLabel}>{t('loading')}</span>}\n          <button\n            type=\"button\"\n            className={css.iconButton}\n            aria-label={t('refresh')}\n            title={t('refresh')}\n            onClick={pager.reload}\n          >\n            <IconRefreshOutlineRegular size={14} />\n          </button>\n        </div>\n      )}\n    </div>\n  )\n}\n\n/**\n * One JSONL record row: a summary line, expanding into the host's JSON tree.\n *\n * Memoized because appending a page re-renders the whole list: without this,\n * every already-mounted record would be reconciled again on each append, and the\n * list is expected to grow into the tens of thousands. The record is parsed here\n * (rather than by the caller) so the parent's `flatMap` only builds elements.\n */\nconst RecordRow = memo(function RecordRow(props: {\n  number: number\n  /** The raw line, shown verbatim when the record does not parse. */\n  line: string\n  expanded: boolean\n  labels: JsonTreeLabels\n  onToggle: (number: number) => void\n}): ReactNode {\n  const { number, line, expanded, labels, onToggle } = props\n  const record = useMemo(() => parseRecord(line), [line])\n  if (!record.ok) {\n    // A blank line is not a broken record — JSONL files normally end with one,\n    // and the host's pages are line-aligned, so it lands as its own row.\n    if (record.error === '') return null\n    return (\n      <li className={clsx(css.largeFileRecord, css.largeFileRecordInvalid)}>\n        <span className={css.largeFileRecordNo} aria-hidden=\"true\">{number}</span>\n        <div className={css.largeFileRecordBody}>\n          <div className={css.largeFileRecordSummary}>{t('jsonlInvalidRecord')}</div>\n          <pre className={css.largeFileRecordRaw}>{line}</pre>\n        </div>\n      </li>\n    )\n  }\n  const value = record.value\n  const tree = isTreeRecord(value)\n  return (\n    <li className={clsx(css.largeFileRecord, expanded && css.largeFileRecordExpanded)}>\n      <span className={css.largeFileRecordNo} aria-hidden=\"true\">{number}</span>\n      <div className={css.largeFileRecordBody}>\n        <button\n          type=\"button\"\n          className={css.largeFileRecordSummary}\n          aria-expanded={tree ? expanded : undefined}\n          disabled={!tree}\n          onClick={() => { onToggle(number) }}\n        >\n          {summarizeRecord(value)}\n        </button>\n        {tree && expanded && (\n          <div className={css.largeFileRecordTree}>\n            <JsonTree data={value} label={`#${number}`} labels={labels} copyable expandTopLevel />\n          </div>\n        )}\n      </div>\n    </li>\n  )\n})\n","/**\n * The workspace root a session-scoped file ADDRESS is built and read with.\n *\n * DSH's address contract fixes that base to the session's STORED header cwd:\n * the host chat builds every file link with\n * `fileAddressFor(sessionId, ctx.sessions.list.getSnapshot().byId[sessionId]?.cwd, path)`\n * (DSH `ui-chat`), and the host's own file resolver reads the relative path\n * back against `sessions.get(sessionId).header.cwd` (DSH `api-workspace-files`)\n * — the same value, so the host round-trips perfectly.\n *\n * The plugin does not: since #802 its filesystem routes follow the ACTIVE git\n * worktree, so an address's relative path re-resolved by a worktree-rooted\n * reader lands somewhere else entirely — doubled when the worktree sits inside\n * the stored cwd (`<repo>/frontend/.worktrees/wt/a.md` arrives as\n * `frontend/.worktrees/wt/a.md` and becomes\n * `<wt>/frontend/.worktrees/wt/a.md`, ENOENT — #947), or silently on the\n * same-named file of another checkout (#950).\n *\n * The rule that removes the whole family: an address's base is THIS value,\n * never the active worktree root, and an address's path is resolved to an\n * absolute one at the boundary where the address is read, so no\n * worktree-rooted code downstream ever sees a relative path it could re-base.\n * Live relative paths the user or the plugin intends (file tree, typed\n * paths, links inside a document) keep using the active root, which is what\n * `useSessionRoot` is for.\n *\n * @param ctx - client context carrying the session list.\n * @param sessionId - the session the address belongs to; `undefined` answers\n *   `undefined` so callers can fall back to their own cwd.\n * @returns the stored header cwd, or `undefined` when it is unknown (a\n *   stripped-down host or a bare test context).\n */\nimport type { Context } from '../context-types.ts'\nimport { resolveSidebarPath } from './paths.ts'\n\nexport function addressBaseOf(ctx: Context, sessionId: string | undefined): string | undefined {\n  if (sessionId === undefined) return undefined\n  try {\n    return ctx.sessions?.list?.getSnapshot?.()?.byId?.[sessionId]?.cwd\n  } catch {\n    // A context without the session list (or with a broken one) keeps the\n    // caller's own cwd; the address is no worse than before this helper.\n    return undefined\n  }\n}\n\n/**\n * Resolve an address's path against its base, spelled the way the base is.\n *\n * The address grammar is `/`-separated on every platform, so joining one onto\n * a Windows base with `resolveSidebarPath` alone leaves a MIXED spelling:\n * `C:\\repo` + `src/a.ts` → `C:\\repo\\src/a.ts`, while the file tree, the git\n * panel and every `join`-based producer spell the same file\n * `C:\\repo\\src\\a.ts`. Two spellings of one file is two tab identities (the\n * editor's `dedupeKey`/id is path-derived) and two answers to \"is it the same\n * path\", so the address boundary folds the separators to the base's style.\n * POSIX keeps the path verbatim: there `\\` is a legal file-name character, not\n * a separator (the same reason `resolveSidebarPath` never folds on POSIX).\n *\n * A UNC prefix is NOT a separator run to fold: `\\\\server\\share` is one path\n * root, and folding its two leading separators into one turns an absolute\n * network path into a drive-root-relative one. On Windows the host then runs\n * `path.resolve()` on it, anchoring `\\wsl.localhost\\...` on the host process\n * drive (`C:\\wsl.localhost\\...`, ENOENT) — every file opened from a\n * `\\\\wsl.localhost\\<distro>\\...` workspace failed that way. Keep exactly the\n * two leading separators and fold only the rest.\n *\n * @param base - the workspace root whose separator style decides the answer.\n * @param path - an address path (relative to `base`) or an absolute path.\n * @returns the resolved path in `base`'s separator style.\n */\nexport function resolveAddressPath(base: string | undefined, path: string): string {\n  const resolved = resolveSidebarPath(base, path)\n  if (base === undefined || !base.includes('\\\\')) return resolved\n  const folded = resolved.replace(/[/\\\\]+/g, '\\\\')\n  return /^[\\\\/]{2}/.test(resolved) ? `\\\\\\\\${folded.replace(/^\\\\+/, '')}` : folded\n}\n","/**\n * The DSH resource-address grammar for files (`dsh-resource://file/…`).\n *\n * DSH's right Sidebar opens content by ADDRESS, and a file's address IS the\n * tab's content identity: the same address is the same tab. Two scopes exist:\n *\n * - `dsh-resource://file/session/<sessionId>/<path>` names a file by its path\n *   relative to that session's workspace root OR by its absolute path kept\n *   absolute inside the session scope (`src/a.ts` vs `/outside/a.ts` — the\n *   leading `/` survives; the host resolves it against the root it holds for\n *   the session);\n * - `dsh-resource://file/absolute/<path>` names a file by its absolute path\n *   with the leading `/` dropped (`absolute/home/me/x.txt`; Windows\n *   `absolute/C:/x/y.txt`; a UNC path keeps an empty first segment,\n *   `absolute//server/share/x.txt`). It carries no session. `fileAddressFor`\n *   no longer produces this scope on DSH 0.1.5-alpha.2, but it must keep\n *   parsing: legacy and third-party addresses still spell it.\n *\n * Every id and path segment is component-encoded, so a name carrying `#`, `?`\n * or a space survives the round trip; `:` stays literal so a drive letter\n * reads as written.\n *\n * The plugin parses these addresses itself instead of importing\n * `@deepseek-ai/dsh-util-workspace-path`: the client bundle's purity gate\n * forbids value-importing an unlisted `@deepseek-ai/*` package. This module\n * mirrors that package's implementation — `packages/util/workspace-path/src/file-address.ts`\n * and `fileAddressFor` in `packages/util/workspace-path/src/index.ts` in\n * DSH 0.1.5-alpha.2 (github.com/deepseek-ai/deepseek-harness, tag\n * `dsh-v0.1.5-alpha.2`) — and is pinned by tests/resource-address.spec.ts.\n */\n\n/** The scheme and type every file address opens with. */\nexport const FILE_ADDRESS_PREFIX = 'dsh-resource://file/'\n\n/**\n * A file resource address, in one of two scopes.\n */\nexport type FileAddress =\n  | {\n    readonly scope: 'session'\n    /** The session whose workspace root resolves the path. */\n    readonly sessionId: string\n    /** Absolute or workspace-relative `/`-separated path; empty for the workspace root itself. */\n    readonly path: string\n  }\n  | {\n    readonly scope: 'absolute'\n    /** Absolute `/`-separated path: `/a/b` on POSIX, `C:/a/b` for a drive, `//server/share/a` for UNC. */\n    readonly path: string\n  }\n\n/** Component-encode one id or path segment, keeping `:` literal for drive letters. */\nfunction encodeSegment(segment: string): string {\n  return encodeURIComponent(segment).replace(/%3A/gi, ':')\n}\n\n/** Encode a `/`-separated path segment by segment. */\nfunction encodePath(path: string): string {\n  return path.split('/').map(encodeSegment).join('/')\n}\n\n/** Whether a decoded first path segment is a Windows drive (`C:`). */\nfunction isDriveSegment(segment: string | undefined): boolean {\n  return segment !== undefined && /^[A-Za-z]:$/.test(segment)\n}\n\n/**\n * Build the address of a file read through one session.\n * @param sessionId - the session whose workspace root resolves the path.\n * @param path - absolute or workspace-relative path; backslashes are normalized\n *   to `/`, and leading `./` prefixes are dropped (a leading `/` is KEPT: an\n *   absolute path stays absolute inside the session scope).\n * @returns the `dsh-resource://file/session/<sessionId>/<path>` address.\n */\nexport function sessionFileAddress(sessionId: string, path: string): string {\n  const normalized = path.replace(/\\\\/g, '/').replace(/^(?:\\.\\/)+/, '')\n  return `${FILE_ADDRESS_PREFIX}session/${encodeSegment(sessionId)}/${encodePath(normalized)}`\n}\n\n/**\n * Build the address of a file by its absolute path.\n * @param path - absolute path; backslashes are normalized to `/` and the leading `/`\n *   is dropped, except that a UNC path keeps one empty first segment.\n * @returns the `dsh-resource://file/absolute/<path>` address.\n */\nexport function absoluteFileAddress(path: string): string {\n  const normalized = path.replace(/\\\\/g, '/')\n  const unc = normalized.startsWith('//')\n  const absolute = normalized.replace(/^\\/+/, '')\n  return `${FILE_ADDRESS_PREFIX}absolute/${unc ? '/' : ''}${encodePath(absolute)}`\n}\n\n/**\n * Read a file address back into its parts without resolving `.` or `..`.\n * Query and fragment suffixes are ignored; encoded path segments are decoded.\n * @param address - a candidate address.\n * @returns the parts, or `undefined` when the string is not a\n *   `dsh-resource://file/` URI in a known scope with a path, or a segment is\n *   not validly encoded.\n */\nexport function parseFileAddress(address: string): FileAddress | undefined {\n  try {\n    if (!address.startsWith(FILE_ADDRESS_PREFIX)) return undefined\n    const end = address.search(/[?#]/)\n    const [scope, ...rest] = address.slice(FILE_ADDRESS_PREFIX.length, end === -1 ? undefined : end).split('/')\n    if (scope === 'session') {\n      const [id, ...segments] = rest\n      if (id === undefined || id === '' || segments.length === 0) return undefined\n      return { scope, sessionId: decodeURIComponent(id), path: segments.map(decodeURIComponent).join('/') }\n    }\n    if (scope === 'absolute') {\n      // An empty first segment with more behind it is a UNC path's `//`; alone it is no path.\n      const unc = rest[0] === '' && rest.length > 1\n      const segments = (unc ? rest.slice(1) : rest).map(decodeURIComponent)\n      if (segments.length === 0 || segments[0] === '') return undefined\n      if (unc) return { scope, path: `//${segments.join('/')}` }\n      return { scope, path: isDriveSegment(segments[0]) ? segments.join('/') : `/${segments.join('/')}` }\n    }\n    return undefined\n  } catch {\n    // `decodeURIComponent` throws URIError on a malformed escape.\n    return undefined\n  }\n}\n\n/** Whether a path is absolute in either spelling the host accepts. */\nfunction isAbsolutePath(path: string): boolean {\n  return path.startsWith('/') || /^[A-Za-z]:[/\\\\]/.test(path) || path.startsWith('\\\\\\\\')\n}\n\n/**\n * The address for a path as a caller holds it: ALWAYS session-scoped. A\n * relative path, or an absolute path inside the session's workspace, becomes\n * the relative spelling; an absolute path outside it, or one whose workspace\n * root is unknown, keeps its absolute path in that session's address. (Mirror\n * of `fileAddressFor` — on alpha.2 this helper no longer produces the\n * `absolute` scope, though such addresses still parse.)\n * @param sessionId - the session the path is read in.\n * @param cwd - that session's workspace root, when known.\n * @param path - absolute or workspace-relative path, either separator spelling.\n * @returns the `dsh-resource://file/…` address.\n */\nexport function fileAddressFor(sessionId: string, cwd: string | undefined, path: string): string {\n  const normalized = path.replace(/\\\\/g, '/')\n  if (!isAbsolutePath(normalized)) return sessionFileAddress(sessionId, normalized)\n  const root = cwd === undefined ? '' : cwd.replace(/\\\\/g, '/').replace(/\\/+$/, '')\n  if (root !== '' && normalized === root) return sessionFileAddress(sessionId, '')\n  if (root !== '' && normalized.startsWith(`${root}/`)) return sessionFileAddress(sessionId, normalized.slice(root.length + 1))\n  return sessionFileAddress(sessionId, normalized)\n}\n","/**\n * Opening one workspace file in the sidebar — after asking DSH's native tab\n * registry which type owns it.\n *\n * Extracted from the removed turn-tail interception (`intercept.tsx`): DSH\n * 0.1.6-alpha.2 turned `conversation.chat.turnTail` from a `chain` into an\n * additive `list`, so a plugin can no longer REPLACE the built-in\n * deliverables row — the plugin's own produced-files row became a duplicate\n * of a row the host already draws, and was deleted. The file-opening half is\n * the only part still used by the changes tab and the editor host.\n *\n * Naming this plugin's own `editor` type directly used to bypass the native\n * tab registry (#695): a type that explicitly claims a file kind (a `.drawio`\n * canvas registered with `extension` priority and a specific address glob,\n * say) wins the registry's ranking — priority band, matched-pattern length,\n * registration order — yet could never render from these entry points, while\n * the same file opened from the chat (`ctx.sidebarRight.openResource`) did\n * reach it. With the native surface installed, `betterSidebar.openTab({type:\n * 'editor', path})` already resolves through the host's registry (openTab's\n * native branch turns the path seed into a resource address), but that\n * address carries no cwd, and merged-mode opens never went through openTab at\n * all. The probe below closes both gaps: open through the native surface\n * whenever a type other than the editor claims the address, and keep the\n * editor path verbatim for every other file.\n */\nimport type { Context } from '../context-types.ts'\nimport { addressBaseOf, resolveAddressPath } from './address-base.ts'\nimport { fileAddressFor } from './resource-address.ts'\n\n/** The kind this plugin's own file editor registers its tab type under. */\nconst EDITOR_KIND = 'editor'\n\n/**\n * The tab type that would open `address` besides this plugin's own editor.\n *\n * Probing is the whole fix for #695: the registry's ranking — not this\n * plugin's hard-coded `editor` — decides who owns a file address, and the\n * plugin itself already relies on that ranking (its editor holds\n * `dsh-resource://file/**` at the `extension` band, which is why it beats the\n * built-in `text` preview at `fallback` in the first place). For a file no\n * other type claims, the editor IS the best candidate, so the answer is\n * undefined and every caller keeps its previous path verbatim.\n *\n * @param ctx - client context; `ctx.get` is used because the registry is\n * optional (a stripped-down host may not provide it).\n * @param address - the `dsh-resource://file/…` address of the file being opened.\n * @returns the claiming type's kind, or undefined when the editor ranks first\n * (or the probe cannot run — the probe is best-effort by contract).\n */\nexport function claimingNativeKind(ctx: Context, address: string): string | undefined {\n  try {\n    const tabs = ctx.get('sidebarRightTabs')\n    if (tabs === undefined) return undefined\n    const best = tabs.candidates(address)[0]\n    return best !== undefined && best.kind !== undefined && best.kind !== EDITOR_KIND ? best.kind : undefined\n  } catch (error) {\n    // Probing is best-effort: an incompatible registry keeps the editor path.\n    console.error('[dsh-better-sidebar] tab-claim probe failed', error)\n    return undefined\n  }\n}\n\n/**\n * Open one file through the native surface when a type other than this\n * plugin's editor claims it.\n *\n * The address is built WITH the session's stored header cwd — the base the\n * host builds and reads its own addresses with, see\n * `src/client/address-base.ts` — so a claimed file opened here dedupes against\n * the tab the chat path already opened for the same file, and the address\n * resolves the same way wherever it is read.\n *\n * @param ctx - client context (`sidebarRightTabs` for the probe,\n * `sidebarRight` for the open).\n * @param sessionId - the session whose workspace the path resolves in.\n * @param cwd - that session's workspace root, when known; used only when the\n * session list cannot answer for `sessionId`.\n * @param path - absolute or session-relative file path.\n * @returns true when the claiming type was handed the file; false leaves the\n * caller on its editor path (unclaimed file, no registry, or no surface).\n */\nexport function openClaimedNativeFile(ctx: Context, sessionId: string, cwd: string | undefined, path: string): boolean {\n  const address = fileAddressFor(sessionId, addressBaseOf(ctx, sessionId) ?? cwd, path)\n  if (claimingNativeKind(ctx, address) === undefined) return false\n  const service = ctx.get('betterSidebar')\n  if (service === undefined) return false\n  service.openTab({ type: 'editor', path, target: 'right' }, { sessionId, cwd })\n  return true\n}\n\n/**\n * Open a file in the sidebar's editor — unless a native type claims it.\n *\n * Routes through the sidebar service so the editor descriptor's dedupeKey\n * (per-path) applies; the id is path-derived so multiple editors coexist.\n *\n * A RELATIVE path resolves against the caller's live workspace root when it\n * has one (`options.cwd`, what every internal caller takes from\n * `useSessionRoot`), and only falls back to the session list's stored cwd: the\n * stored value is the session HEADER cwd, which the agent may have left for a\n * linked worktree, and resolving an intended-relative path against it while\n * the file tree, the editor's own path input and every route resolve against\n * the worktree is exactly the \"same relative path, two files, no error\"\n * divergence of #950. An ABSOLUTE path is unaffected by either base.\n *\n * @param ctx - client context carrying `betterSidebar`.\n * @param sessionId - the session whose workspace resolves a relative path.\n * @param path - absolute or session-relative file path.\n * @param options - `line`: the 1-based line a file reference named\n * (`a.c#L131`, #826), omitted on an ordinary open — it rides the open as a\n * transient navigation, the editor lands on it once (leaving preview, which\n * renders no source lines) and the record forgets it afterwards; `cwd`: the\n * caller's live workspace root for a relative path.\n * @returns nothing.\n */\nexport function openSidebarFile(\n  ctx: Context,\n  sessionId: string,\n  path: string,\n  options: { line?: number; cwd?: string } = {},\n): void {\n  const summary = ctx.sessions.list.getSnapshot().byId[sessionId]\n  const absolute = resolveAddressPath(options.cwd ?? summary?.cwd, path)\n  // A type that explicitly claims this file owns it: hand the address to the\n  // native surface so that type's registered tab body renders instead of this\n  // plugin's editor (#695). Every other file falls through to the editor.\n  if (openClaimedNativeFile(ctx, sessionId, summary?.cwd, absolute)) return\n  const at = Math.max(absolute.lastIndexOf('/'), absolute.lastIndexOf('\\\\'))\n  const title = at === -1 ? absolute : absolute.slice(at + 1)\n  ctx.get('betterSidebar')?.openTab({\n    type: 'editor',\n    title,\n    path: absolute,\n    id: `editor:${absolute}`,\n    ...(options.line === undefined ? {} : { line: options.line }),\n  }, { sessionId, cwd: options.cwd ?? summary?.cwd })\n}\n","/**\n * The `path:line` suffix a file reference can carry, split back off.\n *\n * DSH's markdown link grammar (`parseFileLink` in\n * `packages/client/ui-primitives/src/markdown/file-link.ts`) understands ONE\n * line syntax: the GitHub-style fragment `path#L131` / `path#L131-L200`. A\n * destination without a `#` is taken as the file name VERBATIM, so the other\n * convention models actually write — `path:131`, the one compiler\n * diagnostics, `grep -n` and every terminal use — reaches the tab as a file\n * called `CMakeLists.txt:131`. The editor then reads a path that does not\n * exist and the sidebar says so (#826).\n *\n * The host owns that grammar and this plugin may not patch it, so the\n * correction happens where the plugin already turns a file ADDRESS into a tab\n * record: {@link fileParamsOf} in `native/index.ts`. Everything downstream\n * (the tab title, the viewer match, the read, the save, \"open with\") then sees\n * a real path, so there is nothing left to retry and nothing to remember.\n *\n * The trade is explicit: a file whose NAME really ends in `:<digits>` opened\n * FROM A CHAT LINK loses its suffix. Paths that come from the file tree, the\n * search box or the sidebar's own flows never pass through this module, and\n * `:` is not even a legal filename character on Windows.\n */\n\n/** One line reference split off a path. */\nexport interface LineSpec {\n  /** The path with the spec removed — the file the reference points at. */\n  readonly path: string\n  /** 1-based first line. */\n  readonly line: number\n  /** 1-based last line; equal to {@link line} unless the spec was a range. */\n  readonly end: number\n  /** 1-based column, when the spec carried one (`path:12:5`). */\n  readonly column: number | undefined\n}\n\n/**\n * A trailing line spec: `:<line>`, `:<line>-<end>` or `:<line>:<column>`.\n *\n * Line numbers are 1-based with no leading zero, exactly as the host's own\n * fragment rule (`^L([1-9]\\d*)`) — so `version:0` and a bare `:0` are file\n * names, not line references. The regex is anchored at the END of the string,\n * which is what keeps `data:2024.csv` and `C:` intact.\n */\nconst TRAILING_LINE_SPEC = /:([1-9]\\d{0,8})(?:-([1-9]\\d{0,8}))?(?::([1-9]\\d{0,8}))?$/u\n\n/**\n * Split a trailing `path:line` spec off a path.\n *\n * Rejected on purpose, because stripping them would break a path that is\n * already a valid file name: a spec with nothing in front of it (`:131`), a\n * one-character remainder (`C:131`, where `C` could only be a drive letter),\n * and an inverted range (`a.c:20-12`) — the host rejects that one too.\n * @param path - a path as a caller holds it, in either separator spelling.\n * @returns the path without the spec plus the line it named, or `undefined`\n * when the path carries no trailing line spec.\n */\nexport function splitTrailingLineSpec(path: string): LineSpec | undefined {\n  const match = TRAILING_LINE_SPEC.exec(path)\n  if (match === null) return undefined\n  const head = path.slice(0, match.index)\n  if (head.length < 2) return undefined\n  const line = Number(match[1])\n  const end = match[2] === undefined ? line : Number(match[2])\n  if (end < line) return undefined\n  return {\n    path: head,\n    line,\n    end,\n    column: match[3] === undefined ? undefined : Number(match[3]),\n  }\n}\n","/**\n * React glue for ONE plugin-drawn markdown surface (the container that holds\n * the rendered markdown). It returns three things the caller wires up:\n *\n * - `surfaceRef`: a CALLBACK REF for that container. The installer behind it\n *   runs the DOM pass from `markdown-navigation.ts` (heading slugs + collapsed\n *   explicit anchors) on mount and after every content mutation — the pattern\n *   the raw-HTML preview pass already uses, which keeps late content (the lazy\n *   mermaid chunk, shiki highlighting) covered and makes the pass self-healing\n *   when React re-renders a subtree it owns — and then applies the cross-file\n *   fragment parked for this document. A callback ref (not a `RefObject`)\n *   because the container mounts and unmounts with its host — the preview\n *   container disappears on every preview→edit flip — and only a ref callback\n *   fires on both edges (React 18 hands it `null` on unmount, which is where\n *   the observer is torn down). Its identity is keyed on (session, path) alone,\n *   so an ordinary re-render never detaches anything.\n * - `openFile`: the host delegate's file handler. The host renderer only makes\n *   a local markdown link clickable when a `MarkdownDelegateProvider` supplies\n *   this, which is why every caller wraps its markdown in that provider with\n *   `openFile={surface.openFile}`: the provider's scope IS the claim boundary,\n *   and a link rendered outside it (the host's chat prose, any other panel) is\n *   never seen by this plugin.\n * - `rewrite`: the source-side pass (`rewriteLocalMarkdownLinks`) that runs\n *   BEFORE rendering, so a heading fragment survives the host's parser and a\n *   link the plugin does not claim stays inert prose.\n */\nimport { useCallback, useRef } from 'react'\nimport type { Context } from '../context-types.ts'\nimport {\n  jumpToFragment,\n  lineOfHostFragment,\n  markdownAnchorTarget,\n  prepareMarkdownAnchors,\n  rememberMarkdownAnchor,\n  rewriteLocalMarkdownLinks,\n  takeMarkdownAnchor,\n} from './markdown-navigation.ts'\nimport { openSidebarFile } from './sidebar-file.ts'\nimport { splitTrailingLineSpec } from './path-line.ts'\n\n/** The DOM marker the installer puts on the container it owns (the claim\n *  boundary is the provider scope; this makes the surface inspectable in a\n *  browser and pointable from a spec). */\nexport const MARKDOWN_SURFACE_ATTR = 'data-dsh-md-surface'\n\nexport interface MarkdownSurfaceOptions {\n  /** Client context: the open goes through `openSidebarFile`, the plugin's own\n   *  claim-aware editor path (same entry point the file tree and the chat\n   *  mentions use). */\n  ctx: Context\n  /** The session the markdown renders in — the open scope and the key of the\n   *  pending-fragment table. */\n  sessionId: string\n  /** The session workspace root, when the caller has a scope. Read live at\n   *  click time (a session's cwd may land after the tab does). */\n  cwd?: string\n  /** The rendered file's absolute path: relative targets resolve against its\n   *  directory. Prose surfaces (transcript, task note) omit it — their\n   *  relative targets resolve against the session cwd instead. */\n  path?: string\n  /** Prose such as Side Chat can open source files as well as Markdown documents. */\n  allLocalFiles?: boolean\n}\n\n/** What a surface wires into its markup. */\nexport interface MarkdownSurfaceBinding {\n  /** Callback ref for the container that holds the rendered markdown. */\n  surfaceRef: (element: HTMLElement | null) => void\n  /** `MarkdownDelegateProvider.openFile` for this surface. */\n  openFile: (destination: string, options?: { line?: number }) => void\n  /** Rewrite one markdown text before rendering it in this surface. */\n  rewrite: (text: string) => string\n}\n\n/**\n * Wire one plugin markdown surface.\n * @param opts - the surface's context, session and rendered document path.\n * @returns the container ref, the delegate handler and the source rewrite.\n */\nexport function useMarkdownSurface(opts: MarkdownSurfaceOptions): MarkdownSurfaceBinding {\n  const { ctx, sessionId, cwd, path, allLocalFiles = false } = opts\n  const containerRef = useRef<HTMLElement | null>(null)\n  const detachRef = useRef<(() => void) | null>(null)\n\n  /** The session workspace root: the caller's scope when it has one, else the\n   *  session summary (a stripped-down host or a bare spec context may have no\n   *  session list at all — the opener then resolves against its own cwd). */\n  const resolveCwd = useCallback(\n    (): string | undefined => cwd ?? ctx.sessions?.list?.getSnapshot?.()?.byId?.[sessionId]?.cwd,\n    [ctx, sessionId, cwd],\n  )\n\n  const surfaceRef = useCallback((element: HTMLElement | null): void => {\n    detachRef.current?.()\n    detachRef.current = null\n    containerRef.current = element\n    if (element === null) return\n    detachRef.current = attachMarkdownSurface(element, sessionId, path, resolveCwd)\n  }, [sessionId, path, resolveCwd])\n\n  const openFile = useCallback((destination: string, options?: { line?: number }): void => {\n    const target = markdownAnchorTarget(destination, path, resolveCwd(), allLocalFiles)\n    if (target === null) return\n    if (target.kind === 'same-page') {\n      const container = containerRef.current\n      if (container !== null) jumpToFragment(container, target.fragment)\n      return\n    }\n    // `#L24` is a LINE, not an anchor: the host hands the number over as\n    // `options.line` (and leaves the destination untouched), the fragment is\n    // the same grammar for a caller that only has the destination. Either way\n    // the line has to travel WITH the open — a line reference asks for source,\n    // so the editor lands on it (and leaves preview, which renders no lines).\n    // Only a heading fragment parks a jump for the document about to open.\n    const spec = allLocalFiles ? splitTrailingLineSpec(target.path) : undefined\n    const filePath = spec?.path ?? target.path\n    const line = options?.line ?? lineOfHostFragment(target.fragment) ?? spec?.line\n    if (line === undefined && target.fragment !== '') {\n      rememberMarkdownAnchor(sessionId, resolveCwd(), filePath, target.fragment)\n    }\n    try {\n      // The live root rides along: a destination that resolved to a RELATIVE\n      // path (neither the document's directory nor a cwd was known) must land\n      // on the same workspace the surrounding tree and routes use, not on the\n      // session's frozen header cwd (#950).\n      openSidebarFile(ctx, sessionId, filePath, { line, cwd: resolveCwd() })\n    } catch (error) {\n      // A failed open leaves the reader where they are (the link was claimed);\n      // the parked fragment expires on its own.\n      console.error('[dsh-better-sidebar] markdown file link open failed', error)\n    }\n  }, [ctx, sessionId, path, resolveCwd, allLocalFiles])\n\n  const rewrite = useCallback(\n    (text: string): string => rewriteLocalMarkdownLinks(text, path, resolveCwd(), allLocalFiles),\n    [path, resolveCwd, allLocalFiles],\n  )\n\n  return { surfaceRef, openFile, rewrite }\n}\n\n/**\n * Install the post-render half on one container: the DOM pass, its mutation\n * re-runs, and the pending cross-file fragment.\n * @returns the disposer (observer + marker).\n */\nfunction attachMarkdownSurface(\n  container: HTMLElement,\n  sessionId: string,\n  path: string | undefined,\n  resolveCwd: () => string | undefined,\n): () => void {\n  container.setAttribute(MARKDOWN_SURFACE_ATTR, '')\n  prepareMarkdownAnchors(container)\n\n  /** The fragment this surface still owes the reader (taken once, then carried\n   *  here until the heading actually renders — the content may arrive a beat\n   *  after the container does). */\n  let pending: string | null = path === undefined || path === '' ? null : takeMarkdownAnchor(sessionId, resolveCwd(), path)\n  const applyPending = (): void => {\n    if (pending !== null && jumpToFragment(container, pending)) pending = null\n  }\n  // After the commit that mounted this container: the host's layout effects\n  // (the preview's remembered-scroll restore) run first, so this is the last\n  // write to the scroller.\n  if (pending !== null) queueMicrotask(applyPending)\n\n  let scheduled: number | undefined\n  const observer = new MutationObserver(() => {\n    if (scheduled !== undefined) return\n    // Coalesce a burst of mutations into one DOM pass: each pass walks the\n    // whole preview, and diagram swapping / shiki settling emit many mutations.\n    scheduled = window.setTimeout(() => {\n      scheduled = undefined\n      prepareMarkdownAnchors(container)\n      applyPending()\n    }, 80)\n  })\n  observer.observe(container, { childList: true, subtree: true })\n\n  return () => {\n    observer.disconnect()\n    if (scheduled !== undefined) window.clearTimeout(scheduled)\n    container.removeAttribute(MARKDOWN_SURFACE_ATTR)\n  }\n}\n","/**\n * The markdown preview's table of contents: a sticky zero-height bar keeping\n * a small \"outline\" button pinned at the top-right of the preview's scroll\n * container, visible once the document has at least {@link TOC_MIN_HEADINGS}\n * headings. The button opens a popover outline (h1–h6 collected from the\n * rendered DOM — so headings inside HTML runs count too); clicking an entry\n * expands any collapsed `<details>` ancestor, smooth-scrolls the heading into\n * view and flashes it. The scan re-runs through a MutationObserver so late\n * content (lazy mermaid chunk, shiki highlighting) is picked up.\n *\n * Mount contract: render as a DIRECT child of the scroll container it\n * outlines. The container is discovered through the bar's own DOM position\n * (`parentElement`), not a passed ref — React attaches a parent host\n * element's ref only after its children's layout effects have run, so a\n * ref-based container read here would see null at mount and never re-run.\n * The bar itself renders unconditionally (zero height, pointer-events\n * none), so it never affects the preview layout.\n */\nimport { useLayoutEffect, useRef, useState } from 'react'\nimport type { ReactNode } from 'react'\nimport { IconListPenOutlineRegular } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { t } from './locales.ts'\nimport css from './sidebar.module.css'\n\n/** Fewer headings than this and the button stays hidden (no outline value). */\nexport const TOC_MIN_HEADINGS = 3\n\n/** One collected outline entry; `el` is the live rendered heading element. */\ninterface TocEntry {\n  level: number\n  text: string\n  el: HTMLElement\n}\n\n/** The signature used to skip no-op rescans (identity-safe setState guard). */\nfunction signatureOf(entries: readonly TocEntry[]): string {\n  return entries.map((entry) => `${entry.level}:${entry.text}`).join('\\n')\n}\n\nexport function MdToc(): ReactNode {\n  const barRef = useRef<HTMLDivElement>(null)\n  const [entries, setEntries] = useState<TocEntry[]>([])\n  const [open, setOpen] = useState(false)\n  const signatureRef = useRef('')\n\n  useLayoutEffect(() => {\n    // The bar's own host ref is attached before this effect runs; the scroll\n    // container is its parent by the mount contract above.\n    const container = barRef.current?.parentElement ?? null\n    if (container === null) return\n    const scan = (): void => {\n      const found: TocEntry[] = []\n      for (const el of container.querySelectorAll<HTMLElement>('h1, h2, h3, h4, h5, h6')) {\n        const text = (el.textContent ?? '').trim()\n        if (text === '') continue\n        found.push({ level: Number(el.tagName.charAt(1)), text, el })\n      }\n      const signature = signatureOf(found)\n      if (signature === signatureRef.current) return\n      signatureRef.current = signature\n      setEntries(found)\n    }\n    scan()\n    const observer = new MutationObserver(() => { scan() })\n    observer.observe(container, { childList: true, subtree: true })\n    return () => { observer.disconnect() }\n  }, [])\n\n  // Esc closes the popover (the panel is a sibling of the button, so focus\n  // stays wherever the user came from — a document listener is the simplest).\n  // A document pointerdown also closes it when the click lands outside the\n  // button and the panel, so clicking blank preview space dismisses the\n  // outline instead of requiring a second click on the toggle. The check runs\n  // at pointerdown (before the button's own click toggles), and the button and\n  // panel are exempt so a re-click on the toggle keeps working as a toggle\n  // rather than being eaten by the dismiss.\n  useLayoutEffect(() => {\n    if (!open) return\n    const onKey = (event: KeyboardEvent): void => {\n      if (event.key === 'Escape') setOpen(false)\n    }\n    const onPointerDown = (event: Event): void => {\n      const target = event.target\n      if (!(target instanceof Node)) return\n      const bar = barRef.current\n      if (bar !== null && bar.contains(target)) return\n      setOpen(false)\n    }\n    document.addEventListener('keydown', onKey)\n    document.addEventListener('pointerdown', onPointerDown)\n    return () => {\n      document.removeEventListener('keydown', onKey)\n      document.removeEventListener('pointerdown', onPointerDown)\n    }\n  }, [open])\n\n  const jump = (entry: TocEntry): void => {\n    entry.el.closest('details:not([open])')?.setAttribute('open', '')\n    entry.el.scrollIntoView({ behavior: 'smooth', block: 'start' })\n    const el = entry.el\n    const flash = css.tocFlash\n    if (flash !== undefined) {\n      el.classList.add(flash)\n      window.setTimeout(() => { el.classList.remove(flash) }, 1200)\n    }\n    setOpen(false)\n  }\n\n  const showOutline = entries.length >= TOC_MIN_HEADINGS\n  return (\n    <div className={css.tocBar} ref={barRef}>\n      {open && showOutline && (\n        <div className={css.tocPanel} data-dsh-md-toc-panel>\n          {entries.map((entry, index) => (\n            <button\n              key={index}\n              type=\"button\"\n              className={css.tocItem}\n              data-level={entry.level}\n              title={entry.text}\n              onClick={() => { jump(entry) }}\n            >\n              <span className={css.tocItemLevel}>{entry.level}</span>\n              <span className={css.tocItemText}>{entry.text}</span>\n            </button>\n          ))}\n        </div>\n      )}\n      {showOutline && (\n        <button\n          type=\"button\"\n          className={css.tocButton}\n          data-dsh-md-toc=\"\"\n          aria-label={t('toc')}\n          title={t('toc')}\n          aria-expanded={open}\n          onClick={() => { setOpen(!open) }}\n        >\n          <IconListPenOutlineRegular />\n        </button>\n      )}\n    </div>\n  )\n}\n","/**\n * Shared vocabulary of the sidebar's HTML preview surfaces (the editor's\n * html viewer and the changes tab's op render preview): the sandbox tokens\n * both preview iframes load with.\n */\n\n/**\n * The sandbox tokens of an HTML preview iframe. NO allow-same-origin (the\n * preview must stay in an opaque origin — with the route's own origin it\n * could read session data) and NO allow-top-navigation (a previewed page\n * must not hijack the GUI). The editor viewer can disable the sandbox\n * per-feature in the side card settings (warned); the changes tab's op\n * render preview always stays sandboxed.\n */\nexport const HTML_IFRAME_SANDBOX = 'allow-scripts allow-popups allow-downloads allow-modals'\n","/**\n * Desktop-shell HTML preview inlining.\n *\n * The shell only injects its `x-dsh-desktop-renderer` header for a subframe\n * whose origin is literally `dsh-app://app`; a sandboxed HTML preview frame is\n * an opaque origin, so both the document navigation and every resource it\n * requests from `dsh-app:` are rejected by the shell before they reach the\n * plugin's routes (#1143). The sanctioned shape (the host's own document\n * preview uses it) is a self-contained document in a sandboxed `blob:` frame:\n * the trusted top frame fetches the HTML and its local resources through the\n * plugin routes, rewrites them to `data:` URLs / inline style and script\n * blocks, and the frame then needs no `dsh-app:` request at all.\n *\n * This module is pure on purpose (no fetch, no React): the caller supplies\n * `fetchResource`, so the resolution and rewriting rules are unit-testable and\n * the component owns transport, aborting and object-URL lifetime.\n *\n * Only same-origin resources are inlined. External http(s) URLs, `data:`,\n * `blob:` and `file:` are left exactly as authored; a failed local fetch also\n * leaves the authored reference (the page still renders, the one resource\n * may not). The returned document is always UTF-8 and keeps the route's\n * `object-src 'none'` defense as a meta CSP; the iframe sandbox attribute\n * remains the primary boundary (no `allow-same-origin` is ever added).\n */\n\n/** One fetched local resource, already in memory. */\nexport interface InlineResource {\n  readonly bytes: Uint8Array\n  readonly mediaType: string\n}\n\n/**\n * Fetch one same-origin resource. The caller decides how (the component uses\n * `fetch` with same-origin credentials and an abort signal); returning\n * undefined means \"leave the authored reference alone\".\n */\nexport type FetchInlineResource = (url: string) => Promise<InlineResource | undefined>\n\n/** Same protocol, credentials, host and port — `URL.origin` is `null` for\n *  custom schemes such as `dsh-app:`, so it cannot be used here. */\nfunction sameOrigin(a: URL, b: URL): boolean {\n  return a.protocol === b.protocol\n    && a.username === b.username\n    && a.password === b.password\n    && a.hostname === b.hostname\n    && a.port === b.port\n}\n\n/**\n * Resolve a same-origin resource reference. Returns undefined for empty /\n * fragment destinations, external origins, and every non-http(s)/non-custom\n * protocol this preview cannot inline.\n */\nexport function inlineableUrl(reference: string, baseUrl: string): URL | undefined {\n  const trimmed = reference.trim()\n  if (trimmed === '' || trimmed.startsWith('#')) return undefined\n  let url: URL\n  let base: URL\n  try {\n    base = new URL(baseUrl)\n    url = new URL(trimmed, base)\n  } catch {\n    return undefined\n  }\n  if (url.protocol === 'data:' || url.protocol === 'blob:' || url.protocol === 'file:' || url.protocol === 'javascript:') {\n    return undefined\n  }\n  if (!sameOrigin(url, base)) return undefined\n  return url\n}\n\n/** Base64 in bounded chunks so a multi-megabyte asset cannot overflow the\n *  argument stack through `String.fromCharCode(