Failures leave the authored reference untouched.\n * @param css - The stylesheet source.\n * @param cssUrl - The stylesheet's own URL (base for relative references).\n * @param cache - Per-document resource cache.\n * @param seen - Stylesheet URLs already on the current import chain.\n * @returns The rewritten CSS.\n */\nasync function inlineCss(css: string, cssUrl: string, cache: ResourceCache, seen: ReadonlySet<string> = new Set()): Promise<string> {\n  if (seen.has(cssUrl)) return ''\n  const chain = new Set(seen)\n  chain.add(cssUrl)\n\n  const importReplacements = new Map<string, string>()\n  for (const match of [...css.matchAll(CSS_IMPORT_RE)]) {\n    const reference = cssUrlOf(match)\n    if (reference === undefined) continue\n    const url = inlineableUrl(reference, cssUrl)\n    if (url === undefined) continue\n    const resource = await cache.get(url.href)\n    if (resource === undefined) continue\n    const nested = await inlineCss(decodeText(resource.bytes), url.href, cache, chain)\n    const media = (match[4] ?? '').trim()\n    importReplacements.set(match[0], media === '' ? nested : `@media ${media} {\\n${nested}\\n}`)\n  }\n  const withImports = css.replace(CSS_IMPORT_RE, (match) => importReplacements.get(match) ?? match)\n\n  const urlReplacements = new Map<string, string>()\n  const references = new Set<string>()\n  for (const match of withImports.matchAll(CSS_URL_RE)) {\n    const reference = cssUrlOf(match)\n    if (reference === undefined || reference.startsWith('#')) continue\n    references.add(reference)\n  }\n  await Promise.all([...references].map(async (reference) => {\n    const url = inlineableUrl(reference, cssUrl)\n    if (url === undefined) return\n    const resource = await cache.get(url.href)\n    if (resource === undefined) return\n    urlReplacements.set(reference, `url(\"${dataUrlOf(resource)}\")`)\n  }))\n  return withImports.replace(CSS_URL_RE, (match, _quote: string | undefined, quoted: string | undefined, bare: string | undefined) => {\n    const reference = quoted ?? bare\n    if (reference === undefined) return match\n    return urlReplacements.get(reference) ?? match\n  })\n}\n\n/** Inline one attribute that holds a single resource URL. */\nasync function inlineAttribute(element: Element, attribute: string, baseUrl: string, cache: ResourceCache): Promise<void> {\n  const reference = element.getAttribute(attribute)\n  if (reference === null) return\n  const url = inlineableUrl(reference, baseUrl)\n  if (url === undefined) return\n  const resource = await cache.get(url.href)\n  if (resource === undefined) return\n  element.setAttribute(attribute, dataUrlOf(resource))\n}\n\n/** Rewrite a `srcset` attribute. A value already carrying an inline/data URL\n *  is left alone: splitting it on commas would mangle the payload. */\nasync function inlineSrcset(value: string, baseUrl: string, cache: ResourceCache): Promise<string> {\n  if (/\\b(?:data|blob):/i.test(value)) return value\n  const candidates = value.split(',').map(candidate => candidate.trim()).filter(candidate => candidate !== '')\n  const rewritten: string[] = []\n  for (const candidate of candidates) {\n    const match = /^(\\S+)(\\s+.*)?$/.exec(candidate)\n    if (match === null) {\n      rewritten.push(candidate)\n      continue\n    }\n    const url = inlineableUrl(match[1] ?? '', baseUrl)\n    if (url === undefined) {\n      rewritten.push(candidate)\n      continue\n    }\n    const resource = await cache.get(url.href)\n    rewritten.push(resource === undefined ? candidate : `${dataUrlOf(resource)}${match[2] ?? ''}`)\n  }\n  return rewritten.join(', ')\n}\n\n/** Inline one stylesheet `<link>` as a `<style>` element. */\nasync function inlineStylesheet(link: Element, baseUrl: string, cache: ResourceCache): Promise<void> {\n  const reference = link.getAttribute('href')\n  if (reference === null) return\n  const url = inlineableUrl(reference, baseUrl)\n  if (url === undefined) return\n  const resource = await cache.get(url.href)\n  if (resource === undefined) return\n  const style = link.ownerDocument.createElement('style')\n  const media = link.getAttribute('media')\n  if (media !== null && media !== '') style.setAttribute('media', media)\n  style.textContent = await inlineCss(decodeText(resource.bytes), url.href, cache)\n  link.replaceWith(style)\n}\n\n/** Inline one external script as its own text. */\nasync function inlineScript(script: Element, baseUrl: string, cache: ResourceCache): Promise<void> {\n  const reference = script.getAttribute('src')\n  if (reference === null) return\n  const url = inlineableUrl(reference, baseUrl)\n  if (url === undefined) return\n  const resource = await cache.get(url.href)\n  if (resource === undefined) return\n  script.removeAttribute('src')\n  script.removeAttribute('integrity')\n  script.removeAttribute('crossorigin')\n  script.removeAttribute('async')\n  script.removeAttribute('defer')\n  script.textContent = decodeText(resource.bytes).replace(/<\\/script/gi, '<\\\\/script')\n}\n\n/** Whether a `link` element is a stylesheet. */\nfunction isStylesheet(link: Element): boolean {\n  const rel = (link.getAttribute('rel') ?? '').toLowerCase().split(/\\s+/)\n  return rel.includes('stylesheet') && link.hasAttribute('href')\n}\n\n/**\n * Build the self-contained document for one HTML file.\n * @param html - The authored HTML text.\n * @param documentUrl - The file's absolute route URL (the base for relatives).\n * @param fetchResource - Same-origin resource fetcher (injected; may fail).\n * @returns The rewritten, UTF-8, self-contained HTML.\n */\nexport async function inlineHtmlDocument(\n  html: string,\n  documentUrl: string,\n  fetchResource: FetchInlineResource,\n): Promise<string> {\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  const baseElement = doc.querySelector('base[href]')\n  let baseUrl = documentUrl\n  const authoredBase = baseElement?.getAttribute('href')\n  if (authoredBase !== undefined && authoredBase !== null && authoredBase !== '') {\n    try {\n      baseUrl = new URL(authoredBase, documentUrl).href\n    } catch {\n      // A malformed base falls back to the document URL.\n    }\n  }\n  baseElement?.removeAttribute('href')\n\n  const cache = new ResourceCache(fetchResource)\n  const tasks: Promise<void>[] = []\n\n  for (const link of [...doc.querySelectorAll('link')]) {\n    if (isStylesheet(link)) tasks.push(inlineStylesheet(link, baseUrl, cache))\n  }\n  for (const script of [...doc.querySelectorAll('script[src]')]) {\n    tasks.push(inlineScript(script, baseUrl, cache))\n  }\n  for (const image of [...doc.querySelectorAll('img[src]')]) {\n    tasks.push(inlineAttribute(image, 'src', baseUrl, cache))\n  }\n  for (const image of [...doc.querySelectorAll('img[srcset]')]) {\n    tasks.push(inlineSrcset(image.getAttribute('srcset') ?? '', baseUrl, cache).then((value) => image.setAttribute('srcset', value)))\n  }\n  for (const source of [...doc.querySelectorAll('source[src]')]) {\n    tasks.push(inlineAttribute(source, 'src', baseUrl, cache))\n  }\n  for (const source of [...doc.querySelectorAll('source[srcset]')]) {\n    tasks.push(inlineSrcset(source.getAttribute('srcset') ?? '', baseUrl, cache).then((value) => source.setAttribute('srcset', value)))\n  }\n  for (const video of [...doc.querySelectorAll('video[src]')]) {\n    tasks.push(inlineAttribute(video, 'src', baseUrl, cache))\n  }\n  for (const video of [...doc.querySelectorAll('video[poster]')]) {\n    tasks.push(inlineAttribute(video, 'poster', baseUrl, cache))\n  }\n  for (const audio of [...doc.querySelectorAll('audio[src]')]) {\n    tasks.push(inlineAttribute(audio, 'src', baseUrl, cache))\n  }\n  for (const track of [...doc.querySelectorAll('track[src]')]) {\n    tasks.push(inlineAttribute(track, 'src', baseUrl, cache))\n  }\n  for (const input of [...doc.querySelectorAll('input[type=\"image\"][src]')]) {\n    tasks.push(inlineAttribute(input, 'src', baseUrl, cache))\n  }\n  for (const image of [...doc.querySelectorAll('image')]) {\n    for (const attribute of ['href', 'xlink:href']) {\n      if (image.hasAttribute(attribute)) tasks.push(inlineAttribute(image, attribute, baseUrl, cache))\n    }\n  }\n\n  const styleElements = [...doc.querySelectorAll('style')]\n  const styledElements = [...doc.querySelectorAll('[style]')]\n  for (const style of styleElements) {\n    const source = style.textContent ?? ''\n    tasks.push(inlineCss(source, baseUrl, cache).then((css) => { style.textContent = css }))\n  }\n  for (const element of styledElements) {\n    const source = element.getAttribute('style') ?? ''\n    tasks.push(inlineCss(source, baseUrl, cache).then((css) => element.setAttribute('style', css)))\n  }\n\n  await Promise.all(tasks)\n\n  // The route declared UTF-8 for the document; the blob has no HTTP header to\n  // carry that, so the meta must. A conflicting authored charset is removed.\n  for (const meta of [...doc.querySelectorAll('meta[charset], meta[http-equiv]')]) {\n    if (meta.hasAttribute('charset')) {\n      meta.remove()\n      continue\n    }\n    if ((meta.getAttribute('http-equiv') ?? '').toLowerCase() === 'content-type') {\n      meta.setAttribute('content', 'text/html; charset=utf-8')\n    }\n  }\n  const head = doc.head ?? doc.documentElement\n  const charset = doc.createElement('meta')\n  charset.setAttribute('charset', 'utf-8')\n  head.prepend(charset)\n  const csp = doc.createElement('meta')\n  csp.setAttribute('http-equiv', 'Content-Security-Policy')\n  csp.setAttribute('content', \"object-src 'none'\")\n  head.prepend(csp)\n\n  return `<!DOCTYPE html>\\n${doc.documentElement.outerHTML}`\n}\n","/**\n * The HTML preview iframe shared by the editor's html viewer and the changes\n * tab. In a normal web deployment it is the historical route-src frame. In the\n * desktop shell with the sandbox ON it must be self-contained: the shell\n * rejects every `dsh-app:` request from an opaque-origin subframe (#1143),\n * so the trusted top frame fetches the document and its local resources,\n * rewrites them through `html-preview-inline.ts`, and frames the result as a\n * sandboxed `blob:` document. The sandbox attribute never gains\n * `allow-same-origin`.\n */\nimport { useEffect, useState, type ReactNode } from 'react'\nimport { hostHttpBase, isDesktopShell } from './desktop-env.ts'\nimport { HTML_IFRAME_SANDBOX } from './html-preview.ts'\nimport { inlineHtmlDocument } from './html-preview-inline.ts'\n\n/** One preview frame; `src` is the route URL of the saved HTML file. */\nexport interface HtmlPreviewFrameProps {\n  /** Absolute (or page-relative) `/sidebar/html/...` URL. */\n  src: string\n  title: string\n  className?: string\n  /** Whether the sandbox attribute is applied. Off is the explicit unsafe\n   *  escape hatch owned by the editor settings; the changes surface always\n   *  sandboxes. */\n  sandboxed: boolean\n  /** The page base; injected for tests. Defaults to `hostHttpBase()`. */\n  baseUrl?: string\n}\n\n/** Fetch one same-origin resource for the inliner. */\nasync function fetchInlineResource(url: string, signal: AbortSignal): Promise<{ bytes: Uint8Array; mediaType: string } | undefined> {\n  const response = await fetch(url, { credentials: 'same-origin', cache: 'no-cache', signal })\n  if (!response.ok) return undefined\n  const mediaType = (response.headers.get('content-type') ?? '').split(';')[0]?.trim() || 'application/octet-stream'\n  return { bytes: new Uint8Array(await response.arrayBuffer()), mediaType }\n}\n\n/**\n * Render the HTML preview. Browser / unsandboxed desktop: route-src iframe,\n * exactly as before. Sandboxed desktop: fetch the saved document and its local\n * assets from the top frame, then frame an inlined blob. A fetch failure falls\n * back to route-src rather than inventing a new error surface.\n */\nexport function HtmlPreviewFrame(props: HtmlPreviewFrameProps): ReactNode {\n  const { src, title, className, sandboxed } = props\n  const baseUrl = props.baseUrl ?? hostHttpBase()\n  const inline = sandboxed && isDesktopShell(baseUrl)\n  const [blobUrl, setBlobUrl] = useState<string | undefined>(undefined)\n  const [failed, setFailed] = useState(false)\n\n  useEffect(() => {\n    if (!inline || src === '') {\n      setBlobUrl(undefined)\n      setFailed(false)\n      return\n    }\n    const controller = new AbortController()\n    let cancelled = false\n    let objectUrl: string | undefined\n    setBlobUrl(undefined)\n    setFailed(false)\n    void (async () => {\n      try {\n        const documentUrl = new URL(src, baseUrl).href\n        const response = await fetch(documentUrl, {\n          credentials: 'same-origin',\n          cache: 'no-cache',\n          signal: controller.signal,\n        })\n        if (!response.ok) throw new Error(`html preview fetch failed: ${response.status}`)\n        const source = await response.text()\n        const inlined = await inlineHtmlDocument(source, documentUrl, (url) => fetchInlineResource(url, controller.signal))\n        if (cancelled || controller.signal.aborted) return\n        objectUrl = URL.createObjectURL(new Blob([inlined], { type: 'text/html;charset=utf-8' }))\n        setBlobUrl(objectUrl)\n      } catch {\n        if (cancelled || controller.signal.aborted) return\n        setFailed(true)\n      }\n    })()\n    return () => {\n      cancelled = true\n      controller.abort()\n      if (objectUrl !== undefined) URL.revokeObjectURL(objectUrl)\n    }\n  }, [inline, src, baseUrl])\n\n  const frameSrc = inline ? (failed ? src : blobUrl) : src\n  return (\n    <iframe\n      className={className}\n      src={frameSrc}\n      sandbox={sandboxed ? HTML_IFRAME_SANDBOX : undefined}\n      referrerPolicy=\"no-referrer\"\n      allow=\"\"\n      title={title}\n    />\n  )\n}\n","import type {} from '@huanlin/dsh-plugin-better-locale/client'\n/**\n * The code/markdown file viewer: a CodeMirror 6 editor with line wrapping,\n * syntax highlighting (extension-keyed language), a dirty dot and Ctrl/Cmd+S\n * save, and a preview/edit toggle for markdown files. Registered as the\n * `code` (catch-all) and `markdown` built-in viewers; the editor tab host\n * fetches the content through the fsRead strategy and passes it in props,\n * so this component never fetches or dispatches — it only edits.\n *\n * The toolbar (mode toggle / dirty dot / save / status) renders as its own\n * row below the host's title bar, VSCode-style — unless the host passes\n * `toolbar: 'host'` (the merged editor-explorer mode), in which case this\n * component skips the row and reports state + registers commands through\n * the FileViewerProps toolbar callbacks so the host's path-input header\n * renders the controls instead.\n */\nimport { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState, useSyncExternalStore } from 'react'\nimport { createPortal } from 'react-dom'\nimport clsx from 'clsx'\nimport { EditorState } from '@codemirror/state'\nimport { EditorView as CodeMirrorView, keymap, lineNumbers } from '@codemirror/view'\nimport { defaultKeymap, history, historyKeymap } from '@codemirror/commands'\nimport { openSearchPanel } from '@codemirror/search'\nimport { IconCheckOutlineRegular, IconSearchOutlineRegular, MarkdownDelegateProvider, MarkdownText } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { markdownTextProps } from './markdown-labels.tsx'\nimport {\n  applyGitLineKinds,\n  CmGitGutterCompartment,\n  useEditorGitGutter,\n  type GitGutterHost,\n} from './editor-git-gutter.ts'\nimport { api, htmlUrl, SidebarApiError } from './api.ts'\nimport { hostHttpBase } from './desktop-env.ts'\nimport { markdownPreviewSource } from './markdown-frontmatter.ts'\nimport { createMarkdownPathImages } from './markdown-images.ts'\nimport { rewriteLocalMarkdownLinks } from './markdown-navigation.ts'\nimport { languageForPath } from './lang.ts'\nimport { cmSurfaceTheme, CmThemeCompartment } from './cm-themes.ts'\nimport { cmSearchExtensions, CmSearchPhrases } from './cm-search.ts'\nimport { clearDraftBackup, draftBackupBaseMtime, flushDraftBackups, readDraftBackup, registerDraftSource, sameDocument, scheduleDraftBackup } from './editor-draft-backup.ts'\nimport { flashQuoteLines, quoteFlashField, quoteFlashHighlight } from './quote-flash.ts'\nimport { isDarkScheme, subscribeColorScheme } from './theme.ts'\nimport { SandboxStatusBar } from './SandboxStatusBar.tsx'\nimport { insertReferenceOrText, type PendingReference } from './conversation-draft.ts'\nimport { useSelectionPopup } from './selection-popup.ts'\nimport { buildSelectionInsert, linesOfSelection, type SelectionLines } from './selection-payload.ts'\nimport { insertQuoteChip, type QuoteSelection } from './selection-quote.ts'\nimport { analyzeMarkdownHtml } from './markdown-html.ts'\nimport { LazyMermaidMarkdown, MarkdownDocument, type MarkdownHtmlMedia } from './MarkdownHtml.tsx'\nimport { LargeFileView } from './LargeFileView.tsx'\nimport { useMarkdownSurface } from './use-markdown-surface.ts'\nimport { MdToc } from './md-toc.tsx'\nimport { splitMermaidBlocks } from './mermaid-blocks.ts'\nimport { localeSignature, t } from './locales.ts'\nimport { HtmlPreviewFrame } from './HtmlPreviewFrame.tsx'\nimport type { EditorToolbarState, FileViewerProps } from './service.ts'\nimport css from './sidebar.module.css'\n\n/** Previewable files (rendered output vs source editing). */\ntype ViewMode = 'preview' | 'edit'\n\n/**\n * The popup's payload: the built-in reference chip #1052 already minted PLUS\n * the structured selection the quote chip mints from (the path and the line\n * span are facts only the viewer knows — the pending chip keeps them folded\n * into one label string).\n */\ninterface SelectionInsert extends PendingReference {\n  selection: QuoteSelection\n}\n\n/** Build the popup payload for one selection. */\nfunction selectionInsertOf(\n  path: string,\n  cwd: string | undefined,\n  lines: SelectionLines | undefined,\n  text: string,\n): SelectionInsert {\n  return {\n    ...buildSelectionInsert(path, cwd, lines, text),\n    selection: {\n      path,\n      ...(cwd === undefined ? {} : { cwd }),\n      ...(lines === undefined ? {} : { lines }),\n      text,\n    },\n  }\n}\n\n/** Per-file preview scroll memory. Module-level so it survives viewer\n *  remounts: the save-then-switch-to-preview reload (EditorHost #215 case B)\n *  rebuilds the whole TextEditor instance, and without this the preview\n *  would remount at the top. Keyed by session + path; a fresh entry reads 0\n *  (new file opens at the top), re-opens/toggles restore the last position. */\nconst previewScrollMemory = new Map<string, number>()\nconst previewScrollKey = (scope: { sessionId: string }, path: string): string => `${scope.sessionId}::${path}`\n\n/**\n * How many documents' preview positions are remembered. Since v0.25 every\n * visited native tab body stays mounted (the host has no LRU), so this map\n * would otherwise grow with every file the session ever previewed; past the\n * cap the least recently written document is forgotten and its preview opens\n * at the top again — a cosmetic loss, never a wrong document.\n */\nexport const PREVIEW_SCROLL_CAP = 64\n\n/**\n * Remember one document's preview offset. The write moves the key to the back\n * of the eviction order, so the document forgotten past the cap is the one\n * that has gone longest without a scroll.\n *\n * @param scope - the viewer's scope (its session id is part of the key).\n * @param path - the document's absolute path.\n * @param top - the preview container's `scrollTop`.\n */\nexport function rememberPreviewScroll(scope: { sessionId: string }, path: string, top: number): void {\n  const key = previewScrollKey(scope, path)\n  previewScrollMemory.delete(key)\n  previewScrollMemory.set(key, top)\n  for (const stale of previewScrollMemory.keys()) {\n    if (previewScrollMemory.size <= PREVIEW_SCROLL_CAP) break\n    previewScrollMemory.delete(stale)\n  }\n}\n\n/** The remembered offset of one document (0 = none: open it at the top). */\nexport function previewScrollOf(scope: { sessionId: string }, path: string): number {\n  return previewScrollMemory.get(previewScrollKey(scope, path)) ?? 0\n}\n/** The edit-mode twin of {@link previewScrollMemory}: the CodeMirror scroller's\n *  own position, which a moved (detached + re-attached) tab body loses. Bounded\n *  the same way — a mounted-but-hidden tab body keeps its own scroller, so an\n *  unbounded map would grow with every document the session ever edited. */\nconst editScrollMemory = new Map<string, number>()\n\n/** Remember one document's edit offset. See {@link rememberPreviewScroll} for\n *  why the write moves the key to the back of the eviction order. */\nfunction rememberEditScroll(scope: { sessionId: string }, path: string, top: number): void {\n  const key = previewScrollKey(scope, path)\n  editScrollMemory.delete(key)\n  editScrollMemory.set(key, top)\n  for (const stale of editScrollMemory.keys()) {\n    if (editScrollMemory.size <= PREVIEW_SCROLL_CAP) break\n    editScrollMemory.delete(stale)\n  }\n}\n\n/** The remembered edit offset of one document (0 = none: open it at the top). */\nfunction editScrollOf(scope: { sessionId: string }, path: string): number {\n  return editScrollMemory.get(previewScrollKey(scope, path)) ?? 0\n}\n\nexport function TextEditor(props: FileViewerProps) {\n  const { ctx, scope, path, viewerId, content, size, largeFile, line } = props\n  const [mode, setMode] = useState<ViewMode>('preview')\n  /** The editor's current text (null while clean); preview renders this. */\n  const [draft, setDraft] = useState<string | null>(null)\n  const [dirty, setDirty] = useState(false)\n  const [saveState, setSaveState] = useState<'idle' | 'saving' | 'saved' | 'failed'>('idle')\n  /** The save was refused because the file changed on disk (fs-conflict). */\n  const [conflict, setConflict] = useState(false)\n  const hostRef = useRef<HTMLDivElement>(null)\n  const viewRef = useRef<CodeMirrorView | null>(null)\n  /** The landing flash's self-clear timer (one per editor; see the landing\n   *  effect and the view's unmount cleanup). */\n  const flashTimerRef = useRef<ReturnType<typeof setTimeout> | undefined>(undefined)\n  const savingRef = useRef(false)\n  /** The mtime the draft is based on (`null` = the file did not exist yet).\n   *  Seeded from the load, re-based whenever a fresh load reports a new mtime\n   *  (a reload may return the SAME text — see the effect below), refreshed by\n   *  every successful save, reset by the file-switch effect, and moved back to\n   *  a restored draft's own base (see restoreDraftBackup). */\n  const mtimeRef = useRef<number | null>(props.mtimeMs ?? null)\n  /** The bytes the save baseline belongs to: the last loaded document,\n   *  advanced by every successful save (an edit-mode save never reloads, so\n   *  `props.content` alone can lag behind disk). The conflict banner's reload\n   *  compares the disk read against THIS — never the live draft, which is\n   *  expected to differ because it holds the unsaved edit. `null` = not known:\n   *  a restored draft based on an older revision, whose bytes are not kept. */\n  const savedTextRef = useRef<string | null>(content ?? null)\n  /** The theme compartment of the current view (reconfigured on scheme flip). */\n  const themeCompRef = useRef<CmThemeCompartment | null>(null)\n  /** The search-phrases compartment of the current view (reconfigured on a\n   *  language switch — the panel copy is baked into the EditorState). */\n  const searchPhrasesRef = useRef<CmSearchPhrases | null>(null)\n  /** The uncommitted-change gutter compartment (issue #212; reconfigured on a\n   *  setting flip instead of rebuilding the view). */\n  const gitCompRef = useRef<CmGitGutterCompartment | null>(null)\n  /** The effective UI language (DSH locale id + better-locale override id).\n   *  Read during render and subscribed below: the tab-cell memo only\n   *  compares the DSH locale revision, so a better-locale override switch\n   *  would otherwise never reach this component. */\n  const [localeSig, setLocaleSig] = useState(() => localeSignature())\n  /** The app's resolved color scheme; the editor re-themes in place on flips. */\n  const [dark, setDark] = useState(() => isDarkScheme())\n  /** The markdown preview container (selection-containment + line lookup). */\n  const mdRef = useRef<HTMLDivElement | null>(null)\n  /** Heading slugs, anchor jumps and `.md` link claiming for the preview (the\n   *  delegate provider wrapped around the markdown is its claim boundary — see\n   *  use-markdown-surface). */\n  const { surfaceRef: markdownSurfaceRef, openFile: openSurfaceFile } = useMarkdownSurface({\n    ctx,\n    sessionId: scope.sessionId,\n    cwd: scope.cwd,\n    path,\n  })\n  /** One ref callback for the preview container: the selection/scroll code\n   *  above keeps its object ref, the surface installer gets the same element.\n   *  A stable identity matters — a fresh callback on every render would make\n   *  React re-attach (and re-scan) on every render. */\n  const previewRef = useCallback((element: HTMLDivElement | null) => {\n    mdRef.current = element\n    markdownSurfaceRef(element)\n  }, [markdownSurfaceRef])\n  const markdown = viewerId === 'markdown'\n  const html = viewerId === 'html'\n  /** Newline-delimited JSON: it has its own preview (one card per record) on\n   *  top of the shared editable CodeMirror surface. */\n  const jsonl = viewerId === 'jsonl'\n  /** The file is above the editable threshold: the viewer renders the\n   *  read-only paged preview and no editor at all. */\n  const readOnly = largeFile !== undefined\n  /** The uncommitted-change gutter (issue #212): the `code` viewer only,\n   *  gated by ONE boolean setting (on by default). Nothing else — no\n   *  end-of-line author widget, no badges, no animation. Read reactively\n   *  (same seam as the host's editorExplorer read) so flipping the switch\n   *  reconfigures the live view in place instead of waiting for a reopen. */\n  const gitGutterPref = useSyncExternalStore(\n    useCallback((callback: () => void) => props.store.subscribe(callback), [props.store]),\n    useCallback(() => props.store.getSnapshot().prefs.editorGitGutter !== false, [props.store]),\n    // Server snapshot: this component is rendered to a string by the markdown\n    // preview specs. The value only feeds effects (the extensions are built\n    // client-side), so the store answers on both sides alike.\n    useCallback(() => props.store.getSnapshot().prefs.editorGitGutter !== false, [props.store]),\n  )\n  const gitGutterEnabled = (viewerId === 'code' || viewerId === 'jsonl') && gitGutterPref\n  /** Bumped by every save: the uncommitted diff moved while the file's git\n   *  status entry (which only tracks its XY code) did not. */\n  const [gitRevision, setGitRevision] = useState(0)\n  /** The view-side identity of the gutter's git source: rebuilt only when a\n   *  field it reads actually moves. */\n  const gitHost = useMemo<GitGutterHost>(\n    () => ({ scope: { sessionId: scope.sessionId, cwd: scope.cwd, repoRoot: scope.repoRoot }, path }),\n    [scope.sessionId, scope.cwd, scope.repoRoot, path],\n  )\n  const gitKinds = useEditorGitGutter({\n    enabled: gitGutterEnabled,\n    // A parked native tab stays MOUNTED (`keepMounted`), so the tab's own\n    // visibility is what decides whether the gutter does git work at all: a\n    // hidden editor holds no status subscription and no timer.\n    visible: props.visible !== false,\n    scope,\n    path,\n    content,\n    revision: gitRevision,\n  })\n  /** Preview scroll position across the preview<->edit toggle. The preview\n   *  container re-mounts on every mode switch and its scrollTop lives on that\n   *  element, so capture it on scroll and restore after each remount. Seeded\n   *  from the module-level per-file memory so a full viewer rebuild\n   *  (save-then-switch-to-preview reload) also keeps the position. */\n  const previewScrollRef = useRef(previewScrollOf(scope, path))\n  /** The edit surface's remembered scroll position (see {@link editScrollMemory}). */\n  const editScrollRef = useRef(editScrollOf(scope, path))\n  /** True while {@link restoreEditScroll} is writing, so the scroll event it\n   *  causes is not mistaken for the user's own position. */\n  const restoringEditRef = useRef(false)\n  /** True while a programmatic restore is in flight; raw scroll events caused\n   *  by the restore (or by the browser clamping a collapsed reload container\n   *  to 0) must not overwrite the remembered position. */\n  const restoringRef = useRef(false)\n  /** Preview-side handoff data for the preview -> edit switch: the text at the\n   *  top of the preview viewport (best-effort) plus the scroll ratio. Captured\n   *  throttled on preview scroll; consumed when entering edit mode so the\n   *  editor opens where the reader was instead of at the file top. */\n  const previewSyncRef = useRef<{ text: string | null; ratio: number }>({ text: null, ratio: 0 })\n  const anchorThrottleRef = useRef(false)\n\n  /**\n   * The floating \"add to conversation\" popup (viewport-anchored; null =\n   * hidden). The hook owns show/hide/commit plus the global dismissal\n   * listeners (outside mousedown, Escape, hidden tab/window, surface\n   * leaving the viewport) — see selection-popup.ts.\n   */\n  const selectionPopup = useSelectionPopup<SelectionInsert>({\n    onCommit: (insert) => {\n      // The quote chip first (a clickable, source-owned chip), then #1052's\n      // plain built-in reference chip, then bare text — every step down is one\n      // the host actually supports, never a silent no-op.\n      if (insertQuoteChip(ctx, scope.sessionId, insert.selection)) return\n      insertReferenceOrText(ctx, scope.sessionId, insert)\n    },\n    // The surface that must stay on screen: the markdown preview container\n    // in preview mode, the CodeMirror host otherwise.\n    getSurface: () => (markdown && mode === 'preview' ? mdRef.current : hostRef.current),\n  })\n\n  useEffect(() => subscribeColorScheme(() => { setDark(isDarkScheme()) }), [])\n\n  // Keep `localeSig` fresh from BOTH language sources: the DSH locale service\n  // and (when @huanlin/dsh-plugin-better-locale is installed) the override\n  // store. The sidebar root re-renders the tree on a DSH locale switch, but\n  // an override switch is not part of the tab-cell memo key, so this\n  // component subscribes directly instead of relying on a parent render.\n  useEffect(() => {\n    const sync = (): void => { setLocaleSig(localeSignature()) }\n    sync()\n    const locale = ctx.get('locale')\n    const betterLocale = ctx.get('betterLocale')\n    const offLocale = locale?.subscribe(sync)\n    const offOverride = betterLocale?.subscribe(sync)\n    return () => {\n      offLocale?.()\n      offOverride?.()\n    }\n  }, [ctx])\n\n  // A new file (tab switch) starts clean: fresh preview mode, no draft.\n  useEffect(() => {\n    setMode('preview')\n    setDraft(null)\n    setDirty(false)\n    setSaveState('idle')\n    setConflict(false)\n    // The freshly loaded bytes are the new save baseline.\n    mtimeRef.current = props.mtimeMs ?? null\n    savedTextRef.current = content ?? null\n    selectionPopup.hide()\n    // hide() reads a live ref; the reset must fire only on a content (file)\n    // swap, and the hook object's identity churns on every render.\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [content])\n\n  // The save baseline follows every fresh load, not only a content swap: a\n  // reload can return the SAME bytes with a new mtime (`touch`, `git checkout`,\n  // a formatter rewriting identical text). `content` then never changes and\n  // the file-switch effect above never runs, so the stale baseline would keep\n  // being sent and the host would answer `fs-conflict` forever (#1059).\n  // Baseline only: the mode/draft/dirty reset above stays tied to a new\n  // document, not to a re-read of the same one.\n  useEffect(() => {\n    mtimeRef.current = props.mtimeMs ?? null\n  }, [props.mtimeMs])\n\n  // A different file switches the remembered preview scroll position to that\n  // file's own entry (first open: none, so the preview starts at the top).\n  useEffect(() => {\n    previewScrollRef.current = previewScrollOf(scope, path)\n    editScrollRef.current = editScrollOf(scope, path)\n  }, [scope, path])\n\n  /**\n   * Offer this file's durable backup back to the reader (see\n   * editor-draft-backup.ts): the native tab strip's × and the Desktop shell's\n   * quit can drop the tab without a prompt, so the draft is kept in storage.\n   * Declining drops it; accepting makes it the live draft, which the normal\n   * dirty path then owns.\n   *\n   * The draft was typed against the file as it was when the backup was written,\n   * not against the bytes just loaded. Accepting therefore also restores that\n   * base mtime, so a file that moved while the tab was gone is refused\n   * (fs-conflict) instead of overwritten. The baseline text goes with it: the\n   * banner's reload would otherwise find the disk equal to this load and resolve\n   * the conflict in place, as if only the mtime had moved. An entry without a\n   * base keeps the mtime of this load.\n   */\n  const restoreDraftBackup = (): string | null => {\n    if (content === undefined) return null\n    const backup = readDraftBackup(scope.sessionId, path, content)\n    if (backup === null) return null\n    const confirmed = typeof window.confirm === 'function' ? window.confirm(t('draftRestoreConfirm')) : false\n    if (!confirmed) {\n      clearDraftBackup(scope.sessionId, path)\n      return null\n    }\n    const base = draftBackupBaseMtime(scope.sessionId, path)\n    if (base !== undefined && base !== mtimeRef.current) {\n      mtimeRef.current = base\n      savedTextRef.current = null\n    }\n    return backup\n  }\n\n  // Create the CodeMirror editor once the content is loaded. The view owns\n  // the document; React only tracks dirty state through the update listener\n  // (the draft — the preview's text — is snapshotted from the live view on\n  // entering preview, not re-stringified per keystroke). For markdown the\n  // view stays mounted while previewing (hidden), so unsaved edits survive\n  // the preview/edit toggle. The theme + syntax colors live in a compartment\n  // so a scheme flip reconfigures only that part — the document, undo\n  // history and scroll position survive.\n  useEffect(() => {\n    if (content === undefined) return\n    const host = hostRef.current\n    if (host === null) return\n    const language = languageForPath(path)\n    const themeComp = new CmThemeCompartment()\n    themeCompRef.current = themeComp\n    const searchPhrases = new CmSearchPhrases()\n    searchPhrasesRef.current = searchPhrases\n    const gitComp = new CmGitGutterCompartment()\n    gitCompRef.current = gitComp\n    const restored = restoreDraftBackup()\n    const state = EditorState.create({\n      doc: restored ?? content,\n      extensions: [\n        CodeMirrorView.lineWrapping,\n        // The change bar sits BEFORE the line numbers (VS Code's own order):\n        // a thin colored bar at the far left, the number tinted beside it.\n        // The compartment carries all of it (hover blame included), so the\n        // setting can flip it in place below.\n        gitComp.of(gitGutterEnabled ? gitHost : null),\n        lineNumbers(),\n        history(),\n        EditorState.tabSize.of(2),\n        CodeMirrorView.contentAttributes.of({ spellcheck: 'false' }),\n        cmSurfaceTheme,\n        // The landing flash's range field and its per-line decorations\n        // (inert until a navigation hands this editor a quoted span).\n        quoteFlashField,\n        quoteFlashHighlight,\n        themeComp.of(dark),\n        // Find-in-file (Cmd/Ctrl+F): the top-pinned search panel plus the\n        // upstream search keymap, registered BEFORE the editor's own keymap\n        // below so the search bindings (Escape in particular — the editor\n        // keymap's `simplifySelection` shares that key) win while the panel\n        // is open, and the save key stays in the editor keymap unchanged.\n        ...cmSearchExtensions(),\n        searchPhrases.of(),\n        ...(language !== null ? [language] : []),\n        CodeMirrorView.updateListener.of((update) => {\n          if (update.docChanged) {\n            setDirty(true)\n            scheduleDraftBackup(scope.sessionId, path)\n          }\n        }),\n        keymap.of([\n          {\n            key: 'Mod-s',\n            preventDefault: true,\n            run: () => { save(); return true },\n          },\n          ...defaultKeymap,\n          ...historyKeymap,\n        ]),\n        // Selection popup (the code and markdown editors): a non-empty\n        // selection anchors the floating \"add to conversation\" button above\n        // its head. Scrolling (geometry/viewport change) or losing focus\n        // hides it; typing collapses the selection and hides it too.\n        ...(viewerId === 'code' || viewerId === 'markdown' || viewerId === 'jsonl' ? [\n          CodeMirrorView.updateListener.of((update) => {\n            if (update.geometryChanged || update.viewportChanged) {\n              selectionPopup.hide()\n              return\n            }\n            if (!update.view.hasFocus) {\n              selectionPopup.hide()\n              return\n            }\n            if (!(update.selectionSet || update.docChanged || update.focusChanged)) return\n            const sel = update.state.selection.main\n            if (sel.empty) {\n              selectionPopup.hide()\n              return\n            }\n            const text = update.state.sliceDoc(sel.from, sel.to)\n            if (text.trim() === '') {\n              selectionPopup.hide()\n              return\n            }\n            // Page coordinates (the document ro