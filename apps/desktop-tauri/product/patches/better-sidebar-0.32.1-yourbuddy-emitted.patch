wRun: 'Workflow',\n  tasksNodeState: 'Stato',\n  tasksFoldExpandShort: \"Expand\",\n  tasksTreeCollapseAll: \"Collapse all\",\n  tasksTreeExpandAll: \"Expand all\",\n  tasksTreeCollapseRow: \"Collapse children\",\n  tasksTreeExpandRow: \"Expand children\",\n  tasksNodeTokens: \"Tokens\",\n  tasksNodeDuration: \"Duration\",\n  tasksNodeOpenMain: \"Open in the main window\",\n  tasksNodeMode: 'Modalità',\n  tasksNodeModel: 'Modello',\n  tasksNodeTeamRole: 'Ruolo nel team',\n  tasksStateRunning: 'In esecuzione',\n  tasksStateIdle: 'In attesa',\n  tasksStateProvisioning: 'Provisioning',\n  tasksStateDone: 'Completato',\n  tasksStateError: 'Errore',\n  tasksKindSubagent: 'Subagent',\n  tasksKindTeammate: 'Membro del team',\n  tasksKindWorkflow: 'Workflow',\n  taskWindowCreate: 'New task',\n  taskWindowDetail: 'Task detail',\n  teamBoard: 'Bacheca delle attività del team',\n  teamChip: 'Team {members} membri · {tasks} attività',\n  teamTasksEmpty: 'Ancora nessuna attività condivisa',\n  teamTaskCreate: 'Nuova attività',\n  teamTaskSubject: 'Titolo',\n  teamTaskDescription: 'Descrizione',\n  teamTaskOwner: 'Responsabile',\n  teamTaskUnowned: 'Non assegnata',\n  teamTaskPending: 'Da fare',\n  teamTaskInProgress: 'In corso',\n  teamTaskCompleted: 'Completata',\n  teamTaskBlocked: 'Bloccata',\n  teamTaskClaim: 'Claim',\n  teamTaskComplete: 'Completa',\n  teamTaskReopen: 'Riapri',\n  teamTaskDelete: 'Elimina',\n  teamTaskDeleteConfirm: 'Conferma eliminazione',\n  teamTaskEdit: 'Modifica',\n  teamTaskSave: 'Salva',\n  teamTaskCancel: 'Annulla',\n  teamTaskConflict: 'L’attività è stata modificata da altri; aggiornata',\n  teamTaskError: 'Operazione non riuscita: {message}',\n  teamTaskDeleted: 'Eliminata',\n  teamTaskActions: 'Azioni attività',\n  teamTaskDetail: 'Dettagli attività',\n  teamTaskNoDescription: 'Nessuna descrizione — fai clic su «Modifica» per aggiungerne una',\n  teamTaskBlockedBy: 'Bloccata da',\n  teamTaskSubjectPlaceholder: 'Descrivi il lavoro in una riga',\n  teamTaskDescriptionPlaceholder: 'Dettagli aggiuntivi (opzionale)',\n  teamFilterAll: 'Tutti',\n  tasksNodeTasks: 'Attività condivise',\n  jobCopyOutput: 'Copia output',\n  jobCopied: 'Copiato',\n  jobFollowTail: 'Segui le ultime righe',\n  jobDragHint: 'Trascina per spostare',\n  workflowRunning: 'In corso',\n  workflowCompleted: 'Completato',\n  workflowCancelled: 'Annullato',\n  workflowFailed: 'Non riuscito',\n  workflowPhaseUnnamed: 'Fase senza nome',\n  workflowMembers: '{done}/{total} membri',\n  jobsAutoCollapsed: 'Compresso automaticamente (molti agenti)',\n  contextDiagnostics: 'Diagnostica del contesto',\n  contextDiagnosticsTarget: 'Sessione corrente',\n  contextDiagnosticsFailed: 'Impossibile aprire la diagnostica del contesto per «{label}»',\n  contextDiagnosticsUnavailable: 'La pagina «Contesto» di dsh-context non è disponibile (non installata o non registrata)',\n  contextDiagnosticsNavigation: 'Impossibile individuare quella conversazione',\n  contextDiagnosticsTimeout: 'Apertura scaduta — riprova',\n  contextDiagnosticsOpenFailed: 'Impossibile aprire la pagina',\n  contextDiagnosticsDismiss: 'Chiudi',\n  catalogLoadFailed: 'Impossibile caricare {count} branch',\n  addPluginsTabCard: 'Aggiungi plugin scheda',\n  addPluginsTabCardDesc: 'Registri una nuova pagina della barra laterale',\n  addPluginsViewerCard: 'Aggiungi plugin di anteprima',\n  addPluginsViewerCardDesc: 'Registri un’anteprima di tipo di file',\n  addPluginsTabDesc: 'Le pagine della barra laterale (schede) possono essere estese dai plugin. I plugin si registrano tramite il servizio ctx.betterSidebar; cliccando Installa viene copiato il comando di installazione — lo incolli in un terminale dove risiede il profilo DSH e lo esegua.',\n  addPluginsViewerDesc: 'I visualizzatori di file possono essere estesi dai plugin. I plugin si registrano tramite il servizio ctx.betterSidebar; cliccando Installa viene copiato il comando di installazione — lo incolli in un terminale dove risiede il profilo DSH e lo esegua.',\n  addPluginsBrowseMore: 'Sfogli altri plugin su GitHub (topic: dsh-better-sidebar)',\n  addPluginsSearch: 'Cerca per nome / descrizione del plugin…',\n  addPluginsNoMatch: 'Nessun plugin corrispondente',\n  addPluginsRecommended: 'Plugin consigliati',\n  addPluginsEmpty: 'Nessun plugin curato per ora — pubblichi il suo sotto il topic GitHub',\n  openPlugin: 'Apri',\n  copyInstall: 'Copia comando di installazione',\n  pluginOfficeDesc: 'Anteprima della suite Office (.docx / .xlsx / .pptx) per l’editor di better-sidebar, tenendo le pesanti librerie di rendering Office fuori dal bundle principale, installabili su richiesta',\n  pluginFlowglassDesc: 'Diagramma di flusso live della sessione con tre corsie per utente, assistente e chiamate agli strumenti, più gruppi paralleli, rami dei sottoagenti, drill-down e stato in tempo reale; registra una scheda nativa Flowglass quando better-sidebar è installato e mantiene il suo cassetto autonomo come fallback',\n  pluginGitForgeDesc: 'Scheda Git Forge: libreria di account GitHub/Gitea (e altri forge) + concessioni per progetto + blocco rigido della politica di push; i token restano nei segreti locali (mai nel contesto del modello); strumento GitForge in sola lettura e helper di credenziali HTTPS per l’agente',\n  pluginGithubWorkbenchDesc: 'Scheda GitHub Workbench: albero del repository remoto + Issues / Pull requests / Actions con pieno supporto in scrittura — creazione di issue/PR, commenti, modifica, chiusura/riapertura, merge squash·merge·rebase (conferma rafforzata), riavvio/annullamento della CI; il selettore dei repository elenca automaticamente quelli accessibili e cerca tra quelli pubblici; senza better-sidebar esegue il fallback a un pannello laterale destro indipendente',\n  pluginIdeGitDesc: 'Scheda Git per better-sidebar: albero dei branch (badge ahead/behind, indicatore worktree), grafo dei commit con filtri testo/branch/autore/data/percorso, diff riga per riga per file, elenco modifiche e casella di commit, più merge, rebase, cherry-pick, reset, stash e tag; le azioni distruttive chiedono conferma e le eliminazioni o gli scarti sono reversibili. Senza better-sidebar si registra nella barra laterale destra nativa di DSH e funziona da sola',\n  pluginAgentPersonaDesc: 'Persone del prompt di sistema per spazio di lavoro o sessione: una persona può coprire diverse directory di spazi di lavoro e diverse sessioni, con corrispondenza esatta, per prefisso, per sottostringa o tramite espressione regolare — vince la più specifica, e una persona può essere impostata come predefinita; gestita da una pagina di impostazioni e da una scheda «Persona» nella conversazione, efficace dal messaggio successivo',\n  pluginMdExportDesc: 'Aggiunge un pulsante «Esporta» alla barra degli strumenti Markdown di better-sidebar: con un clic esegue il rendering del .md corrente in HTML autonomo (tabelle/blocchi di codice/diagrammi Mermaid in linea, layout fedele al tema di anteprima) e lo salva accanto al .md, oppure esporta in PDF tramite la finestra di stampa',\n  pluginCodeNavDesc: 'Navigazione dell’anteprima del codice: rileva il linguaggio dal tipo di file ed evidenzia la sintassi, struttura dei simboli (filtri classi/metodi/variabili + salto con un clic) e ricerca nel file (tutte le corrispondenze evidenziate, precedente/successiva, maiuscole/minuscole) — gestisce l’anteprima dei file di codice nell’editor better-sidebar',\n  pluginSuhuangScrollDesc: 'Collega il Runtime Suhuang Scroll locale alle impostazioni DSH e a better-sidebar per configurare il modello, testare la connessione e controllare la correzione continua; richiede Suhuang Scroll Runtime e dsh-better-sidebar',\n  pluginBetterOverleafDesc: 'Tab Overleaf per better-sidebar: accesso diretto tramite browser CDP (supporta Chromium di terze parti), elenco/cambio progetti, mirror git locali in <workspace>/overleaf/, sincronizzazione git bidirezionale con fallback API di sola lettura e anteprima dei file tramite la workbench della barra laterale',\n  pluginSentinelDesc: 'Sistema di risveglio dell’agente guidato da condizioni: sensori file/processo/porta/HTTP/comando/webhook risvegliano le sessioni dormienti quando le condizioni si verificano; registra una scheda «Sentinella» con la tabella di monitoraggio globale del server',\n  pluginServerDeckDesc: 'Dashboard a schede dei server: una scheda per host con stato online, OS, uptime, utilizzo CPU/RAM/disco e latenza; clicca una scheda per aprire un terminale interattivo xterm.js; importazione del ~/.ssh/config con un clic (gli alias di hosting Git vengono saltati). Registra la scheda nativa «Server» quando better-sidebar è installato, altrimenti mantiene il pannello laterale autonomo',\n  pluginSidebarQaDesc: 'Selezione e domanda: selezioni il testo della conversazione → ponga la domanda nel pannello a destra → una sessione di follow-up dedicata (❓ follow-up) nello stesso spazio di lavoro; un modello veloce senza pensiero comprime il contesto principale e lo inietta con la citazione, senza interrompere la conversazione principale. I follow-up si annidano, proseguono e si archiviano',\n  pluginSidenoteDesc: 'Side chat in stile Codex + annotazioni da selezione: esegui il fork della sessione corrente in un pannello laterale persistente (archiviata e nascosta dall’elenco delle sessioni, più istanze, comando /side, sopravvive al reload, il modello segue la sessione principale); seleziona il testo dell’assistant → badge numerato + editor di note → un chip \"N annotazioni\" che viaggia con il tuo prossimo messaggio, oppure chiedi direttamente in una side chat',\n  pluginSshTunnelDesc: 'Scheda SSH Tunnel: inventario multi-host + concessioni per progetto + chiavi locali; strumento SSHManager per il modello (exec/SFTP/strategie di sessione); terminale interattivo centrale e SFTP a due pannelli',\n  pluginVideoPreviewDesc: 'Anteprima video in linea nell’editor di better-sidebar (.mp4/.webm/.mov/.mkv/.avi ecc.), supportata da una route host /video dedicata con supporto HTTP Range (206) — la barra di avanzamento è trascinabile e la riproduzione parte prima che l’intero file sia scaricato',\n  pluginAudioDesc: \"Anteprima dei file audio (.mp3/.wav/.flac/.ogg/.m4a/.aac/.opus) nell'editor better-sidebar: lettore di forma d'onda con zoom (clic/trascina per spostarsi, loop A-B, cambio canale), spettro dal vivo e spettrogramma dell'intero file — la rotta media propria supporta HTTP Range, quindi si sposta a qualsiasi dimensione\",\n  pluginDevGitGraphDesc: 'A faithful vscode-git-graph port as a sidebar tab: the only entry is a native better-sidebar tab, auto-bound to the session workspace, full git operations (checkout/merge/rebase/push/tag/stash), light/dark theming, file diffs open in the built-in DiffTab; requires dsh-better-sidebar',\n  pluginDocsPanelDesc: 'Documenti globali nella barra laterale di DSH: legga le sue note Markdown da qualsiasi spazio di lavoro — una lista di file, una struttura, apertura in Chrome / VS Code e pulsanti di copia; la directory dei documenti è configurabile (predefinita ~/.dsh/docs)',\n  pluginTylinaDesc: 'Uno strumento di editing di documenti Typst che condivide lo spazio di lavoro della sessione corrente: modifica e impaginazione WYSIWYG di documenti Typst, utile per scrivere e impaginare articoli, relazioni, esami, curriculum, grafici, poster, spartiti e diapositive esportabili in PPTX',\n  pluginEgoBrowserDesc: 'Il browser agente per DeepSeek Harness: 32 strumenti ego_* pilotano un vero Chromium; una scheda nativa «ego browser» nella barra laterale mostra in tempo reale ogni pagina visitata dall’agente — puoi cliccare, trascinare e digitare per prendere il controllo. Registra la scheda automaticamente se better-sidebar è presente, altrimenti una bolla flottante',\n  pluginBilingualReaderDesc: 'Leggi PDF nella barra laterale DSH: visualizzazione PDF nativa, seleziona il testo per tradurlo con l’LLM, con contesto e completamente isolato dalla conversazione principale',\n  changesRedactOn: \"Mascheramento attivo: i segreti appaiono come [REDACTED]; clicca per disattivare (a tuo rischio)\",\n  changesRedactOff: \"Mascheramento disattivo: il contenuto appare invariato; clicca per attivare\",\n  changesRedactOnLabel: \"Mascheramento\",\n  changesRedactOffLabel: \"Senza mascheramento\",\n  changesRedactBanner: \"Mascherato\",\n  pluginAgentPersonaName: 'dsh-agent-persona Persone',\n  pluginSentinelName: 'dsh-sentinel Sistema di riattivazione',\n  pluginFileTraceName: 'dsh-file-trace Tracciatura file',\n  pluginFileTraceDesc: 'Registra ogni file letto, scritto o modificato dal modello; elenco raggruppato con contenuti e diff riga per riga, modalità lettura Markdown e mascheramento dei segreti; finestra mobile autonoma senza better-sidebar',\n  pluginMnemeName: 'dsh-mneme Libreria di memoria',\n  pluginMnemeDesc: 'Motore di memoria tra sessioni: consolidamento in background autoDream, riassunti di sessione e profilo utente; SQLite + specchi Markdown modificabili a mano, completamente offline e privato. Registra una scheda «Libreria di memoria» (viste memoria/entità/stato/impostazioni) se better-sidebar è presente, altrimenti mantiene il suo pannello laterale indipendente',\n  pluginEgoBrowserName: 'ego-browser Browser dell’agente',\n  pluginBetterOverleafName: 'dsh-better-overleaf Scheda Overleaf',\n  pluginDocsPanelName: 'dsh-docs-panel Documenti globali',\n  pluginTylinaName: 'dsh-tylina Editor di documenti Typst',\n  pluginFlowglassName: 'dsh-flowglass Flowglass',\n  pluginGitForgeName: 'dsh-git-forge Credenziali Git',\n  pluginGithubWorkbenchName: 'dsh-github-workbench Banco di lavoro GitHub',\n  pluginIdeGitName: 'dsh-ide-git Finestra Git',\n  pluginSidebarQaName: 'dsh-sidebar-qa Seleziona e chiedi',\n  pluginSidenoteName: 'dsh-sidenote Chat laterale',\n  pluginServerDeckName: 'dsh-server-deck Ponte server',\n  pluginSuhuangScrollName: 'dsh-suhuang-scroll Suhuang Scroll',\n  pluginSshTunnelName: 'dsh-ssh-tunnel Tunnel SSH',\n  pluginBilingualReaderName: 'dsh-bilingual-reader Lettore bilingue',\n  pluginOfficeName: 'Anteprima Office',\n  pluginMdExportName: 'Esportazione Markdown',\n  pluginCodeNavName: 'Navigatore anteprima codice',\n  pluginVideoPreviewName: 'Anteprima video',\n  pluginAudioName: 'Anteprima audio',\n  pluginTurnOutlineName: \"dsh-turn-outline Schema dei turni\",\n  pluginTurnOutlineDesc: \"Ripiega la sessione in turni utente (input + passaggi strumento + output); clic su un passaggio per tornare al punto esatto della conversazione — nessuna chiamata LLM, sola lettura\",\n  pluginDshMemoryDeltaName: 'dsh-memory-delta Memoria',\n  pluginDshMemoryDeltaDesc: 'Memoria tra sessioni: inietta solo ciò che è cambiato (nulla se nulla è cambiato), con promemoria di revisione, ricerca per rilevanza e scheda laterale.',\n}\n","/**\n * The nl (Dutch) dictionary for the betterSidebar namespace.\n *\n * Mirrors the key set of `zh` in `locales.ts`. The sidebar's `t()`\n * consults this dict when `attachBetterLocale(store)` has been called\n * with an active better-locale store whose `active` is `'nl'`; absent\n * that, the existing zh/en chain runs unchanged.\n *\n * Translation conventions:\n * - Formal \"u\" form for user-facing text.\n * - Technical loanwords stay in English (Git, SSH, HTTP, URL, Markdown, PDF, VS Code).\n * - Git vocabulary follows English-derived conventions (stagen, unstagen, commit, branch).\n * - Placeholders keep `{name}` verbatim (interpolation runs after lookup).\n * - English brand names (VS Code, Cursor, Zed, SSH) stay as-is.\n */\nexport const nl: Record<string, string> = {\n  files: 'Bestanden',\n  guideDescFiles: 'Blader door de bestandsboom van de workspace; klik opent voorbeeld of editor',\n  guideDescGit: 'Git-wijzigingen en bestandswijzigingen van deze sessie in één tabblad',\n  guideDescSubagent: 'Workflowgrafiek, teamtakenbord en achtergrondtaken, live',\n  guideDescSidechat: 'Een onafhankelijke vervolgthread met de context van deze sessie',\n  guideDescTerminal: '