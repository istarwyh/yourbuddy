ring\n}\n\n/**\n * The sidebar's Blocks reuse the Side Chat dictionary's chrome family (copy\n * pair + the collapse/expand family that is common to every Block kind).\n */\nexport function blockLabels(): BlockLabels {\n  return {\n    copy: t('copy'),\n    copied: t('copied'),\n    collapse: t('sideChatBlockCollapse'),\n    collapseAria: t('sideChatBlockCollapseAria'),\n    expand: (hidden: number) => t('sideChatBlockExpand', { hidden }),\n    expandAria: (hidden: number) => t('sideChatBlockExpandAria', { hidden }),\n  }\n}\n\n/** The `TerminalBlockLabels` shape (structural mirror; the host owns the type). */\nexport interface TerminalLabels {\n  commandLine: (line: number) => string\n  signal: (signal: string) => string\n  exitCode: (exitCode: number) => string\n  noExitCode: string\n  running: string\n  failed: string\n  done: string\n  copy: string\n  copied: string\n  noOutput: string\n  collapseAria: string\n  collapse: string\n  expandAria: (hidden: number) => string\n  expand: (hidden: number) => string\n}\n\n/** Labels for one `TerminalBlock` (a captured command plus its output). */\nexport function terminalBlockLabels(): TerminalLabels {\n  return {\n    ...blockLabels(),\n    commandLine: (line: number) => t('sideChatBlockCommandLine', { line }),\n    signal: (signal: string) => t('sideChatBlockSignal', { signal }),\n    exitCode: (exitCode: number) => t('sideChatBlockExitCode', { code: exitCode }),\n    // DSH 0.1.6-alpha.2 added this pill text: a settle the view cannot\n    // name (killed by an unknown signal, or never started).\n    noExitCode: t('sideChatBlockNoExitCode'),\n    running: t('sideChatBlockRunning'),\n    failed: t('sideChatBlockFailed'),\n    done: t('sideChatBlockDone'),\n    noOutput: t('sideChatBlockNoOutput'),\n  }\n}\n","/**\n * The plugin's reusable PERSISTENT floating window: a draggable, resizable,\n * body-portaled card with its own title bar, close button and scrolling body.\n *\n * Why a second window primitive next to {@link AnchoredPopover}: that one is a\n * POPOVER — it is anchored to an element, sized to its content, and dismissed\n * by any interaction outside it (outside mousedown, window blur, its anchor\n * leaving the viewport). That contract is exactly wrong for a surface the\n * reader WATCHES for minutes: a job's output must survive clicking elsewhere,\n * must not grow past the viewport, and must keep its place while the work\n * runs. This component therefore carries the opposite lifecycle — only the\n * close button and Escape end it — plus the two interactions a watched pane\n * needs: move it out of the way, and resize it to the log at hand.\n *\n * The body is the window's own scroll container, which is what bounds a long\n * output (the popover it replaces had no height limit at all, so a chatty job\n * simply ran off screen). Callers that follow a live tail pass `bodyRef` and\n * scroll it themselves.\n *\n * Mechanics reuse the two proven patterns of this codebase rather than\n * inventing a third: the MOVE rides window-level pointer listeners (the\n * `AnchoredPopover` drag — capture on the container would retarget the\n * derived click and kill the buttons inside), and the RESIZE rides\n * `setPointerCapture` on the handle plus a `createFrameBatcher` per-frame\n * commit (the `EditorHost` docked-panel resize; a per-event setState on a\n * streamed log is the visible drag lag of #315).\n *\n * Skin contract: tokens only (`--dsw-alias-*` / `--dsw-font-*`), the floating\n * layer keeps the app's `--dsw-shadow-lv3`, and the radius matches the Tasks\n * page's node cards (8px).\n */\nimport {\n  useCallback, useEffect, useMemo, useRef, useState,\n  type PointerEvent as ReactPointerEvent, type ReactNode, type RefObject,\n} from 'react'\nimport { createPortal } from 'react-dom'\nimport { Button, IconCloseFillRegular } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { createFrameBatcher } from './frame-batcher.ts'\nimport { t } from './locales.ts'\nimport { useViewportInsetTop } from './viewport-inset.ts'\nimport css from './FloatingWindow.module.css'\n\n/** Default share of the viewport a fresh window takes. */\nconst DEFAULT_WIDTH_RATIO = 0.7\nconst DEFAULT_HEIGHT_RATIO = 0.6\n/** Default floor, and the hard floor a resize can never cross. */\nconst DEFAULT_MIN_WIDTH = 320\nconst DEFAULT_MIN_HEIGHT = 240\n/** How much of the title bar must stay on screen while dragging. */\nconst KEEP_ON_SCREEN = 48\n/** Free space kept at the viewport edges. */\nconst VIEWPORT_MARGIN = 8\n/** Room a window never takes from the viewport (title bar + margins). */\nconst MIN_VIEWPORT_HEIGHT = 160\n\n/** One window box, viewport coordinates. */\ninterface WindowBox {\n  left: number\n  top: number\n  width: number\n  height: number\n}\n\nexport interface FloatingWindowProps {\n  /** Title-bar text (also the dialog's accessible name). */\n  title: string\n  /** Close (the button, or Escape). */\n  onClose(): void\n  /** Initial size; omitted → 70% × 60% of the viewport, then clamped. */\n  initialSize?: { width: number; height: number }\n  /** Resize floor; omitted → 320 × 240. */\n  minSize?: { width: number; height: number }\n  /**\n   * Where the window first appears: just below-right of this element (the\n   * row that opened it). Omitted / off-screen anchors centre it.\n   */\n  anchor?: HTMLElement | null\n  /** Header controls, left of the close button (a job's copy action). */\n  actions?: ReactNode\n  /** Bottom action row (a job's follow switch + stop control). */\n  footer?: ReactNode\n  /**\n   * The scrollable body element, for callers that follow a live tail. The\n   * caller scrolls it; the window owns its size and its overflow.\n   */\n  bodyRef?: RefObject<HTMLDivElement>\n  /**\n   * How the body stacks its children. `scroll` (default) flows them from the\n   * top inside the scrolling box — right for a log or a table. `fill` makes\n   * the body a column whose children stretch to the window's height — right\n   * for a detail view or a form, where the point of enlarging the window is\n   * more room for the content, not more empty space under it.\n   */\n  bodyLayout?: 'scroll' | 'fill'\n  children: ReactNode\n}\n\n/** Clamp one number into `[min, max]` (max first, so an inverted range is safe). */\nfunction clamp(value: number, min: number, max: number): number {\n  return Math.min(Math.max(min, value), Math.max(min, max))\n}\n\n/**\n * Clamp one axis of a window's origin. The rule is \"keep the WHOLE window on\n * screen when it fits, and otherwise keep {@link KEEP_ON_SCREEN}px of it (its\n * title bar / its right edge) reachable\": a window that hangs off the bottom\n * edge hides its own resize corner, which is exactly how the first real-host\n * check lost it.\n *\n * `minStart` is the lowest the origin may go; callers pass the top edge raised\n * past the shell's native window-control band, which takes pointer events\n * before the page sees them (./viewport-inset.ts). The overflow branch keeps\n * its old shape: there the title bar is already off-screen, so raising the\n * floor would only push the window's bottom further out.\n */\nfunction clampOrigin(\n  start: number,\n  size: number,\n  viewport: number,\n  minStart = VIEWPORT_MARGIN,\n): number {\n  const fullyInside = viewport - size - VIEWPORT_MARGIN\n  return fullyInside >= minStart\n    ? clamp(start, minStart, fullyInside)\n    : clamp(start, KEEP_ON_SCREEN - size, viewport - KEEP_ON_SCREEN)\n}\n\n/** The viewport-clamped initial box of one window. */\nfunction initialBox(\n  anchor: HTMLElement | null | undefined,\n  size: { width: number; height: number } | undefined,\n  min: { width: number; height: number },\n  viewport: { width: number; height: number },\n  insetTop: number,\n): WindowBox {\n  const topFloor = VIEWPORT_MARGIN + insetTop\n  const width = clamp(\n    size?.width ?? viewport.width * DEFAULT_WIDTH_RATIO,\n    min.width,\n    Math.max(min.width, viewport.width - VIEWPORT_MARGIN * 2),\n  )\n  const height = clamp(\n    size?.height ?? viewport.height * DEFAULT_HEIGHT_RATIO,\n    min.height,\n    Math.max(min.height, viewport.height - topFloor - VIEWPORT_MARGIN),\n  )\n  const rect = anchor?.getBoundingClientRect()\n  const left = rect === undefined\n    ? (viewport.width - width) / 2\n    : clamp(rect.left, VIEWPORT_MARGIN, viewport.width - width - VIEWPORT_MARGIN)\n  const top = rect === undefined\n    ? Math.max(topFloor, (viewport.height - height) / 2)\n    : clamp(rect.bottom + 6, topFloor, viewport.height - height - VIEWPORT_MARGIN)\n  return {\n    left: Math.round(left),\n    top: Math.round(top),\n    width: Math.round(width),\n    height: Math.round(height),\n  }\n}\n\n/**\n * Render a persistent floating window. The caller owns WHAT is shown (body,\n * header actions, footer); this component owns the frame, the geometry, the\n * two drag gestures and the dismissal contract (close button + Escape only).\n */\nexport function FloatingWindow(props: FloatingWindowProps): ReactNode {\n  const {\n    title, onClose, initialSize, minSize, anchor, actions, footer, bodyRef, bodyLayout, children,\n  } = props\n  const min = useMemo(() => ({\n    width: minSize?.width ?? DEFAULT_MIN_WIDTH,\n    height: minSize?.height ?? DEFAULT_MIN_HEIGHT,\n  }), [minSize?.width, minSize?.height])\n  /** The shell's native window-control band: pointer events die in it. */\n  const insetTop = useViewportInsetTop()\n  const topFloor = VIEWPORT_MARGIN + insetTop\n  const frameRef = useRef<HTMLDivElement>(null)\n  const onCloseRef = useRef(onClose)\n  onCloseRef.current = onClose\n  /**\n   * The box is measured ONCE, on mount, from the live viewport: a later\n   * re-render (a streamed output frame, a status flip) must never move or\n   * resize a window the reader placed.\n   */\n  const [box, setBox] = useState<WindowBox | null>(null)\n  const boxRef = useRef(box)\n  boxRef.current = box\n\n  useEffect(() => {\n    setBox(initialBox(anchor, initialSize, min, {\n      width: window.innerWidth,\n      height: window.innerHeight,\n    }, insetTop))\n    // Mount-only on purpose: see the comment above. The inset is read\n    // synchronously at module evaluation, so this first box already clears the\n    // shell band; a later change is handled by the re-clamp effect below.\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, [])\n\n  /** Keep the box reachable after a viewport change (a rotation, a split pane). */\n  useEffect(() => {\n    const onResize = (): void => {\n      const current = boxRef.current\n      if (current === null) return\n      const width = clamp(current.width, min.width, Math.max(min.width, window.innerWidth - VIEWPORT_MARGIN * 2))\n      // Old cap (\"leave room for the title bar below\") AND the new top floor:\n      // a band that grew while the window sat near the top would otherwise\n      // leave its title bar under the native controls.\n      const heightCap = Math.min(\n        window.innerHeight - MIN_VIEWPORT_HEIGHT,\n        window.innerHeight - topFloor - VIEWPORT_MARGIN,\n      )\n      const height = clamp(current.height, min.height, Math.max(min.height, heightCap))\n      setBox({\n        width,\n        height,\n        left: clampOrigin(current.left, width, window.innerWidth),\n        top: clampOrigin(current.top, height, window.innerHeight, topFloor),\n      })\n    }\n    window.addEventListener('resize', onResize)\n    // The band changed under an already-placed window: lift it out, never\n    // push it back down (that would move a window the reader placed).\n    onResize()\n    return () => { window.removeEventListener('resize', onResize) }\n  }, [min.width, min.height, topFloor])\n\n  // Escape only: no outside-click, no blur, no anchor observer (see the header).\n  useEffect(() => {\n    const onKeyDown = (event: KeyboardEvent): void => {\n      if (event.key === 'Escape') onCloseRef.current()\n    }\n    document.addEventListener('keydown', onKeyDown, true)\n    return () => { document.removeEventListener('keydown', onKeyDown, true) }\n  }, [])\n\n  /** Drag the window by its title bar (buttons inside it keep working). */\n  const dragBatcher = useRef(createFrameBatcher()).current\n  const pendingDragRef = useRef<WindowBox | null>(null)\n  useEffect(() => () => { dragBatcher.dispose() }, [dragBatcher])\n  const onTitlePointerDown = useCallback((event: ReactPointerEvent<HTMLDivElement>): void => {\n    if (event.button !== 0) return\n    const target = event.target as HTMLElement\n    // The header's own controls (copy, close) must not start a drag.\n    if (target.closest('button, input, textarea, select, a, [data-window-no-drag]') !== null) return\n    const start = boxRef.current\n    if (start === null) return\n    event.preventDefault()\n    const startX = event.clientX\n    const startY = event.clientY\n    const onMove = (move: PointerEvent): void => {\n      // A pointer stream outruns the display; compose the latest box here and\n      // commit it once per frame, not once per event (see ./frame-batcher.ts).\n      pendingDragRef.current = {\n        ...start,\n        left: clampOrigin(start.left + (move.clientX - startX), start.width, window.innerWidth),\n        top: clampOrigin(start.top + (move.clientY - startY), start.height, window.innerHeight, topFloor),\n      }\n      dragBatcher.schedule(() => {\n        const pending = pendingDragRef.current\n        if (pending === null) return\n        pendingDragRef.current = null\n        setBox(pending)\n      })\n    }\n    const onUp = (): void => {\n      window.removeEventListener('pointermove', onMove)\n      window.removeEventListener('pointerup', onUp)\n      window.removeEventListener('pointercancel', onUp)\n      dragBatcher.flushNow()\n    }\n    window.addEventListener('pointermove', onMove)\n    window.addEventListener('pointerup', onUp)\n    window.addEventListener('pointercancel', onUp)\n  }, [dragBatcher, topFloor])\n\n  /** Resize from one edge handle: `axis` picks which dimension the handle owns. */\n  const resizeBatcher = useRef(createFrameBatcher()).current\n  useEffect(() => () => { resizeBatcher.dispose() }, [resizeBatcher])\n  const resizeRef = useRef<{ startX: number; startY: number; box: WindowBox; axis: 'x' | 'y' | 'both' } | null>(null)\n  const pendingBoxRef = useRef<WindowBox | null>(null)\n\n  const onResizeStart = useCallback((axis: 'x' | 'y' | 'both') => (event: ReactPointerEvent<HTMLDivElement>): void => {\n    const start = boxRef.current\n    if (start === null || event.button !== 0) return\n    event.preventDefault()\n    event.stopPropagation()\n    // jsdom lacks setPointerCapture — the tests dispatch plain pointer events.\n    event.currentTarget.setPointerCapture?.(event.pointerId)\n    resizeRef.current = { startX: event.clientX, startY: event.clientY, box: start, axis }\n  }, [])\n\n  const onResizeMove = useCallback((event: ReactPointerEvent<HTMLDivElement>): void => {\n    const drag = resizeRef.current\n    if (drag === null) return\n    const growX = drag.axis === 'y' ? 0 : event.clientX - drag.startX\n    const growY = drag.axis === 'x' ? 0 : event.clientY - drag.startY\n    pendingBoxRef.current = {\n      ...drag.box,\n      width: clamp(\n        drag.box.width + growX,\n        min.width,\n        Math.max(min.width, window.innerWidth - drag.box.left - VIEWPORT_MARGIN),\n      ),\n      height: clamp(\n        drag.box.height + growY,\n        min.height,\n        Math.max(min.height, window.innerHeight - drag.box.top - VIEWPORT_MARGIN),\n      ),\n    }\n    resizeBatcher.schedule(() => {\n      const pending = pendingBoxRef.current\n      if (pending !== null) setBox(pending)\n    })\n  }, [min.width, min.height, resizeBatcher])\n\n  const onResizeEnd = useCallback((event: ReactPointerEvent<HTMLDivElement>): void => {\n    if (resizeRef.current === null) return\n    // Flush the last frame: a release can land with the final move still\n    // queued (the committed box would otherwise lose it).\n    resizeBatcher.flushNow()\n    resizeRef.current = null\n    pendingBoxRef.current = null\n    event.currentTarget.releasePointerCapture?.(event.pointerId)\n  }, [resizeBatcher])\n\n  return createPortal(\n    <div\n      ref={frameRef}\n      role=\"dialog\"\n      aria-label={title}\n      data-floating-window\n      className={css.window}\n      style={box === null\n        ? { left: -9999, top: -9999, width: DEFAULT_MIN_WIDTH, height: DEFAULT_MIN_HEIGHT }\n        : { left: box.left, top: box.top, width: box.width, height: box.height }}\n    >\n      <div className={css.titleBar} data-window-handle onPointerDown={onTitlePointerDown}>\n        <span className={css.title} title={title}>{title}</span>\n        <span className={css.titleActions} data-window-no-drag>\n          {actions}\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            className={css.close}\n            icon={<IconCloseFillRegular size={14} />}\n            aria-label={t('close')}\n            title={t('close')}\n            onClick={onClose}\n          />\n        </span>\n      </div>\n      <div\n        ref={bodyRef}\n        className={bodyLayout === 'fill' ? `${css.body} ${css.bodyFill}` : css.body}\n        data-window-body\n        data-window-body-layout={bodyLayout ?? 'scroll'}\n      >\n        {children}\n      </div>\n      {footer !== undefined && <div className={css.footer} data-window-footer>{footer}</div>}\n      {/*\n        Three handles rather than eight: the window grows from the bottom-right\n        in practice (a log gets longer), and the two edges keep a single-axis\n        resize possible. They sit above the body's scrollbar as thin strips.\n      */}\n      <div\n        className={`${css.handle} ${css.handleRight}`}\n        data-window-resize=\"x\"\n        aria-hidden=\"true\"\n        onPointerDown={onResizeStart('x')}\n        onPointerMove={onResizeMove}\n        onPointerUp={onResizeEnd}\n        onPointerCancel={onResizeEnd}\n      />\n      <div\n        className={`${css.handle} ${css.handleBottom}`}\n        data-window-resize=\"y\"\n        aria-hidden=\"true\"\n        onPointerDown={onResizeStart('y')}\n        onPointerMove={onResizeMove}\n        onPointerUp={onResizeEnd}\n        onPointerCancel={onResizeEnd}\n      />\n      <div\n        className={`${css.handle} ${css.handleCorner}`}\n        data-window-resize=\"both\"\n        aria-hidden=\"true\"\n        onPointerDown={onResizeStart('both')}\n        onPointerMove={onResizeMove}\n        onPointerUp={onResizeEnd}\n        onPointerCancel={onResizeEnd}\n      />\n    </div>,\n    document.body,\n  )\n}\n","/**\n * The background-jobs bottom drawer of the Tasks page and its output popover.\n *\n * Drawer: the tree's jobs (owner-labeled, fed by the HOST's client jobs\n * service — see jobs-client.ts) collapse into a bottom bar that AUTO-COLLAPSES\n * once the tree has many agents — the manual toggle always wins afterwards.\n *\n * Window: clicking a row opens a PERSISTENT floating window (FloatingWindow —\n * draggable, resizable, closed only by its own button or Escape), because a\n * job's output is something the reader watches for minutes: the popover it\n * used to open was dismissed by any click elsewhere and had no height bound,\n * so a chatty job ran off the bottom of the screen. The window's BODY is the\n * scroll container, so the output stays readable whatever its length. It shows\n * what the host streams for an OBSERVER (never the model's consuming cursor),\n * with a copy action in the title bar, a follow-latest switch and the\n * two-click kill in the footer, and a terminal-style tail while the job runs.\n *\n * Every control is a host primitive (Button / Tag / Switch / StateDot /\n * TerminalBlock).\n */\nimport { memo, useCallback, useEffect, useMemo, useRef, useState, type ReactNode } from 'react'\nimport {\n  Button, IconChevronUpOutlineRegular, IconCopyOutlineRegular, IconStopFillRegular, StateDot, Switch, Tag,\n  TerminalBlock, type TagTone,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { SidebarClientJobsService, SidebarJobView, SidebarObservedJob } from '../context-types.ts'\nimport type { ContextDiagnosticTarget } from './context-diagnostics.ts'\nimport { ContextDiagnosticsButton } from './context-diagnostics-ui.tsx'\nimport { terminalBlockLabels } from './block-labels.ts'\nimport {\n  formatJobDuration,\n  isJobLive,\n  jobDotState,\n  jobStatusLabel,\n  type TreeJob,\n} from './subagent-jobs.ts'\nimport { FloatingWindow } from './FloatingWindow.tsx'\nimport { useAutoAnimateRef } from './use-auto-animate.ts'\nimport { t } from './locales.ts'\nimport css from './tasks-graph.module.css'\n\n/** How long the kill button stays armed before it needs re-confirming. */\nconst JOB_KILL_ARM_MS = 3000\n/** The agent count at which the drawer starts collapsed. */\nexport const JOBS_DRAWER_COLLAPSE_AT = 8\n/** The cadence of a live row's elapsed text. */\nconst ELAPSED_TICK_MS = 1_000\n\n/**\n * Whether the PAGE is hidden (a background browser tab). The drawer's clock\n * must not tick for a document nobody is looking at, and it must show the\n * truth the moment the page comes back — hence a subscription rather than a\n * one-shot read.\n */\nfunction usePageHidden(): boolean {\n  const [hidden, setHidden] = useState(() => typeof document !== 'undefined' && document.hidden === true)\n  useEffect(() => {\n    if (typeof document === 'undefined') return undefined\n    const sync = (): void => { setHidden(document.hidden === true) }\n    document.addEventListener('visibilitychange', sync)\n    return () => { document.removeEventListener('visibilitychange', sync) }\n  }, [])\n  return hidden\n}\n\n/**\n * One live row's elapsed text. The clock lives HERE — in the span it prints —\n * and not in the drawer: `setNow(Date.now())` in the drawer handed React a new\n * value every second, so the whole row list was rebuilt once per tick (and a\n * parked Tasks tab kept doing it). A memoized span that owns its own second\n * re-renders one text node per tick instead, and creates no timer at all while\n * the row is settled, the drawer is collapsed (nothing renders it) or the page\n * is not really on screen. Leaving and re-entering visibility re-reads the\n * clock, so the elapsed time shown on return is current, not the value frozen\n * when the tab was parked.\n */\nconst LiveElapsed = memo(function LiveElapsed(props: {\n  /** Epoch ms the job started. */\n  startedAt: number\n  /** Settlement time; the duration is final once it is present. */\n  finishedAt: number | undefined\n  /** Whether the registry still holds the job open (drives the clock). */\n  live: boolean\n  /** Whether the page is on screen (a parked tab runs no timer). */\n  visible: boolean\n}): ReactNode {\n  const { startedAt, finishedAt, live, visible } = props\n  const running = live && visible\n  const [now, setNow] = useState(() => Date.now())\n  useEffect(() => {\n    if (!running) return undefined\n    // The pause may have been long: read the clock before the first tick.\n    setNow(Date.now())\n    const timer = window.setInterval(() => { setNow(Date.now()) }, ELAPSED_TICK_MS)\n    return () => { window.clearInterval(timer) }\n  }, [running])\n  // The settled expression mirrors the drawer's own: a live row measures from\n  // now, a settled one from its settlement time (its start when it never\n  // settled), so a stopped job's duration never keeps growing.\n  const elapsed = (live ? now : finishedAt ?? startedAt) - startedAt\n  return <>{formatJobDuration(elapsed, t)}</>\n})\n\n/** The Tag tone of one job status. */\nfunction jobTone(job: SidebarJobView): TagTone {\n  if (job.status === 'running') return 'info'\n  if (job.status === 'completed') return 'success'\n  if (job.status === 'failed') return 'danger'\n  return 'neutral'\n}\n\nexport interface JobsDrawerProps {\n  rows: readonly TreeJob[]\n  /** The host client jobs service; absent → no kill control is offered. */\n  jobs: SidebarClientJobsService | undefined\n  /** The observed output of the job whose panel is open (host stream). */\n  observed: SidebarObservedJob | undefined\n  /** Agent count of the tree (root included) — the auto-collapse signal. */\n  agentCount: number\n  /** Follow the agent-count collapse rule unless the reader overrides it. */\n  autoCollapse?: boolean\n  /** Open the output popover of one row (anchor = the row's main button). */\n  onOpenOutput(row: TreeJob, anchor: HTMLElement): void\n  /** The job whose output popover is currently open (row highlight). */\n  openJobId?: string\n  /** Whether the page hosting the drawer is really on screen (the native tab's\n   *  own `visible`). Omitted = assume it is: a parked Tasks tab must not keep a\n   *  per-second clock running. */\n  visible?: boolean\n}\n\nexport function JobsDrawer(props: JobsDrawerProps): ReactNode {\n  const { rows, agentCount, jobs, onOpenOutput, openJobId, visible = true, autoCollapse = true } = props\n  const autoOpen = !autoCollapse || agentCount < JOBS_DRAWER_COLLAPSE_AT\n  /** Manual override; undefined = follow the auto rule. */\n  const [manualOpen, setManualOpen] = useState<boolean | undefined>(undefined)\n  const open = manualOpen ?? autoOpen\n  /** The rows: a job arriving or settling slides in instead of blinking. */\n  const rowsRef = useRef<HTMLDivElement>(null)\n  useAutoAnimateRef(rowsRef)\n  const [armedId, setArmedId] = useState<string | undefined>(undefined)\n  const [killingId, setKillingId] = useState<string | undefined>(undefined)\n  const [killErrorId, setKillErrorId] = useState<string | undefined>(undefined)\n  /** The page's own visibility: the elapsed clocks below are gated on it. */\n  const pageHidden = usePageHidden()\n  const ticking = visible && !pageHidden\n\n  const liveCount = useMemo(\n    () => rows.reduce((count, row) => count + (isJobLive(row.job) ? 1 : 0), 0),\n    [rows],\n  )\n  const multiOwner = useMemo(\n    () => new Set(rows.map(row => row.ownerSessionId)).size > 1,\n    [rows],\n  )\n\n  // The kill button stays armed only briefly; a stray click must never kill.\n  useEffect(() => {\n    if (armedId === undefined) return\n    const timer = window.setTimeout(() => { setArmedId(undefined) }, JOB_KILL_ARM_MS)\n    return () => { window.clearTimeout(timer) }\n  }, [armedId])\n\n  const kill = useCallback(async (row: TreeJob): Promise<void> => {\n    if (jobs === undefined) return\n    setKillingId(row.job.id)\n    setKillErrorId(undefined)\n    try {\n      await jobs.kill(row.ownerSessionId, row.job.id)\n    } catch {\n      setKillErrorId(row.job.id)\n    } finally {\n      setKillingId(undefined)\n      setArmedId(undefined)\n    }\n  }, [jobs])\n\n  if (rows.length === 0) return null\n\n  const countLabel = liveCount > 0\n    ? t('jobsCountRunning', { count: rows.length, running: liveCount })\n    : t('jobsCount', { count: rows.length })\n\n  return (\n    <section className={css.jobsDrawer} aria-label={t('jobs')}>\n      <button\n        type=\"button\"\n        className={css.jobsDrawerBar}\n        aria-expanded={open}\n        onClick={() => { setManualOpen(!open) }}\n      >\n        <span>{t('jobs')}</span>\n        <span className={css.jobsBigNum}>{liveCount > 0 ? liveCount : rows.length}</span>\n        <span className={css.jobsDrawerCount}>{countLabel}</span>\n        <span className={css.jobsDrawerChev} data-open={open ? 'true' : 'false'} aria-hidden=\"true\">\n          <IconChevronUpOutlineRegular size={12} />\n        </span>\n      </button>\n      {!autoOpen && <div className={css.jobsAutoNote}>{t('jobsAutoCollapsed')}</div>}\n      {open && (\n        <div className={css.jobsDrawerBody} ref={rowsRef}>\n          {rows.map((row) => {\n            const { job } = row\n            const live = isJobLive(job)\n            const armed = armedId === job.id\n            const killing = killingId === job.id\n            const killFailed = killErrorId === job.id\n            // Everything here is row-stable: the ticking duration is the\n            // elapsed SPAN's own state (see LiveElapsed), so a clock tick never\n            // rebuilds this list. The accessible name deliberately carries the\n            // stable half only — a name that changes every second is noise for\n            // a screen reader, and keeping it here would drag the whole row\n            // back into the per-second render.\n            const meta = [\n              ...(multiOwner ? [row.ownerTitle] : []),\n              ...(job.detail !== undefined && job.detail !== '' ? [job.detail] : []),\n            ].filter(Boolean).join(' · ')\n            return (\n              <div\n                key={job.id}\n                className={css.jobsRow}\n                data-settled={live ? 'false' : 'true'}\n                data-open={openJobId === job.id ? 'true' : 'false'}\n              >\n                <Button\n                  variant=\"ghost\"\n                  size=\"sm\"\n                  className={css.jobsRowMain}\n                  aria-label={`${job.label} ${jobStatusLabel(job.status, t)}${meta === '' ? '' : ` ${meta}`}`}\n                  title={t('jobViewOutput')}\n                  onClick={(event) => { onOpenOutput(row, event.currentTarget) }}\n                >\n                  <StateDot state={jobDotState(job.status)} size={6} />\n                  <Tag tone=\"quiet\">{job.kind}</Tag>\n                  <span className={css.jobsLabel} title={job.label}>{job.label}</span>\n                  <Tag tone={jobTone(job)}>{jobStatusLabel(job.status, t)}</Tag>\n                  <span className={css.jobsMeta}>\n                    {meta === '' ? '' : `${meta} · `}\n                    <LiveElapsed\n                      startedAt={job.startedAt}\n                      finishedAt={job.finishedAt}\n                      live={live}\n                      visible={ticking}\n                    />\n                  </span>\n                </Button>\n                {/*\n                  The terminate column is reserved by EVERY row (settled ones\n                  included): the button lives inside a fixed 28px box, so\n                  revealing it on hover/focus or arming the confirm never\n                  re-flows the row's text.\n                */}\n                <span className={css.jobsKillSlot}>\n                  {job.status === 'running' && (\n                    <Button\n                      variant=\"outline\"\n                      size=\"sm\"\n                      className={css.jobsKill}\n                      data-armed={armed ? 'true' : 'false'}\n                      icon={<IconStopFillRegular size={11} />}\n                      aria-label={armed ? t('jobKillConfirm') : t('jobKill')}\n                      title={armed ? t('jobKillConfirm') : t('jobKill')}\n                      disabled={killing}\n                      onClick={() => {\n                        if (armed) void kill(row)\n                        else setArmedId(job.id)\n                      }}\n                    >\n                      {armed ? t('jobKillConfirm') : undefined}\n                    </Button>\n                  )}\n                  {killFailed && <span className={css.jobsKillError}>{t('jobKillError')}</span>}\n                </span>\n              </div>\n            )\n          })}\n        </div>\n      )}\n    </section>\n  )\n}\n\n/**\n * The output WINDOW of one job: what the host streams for an observer of this\n * job, inside the plugin's persistent floating window. The window owns the\n * frame, the geometry and the dismissal contract; this component owns the\n * content (status header rows, the terminal tail) and the footer controls\n * (follow-latest, two-click kill).\n */\nexport function JobOutputWindow(props: {\n  /** The host client jobs service (absent → the panel only reports that). */\n  jobs: SidebarClientJobsService | undefined\n  job: SidebarJobView\n  /** The owner session the roster carried the job under (kill + observation). */\n  ownerSessionId: string\n  /** The host's streamed observation of THIS job (undefined until it arrives). */\n  observed: SidebarObservedJob | undefined\n  /**\n   * The diagnostics target of the conversation that OWNS this job, resolved by\n   * the caller from the tree model (`undefined` = the owner is not in this\n   * tree, or the page has no such capability): the window never derives it\n   * from `ownerSessionId`, which names the session the roster was WATCHED\n   * under, not the session that owns the job.\n   */\n  diagnostics?: ContextDiagnosticTarget | undefined\n  /** The row's main button — where the window first appears. */\n  anchor?: HTMLElement | null\n  /** Close the window (the close button, or Escape). */\n  onClose(): void\n}): ReactNode {\n  const { jobs, job, ownerSessionId, observed, diagnostics: diagnosticTarget, anchor, onClose } = props\n  const [follow, setFollow] = useState(true)\n  const [copied, setCopied] = useState(false)\n  const [armed, setArmed] = useState(false)\n  const [killing, setKilling] = useState(false)\n  const [killFailed, setKillFailed] = useState(false)\n  const bodyRef = useRef<HTMLDivElement>(null)\n  const live = isJobLive(job)\n  const text = observed?.text ?? ''\n  const labels = useMemo(() => terminalBlockLabels(), [])\n\n  // The armed kill disarms itself, like the drawer's button.\n  useEffect(() => {\n    if (!armed) return\n    const timer = window.setTimeout(() => { setArmed(false) }, JOB_KILL_ARM_MS)\n    return () => { window.clearTimeout(timer) }\n  }, [armed])\n\n  // Terminal-tail behavior: every frame pins the BODY (the window's own scroll\n  // container — the element the previous popover wrapped in a div that never\n  // scrolled) to the newest output while the reader keeps follow on.\n  useEffect(() => {\n    if (!live || !follow || text.length === 0) return\n    const body = bodyRef.current\n    if (body !== null) body.scrollTop = body.scrollHeight\n  }, [text, live, follow])\n\n  /** Two-click kill from the window (the roster settles the row afterwards). */\n  const kill = async (): Promise<void> => {\n    if (jobs === undefined) return\n    setKilling(true)\n    setKillFailed(false)\n    try {\n      await jobs.kill(ownerSessionId, job.id)\n      setArmed(false)\n    } catch {\n      setKillFailed(true)\n    } finally {\n      setKilling(false)\n    }\n  }\n\n  return (\n    <FloatingWindow\n      title={job.label}\n      onClose={onClose}\n      {...(anchor === undefined ? {} : { anchor })}\n      bodyRef={bodyRef}\n      actions={(\n        <>\n          {/*\n            The owning conversation's Context view, beside the copy action: it is\n            offered only when the caller resolved the job's OWNER into the tree\n            (see the `diagnostics` prop) and the deployment has the page at all.\n          */}\n          <ContextDiagnosticsButton kind=\"job\" target={diagnosticTarget} iconSize={12} onNavigate={onClose} />\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            icon={<IconCopyOutlineRegular size={12} />}\n            aria-label={copied ? t('jobCopied') : t('jobCopyOutput')}\n            title={copied ? t('jobCopied') : t('jobCopyOutput')}\n            disabled={text === ''}\n            onClick={() => {\n              void navigator.clipboard?.writeText(text).then(() => {\n                setCopied(true)\n                window.setTimeout(() => { setCopied(false) }, 1500)\n              })\n            }}\n          />\n        </>\n      )}\n      footer={(\n        <div className={css.jobPopActions}>\n          {/*\n            The host Switch draws a bare track, so its wording rides beside it —\n            the same `jobFollowTail` copy the switch already carries as its\n            accessible name.\n          */}\n          <span className={css.jobPopFollow}>\n            <Switch\n              checked={follow}\n              onChange={setFollow}\n              label={t('jobFollowTail')}\n              disabled={!live}\n            />\n            <span className={css.jobPopFollowLabel}>{t('jobFollowTail')}</span>\n          </span>\n          {live && (\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              className={armed ? css.jobPopKillArmed : undefined}\n              icon={<IconStopFillRegular size={11} />}\n              disabled={killing}\n              onClick={() => {\n                if (armed) void kill()\n                else setArmed(true)\n              }}\n            >\n              {armed ? t('jobKillConfirm') : t('jobKill')}\n            </Button>\n          )}\n          {killFailed && <div className={css.popError}>{t('jobKillError')}</div>}\n        </div>\n      )}\n    >\n      <div className={css.jobPopTitle}>\n        <StateDot state={jobDotState(job.status)} size={6} />\n        <span className={css.popTitle} title={job.label}>{job.label}</span>\n        <Tag tone={jobTone(job)}>{jobStatusLabel(job.status, t)}</Tag>\n      </div>\n      <div className={css.jobPopMeta}>\n        <Tag tone=\"quiet\">{job.kind}</Tag>\n        {job.detail !== undefined && job.detail !== '' && <span>{job.detail}</span>}\n        <span className={css.popHint}>{t('jobDragHint')}</span>\n      </div>\n      {observed === undefined && <div className={css.popHint}>{t('loading')}</div>}\n      {observed !== undefined && (\n        <>\n          {observed.gapBefore && <div className={css.popHint}>{t('jobOutputTruncated')}</div>}\n          {observed.error !== undefined && <div className={css.popError}>{t('jobOutputError')}</div>}\n          {observed.text.length > 0\n            ? (\n              <div>\n                <TerminalBlock\n                  command={job.label}\n                  output={observed.text}\n                  running={observed.streaming}\n                  runStateDot={false}\n                  maxLines={Number.POSITIVE_INFINITY}\n                  copyText={job.label}\n                  labels={labels}\n                />\n              </div>\n            )\n            : <div className={css.popHint}>{t('jobNoOutput')}</div>}\n        </>\n      )}\n    </FloatingWindow>\n  )\n}\n","/**\n * Side Chat transcript mapping (browser half): turns a thread child's own\n * events (`sidechat.events` — the plugin route, which reads the log without\n * activating the child and cuts the inherited seed host-side) into compact\n * display rows.\n *\n * A thread child's log starts with the ENTIRE inherited parent log as its\n * fork seed. The route already cuts everything up to the last tagged\n * `session/end-seed { inherited: true }` marker; the mapping re-applies the\n * same cut (never a restore/replay lifecycle marker) so any\n * seed event that somehow crosses the wire still never renders, and maps\n * context injections (the \"Side conversation boundary\" prompt,\n * plugin-sourced context) onto a collapsible injection row, so the view\n * shows only the thread's own conversation.\n *\n * Live streaming: `assistant/message` events only land when a step\n * completes, but the host's `assistant/live-chunk` rows stream token-level\n * text and reasoning deltas (DSH 0.1.5 publishes them outside the session\n * log — see assistant-live.ts). The mapping accumulates both per block and\n * supersedes them with the assembled message once it lands (settled rows).\n *\n * Failures: a provider/agent error used to end a turn with nothing on screen.\n * The terminal `turn/end` reason and a failed attempt's embedded finish chunk\n * both map onto one visible `error` row per turn.\n *\n * Deliveries: a `present` call maps onto a compact deliverables card, and the\n * authoritative `deliverables/presented` event the tool appends attaches to\n * that card by `callId` — or stands alone when the call row is outside the\n * events route's head cap. One card per call; a FAILED call replaces its card\n * with the generic failed tool row. (The host's own `PresentRow` is a status\n * disclosure row over the call — its delivery cards come from the turn-tail\n * deliverables, not from the call itself.)\n */\nimport type {\n  DiffHunk,\n  ReadBlockLine,\n  SearchBlockProps,\n  SearchFileGroup,\n  WebBlockProps,\n  WebSourceView,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport { projectSidechatContent, type SidechatImageOccurrence } from '../sidechat-images.ts'\nimport type { SidebarHistoryEntry } from '../context-types.ts'\nimport { isContextInjectionMessage, SIDE_BOUNDARY_PROMPT, threadOwnLogEvents } from '../sidechat-core.ts'\n\n/** {@link Omit} that distributes over a union, so a discriminated props union\n *  keeps its `kind` discriminant (the host's card models use the same trick). */\ntype DistributiveOmit<T, K extends keyof T> = T extends unknown ? Omit<T, K> : never\n\n/** The host `SearchBlock` props minus the render site's own fields. */\nexport type SidechatSearchCard = DistributiveOmit<SearchBlockProps, 'labels' | 'className'>\n\n/** The host `WebBlock` props minus the render site's own fields. */\nexport type SidechatWebCard = DistributiveOmit<WebBlockProps, 'labels' | 'className'>\n\n/**\n * Structured render payload for a tool row that maps onto one of the host's\n * ui-primitives Blocks (the same atoms the main conversation renders). Derived\n * defensively from raw `tool/call` arguments and `tool/result` `meta` — the\n * producing tool owns the meta shape, so every field is narrowed and any\n * malformed input silently falls back to the generic text row.\n */\nexport type SidechatToolCard =\n  | {\n    type: 'terminal'\n    command: string\n    cwd?: string\n    output?: string\n    exitCode?: number\n    signal?: string\n  }\n  | { type: 'diff'; diffs: DiffHunk[] }\n  | { type: 'read'; label: string; lines: ReadBlockLine[]; totalLines: number; lang?: string }\n  /** grep / glob: the host SearchBlock, in its `matches` or `paths` shape. */\n  | { type: 'search'; card: SidechatSearchCard }\n  /** web_search / web_fetch: the host WebBlock, in its `search` or `fetch` shape. */\n  | { type: 'web'; card: SidechatWebCard }\n\n/** One file a `present` call delivered: its path (absolute from the\n *  `deliverables/presented` event, session-relative from the call arguments)\n *  plus the model's own description when it wrote one. */\nexport interface SidechatDeliverable {\n  path: string\n  description?: string\n}\n\n/** One compact transcript row rendered in the thread view. `seq` is the\n *  source event's log sequence. Text/reasoning also retain the original\n *  content-block index: one event can yield several rows, so seq alone is\n *  not a unique React key across polls. */\nexport type SidechatTranscriptRow =\n  /** `messageId` is the durable message identity the log records on the event\n   *  (`data.id`); the view uses it to dedupe a still-pending inbox row against\n   *  the durable row the claim eventually writes. Older logs may lack it. */\n  | {\n    kind: 'user'\n    seq: number\n    text: string\n    messageId?: string\n    /** Upstream's projected image occurrences (side-chat images). */\n    images?: SidechatImageOccurrence[]\n    /** The message's `file` blocks, in content order (a bubble is one visual\n     *  unit, so they ride the row instead of becoming siblings). */\n    attachments?: readonly SidechatAttachment[]\n  }\n  /** A context injection (the side boundary prompt + the parked in-progress\n   *  snapshot, or any plugin-sourced context): rendered as one collapsible\n   *  row, never as a user bubble. */\n  | { kind: 'injection'; seq: number; text: string }\n  /** A provider/agent FAILURE, which used to end a turn silently: either a\n   *  `turn/end` carrying `reason.kind === 'error'` or a failed\n   *  `assistant/attempt` (its stream's terminal `finish` chunk). One row per\n   *  turn — the attempt error and the turn/end that follows it are the same\n   *  failure. */\n  | { kind: 'error'; seq: number; text: string }\n  /** `settled` distinguishes an assembled message from a still-streaming\n   *  chunk accumulation. Original content-block indexes are never compacted;\n   *  a live chunk that lacks a valid index keeps it undefined. */\n  | { kind: 'assistant'; seq: number; text: string; settled: boolean; contentBlockIndex?: number }\n  | {\n    kind: 'reasoning'\n    seq: number\n    text: string\n    settled: boolean\n    contentBlockIndex?: number\n    /** The turn this row belongs to, when the log records one (the view groups\n     *  a Turn's work rows by it). */\n    turn?: number\n    /** True when that turn already ended (`turn/end` landed): its work rows are\n     *  settled and may be folded shut. */\n    turnEnded?: boolean\n  }\n  | {\n    kind: 'tool'\n    seq: number\n    name: string\n    failed: boolean\n    /** Raw arguments JSON as the model produced it. */\n    args?: string\n    /** Plain text of the paired result. */\n    resultText?: string\n    /** True while the call's result has not landed yet. */\n    executing?: boolean\n    /** Structured render payload (host Block atoms); absent = generic row. */\n    card?: SidechatToolCard\n    /** `image` / `file` blocks of the paired result's content list. */\n    resultAttachments?: readonly SidechatAttachment[]\n    /** The turn this call belongs to, and whether that turn already ended (see\n     *  `reasoning.turn`). */\n    turn?: number\n    turnEnded?: boolean\n  }\n  /** One `present` delivery (a compact deliverables card instead of a tool\n   *  row). A `deliverables/presented` event with the same `callId` REPLACES\n   *  the call's arguments copy — one card per call, never two, whichever\n   *  event lands first. An event with no call row in the window (an\n   *  event-only delivery) still gets its own. A FAILED present call delivered\n   *  nothing and renders as the generic failed tool row instead. */\n  | { kind: 'deliverables'; seq: number; callId?: string; files: readonly SidechatDeliverable[] }\n  /** One turn's tail metrics, emitted at `turn/end`: the turn's token usage\n   *  (aggregated from `assistant/message.usage`) and wall duration (envelope\n   *  time delta from `turn/start`), whichever are computable. */\n  | {\n    kind: 'turnSummary'\n    seq: number\n    /** The turn these metrics belong to (the view's work-details control reads\n     *  its duration from here). */\n    turn?: number\n    inputTokens?: number\n    outputTokens?: number\n    durationMs?: number\n  }\n  /** A turn that ended WITHOUT a normal completion, so the transcript says why\n   *  it stops there instead of looking deliberately finished: the reader (or\n   *  the agent) stopped it (`aborted`), or the output limit cut it\n   *  (`max-tokens`). One row per turn — the attempt's terminal finish reason and\n   *  the `turn/end` that repeats it are the same event. */\n  | { kind: 'terminal'; seq: number; reason: 'aborted' | 'max-tokens' }\n  /** One `image` / `file` content block of an ASSISTANT message, rendered in\n   *  block order: the assistant branch explodes a message per content block, so\n   *  an attachment needs its own row to keep that order. A USER message keeps\n   *  its blocks on the message's own row (`user.attachments`) — the bubble is\n   *  one visual unit. */\n  | {\n    kind: 'attachment'\n    seq: number\n    attachment: SidechatAttachment\n    contentBlockIndex?: number\n  }\n  /** One compaction transaction, drawn at its landed CHECKPOINT (host parity:\n   *  no checkpoint, no node). `text` is the summary body the row publishes\n   *  behind its disclosure (`''` when the metering event is outside the\n   *  window); the counts come from that same metering event, so they are null\n   *  whenever it is. */\n  | {\n    kind: 'compaction'\n    seq: number\n    text: string\n    summary: string | null\n    shadowedItemCount: number | null\n    shadowedTokenCount: number | null\n  }\n  /** One model-request retry CHAIN (`retryId`), folded like the host: every\n   *  further attempt updates this row, which keeps the chain's first seq. */\n  | {\n    kind: 'retry'\n    seq: number\n    retry: number\n    maxRetries?: number\n    delayMs?: number\n    provider?: string\n    state: 'scheduled' | 'started'\n    failureMessage?: string\n  }\n\n/**\n * One image content block the transcript must show. The bytes are NOT part of\n * the log — only the id is — so the read goes through the host Remote with the\n * THREAD's own session id (see `SidechatAttachments`); a `uiConversation`\n * image URL is never the source.\n */\nexport interface SidechatImageAttachment {\n  /** Opaque host id — the only key a byte read may use. */\n  attachmentId: string\n  /** The image's media type (becomes the Blob's `type`). */\n  mediaType: string\n  /** The producer's file name, when it recorded one (the thumbnail's alt). */\n  name?: string\n}\n\n/** One non-image file the model was given: a chip, never a byte read. */\nexport interface SidechatFileAttachment {\n  name: string\n  /** Byte count for the size chip (absent when the producer recorded none). */\n  bytes?: number\n}\n\n/** What a landing checkpoint takes from its `compaction/summary` metering\n *  event: the summary body it replaced the range with, and that range's shadow\n *  price. Absent when the metering event is outside the event window. */\ninterface CompactionFacts {\n  summary: string | null\n  shadowedItemCount: number | null\n  shadowedTokenCount: number | null\n}\n\n/** An `image` or `file` content block, narrowed to what the transcript renders. */\nexport type SidechatAttachment =\n  | { kind: 'image'; image: SidechatImageAttachment }\n  | { kind: 'file'; file: SidechatFileAttachment }\n\n/** Compact token count the way the main conversation prints usage\n *  (517 / 12.2K / 1.2M — the host's own formatter is not exported). */\nexport function formatTokens(n: number): string {\n  const scaled = (v: number): string => (v >= 100 ? String(Math.round(v)) : String(Math.round(v * 10) / 10))\n  if (n < 1_000) return String(n)\n  if (n < 1_000_000) return `${scaled(n / 1_000)}K`\n  return `${scaled(n / 1_000_000)}M`\n}\n\n/** Compact duration the way the main conversation prints run times\n *  (45.2s / 2m42s — sub-minute keeps one decimal). */\nexport function formatDurationMs(ms: number): string {\n  const seconds = ms / 1_000\n  if (seconds < 60) return `${Math.round(seconds * 10) / 10}s`\n  const whole = Math.round(seconds)\n  return `${Math.floor(whole / 60)}m${whole % 60}s`\n}\n\n/** The plain text of a content list (`text` blocks verbatim, joined by blank\n *  lines), '' when it carries no text block at all. */\nfunction joinedText(content: readonly unknown[]): string {\n  const parts: string[] = []\n  for (const block of content) {\n    if (block === null || typeof block !== 'object') continue\n    const candidate = block as { type?: unknown; text?: unknown }\n    if (candidate.type === 'text' && typeof candidate.text === 'string') {\n      parts.push(candidate.text)\n    }\n  }\n  return parts.join('\\n\\n')\n}\n\n/** Extract the visible text of a content-block list (`text` blocks verbatim,\n *  joined by blank lines); empty reads `…` so rows never render blank. */\nexport function blockText(content: readonly unknown[]): string {\n  const text = joinedText(content)\n  return text === '' ? '…' : text\n}\n\n/** Cap for a tool row's one-line argument summary (display only). */\nconst ARGS_SUMMARY_MAX = 80\n\n/** The most identifying argument keys, in priority order (bash's command,\n *  fs tools' paths, search's pattern, …). */\nconst ARGS_SUMMARY_KEYS = ['command', 'file_path', 'path', 'pattern', 'query', 'url', 'prompt'] as const\n\nfunction flatTruncate(text: string): string {\n  const flat = text.replace(/\\s+/g, ' ').trim()\n  return flat.length > ARGS_SUMMARY_MAX ? `${flat.slice(0, ARGS_SUMMARY_MAX - 1)}…` : flat\n}\n\n/**\n * The short summary of one argument object that names no identifying key: the\n * FIRST string field, or the first array field's primitive entries joined —\n * whichever comes first in the object's own order. Undefined when the object\n * carries neither (all numbers/booleans/nested objects).\n */\nfunction firstFieldSummary(parsed: Record<string, unknown>): string | undefined {\n  for (const value of Object.values(parsed)) {\n    if (typeof value === 'string' && value.trim() !== '') return flatTruncate(value)\n    if (!Array.isArray(value)) continue\n    const parts = value\n      .filter((item): item is string | number | boolean =>\n        typeof item === 'string' || typeof item === 'number' || typeof item === 'boolean')\n      .map(item => String(item))\n      .filter(item => item.trim() !== '')\n    if (parts.length > 0) return flatTruncate(parts.join(', '))\n  }\n  return undefined\n}\n\n/**\n * One-line summary of a tool call's raw arguments JSON for the collapsed row:\n * the first identifying string field when the JSON parses, else (an object with\n * none of those keys) the first string/array field, else nothing at all.\n *\n * The raw JSON is NEVER the answer for a parsed object — a collapsed row that\n * reads `{\"custom\":\"v\"}` tells the reader nothing they can scan. Raw text still\n * serves the one case where it is all there is: arguments that are not an\n * object at all (unparsable, or a bare array/literal), and an object that HAS an\n * identifying key but left it blank (the key is the tool's own vocabulary, so\n * the arguments themselves are the honest summary). Empty when there is nothing\n * worth showing.\n */\nexport function toolArgsSummary(args: string | undefined): string {\n  if (args === undefined) return ''\n  try {\n    const parsed = JSON.parse(args) as Record<string, unknown> | null\n    if (parsed !== null && typeof parsed === 'object' && !Array.isArray(parsed)) {\n      let identifying = false\n      for (const key of ARGS_SUMMARY_KEYS) {\n        if (!(key in parsed)) continue\n        identifying = true\n        const value = parsed[key]\n        if (typeof value === 'string' && value.trim() !== '') return flatTruncate(value)\n      }\n      if (identifying) return flatTruncate(args)\n      return firstFieldSummary(parsed) ?? ''\n    }\n  } catch {\n    // Raw text fallthrough.\n  }\n  return flatTruncate(args)\n}\n\n/**\n * The result content blocks of one tool/result message under BOTH logged\n * shapes: 0.1.6 wrapped them in a single `type: 'tool-result'` content block\n * on a user-role message, 0.1.7's first-class tool-role message carries them\n * at the message's own top level. Historical logs keep the old shape forever,\n * so both are read. Undefined when the message carries no block array.\n */\nfunction resultBlocks(content: unknown): readonly unknown[] | undefined {\n  if (!Array.isArray(content)) return undefined\n  for (const block of content) {\n    if (block === null || typeof block !== 'object') continue\n    const wrapper = block as { type?: unknown; content?: unknown }\n    if (wrapper.type === 'tool-result' && Array.isArray(wrapper.content)) {\n      return wrapper.content as readonly unknown[]\n    }\n  }\n  return content as readonly unknown[]\n}\n\n/** The plain text of a tool/result message (its text blocks, under either of\n *  the two shapes {@link resultBlocks} reads). */\nfunction resultTextOf(data: Record<string, unknown>): string {\n  const message = data.message as { content?: unknown } | undefined\n  const blocks = resultBlocks(message?.content)\n  if (blocks === undefined) return ''\n  const parts: string[] = []\n  for (const item of blocks) {\n    if (item === null || typeof item !== 'object') continue\n    const textItem = item as { type?: unknown; text?: unknown }\n    if (textItem.type === 'text' && typeof textItem.text === 'string') {\n      parts.push(textItem.text)\n    }\n  }\n  return parts.join('\\n')\n}\n\n/**\n * Narrow one `image` / `file` content block. A block without the fields the\n * transcript can actually render is SKIPPED (no row, no placeholder, no byte\n * read): an image needs an `attachmentId` (the read key) and a `mediaType` (the\n * Blob's type); a file needs its `name` (the chip's whole text).\n * @param block - one content block from a message or a tool result.\n * @returns the narrowed attachment, or undefined for anything else.\n */\nfunction attachmentOf(block: unknown): SidechatAttachment | undefined {\n  if (block === null || typeof block !== 'object') return undefined\n  const { type, attachment } = block as { type?: unknown; attachment?: unknown }\n  if (attachment === null || typeof attachment !== 'object') return undefined\n  const ref = attachment as Record<string, unknown>\n  if (type === 'image') {\n    const { attachmentId, mediaType, name } = ref\n    if (typeof attachmentId !== 'string' || attachmentId === '') return undefined\n    if (typeof mediaType !== 'string' || mediaType === '') return undefined\n    return {\n      kind: 'image',\n      image: {\n        attachmentId,\n        mediaType,\n        ...(typeof name === 'string' && name !== '' ? { name } : {}),\n      },\n    }\n  }\n  if (type !== 'file') return undefined\n  const { name, bytes } = ref\n  if (typeof name !== 'string' || name === '') return undefined\n  return {\n    kind: 'file',\n    file: {\n      name,\n      ...(typeof bytes === 'number' && Number.isFinite(bytes) && bytes >= 0 ? { bytes } : {}),\n    },\n  }\n}\n\n/** Every renderable attachment of one content list, in block order. */\nfunction attachmentsOf(content: readonly unknown[]): SidechatAttachment[] {\n  const attachments: SidechatAttachment[] = []\n  for (const block of content) {\n    const attachment = attachmentOf(block)\n    if (attachment !== undefined) attachments.push(attachment)\n  }\n  return attachments\n}\n\n/** Whether two narrowed attachment lists render the same thing (the row-reuse\n *  compare; the row objects keep their identity across polls when they do). */\nfunction attachmentsEqual(a: readonly SidechatAttachment[] | undefined, b: readonly SidechatAttachment[] | undefined): boolean {\n  if (a === b) return true\n  if (a === undefined || b === undefined || a.length !== b.length) return false\n  return a.every((attachment, index) => {\n    const peer = b[index]\n    if (peer === undefined || peer.kind !== attachment.kind) return false\n    if (attachment.kind === 'image') {\n      const left = attachment.image\n      const right = (peer as typeof attachment).image\n      return left.attachmentId === right.attachmentId && left.mediaType === right.mediaType && left.name === right.name\n    }\n    const left = attachment.file\n    const right = (peer as typeof attachment).file\n    return left.name === right.name && left.bytes === right.bytes\n  })\n}\n\n/** The provider failure message of one `llm/retry` (`{ kind, message? }`), or\n *  undefined when the producer recorded none — the row then carries no meta. */\nfunction retryFailureMessage(failure: unknown): string | undefined {\n  if (failure === null || typeof failure !== 'object') return undefined\n  const message = (failure as { message?: unknown }).message\n  return typeof message === 'string' && message !== '' ? message : undefined\n}\n\n/**\n * Whether one `tool/result` reports a FAILED invocation.\n *\n * The host channel is the tool-role message's own `isError` (`llm`'s\n * `ToolResultMessage`, and the flag its own produced-path scan reads); 0.1.6\n * logs carry the same flag on the wrapping `tool-result` block instead, which\n * this module reads everywhere else. A plugin-era `data.error` stays as the last\n * fallback so an older fixture or a foreign producer is still read as failed —\n * a tool that throws a BARE error (no `error.info`) sets `isError` and nothing\n * else, which is exactly the case the fallback alone missed.\n * @param data - one `tool/result` event's data record.\n * @returns true when the result is a failure.\n */\nfunction resultFailed(data: Record<string, unknown>): boolean {\n  const message = data.message as { isError?: unknown; content?: unknown } | undefined\n  if (message?.isError === true) return true\n  if (Array.isArray(message?.content)) {\n    for (const block of message.content) {\n      if (block === null || typeof block !== 'object') continue\n      const wrapper = block as { type?: unknown; isError?: unknown }\n      if (wrapper.type === 'tool-result' && wrapper.isError === true) return true\n    }\n  }\n  return data.error !== undefined\n}\n\n/** The `image` / `file` blocks of a tool/result message's content list (under\n *  either logged shape — {@link resultBlocks}). */\nfunction resultAttachmentsOf(data: Record<string, unknown>): SidechatAttachment[] {\n  const message = data.message as { content?: unknown } | undefined\n  const blocks = resultBlocks(message?.content)\n  return blocks === undefined ? [] : attachmentsOf(blocks)\n}\n\n/** Parse the tool's raw arguments JSON to an object, or undefined (malformed\n *  JSON, a non-object, or an absent argument string). Shared with the file-\n *  mention vocabulary, which reads the same arguments. */\nexport function parseArgsObject(args: string | undefined): Record<string, unknown> | undefined {\n  if (args === undefined) return undefined\n  try {\n    const parsed: unknown = JSON.parse(args)\n    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) return undefined\n    return parsed as Record<string, unknown>\n  } catch {\n    return undefined\n  }\n}\n\n/**\n * Narrow one delivered-file entry (`{ path, description? }`). The path is\n * kept verbatim: the card resolves it against the session cwd on click and\n * through the media route on render, so both the call-arguments spelling\n * (cwd-relative) and the event spelling (absolute) work unchanged. A\n * malformed entry declines the whole list: the call-arguments path then falls\n * back to the generic tool row, while the event path renders no card (an\n * event carries no call row of its own to fall back to).\n */\nfunction deliverableOf(value: unknown): SidechatDeliverable | undefined {\n  if (value === null || typeof value !== 'object' || Array.isArray(value)) return undefined\n  const { path, description } = value as { path?: unknown; description?: unknown }\n  if (typeof path !== 'string' || path.trim() === '') return undefined\n  if (description !== undefined && typeof description !== 'string') return undefined\n  return { path, ...(description !== undefined && description !== '' ? { description } : {}) }\n}\n\n/** The `files` array of a `present` argument object or a\n *  `deliverables/presented` event, or undefined when the value is not one. */\nfunction deliverableFiles(value: unknown): SidechatDeliverable[] | undefined {\n  if (!Array.isArray(value)) return undefined\n  const files: SidechatDeliverable[] = []\n  for (const entry of value) {\n    const file = deliverableOf(entry)\n    if (file === undefined) return undefined\n    files.push(file)\n  }\n  return files\n}\n\n/** The delivered files of a `present` tool call, or undefined when its\n *  arguments name none (the call then renders as the generic tool row). */\nfunction presentCallFiles(args: string | undefined): SidechatDeliverable[] | undefined {\n  const files = deliverableFiles(parseArgsObject(args)?.files)\n  return files !== undefined && files.length > 0 ? files : undefined\n}\n\n/**\n * Call-time card from the raw `tool/call` arguments — the same literal cards\n * the host's own presenters derive before any result exists: bash shows the\n * command line (foreground only), edit/write show the literal replacement.\n * `read` has no call-time window (its structure only exists in the result).\n */\nfunction callCard(name: string, args: string | undefined): SidechatToolCard | undefined {\n  const parsed = parseArgsObject(args)\n  if (parsed === undefined) return undefined\n  if (name === 'bash') {\n    const command = typeof parsed.command === 'string' && parsed.command !== '' ? parsed.command : undefined\n    if (command === undefined || parsed.run_in_background === true) return undefined\n    const cwd = typeof parsed.workdir === 'string' && parsed.workdir !== '' ? parsed.workdir : undefined\n    return { type: 'terminal', command, ...(cwd !== undefined ? { cwd } : {}) }\n  }\n  if (name === 'edit' || name === 'write') {\n    const path = typeof parsed.file_path === 'string' && parsed.file_path !== '' ? parsed.file_path : undefined\n    if (path === undefined) return undefined\n    if (name === 'edit') {\n      const oldText = typeof parsed.old_string === 'string' ? parsed.old_string : ''\n      const newText = typeof parsed.new_string === 'string' ? parsed.new_string : ''\n      return { type: 'diff', diffs: [{ path, oldText: oldText === '' ? null : oldText, newText }] }\n    }\n    const newText = typeof parsed.content === 'string' ? parsed.content : ''\n    return { type: 'diff', diffs: [{ path, oldText: null, newText }] }\n  }\n  return undefined\n}\n\n/** The `tool/result` `meta` as an object, or undefined (opaque tool payload). */\nfunction metaObject(data: Record<string, unknown>): Record<string, unknown> | undefined {\n  const meta = data.meta\n  if (meta === null || typeof meta !== 'object' || Array.isArray(meta)) return undefined\n  return meta as Record<string, unknown>\n}\n\n/** Narrow edit/write's contextual-diff meta (`{ diffs: FileDiff[] }`) to\n *  DiffHunk[], declining on any malformed entry. */\nfunction diffCardFromMeta(meta: Record<string, unknown>): SidechatToolCard | undefined {\n  const diffs = meta.diffs\n  if (!Array.isArray(diffs) || diffs.length === 0) return undefined\n  const hunks: DiffHunk[] = []\n  for (const item of diffs) {\n    if (item === null || typeof item !== 'object' || Array.isArray(item)) return undefined\n    const { path, oldText, newText } = item as Record<string, unknown>\n    if (typeof path !== 'string' || typeof newText !== 'string') return undefined\n    if (oldText !== null && typeof oldText !== 'string') return undefined\n    hunks.push({ path, oldText, newText })\n  }\n  return { type: 'diff', diffs: hunks }\n}\n\n/** Narrow read's line-window meta (`{ path, offset, lines, totalLines, lang? }`)\n *  to a read card, enforcing the same semantic contract the host does: 1-based\n *  strictly increasing line numbers that never exceed `totalLines`. */\nfunction readCardFromMeta(meta: Record<string, unknown>): SidechatToolCard | undefined {\n  const { path, offset, lines, totalLines, lang } = meta\n  if (typeof path !== 'string' || typeof offset !== 'number' || typeof totalLines !== 'number') return undefined\n  if (!Number.isInteger(offset) || offset < 1) return undefined\n  if (!Number.isInteger(totalLines) || totalLines < 0) return undefined\n  if (!Array.isArray(lines)) return undefined\n  const narrowed: ReadBlockLine[] = []\n  let previous = offset - 1\n  for (const line of lines) {\n    if (line === null || typeof line !== 'object' || Array.isArray(line)) return undefined\n    const candidate = line as { number?: unknown; text?: unknown }\n    if (typeof candidate.number !== 'number' || !Number.isInteger(candidate.number)) return undefined\n    if (candidate.number <= previous || candidate.number > totalLines) return undefined\n    if (typeof candidate.text !== 'string') return undefined\n    narrowed.push({ number: candidate.number, text: candidate.text })\n    previous = candidate.number\n  }\n  if (lang !== undefined && typeof lang !== 'string') return undefined\n  return { type: 'read', label: path, lines: narrowed, totalLines, ...(lang !== undefined ? { lang } : {}) }\n}\n\n/** The grouped matches of grep's meta (`files: [{ path, matches: [{ lineNumber, line }] }]`),\n *  or undefined when any entry is malformed — the host's own `searchFiles`\n *  narrowing (1-based integer line numbers, string paths/lines). */\nfunction searchFiles(value: unknown): SearchFileGroup[] | undefined {\n  if (!Array.isArray(value)) return undefined\n  const files: SearchFileGroup[] = []\n  for (const entry of value) {\n    if (entry === null || typeof entry !== 'object' || Array.isArray(entry)) return undefined\n    const { path, matches } = entry as Record<string, unknown>\n    if (typeof path !== 'string' || !Array.isArray(matches)) return undefined\n    const narrowed: SearchFileGroup['matches'] = []\n    for (const match of matches) {\n      if (match === null || typeof match !== 'object' || Array.isArray(match)) return undefined\n      const { lineNumber, line } = match as Record<string, unknown>\n      if (typeof lineNumber !== 'number' || !Number.isInteger(lineNumber) || lineNumber < 1) return undefined\n      if (typeof line !== 'string') return undefined\n      narrowed.push({ lineNumber, line })\n    }\n    files.push({ path, matches: narrowed })\n  }\n  return files\n}\n\n/** The cited sources of web_search's meta (`[{ url, title?, snippet?, publishedAt? }]`),\n *  or undefined when any entry is malformed (a URL is required; the three\n *  optional fields must be strings when present). */\nfunction webSources(value: unknown): WebSourceView[] | undefined {\n  if (!Array.isArray(value)) return undefined\n  const sources: WebSourceView[] = []\n  for (const entry of value) {\n    if (entry === null || typeof entry !== 'object' || Array.isArray(entry)) return undefined\n    const { url, title, snippet, publishedAt } = entry as Record<string, unknown>\n    if (typeof url !== 'string') return undefined\n    if (title !== undefined && typeof title !== 'string') return undefined\n    if (snippet !== undefined && typeof snippet !== 'string') return undefined\n    if (publishedAt !== undefined && typeof publishedAt !== 'string') return undefined\n    sources.push({\n      url,\n      ...(title === undefined ? {} : { title }),\n      ...(snippet === undefined ? {} : { snippet }),\n      ...(publishedAt === undefined ? {} : { publishedAt }),\n    })\n  }\n  return sources\n}\n\n/**\n * grep / glob's structured result, narrowed from `tool/result` `meta` alone —\n * never by parsing the result text, and never from the call's arguments (the\n * plugin only draws what the tool itself published). The narrowing is the\n * host's: an exact `shape`, a boolean `truncated`, a non-negative integer\n * `total`, and the shape's own arrays. Anything less keeps the generic row.\n */\nfunction searchCardFromMeta(name: string, meta: Record<string, unknown>): SidechatToolCard | undefined {\n  const { truncated, total, shape } = meta\n  if (typeof truncated !== 'boolean') return undefined\n  if (typeof total !== 'number' || !Number.isInteger(total) || total < 0) return undefined\n  if (name === 'grep') {\n    if (shape !== 'matches') return undefined\n    const files = searchFiles(meta.files)\n    return files === undefined ? undefined : { type: 'search', card: { kind: 'matches', files, truncated, total } }\n  }\n  if (name !== 'glob' || shape !== 'paths' || !Array.isArray(meta.paths)) return undefined\n  if (!meta.paths.every((path): path is string => typeof path === 'string')) return undefined\n  return { type: 'search', card: { kind: 'paths', paths: [...meta.paths], truncated, total } }\n}\n\n/**\n * web_search / web_fetch's structured result, narrowed from `tool/result`\n * `meta` alone (see {@link searchCardFromMeta} for the same rules).\n */\nfunction webCardFromMeta(name: string, meta: Record<string, unknown>): SidechatToolCard | undefined {\n  const { truncated } = meta\n  if (typeof truncated !== 'boolean') return undefined\n  if (name === 'web_search') {\n    const sources = webSources(meta.sources)\n    if (sources === undefined) return undefined\n    if (meta.answer !== undefined && typeof meta.answer !== 'string') return undefined\n    const answer = typeof meta.answer === 'string' ? meta.answer : undefined\n    return { type: 'web', card: { kind: 'search', sources, truncated, ...(answer === undefined ? {} : { answer }) } }\n  }\n  if (name !== 'web_fetch' || typeof meta.url !== 'string') return undefined\n  const { statusCode } = meta\n  if (typeof statusCode !== 'number' || !Number.isInteger(statusCode)) return undefined\n  return { type: 'web', card: { kind: 'fetch', url: meta.url, statusCode, truncated } }\n}\n\n/** The bash result's trailing exit markers (`[exit code: N]` /\n *  `[killed by signal: X]` — the model-facing text the tool appends), stripped\n *  the same way the host's parseExitStatus recovers the exit pill. */\nconst EXIT_SIGNAL_RE = /\\n\\[killed by signal: ([^\\]\\n]+)\\]$/\nconst EXIT_CODE_RE = /\\n\\[exit code: (\\d+)\\]$/\n\n/**\n * Result-time card refinement: `meta`-carrying structure wins (edit/write's\n * applied hunks, read's line window, grep/glob's search card and web_search /\n * web_fetch's web card), bash's output gets its exit marker stripped into the\n * exit pill, and a failed result always falls back to the generic row (the\n * host's isError path renders generic output too).\n */\nfunction resultCard(\n  name: string,\n  previous: SidechatToolCard | undefined,\n  data: Record<string, unknown>,\n  resultText: string,\n): SidechatToolCard | undefined {\n  if (name === 'bash') {\n    if (previous === undefined || previous.type !== 'terminal' || resultText === '') return previous\n    const signal = EXIT_SIGNAL_RE.exec(resultText)\n    if (signal?.[1] !== undefined) {\n      return { ...previous, output: resultText.slice(0, signal.index), exitCode: undefined, signal: signal[1] }\n    }\n    const exit = EXIT_CODE_RE.exec(resultText)\n    if (exit?.[1] !== undefined) {\n      return { ...previous, output: resultText.slice(0, exit.index), exitCode: Number(exit[1]), signal: undefined }\n    }\n    return { ...previous, output: resultText, exitCode: 0, signal: undefined }\n  }\n  const meta = metaObject(data)\n  if (meta === undefined) return previous\n  if (name === 'edit' || name === 'write') return diffCardFromMeta(meta) ?? previous\n  if (name === 'read') return readCardFromMeta(meta)\n  if (name === 'grep' || name === 'glob') return searchCardFromMeta(name, meta) ?? previous\n  if (name === 'web_search' || name === 'web_fetch') return webCardFromMeta(name, meta) ?? previous\n  return previous\n}\n\n/**\n * The human-readable text of one FAILURE reason, or undefined when the reason\n * is not an error. `turn/end` records the failure as `reason.error.message`\n * (the agent loop's own shape); an attempt's terminal `finish` chunk carries\n * the adapter-failure shape `reason.failure.message` (dsh-llm's\n * `adapterFailureChunk`). Neither present falls back to a plain string\n * rendering of the reason, so the row is never blank.\n */\nfunction failureText(reason: unknown): string | undefined {\n  if (reason === null || typeof reason !== 'object' || Array.isArray(reason)) return undefined\n  const record = reason as Record<string, unknown>\n  if (record.kind !== 'error') return undefined\n  for (const candidate of [record.error, record.failure]) {\n    if (candidate === null || typeof candidate !== 'object') continue\n    const message = (candidate as { message?: unknown }).message\n    if (typeof message === 'string' && message !== '') return message\n  }\n  return String(reason)\n}\n\n/**\n * The failure that an `assistant/attempt` carries in its durable stream: the\n * terminal `finish` chunk's `reason`. The record walk mirrors sidechat-core's\n * `streamTexts` (the same compact `AssistantStreamRecord[]` shape), only\n * reading the finish reason instead of the text chunks. Undefined when the\n * attempt ended any other way (`stop`, `max-tokens`, `aborted`, …).\n */\nfunction attemptFailure(stream: unknown): string | undefined {\n  if (!Array.isArray(stream)) return undefined\n  for (const record of stream) {\n    if (record === null || typeof record !== 'object') continue\n    const entry = record as { type?: unknown; chunk?: unknown }\n    if (entry.type !== 'chunk') continue\n    const chunk = entry.chunk as { type?: unknown; reason?: unknown } | undefined\n    if (chunk === null || typeof chunk !== 'object' || chunk.type !== 'finish') continue\n    const text = failureText(chunk.reason)\n    if (text !== undefined) return text\n  }\n  return undefined\n}\n\n/**\n * The TERMINAL state of a turn, or undefined when the reason is a normal finish\n * or a provider error (which gets its own row): `aborted` and `interrupted`\n * both mean \"stopped before it finished\", while `max-tokens` means the model hit\n * the output limit and the answer is cut off.\n */\nfunction terminalReason(reason: unknown): 'aborted' | 'max-tokens' | undefined {\n  if (reason === null || typeof reason !== 'object' || Array.isArray(reason)) return undefined\n  const kind = (reason as { kind?: unknown }).kind\n  if (kind === 'aborted' || kind === 'interrupted') return 'aborted'\n  if (kind === 'max-tokens') return 'max-tokens'\n  return undefined\n}\n\n/**\n * The terminal state an `assistant/attempt` carries in its durable stream: the\n * terminal `finish` chunk's reason (the same record walk as {@link attemptFailure},\n * read for the stop/limit kinds instead of errors). Undefined for every other\n * ending.\n */\nfunction attemptTerminal(stream: unknown): 'aborted' | 'max-tokens' | undefined {\n  if (!Array.isArray(stream)) return undefined\n  for (const record of stream) {\n    if (record === null || typeof record !== 'object') continue\n    const entry = record as { type?: unknown; chunk?: unknown }\n    if (entry.type !== 'chunk') continue\n    const chunk = entry.chunk as { type?: unknown; reason?: unknown } | undefined\n    if (chunk === null || typeof chunk !== 'object' || chunk.type !== 'finish') continue\n    const terminal = terminalReason(chunk.reason)\n    if (terminal !== undefined) return terminal\n  }\n  return undefined\n}\n\n/**\n * Map a thread child's history rows onto compact transcript rows: the\n * inherited fork seed is cut at the last `session/end-seed`, context\n * injections map onto a collapsible injection row, `assistant/live-chunk`\n * deltas accumulate into streaming rows per (turn, step, block) and are\n * superseded by the assembled `assistant/message`, and tool invocations\n * render one expandable line each (arguments, paired result text, failure\n * marker; a still-executing call is marked until its result lands). A failed\n * turn renders exactly one `error` row — the attempt's stream error and the\n * `turn/end` reason are the same failure.\n * @param entries - history rows (event + host-computed view) in seq order,\n *   the live deltas of the in-flight attempt appended after the durable tail.\n * @returns display rows in log order.\n */\nexport function transcriptRows(entries: readonly SidebarHistoryEntry[], prev?: readonly SidechatTranscriptRow[]): SidechatTranscriptRow[] {\n  const events = threadOwnLogEvents(entries.map(entry => entry.event))\n  const rows: SidechatTranscriptRow[] = []\n  /** (turn, step, index, kind) key → index of its accumulating stream row. */\n  const streamRows = new Map<string, number>()\n  /** tool callId → index of its tool row in `rows` (result pairing). */\n  const callRows = new Map<string, number>()\n  /** present callId → its deliverables card: the card row's index plus the\n   *  call's raw arguments (a FAILED result needs them to rebuild the generic\n   *  tool row). A `deliverables/presented` event attaches to this card\n   *  instead of appending a second one, in either arrival order. */\n  const presentCalls = new Map<string, { rowIndex: number; args: string | undefined }>()\n  /** turn → envelope time of its `turn/start` (turn-tail duration basis). */\n  const turnStarts = new Map<number, number>()\n  /** Turns that already rendered a failure row (an attempt error and the\n   *  `turn/end` that follows it are the SAME failure — one row per turn). */\n  const errorTurns = new Set<number>()\n  /** Turns that already rendered a terminal row (same dedupe rule: the attempt's\n   *  stop/limit finish reason and the `turn/end` that repeats it are one turn). */\n  const terminalTurns = new Set<number>()\n  /** turn → usage aggregate: output accumulates across steps, input takes the\n   *  last request's prompt size (earlier steps' input is mostly the same\n   *  context re-sent, so summing would double-count). */\n  const turnUsage = new Map<number, { inputTokens: number; outputTokens: number }>()\n  /** compactionId → the metering facts of its summary event. The checkpoint\n   *  that shadows the range carries only ids: the summary text and the shadow\n   *  price live in the `compaction/summary` logged immediately before it. */\n  const compactionFacts = new Map<string, CompactionFacts>()\n  /** The most recent metering facts (a checkpoint without a compactionId still\n   *  pairs with the event directly before it — the documented adjacency). */\n  let lastCompaction: CompactionFacts | undefined\n  /** retryId → index of its retry row (a chain folds into one row). */\n  const retryRows = new Map<string, number>()\n  /**\n   * Turns whose `turn/end` is in this log. Read UP FRONT (not while rows are\n   * being built) so a work row can carry its turn's settledness at creation:\n   * annotating afterwards would replace row objects on every pull and defeat\n   * the identity pass below.\n   */\n  const endedTurns = new Set<number>()\n  for (const event of events) {\n    if (event.type !== 'turn/end') continue\n    const turn = (event.data as Record<string, unknown>).turn\n    if (typeof turn === 'number' && Number.isInteger(turn)) endedTurns.add(turn)\n  }\n  /** The turn annotations of one row, from its event's `data.turn`. */\n  const turnFields = (turn: unknown): { turn?: number; turnEnded?: boolean } => {\n    if (typeof turn !== 'number' || !Number.isInteger(turn)) return {}\n    return { turn, ...(endedTurns.has(turn) ? { turnEnded: true } : {}) }\n  }\n  for (let index = 0; index < events.length; index++) {\n    const event = events[index]\n    if (event === undefined) continue\n    const data = event.data as Record<string, unknown>\n    switch (event.type) {\n      case 'turn/start': {\n        const turn = data.turn\n        if (typeof turn === 'number' && Number.isInteger(turn)) turnStarts.set(turn, event.time)\n        break\n      }\n      case 'turn/end': {\n        const turn = data.turn\n        if (typeof turn !== 'number' || !Number.isInteger(turn)) break\n        const failure = failureText(data.reason)\n        if (failure !== undefined && !errorTurns.has(turn)) {\n          errorTurns.add(turn)\n          rows.push({ kind: 'error', seq: event.seq, text: failure })\n        }\n        // A stop or an output-limit cut is not an error, but it must not look\n        // like a deliberate finish either: one terminal row per turn.\n        const terminal = terminalReason(data.reason)\n        if (terminal !== undefined && !terminalTurns.has(turn)) {\n          terminalTurns.add(turn)\n          rows.push({ kind: 'terminal', seq: event.seq, reason: terminal })\n        }\n        const start = turnStarts.get(turn)\n        turnStarts.delete(turn)\n        const usage = turnUsage.get(turn)\n        turnUsage.delete(turn)\n        const durationMs = start !== undefined ? Math.max(0, event.time - start) : undefined\n        if (usage === undefined && durationMs === undefined) break\n        rows.push({\n          kind: 'turnSummary',\n          seq: event.seq,\n          turn,\n          ...(usage !== undefined ? { inputTokens: usage.inputTokens, outputTokens: usage.outputTokens } : {}),\n          ...(durationMs !== undefined ? { durationMs } : {}),\n        })\n        break\n      }\n      case 'assistant/attempt': {\n        // A failed attempt settles durably WITHOUT a message: the visible\n        // error row is the finish chunk's reason (the turn/end that follows\n        // repeats the same failure and must not render it twice).\n        const turn = data.turn\n        if (typeof turn !== 'number' || !Number.isInteger(turn)) break\n        if (!errorTurns.has(turn)) {\n          const failure = attemptFailure(data.stream)\n          if (failure !== undefined) {\n            errorTurns.add(turn)\n            rows.push({ kind: 'error', seq: event.seq, text: failure })\n          }\n        }\n        // A stopped / output-limit attempt settles the same way, with the same\n        // \"one row per turn\" rule (the turn/end that follows repeats it).\n        if (!terminalTurns.has(turn)) {\n          const terminal = attemptTerminal(data.stream)\n          if (terminal !== undefined) {\n            terminalTurns.add(turn)\n            rows.push({ kind: 'terminal', seq: event.seq, reason: terminal })\n          }\n        }\n        break\n      }\n      case 'user/message': {\n        const content = Array.isArray(data.content) ? data.content : []\n        const attachments = attachmentsOf(content)\n        const projected = projectSidechatContent(data.content, '\\n\\n')\n        // An attachment-only message is not a \"…\" row: the thumbnail IS its\n        // content (the placeholder exists for a message with nothing to show).\n        const hasVisual = attachments.length > 0 || projected.images !== undefined\n        const text = projected.text === '' ? (hasVisual ? '' : '…') : projected.text\n        // The durable identity the pending-row dedupe keys on (absent on logs\n        // written before the field existed, and on the loose fixtures).\n        const messageId = typeof data.id === 'string' && data.id !== '' ? data.id : undefined\n        // A REPLACEMENT message is not a message: the host draws it as the node\n        // that shadowed a surface range. This must come BEFORE the injection\n        // predicate — a checkpoint's `source.kind` is not 'user', so the\n        // injection branch would swallow the whole compacted summary into a\n        // \"context injected\" row and hide the fact that history was compacted.\n        const surfaceOp = (event as { surfaceOp?: unknown }).surfaceOp\n        if (surfaceOp !== undefined && surfaceOp !== 'append') {\n          const source = data.source as { kind?: unknown; compactionId?: unknown } | undefined\n          if (source?.kind === 'compact-checkpoint') {\n            const id = typeof source.compactionId === 'string' ? source.compactionId : undefined\n            const facts = (id === undefined ? undefined : compactionFacts.get(id)) ?? lastCompaction\n            const summary = facts?.summary ?? null\n            rows.push({\n              kind: 'compaction',\n              seq: event.seq,\n              text: summary ?? '',\n              summary,\n              shadowedItemCount: facts?.shadowedItemCount ?? null,\n              shadowedTokenCount: facts?.shadowedTokenCount ?? null,\n            })\n          }\n          break\n        }\n        // Context injections (the boundary prompt + snapshot, plugin-sourced\n        // context) collapse into an injection row; genuine user messages —\n        // including the FIRST one, which the host now delivers as its own\n        // event — render as user rows.\n        if (isContextInjectionMessage(data)) {\n          const source = data.source as { kind?: unknown } | undefined\n          // Threads logged BEFORE the host split carry boundary(+snapshot)+\n          // question in ONE 'user' message. The boundary prompt is a known\n          // constant, so the message splits THERE: the injection row keeps\n          // the prompt, the remainder (snapshot + question if any — pure\n          // question in the common case) renders as the user's real message.\n          if (source?.kind === 'user' && text.startsWith(`${SIDE_BOUNDARY_PROMPT}\\n\\n`)) {\n            rows.push({ kind: 'injection', seq: event.seq, text: SIDE_BOUNDARY_PROMPT })\n            const body = text.slice(SIDE_BOUNDARY_PROMPT.length + 2)\n            if (body !== '' || attachments.length > 0) {\n              rows.push({\n                kind: 'user',\n                seq: event.seq,\n                text: body,\n                ...(messageId !== undefined ? { messageId } : {}),\n                ...(attachments.length > 0 ? { attachments } : {}),\n              })\n            }\n            break\n          }\n          rows.push({ kind: 'injection', seq: event.seq, text })\n          break\n        }\n        rows.push({\n          kind: 'user',\n          seq: event.seq,\n          ...projected,\n          text,\n          ...(messageId !== undefined ? { messageId } : {}),\n          ...(attachments.length > 0 ? { attachments } : {}),\n        })\n        break\n      }\n      case 'compaction/summary': {\n        // The metering event: it prices the replacement logged right after it.\n        const id = typeof data.compactionId === 'string' ? data.compactionId : undefined\n        const summary = joinedText(Array.isArray(data.summary) ? data.summary : [])\n        const shadowed = data.shadowedSeqs\n        const tokens = data.shadowedTokenCount\n        const facts: CompactionFacts = {\n          summary: summary === '' ? null : summary,\n          shadowedItemCount: Array.isArray(shadowed) ? shadowed.length : null,\n          shadowedTokenCount: typeof tokens === 'number' && Number.isFinite(tokens) ? tokens : null,\n        }\n        if (id !== undefined) compactionFacts.set(id, facts)\n        lastCompaction = facts\n        break\n      }\n      case 'llm/retry': {\n        // One row per retryId (the producer's chain identity), so a chain of\n        // attempts reads as \"retried N times\" instead of N silent gaps.\n        const retryId = data.retryId\n        if (typeof retryId !== 'string' || retryId === '') break\n        const retry = data.retry\n        if (typeof retry !== 'number' || !Number.isInteger(retry) || retry < 1) break\n        const maxRetries = data.maxRetries\n        const delayMs = data.delayMs\n        const provider = data.provider\n        const failureMessage = retryFailureMessage(data.failure)\n        const index = retryRows.get(retryId)\n        const existing = index === undefined ? undefined : rows[index]\n        const update = {\n          retry,\n          state: 'scheduled' as const,\n          ...(typeof maxRetries === 'number' && Number.isInteger(maxRetries) ? { maxRetries } : {}),\n          ...(typeof delayMs === 'number' && Number.isFinite(delayMs) ? { delayMs } : {}),\n          ...(typeof provider === 'string' && provider !== '' ? { provider } : {}),\n          ...(failureMessage === undefined ? {} : { failureMessage }),\n        }\n        if (existing !== undefined && existing.kind === 'retry') {\n          // A further attempt REPLACES the row's facts but keeps the chain's\n          // first seq (the reader sees one row where the chain began).\n          rows[index as number] = { ...existing, ...update }\n          break\n        }\n        retryRows.set(retryId, rows.length)\n        rows.push({ kind: 'retry', seq: event.seq, ...update })\n        break\n      }\n      case 'llm/retry-started': {\n        // The wait ended: the SAME row flips to `started`, no second row.\n        const retryId = data.retryId\n        if (typeof retryId !== 'string' || retryId === '') break\n        const index = retryRows.get(retryId)\n        const row = index === undefined ? undefined : rows[index]\n        if (row !== undefined && row.kind === 'retry') rows[index as number] = { ...row, state: 'started' }\n        break\n      }\n      case 'assistant/live-chunk': {\n        const chunk = data.chunk as { type?: unknown; text?: unknown } | undefined\n        if (chunk === null || typeof chunk !== 'object') break\n        const kind = chunk.type === 'text-delta' ? 'assistant' : chunk.type === 'reasoning-delta' ? 'reasoning' : null\n        if (kind === null || typeof chunk.text !== 'string' || chunk.text === '') break\n        const turn = data.turn\n        const step = data.step\n        const blockIndex = (chunk as { index?: unknown }).index\n        const key = `${String(turn)}:${String(step)}:${String(blockIndex)}:${kind}`\n        const existing = streamRows.get(key)\n        if (existing !== undefined) {\n          const row = rows[existing]\n          if (row !== undefined && row.kind === kind && !row.settled) {\n            rows[existing] = { ...row, text: row.text + chunk.text }\n          }\n        } else {\n          streamRows.set(key, rows.length)\n          rows.push({ kind, seq: event.seq, text: chunk.text, settled: false,\n            ...(typeof blockIndex === 'number' && Number.isSafeInteger(blockIndex) && blockIndex >= 0\n              ? { contentBlockIndex: blockIndex } : {}),\n            ...(kind === 'reasoning' ? turnFields(data.turn) : {}),\n          })\n        }\n        break\n      }\n      case 'assistant/message': {\n        // Turn-tail usage: each assembled message carries its step's token\n        // accounting (absent when the adapter reported none).\n        const usageTurn = data.turn\n        if (typeof usageTurn === 'number' && Number.isInteger(usageTurn)) {\n          const usage = data.usage as { inputTokens?: unknown; outputTokens?: unknown } | undefined\n          const input = typeof usage?.inputTokens === 'number' ? usage.inputTokens : undefined\n          const output = typeof usage?.outputTokens === 'number' ? usage.outputTokens : undefined\n          if (input !== undefined && output !== undefined) {\n            const aggregate = turnUsage.get(usageTurn)\n            if (aggregate === undefined) turnUsage.set(usageTurn, { inputTokens: input, outputTokens: output })\n            else turnUsage.set(usageTurn, { inputTokens: input, outputTokens: aggregate.outputTokens + output })\n          }\n        }\n        const prefix = `${String(data.turn)}:${String(data.step)}:`\n        const streamed = [...streamRows.entries()]\n          .filter(([key]) => key.startsWith(prefix))\n          .map(([, rowIndex]) => rowIndex)\n        for (const key of [...streamRows.keys()]) {\n          if (key.startsWith(prefix)) streamRows.delete(key)\n        }\n        const content = Array.isArray((data.message as { content?: unknown } | undefined)?.content)\n          ? (data.message as { content: readonly unknown[] }).content\n          : []\n        const settled: SidechatTranscriptRow[] = content.flatMap((block, contentBlockIndex): SidechatTranscriptRow[] => {\n          if (block === null || typeof block !== 'object') return []\n          const candidate = block as { type?: unknown; text?: unknown }\n          if (candidate.type === 'reasoning' && typeof candidate.text === 'string' && candidate.text !== '') {\n            return [{\n              kind: 'reasoning',\n              seq: event.seq,\n              text: candidate.text,\n              settled: true,\n              contentBlockIndex,\n              ...turnFields(data.turn),\n            }]\n          }\n          if (candidate.type === 'text' && typeof candidate.text === 'string' && candidate.text !== '') {\n            return [{ kind: 'assistant', seq: event.seq, text: candidate.text, settled: true, contentBlockIndex }]\n          }\n          const attachment = attachmentOf(block)\n          if (attachment !== undefined) {\n            return [{ kind: 'attachment', seq: event.seq, attachment, contentBlockIndex }]\n          }\n          return []\n        })\n        if (streamed.length === 0) rows.push(...settled)\n        else rows.splice(Math.min(...streamed), streamed.length, ...settled)\n        break\n      }\n      case 'tool/call': {\n        const callId = data.callId\n        const name = typeof data.name === 'string' ? data.name : 'tool'\n        const args = typeof data.arguments === 'string' ? data.arguments : undefined\n        // A present call renders as its deliverables card, not a tool row.\n        // Its arguments are the pre-event copy a later deliverables/presented\n        // event refines; when the event already drew the card, keep that card\n        // and record the arguments only for a possible failed result.\n        if (name === 'present') {\n          // Event-first: the deliverables event already drew this call's card\n          // (the event reached the window before the call). The event is\n          // authoritative, so keep its files and only record the arguments a\n          // failed result needs.\n          if (typeof callId === 'string') {\n            const existing = presentCalls.get(callId)\n            if (existing !== undefined) {\n              presentCalls.set(callId, { ...existing, args })\n              break\n            }\n          }\n          const files = presentCallFiles(args)\n          if (files !== undefined) {\n            if (typeof callId === 'string') presentCalls.set(callId, { rowIndex: rows.length, args })\n            rows.push({ kind: 'deliverables', seq: event.seq, ...(typeof callId === 'string' ? { callId } : {}), files })\n            break\n          }\n        }\n        const card = callCard(name, args)\n        const rowIndex = rows.length\n        if (typeof callId === 'string') callRows.set(callId, rowIndex)\n        rows.push({\n          kind: 'tool',\n          seq: event.seq,\n          name,\n          failed: false,\n          args,\n          executing: true,\n          ...(card !== undefined ? { card } : {}),\n          ...turnFields(data.turn),\n        })\n        break\n      }\n      case 'tool/result': {\n        const source = data.message as { source?: { callId?: unknown } } | undefined\n        const callId = typeof source?.source?.callId === 'string' ? source.source.callId : undefined\n        const resultText = resultTextOf(data)\n        // A present call's result is not a row: its deliverables card already\n        // shows what was delivered (and the event supersedes that copy). A\n        // FAILED present delivered nothing, so its card is replaced by the\n        // generic failed tool row the call rendered before the card existed,\n        // and the call stops being associated with a card.\n        const present = callId === undefined ? undefined : presentCalls.get(callId)\n        if (callId !== undefined && present !== undefined) {\n          if (resultFailed(data)) {\n            presentCalls.delete(callId)\n            const card = rows[present.rowIndex]\n            if (card !== undefined && card.kind === 'deliverables') {\n              rows[present.rowIndex] = {\n                kind: 'tool',\n                seq: card.seq,\n                name: 'present',\n                failed: true,\n                ...(present.args !== undefined ? { args: present.args } : {}),\n                ...(resultText !== '' ? { resultText } : {}),\n                executing: false,\n              }\n            }\n          }\n          break\n        }\n        const rowIndex = callId === undefined ? undefined : callRows.get(callId)\n        const failed = resultFailed(data)\n        // A result's own image/file blocks belong to the row whose call\n        // produced them (they render inside its disclosed body).\n        const resultAttachments = resultAttachmentsOf(data)\n        if (rowIndex !== undefined) {\n          const row = rows[rowIndex]\n          if (row !== undefined && row.kind === 'tool') {\n            // Failed results render the generic row (the host's isError path\n            // skips its structured cards too); otherwise the result's own\n            // structure — meta hunks/windows, bash's exit marker — refines or\n            // replaces the call-time literal card.\n            const card = failed ? undefined : resultCard(row.name, row.card, data, resultText)\n            rows[rowIndex] = {\n              ...row,\n              failed: row.failed || failed,\n              resultText: resultText === '' ? row.resultText : resultText,\n              executing: false,\n              ...(card !== undefined ? { card } : { card: undefined }),\n              ...(resultAttachments.length > 0 ? { resultAttachments } : {}),\n            }\n          }\n        } else if (failed || resultText !== '' || resultAttachments.length > 0) {\n          // Orphan result (no call row in the window): surface it so the row\n          // stays informative and expandable.\n          rows.push({\n            kind: 'tool',\n            seq: event.seq,\n            name: callId === undefined ? 'tool' : `tool:${callId.slice(0, 8)}`,\n            failed,\n            resultText: resultText === '' ? undefined : resultText,\n            ...(resultAttachments.length > 0 ? { resultAttachments } : {}),\n          })\n        }\n        break\n      }\n      case 'deliverables/presented': {\n        // The authoritative delivery record (`files[].path` absolute, plus the\n        // model's descriptions). It attaches to its call's card by callId —\n        // one card per call — and stands on its own when the call row is not\n        // in the window (the events route caps the window's head, so this\n        // event can be served without its earlier call).\n        const files = deliverableFiles(data.files)\n        if (files === undefined || files.length === 0) break\n        const callId = typeof data.callId === 'string' ? data.callId : undefined\n        const existing = callId === undefined ? undefined : presentCalls.get(callId)\n        const card = existing === undefined ? undefined : rows[existing.rowIndex]\n        if (existing !== undefined && card !== undefined && card.kind === 'deliverables') {\n          rows[existing.rowIndex] = { ...card, files }\n          break\n        }\n        if (callId !== undefined) presentCalls.set(callId, { rowIndex: rows.length, args: undefined })\n        rows.push({ kind: 'deliverables', seq: event.seq, ...(callId !== undefined ? { callId } : {}), files })\n        break\n      }\n      default: {\n        break\n      }\n    }\n  }\n  return reuseRows(rows, prev)\n}\n\n/** A single assistant event can have multiple text/reasoning blocks. Keep the\n * original block index (including skipped blocks), not a filtered row index. */\nexport function sidechatRowKey(row: SidechatTranscriptRow): string {\n  // Per-content-block rows share their event's seq, so the block index is what\n  // keeps their keys unique (one message may carry several blocks).\n  return row.kind === 'assistant' || row.kind === 'reasoning' || row.kind === 'attachment'\n    ? `${row.kind}:${row.seq}:${row.contentBlockIndex ?? 'unknown'}`\n    : `${row.kind}:${row.seq}`\n}\n\n/** The turn annotation of one row (absent for the kinds that carry none). */\nfunction turnAnnotationOf(row: SidechatTranscriptRow): { turn?: number; turnEnded?: boolean } {\n  return row.kind === 'reasoning' || row.kind === 'tool' ? row : {}\n}\n\n/** Whether two rows carry identical display content (identity fields plus\n *  every rendered field of their kind). */\nfunction rowsEqual(a: SidechatTranscriptRow, b: SidechatTranscriptRow): boolean {\n  if (a.kind !== b.kind || a.seq !== b.seq) return false\n  switch (a.kind) {\n    case 'user': {\n      const other = b as typeof a\n      return a.text === other.text && a.messageId === other.messageId\n        && JSON.stringify(a.images) === JSON.stringify(other.images)\n        && attachmentsEqual(a.attachments, other.attachments)\n    }\n    case 'injection':\n    case 'error': {\n      const other = b as typeof a\n      return a.text === other.text\n    }\n    case 'assistant':\n    case 'reasoning': {\n      const other = b as typeof a\n      // The turn annotation is compared too: `turnEnded` flips when the turn\n      // ends, and a row re-adopted with the old flag would never fold.\n      const left = turnAnnotationOf(a)\n      const right = turnAnnotationOf(b)\n      return a.text === other.text && a.settled === other.settled\n        && a.contentBlockIndex === other.contentBlockIndex\n        && left.turn === right.turn && left.turnEnded === right.turnEnded\n    }\n    case 'tool': {\n      // The card is NOT compared by value: its content is a pure function of\n      // the call-time args and the tool/result landing, and every transition\n      // (output/exit arriving) flips `executing`/`failed`/`resultText` —\n      // compared here — so a card whose content changed never slips through\n      // an equal compare, and an equal compare re-adopting the OLD card\n      // object (identical content, stale reference) only helps React skip.\n      const other = b as typeof a\n      const left = turnAnnotationOf(a)\n      const right = turnAnnotationOf(b)\n      return a.name === other.name && a.failed === other.failed && a.args === other.args\n        && a.resultText === other.resultText && a.executing === other.executing\n        && attachmentsEqual(a.resultAttachments, other.resultAttachments)\n        && left.turn === right.turn && left.turnEnded === right.turnEnded\n    }\n    case 'deliverables': {\n      const other = b as typeof a\n      if (a.callId !== other.callId || a.files.length !== other.files.length) return false\n      return a.files.every((file, index) => {\n        const peer = other.files[index]\n        return peer !== undefined && file.path === peer.path && file.description === peer.description\n      })\n    }\n    case 'turnSummary': {\n      const other = b as typeof a\n      return a.turn === other.turn\n        && a.inputTokens === other.inputTokens && a.outputTokens === other.outputTokens\n        && a.durationMs === other.durationMs\n    }\n    case 'terminal': {\n      const other = b as typeof a\n      return a.reason === other.reason\n    }\n    case 'compaction': {\n      const other = b as typeof a\n      return a.text === other.text && a.summary === other.summary\n        && a.shadowedItemCount === other.shadowedItemCount\n        && a.shadowedTokenCount === other.shadowedTokenCount\n    }\n    case 'retry': {\n      const other = b as typeof a\n      return a.retry === other.retry && a.state === other.state\n        && a.maxRetries === other.maxRetries && a.delayMs === other.delayMs\n        && a.provider === other.provider && a.failureMessage === other.failureMessage\n    }\n    case 'attachment': {\n      const other = b as typeof a\n      return a.contentBlockIndex === other.contentBlockIndex\n        && attachmentsEqual([a.attachment], [other.attachment])\n    }\n  }\n}\n\n/** Re-adopt the PREVIOUS poll's row objects wherever the content is\n *  unchanged (position-aligned, append-mostly): settled rows keep their\n *  object identity across the transcript pulls, so React's reconciler and the\n *  markdown/DOMPurify caches downstream skip them instead of re-rendering\n *  the whole transcript every poll. Comparing the strings is far cheaper\n *  than what a fresh reference costs the row below. Rows past the first\n *  mismatch (an inserted/superseded streaming row) rebuild as usual — that\n *  is exactly the changed tail. */\nfunction reuseRows(rows: SidechatTranscriptRow[], prev: readonly SidechatTranscriptRow[] | undefined): SidechatTranscriptRow[] {\n  if (prev === undefined) return rows\n  const shared = Math.min(rows.length, prev.length)\n  for (let index = 0; index < shared; index++) {\n    const before = prev[index]\n    const after = rows[index]\n    if (before === undefined || after === undefined) continue\n    if (rowsEqual(before, after)) rows[index] = before\n  }\n  return rows\n}\n","/**\n * The anchored-popover CONTENTS of the Tasks page (geometry and dismissal\n * live in AnchoredPopover): the agent node detail with a transcript jump and\n * the workflow run detail with clickable member rows. Both share one grammar:\n * a letter-spaced uppercase head, a [glyph][title] title row, a dt/dd\n * key/value grid, a titled well and one full-width jump action.\n *\n * The two cards are ONE skeleton: the same head band, the same [glyph][title]\n * title row (the card's own host glyph, never a typed character), the same\n * inset list well of 28px rows, and one l1 hairline around whatever closes the\n * card. The only intended difference is where a group header sits: a single\n * list keeps its label fixed above the well, while a multi-phase run scrolls\n * each phase label with its own rows.\n *\n * Every control is a host primitive (`Button` / `StateDot` / `Tag`) — a row\n * that opens something IS a `<button>`, so it is keyboard reachable — and the\n * boxes around them are the page's own module classes (`popCard`, `popRows`,\n * `popList*`). The card is the portal's content root, so it paints the floating\n * surface itself: the popover shell only positions the box it portals.\n *\n * A member row with a child session jumps to that transcript; a member without\n * one (a declaration that never spawned) stays a plain tally line.\n *\n * The team board is NOT here: it is always visible as a strip above the\n * canvas (TeamBoard.tsx).\n */\nimport { useRef, useState, type ReactNode } from 'react'\nimport clsx from 'clsx'\nimport {\n  Button, IconChevronDownOutlineRegular, IconRightUpOutlineRegular, MenuSurface, StateDot, Tag,\n  useDismissOnOutsidePointer,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { SidebarSubagentAddress, SidebarTokenUsage } from '../context-types.ts'\nimport type { TasksAgentNode, TasksWorkflowNode } from './tasks-model.ts'\nimport type { ContextDiagnosticTarget } from './context-diagnostics.ts'\nimport { ContextDiagnosticsButton, diagnosticAddressOf } from './context-diagnostics-ui.tsx'\nimport {\n  activityLine, AgentGlyph, WorkflowGlyph, flatten, modeLabel, nodeDotState, taskDotState,\n  taskStatusLabel, taskTone, workflowStatusKey,\n} from './tasks-shared.tsx'\nimport { elapsedMs, totalTokens } from './session-metrics.ts'\nimport { formatJobDuration } from './subagent-jobs.ts'\nimport { formatTokens } from './sidechat-transcript.ts'\nimport { chatT, t, type CopyKey } from './locales.ts'\nimport css from './tasks-graph.module.css'\n\n/**\n * The usage row's tooltip: the four buckets the host bills separately, in the\n * host's own words (the `chat` namespace's usage dialog). Undefined when that\n * wording is unavailable — an empty `title` would still swallow the hover.\n */\nfunction usageTitle(usage: SidebarTokenUsage): string | undefined {\n  const buckets: [string | undefined, number][] = [\n    [chatT('message.turnUsage.input'), usage.uncachedInputTokens],\n    [chatT('message.turnUsage.cacheRead'), usage.cacheReadTokens],\n    [chatT('message.turnUsage.cacheWrite'), usage.cacheWriteTokens],\n    [chatT('message.turnUsage.output'), usage.outputTokens],\n  ]\n  const parts = buckets\n    .filter(([label]) => label !== undefined)\n    .map(([label, count]) => `${label ?? ''} ${formatTokens(count)}`)\n  return parts.length === 0 ? undefined : parts.join(' · ')\n}\n\n/** The display-state label key. */\nfunction stateKey(state: TasksAgentNode['state']): CopyKey {\n  switch (state) {\n    case 'running': return 'tasksStateRunning'\n    case 'idle': return 'tasksStateIdle'\n    case 'done': return 'tasksStateDone'\n    case 'error': return 'tasksStateError'\n  }\n}\n\n/** The popover's key/value grid. */\nfunction PopRows(props: { children: ReactNode }): ReactNode {\n  return <dl className={css.popRows}>{props.children}</dl>\n}\n\n/** One key/value row of a popover. */\nfunction PopRow(props: { label: string; mono?: boolean; children: ReactNode }): ReactNode {\n  return (\n    <>\n      <dt className={css.popKey}>{props.label}</dt>\n      <dd className={clsx(css.popValue, props.mono === true && css.popValueMono)}>{props.children}</dd>\n    </>\n  )\n}\n\n/** The title row both popovers open with: the card's host glyph, then the name. */\nfunction PopTitleRow(props: { glyph: ReactNode; title: string }): ReactNode {\n  return (\n    <div className={css.popTitleRow}>\n      <span className={css.popGlyph} aria-hidden=\"true\">{props.glyph}</span>\n      <span className={css.popTitle} title={props.title}>{props.title}</span>\n    </div>\n  )\n}\n\n/**\n * The transcript jump, offered the way the host's own subagent list offers it:\n * the primary action opens the child's transcript in the NATIVE right sidebar\n * (the `subagentchat` tab type — the page never re-implements a transcript\n * pane), and the caret beside it opens the main window instead.\n *\n * The ROOT node has no child to embed — it IS the main session — and a host\n * without the `subagentchat` type has no sidebar to open into, so both keep the\n * single button.\n *\n * The optional `children` slot carries the card's OTHER footer control (the\n * diagnostics jump): the two live in one row so the card still has exactly one\n * action band, and the split's own box stays fixed-width beside it.\n */\nfunction JumpActions(props: {\n  node: TasksAgentNode\n  asideAvailable: boolean\n  onJump(node: TasksAgentNode, place: 'right' | 'side' | 'main'): void\n  children?: ReactNode\n}): ReactNode {\n  const { node, asideAvailable, onJump } = props\n  const [open, setOpen] = useState(false)\n  const rootRef = useRef<HTMLSpanElement>(null)\n  useDismissOnOutsidePointer(rootRef, open, setOpen)\n  const split = asideAvailable && node.childAddress !== undefined\n  const primaryPlace = split ? 'right' : 'main'\n  return (\n    <>\n      <Button\n        variant=\"primary\"\n        size=\"sm\"\n        icon={<IconRightUpOutlineRegular size={12} />}\n        onClick={() => { onJump(node, primaryPlace) }}\n      >\n        {t('tasksNodeJump')}\n      </Button>\n      {split && (\n        <span className={css.jumpMore} ref={rootRef}>\n          <Button\n            variant=\"primary\"\n            size=\"sm\"\n            className={css.jumpMoreButton}\n            aria-label={t('tasksNodeOpenMain')}\n            aria-haspopup=\"menu\"\n            aria-expanded={open}\n            title={t('tasksNodeOpenMain')}\n            onClick={() => { setOpen(current => !current) }}\n          >\n            {/*\n              The split's caret, the same split the host's own jump control\n              shows: the glyph names the MENU it opens, never the primary\n              action beside it.\n            */}\n            <IconChevronDownOutlineRegular size={12} />\n          </Button>\n          {open && (\n            <MenuSurface compact className={css.jumpMenu} role=\"menu\">\n              <Button\n                variant=\"ghost\"\n                size=\"sm\"\n                role=\"menuitem\"\n                className={css.jumpMenuItem}\n                onClick={() => {\n                  setOpen(false)\n                  onJump(node, 'side')\n                }}\n              >\n                {t('openFileSide')}\n              </Button>\n              <Button\n                variant=\"ghost\"\n                size=\"sm\"\n                role=\"menuitem\"\n                className={css.jumpMenuItem}\n                onClick={() => {\n                  setOpen(false)\n                  onJump(node, 'main')\n                }}\n              >\n                {t('tasksNodeOpenMain')}\n              </Button>\n            </MenuSurface>\n          )}\n        </span>\n      )}\n      {props.children}\n    </>\n  )\n}\n\n/**\n * The agent node detail popover.\n *\n * The merged activity is a SUBTITLE, not a fact: it sits under the title in\n * the card's smallest voice instead of filling a row of the key/value grid\n * (where the right-aligned value column ellipsised it at 280px and the label\n * \"最近活动\" spent a third of the width saying what the position already says).\n * With no process data at all the block renders nothing — a settled node must\n * never claim to be analysing a request.\n */\nexport function AgentNodePopover(props: {\n  node: TasksAgentNode\n  /**\n   * Whether the host can host a child transcript in its right column. Without\n   * it (no `subagentchat` tab type, no right column) the footer is a single\n   * main-view button — the choice simply does not exist.\n   */\n  asideAvailable: boolean\n  onJump(node: TasksAgentNode, place: 'right' | 'side' | 'main'): void\n  /** Open the shared task window for one of the node's tasks. */\n  onOpenTask(taskId: string, anchor: HTMLElement): void\n  onClose(): void\n}): ReactNode {\n  const { node, onJump, onOpenTask } = props\n  /** The row's mode word; `unknown` claims no mode and this row is omitted. */\n  const nodeMode = modeLabel(node.mode)\n  const liveText = node.live?.text !== undefined ? flatten(node.live.text) : undefined\n  /** Tokens the node's own session was billed for (host projection). */\n  const usage = node.metrics?.usage\n  /**\n   * How long it worked. Read per render on purpose: the page re-reads its live\n   * snapshot every 3s, which is also the cadence at which a running node's open\n   * turn grows (the projection's `through` only moves when an event commits).\n   */\n  const elapsed = elapsedMs(node.metrics?.timing, Date.now())\n  const usageTip = usage === undefined ? undefined : usageTitle(usage)\n  // The merged activity the main conversation would show for this node's\n  // newest range — the host's own wording, in its running or settled form\n  // (see activityLine).\n  const activity = activityLine(node)\n  /**\n   * The diagnostics jump's address: a child node carries the durable\n   * parent/child address its catalog row built, and the ROOT node has none —\n   * it IS the tree's main session — so it is addressed by its own session id.\n   * A node whose address is incomplete (a stale parent, a synthesized member)\n   * yields no diagnostics control; the transcript's original footer gate is\n   * independent of this optional integration.\n   */\n  const diagnosticsAddress = node.parentId === undefined\n    ? undefined\n    : diagnosticAddressOf(node.id, node.childAddress)\n  const diagnosticsUsable = node.parentId === undefined ? true : diagnosticsAddress !== undefined\n  const diagnosticsTarget: ContextDiagnosticTarget | undefined = diagnosticsUsable\n    ? { sessionId: node.id, label: node.label, ...(diagnosticsAddress === undefined ? {} : { address: diagnosticsAddress }) }\n    : undefined\n  return (\n    <div className={css.popCard}>\n      <div className={css.popHead}>\n        <span>{t('tasksNodeDetail')}</span>\n      </div>\n      <PopTitleRow glyph={<AgentGlyph node={node} />} title={node.label} />\n      {(activity !== undefined || liveText !== undefined) && (\n        <div className={css.popActivityBlock} data-node-activity>\n          {activity !== undefined && (\n            <span className={css.popActivity} title={activity}>{activity}</span>\n          )}\n          {liveText !== undefined && (\n            <span className={css.popHint} title={liveText}>{liveText}</span>\n          )}\n        </div>\n      )}\n      <PopRows>\n        <PopRow label={t('tasksNodeState')}>\n          <StateDot state={nodeDotState(node.state)} size={6} /> {t(stateKey(node.state))}\n        </PopRow>\n        {nodeMode !== undefined && (\n          <PopRow label={t('tasksNodeMode')}>{nodeMode}</PopRow>\n        )}\n        {node.team !== undefined && (\n          <PopRow label={t('tasksNodeTeamRole')}>\n            {node.team.role === 'lead' ? 'lead' : node.team.name}\n          </PopRow>\n        )}\n        {/*\n          What the node SPENT and how long it worked: both come from the host's\n          session projections, and either row is omitted when the host published\n          nothing — a \"0 tok / 0s\" line would claim measurements we do not have.\n        */}\n        {usage !== undefined && (\n          <PopRow label={t('tasksNodeTokens')}>\n            <span {...(usageTip === undefined ? {} : { title: usageTip })}>\n              {formatTokens(totalTokens(usage))}\n            </span>\n          </PopRow>\n        )}\n        {elapsed !== undefined && (\n          <PopRow label={t('tasksNodeDuration')}>\n            {formatJobDuration(elapsed, t)}\n          </PopRow>\n        )}\n      </PopRows>\n      {(node.tasks?.length ?? 0) > 0 && (\n        <div className={css.popSection}>\n          <div className={css.popGroup}>{t('tasksNodeTasks')}</div>\n          <div className={css.popList}>\n            {(node.tasks ?? []).map(task => (\n              // The whole row opens the shared task window.\n              <Button\n                key={task.id}\n                variant=\"ghost\"\n                size=\"sm\"\n                className={css.popListRow}\n                title={task.subject}\n                onClick={(event) => { onOpenTask(task.id, event.currentTarget) }}\n              >\n                <StateDot state={taskDotState(task)} size={6} />\n                <span className={css.popListLabel}>{task.subject}</span>\n                <Tag tone={taskTone(task)}>{taskStatusLabel(task)}</Tag>\n              </Button>\n            ))}\n          </div>\n        </div>\n      )}\n      {(node.childAddress !== undefined || node.parentId === undefined) && (\n        <div className={css.popFoot}>\n          <JumpActions\n            node={node}\n            asideAvailable={props.asideAvailable}\n            onJump={onJump}\n          >\n            <ContextDiagnosticsButton kind=\"agent\" target={diagnosticsTarget} iconSize={14} className={css.popActionIcon} onNavigate={props.onClose} />\n          </JumpActions>\n        </div>\n      )}\n    </div>\n  )\n}\n\n/** The workflow run detail popover (phases with clickable member rows). */\nexport function WorkflowNodePopover(props: {\n  node: TasksWorkflowNode\n  onJumpMember(address: SidebarSubagentAddress): void\n}): ReactNode {\n  const { node, onJumpMember } = props\n  const { run } = node\n  /** A member with no outcome yet still runs; only completed/failed settle. */\n  const memberDot = (outcome: string | undefined): 'ongoing' | 'done' | 'error' | 'idle' => {\n    if (outcome === undefined) return 'ongoing'\n    if (outcome === 'completed') return 'done'\n    if (outcome === 'failed') return 'error'\n    return 'idle'\n  }\n  return (\n    <div className={css.popCard}>\n      <div className={css.popHead}>\n        <span>{t('workflowRun')}</span>\n      </div>\n      <PopTitleRow glyph={<WorkflowGlyph />} title={run.name} />\n      <PopRows>\n        <PopRow label={t('tasksNodeState')}>{t(workflowStatusKey(run.status))}</PopRow>\n      </PopRows>\n      {run.phases.length > 0 && (\n        <div className={css.popSection}>\n          <div className={css.popList}>\n            {run.phases.map((phase, phaseIndex) => (\n              <div key={`${phase.title ?? 'phase'}-${phaseIndex}`}>\n                <div className={css.popGroup}>{phase.title ?? t('workflowPhaseUnnamed')}</div>\n                {phase.members.length === 0 && (\n                  <div className={css.popHint}>{t('subagentEmpty')}</div>\n                )}\n                {phase.members.map(member => {\n                  const body = (\n                    <>\n                      <StateDot size={6} state={memberDot(member.outcome)} />\n                      <span className={css.popListLabel}>{member.label}</span>\n                    </>\n                  )\n                  // A member row IS a jump affordance when it has a child\n                  // session (a real button, so it is keyboard reachable);\n                  // without one it stays a plain tally line.\n                  return member.childId === ''\n                    ? (\n                      <div key={member.seq} className={css.popListRow} title={member.label}>{body}</div>\n                    )\n                    : (\n                      <Button\n                        key={member.seq}\n                        variant=\"ghost\"\n                        size=\"sm\"\n                        className={css.popListRow}\n                        title={member.label}\n                        onClick={() => {\n                          onJumpMember({\n                            parentSessionId: run.originSessionId,\n                            childSessionId: member.childId,\n                            mode: 'one-shot',\n                          })\n                        }}\n                      >\n                        {body}\n                      </Button>\n                    )\n                })}\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n    </div>\n  )\n}\n","/**\n * The Agent Teams board — ALWAYS VISIBLE under the page header whenever the\n * tree's root leads a team. Every control is a host primitive (Menu / Pill /\n * Tag / Button / StateDot); the page ships no native form control of its own.\n *\n * Layout: the strip is full width because the native sidebar is narrow — a\n * member row of Pills (also the owner filter), then task rows (subject +\n * owner + status Tag + ONE overflow Menu).\n *\n * Readability: the four blocks (bar / filters / rows / footer) share one 12px\n * gutter and one 6px vertical beat, divided by the 1px l1 rules the stylesheet\n * draws; a row sits on the 28px rhythm and every line that can be ellipsised\n * (subject, owner) carries its full text as `title`.\n *\n * Behaviour: a row and EVERY entry of its menu open the shared task window,\n * which is the ONE surface owning view / edit / create and every CAS mutation\n * — the menu is that window's affordance list hoisted onto the row, not a\n * second mutation path. A conflict therefore still surfaces in the window and\n * re-syncs through the parent's poller.\n */\nimport { useMemo, useRef, useState, type ReactNode } from 'react'\nimport {\n  Button, IconChecklistOutlineRegular, IconCheckOutlineRegular, IconChevronUpOutlineRegular, IconEditOutlineRegular,\n  IconEllipsisOutlineRegular, IconPlusOutlineRegular, IconRefreshOutlineRegular, IconTrashOutlineRegular,\n  IconUserOutlineRegular, Menu, Pill, StateDot, Tag,\n  type MenuEntry,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { SidebarTeamTaskView } from '../context-types.ts'\nimport type { TeamMemberRow } from './team-projection.ts'\nimport { taskDotState, taskStatusLabel, taskTone } from './tasks-shared.tsx'\nimport { t } from './locales.ts'\nimport css from './tasks-graph.module.css'\n\n/**\n * The status dot of one roster row: the member's derived status (see\n * ./team-projection.ts — the session's own run bit).\n */\nfunction memberDotState(status: TeamMemberRow['status']): 'ongoing' | 'idle' {\n  return status === 'running' ? 'ongoing' : 'idle'\n}\n\n/**\n * One task's row menu: the shared task window's own affordance list hoisted\n * onto the row — complete (or reopen, once completed), edit, reassign the\n * owner, delete. Every entry opens that window rather than mutating anything,\n * so the labels mirror the window's actions and the delete stays NEUTRAL: it\n * does not delete, it opens the surface whose own delete is the two-step\n * confirm (a permanently red row would over-signal).\n *\n * The owner submenu lists TEAMMATES only — a shared task is handed to a\n * worker, not back to the lead (the member chips above still list everyone).\n */\nfunction taskMenuItems(\n  task: SidebarTeamTaskView,\n  teammates: readonly TeamMemberRow[],\n): MenuEntry[] {\n  const completed = task.status === 'completed'\n  return [\n    {\n      id: 'state',\n      label: t(completed ? 'teamTaskReopen' : 'teamTaskComplete'),\n      icon: completed ? <IconRefreshOutlineRegular size={14} /> : <IconCheckOutlineRegular size={14} />,\n    },\n    { id: 'edit', label: t('teamTaskEdit'), icon: <IconEditOutlineRegular size={14} /> },\n    {\n      id: 'owner',\n      label: t('teamTaskOwner'),\n      icon: <IconUserOutlineRegular size={14} />,\n      submenu: [\n        { id: 'owner:', label: t('teamTaskUnowned') },\n        ...teammates.map(member => ({ id: `owner:${member.name}`, label: member.name })),\n      ],\n    },\n    { type: 'separator', id: 'team-task-sep' },\n    { id: 'delete', label: t('teamTaskDelete'), icon: <IconTrashOutlineRegular size={14} /> },\n  ]\n}\n\n/**\n * One board row: state dot, subject, owner, status Tag, and the row's overflow\n * Menu.\n *\n * The press target is a real `<button>` covering the row (the whole row opens\n * the shared task window) and the Menu is its SIBLING — a control may not nest\n * inside another, and the trigger is the only part of the row that belongs to\n * the menu. The row node is held in a ref so a menu pick can hand a MOUNTED\n * anchor to the window: the menu list is portaled and unmounts the moment an\n * entry is picked, while the window measures its anchor on mount.\n */\nfunction TeamTaskRow(props: {\n  task: SidebarTeamTaskView\n  teammates: readonly TeamMemberRow[]\n  onOpenTask(task: SidebarTeamTaskView, anchor: HTMLElement): void\n}): ReactNode {\n  const { task, teammates, onOpenTask } = props\n  const [menuOpen, setMenuOpen] = useState(false)\n  /** The row itself: the anchor every window opened from this row shares. */\n  const rowRef = useRef<HTMLDivElement>(null)\n  /** Every entry lands on the same surface (the window owns the actions). */\n  const openWindow = (): void => {\n    const row = rowRef.current\n    if (row !== null) onOpenTask(task, row)\n  }\n\n  return (\n    // The row is a flex line so the trailing Menu can sit beside the press\n    // target (`.teamTaskRow`).\n    <div ref={rowRef} className={css.teamTaskRow}>\n      <Button\n        variant=\"ghost\"\n        size=\"sm\"\n        className={css.teamTask}\n        aria-label={`${t('teamTaskDetail')} ${task.subject}`}\n        title={t('teamTaskDetail')}\n        onClick={(event) => { onOpenTask(task, event.currentTarget) }}\n      >\n        <StateDot size={6} state={taskDotState(task)} />\n        <span className={css.teamTaskSubject} title={task.subject}>{task.subject}</span>\n        {task.ownerName !== undefined && (\n          <span className={css.teamTaskOwner} title={task.ownerName}>{task.ownerName}</span>\n        )}\n        <Tag tone={taskTone(task)}>{taskStatusLabel(task)}</Tag>\n      </Button>\n      <Menu\n        open={menuOpen}\n        onClose={() => { setMenuOpen(false) }}\n        items={taskMenuItems(task, teammates)}\n        onSelect={() => {\n          setMenuOpen(false)\n          openWindow()\n        }}\n        align=\"end\"\n        portal\n        compact\n        anchor={(\n          <Button\n            variant=\"ghost\"\n            size=\"sm\"\n            icon={<IconEllipsisOutlineRegular size={13} />}\n            aria-label={`${t('teamTaskActions')} ${task.subject}`}\n            aria-haspopup=\"menu\"\n            aria-expanded={menuOpen}\n            title={t('teamTaskActions')}\n            onClick={() => { setMenuOpen(current => !current) }}\n          />\n        )}\n      />\n    </div>\n  )\n}\n\nexport interface TeamBoardProps {\n  rootId: string\n  members: readonly TeamMemberRow[]\n  tasks: readonly SidebarTeamTaskView[]\n  /** Open the shared task window (undefined = create) anchored at the click. */\n  onOpenTask(task: SidebarTeamTaskView | undefined, anchor: HTMLElement): void\n  /** The strip's own collapse state (the reader's choice, remembered while mounted). */\n  collapsed: boolean\n  onToggleCollapsed(): void\n}\n\nexport function TeamBoard(props: TeamBoardProps): ReactNode {\n  const { members, tasks, onOpenTask, collapsed, onToggleCollapsed } = props\n  const [ownerFilter, setOwnerFilter] = useState<string | undefined>(undefined)\n\n  const live = useMemo(() => tasks.filter(task => task.status !== 'deleted'), [tasks])\n  const shown = useMemo(\n    () => live.filter(task => ownerFilter === undefined || task.ownerName === ownerFilter),\n    [live, ownerFilter],\n  )\n  const teammates = useMemo(() => members.filter(member => member.role === 'teammate'), [members])\n\n  return (\n    <section className={css.teamBoard} aria-label={t('teamBoard')} data-team-board>\n      <button\n        type=\"button\"\n        className={css.teamBoardBar}\n        aria-expanded={!collapsed}\n        onClick={onToggleCollapsed}\n      >\n        <span className={css.teamBoardIcon} aria-hidden=\"true\"><IconChecklistOutlineRegular size={11} /></span>\n        <span>{t('teamBoard')}</span>\n        <span className={css.teamBoardCount}>\n          {t('teamChip', { members: members.length, tasks: live.length })}\n        </span>\n        <span\n          className={css.teamBoardChev}\n          style={{ display: 'inline-flex', transform: collapsed ? undefined : 'rotate(180deg)' }}\n          aria-hidden=\"true\"\n        >\n          <IconChevronUpOutlineRegular size={12} />\n        </span>\n      </button>\n      {!collapsed && (\n        <>\n          <div className={css.teamMembers}>\n            <Pill\n              active={ownerFilter === undefined}\n              onClick={() => { setOwnerFilter(undefined) }}\n            >\n              {t('teamFilterAll')}\n            </Pill>\n            {members.map(member => (\n              <Pill\n                key={member.id}\n                active={ownerFilter === member.name}\n                title={`${member.name} · ${member.role}`}\n                onClick={() => {\n                  setOwnerFilter(current => (current === member.name ? undefined : member.name))\n                }}\n              >\n                <StateDot size={6} state={memberDotState(member.status)} />\n                <span className={css.teamMemberName}>{member.name}</span>\n              </Pill>\n            ))}\n          </div>\n          <div className={css.teamTasks}>\n            {shown.length === 0 && <div className={css.teamEmpty}>{t('teamTasksEmpty')}</div>}\n            {shown.map(task => (\n              <TeamTaskRow\n                key={task.id}\n                task={task}\n                teammates={teammates}\n                onOpenTask={onOpenTask}\n              />\n            ))}\n          </div>\n          <div className={css.teamActions}>\n            <Button\n              variant=\"outline\"\n              size=\"sm\"\n              icon={<IconPlusOutlineRegular size={13} />}\n              onClick={(event) => { onOpenTask(undefined, event.currentTarget) }}\n            >\n              {t('teamTaskCreate')}\n            </Button>\n          </div>\n        </>\n      )}\n    </section>\n  )\n}\n","/**\n * The ONE task window: view, edit and create all live here, and every task\n * surface (the board's rows, an agent node's task line, the node detail\n * popover) opens THIS component — pointer targets stay thin, the window owns\n * the behaviour.\n *\n * Shape: the plugin's shared {@link FloatingWindow} — a draggable, resizable,\n * body-portaled card with a title bar and a fixed action row, NOT a popover.\n * A task edit is a sustained interaction (a long markdown description), so it\n * gets the same lifecycle a watched job output gets: it survives clicking\n * elsewhere and only the close button or Escape ends it. Details render as\n * multi-line MARKDOWN; 编辑 switches the same window into multi-line editing,\n * and the footer keeps its actions while the body scrolls.\n * Actions: owner reassignment (Pills, CAS-immediate), edit/save, reopen or\n * complete, and a two-step delete.\n *\n * Host primitives everywhere (Button / Input / Pill / Tag / StateDot) plus the\n * plugin's own `MultilineField` (the host set ships no multi-line input) and\n * the shared `MarkdownText` renderer with the plugin's copy labels.\n */\nimport { useEffect, useId, useRef, useState, type ReactNode } from 'react'\nimport clsx from 'clsx'\nimport {\n  Button, IconCheckOutlineRegular, IconEditOutlineRegular,\n  IconRefreshOutlineRegular, IconTrashOutlineRegular, Input, MarkdownDelegateProvider, MarkdownText, Pill, StateDot, Tag,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { Context, SidebarTeamTaskView } from '../context-types.ts'\nimport { api } from './api.ts'\nimport { markdownTextProps } from './markdown-labels.tsx'\nimport { useMarkdownSurface } from './use-markdown-surface.ts'\nimport { FloatingWindow } from './FloatingWindow.tsx'\nimport { taskBlocked, taskDotState, taskStatusLabel, taskTone } from './tasks-shared.tsx'\nimport type { TeamMemberRow } from './team-projection.ts'\nimport { t } from './locales.ts'\nimport css from './tasks-graph.module.css'\n\n/** The wire code of a stale-revision write (see src/team-routes.ts). */\nconst CONFLICT_CODE = 'team-conflict'\n\n/** One mutation outcome: success, or a rejection the window must report. */\ntype MutationOutcome = { ok: true } | { ok: false; code?: string; message: string }\n\n/**\n * The plugin's own multi-line input: the host primitive set ships no\n * textarea, so this is OUR component (token-styled, drag-exempt) and every\n * multi-line edit in the page goes through it.\n */\nexport function MultilineField(props: {\n  value: string\n  label: string\n  placeholder?: string\n  rows?: number\n  onChange?(next: string): void\n}): ReactNode {\n  return (\n    <textarea\n      className={css.taskTextarea}\n      value={props.value}\n      rows={props.rows ?? 7}\n      placeholder={props.placeholder}\n      aria-label={props.label}\n      data-window-no-drag\n      onChange={(event) => { props.onChange?.(event.target.value) }}\n    />\n  )\n}\n\n/** The owner picker (Pills; CAS-immediate, so it is never a draft field). */\nfunction OwnerPicker(props: {\n  members: readonly TeamMemberRow[]\n  owner: string | undefined\n  disabled: boolean\n  onPick(owner: string): void\n}): ReactNode {\n  return (\n    <div className={css.taskOwnerRow} role=\"group\" aria-label={t('teamTaskOwner')}>\n      <Pill\n        className={clsx(css.taskOwnerPill, props.owner === undefined && css.taskOwnerPillActive)}\n        active={props.owner === undefined}\n        disabled={props.disabled}\n        onClick={() => { props.onPick('') }}\n      >\n        {t('teamTaskUnowned')}\n      </Pill>\n      {props.members.map(member => (\n        <Pill\n          key={member.id}\n          className={clsx(css.taskOwnerPill, props.owner === member.name && css.taskOwnerPillActive)}\n          active={props.owner === member.name}\n          disabled={props.disabled}\n          onClick={() => { props.onPick(member.name) }}\n        >\n          {member.name}\n        </Pill>\n      ))}\n    </div>\n  )\n}\n\n/**\n * The read-only body: the owner line and the markdown description. The status\n * and the owner NAME live in the window's own head row (see `TaskWindow`); this\n * body carries the editable owner picker beside the prose it belongs to.\n *\n * The description is a markdown SURFACE like every other one the plugin draws:\n * heading slugs, in-note anchor jumps and `.md` link claiming. It renders no\n * file of its own, so a relative link target resolves against the session cwd\n * (`sessionId` is the team root the window was opened for).\n */\nfunction TaskViewBody(props: {\n  task: SidebarTeamTaskView\n  teammates: readonly TeamMemberRow[]\n  busy: boolean\n  ctx: Context\n  sessionId: string\n  onReassign(owner: string): void\n}): ReactNode {\n  const { task } = props\n  const surface = useMarkdownSurface({ ctx: props.ctx, sessionId: props.sessionId })\n  const body = task.description.trim()\n  return (\n    <>\n      <div className={css.jobPopMeta}>\n        <span className={css.popKey}>{t('teamTaskOwner')}</span>\n        <span className={css.jobPopValue}>{task.ownerName ?? t('teamTaskUnowned')}</span>\n        {task.blockedBy.length > 0 && (\n          <>\n            <span className={css.popKey}>{t('teamTaskBlockedBy')}</span>\n            <span className={css.jobPopValue}>{task.blockedBy.join(' · ')}</span>\n          </>\n        )}\n      </div>\n      <div className={css.taskMarkdown} data-task-description ref={surface.surfaceRef}>\n        {body === ''\n          ? <div className={css.popHint}>{t('teamTaskNoDescription')}</div>\n          : (\n            <MarkdownDelegateProvider openFile={surface.openFile}>\n              <MarkdownText\n                {...markdownTextProps(surface.rewrite(body), {\n                  copyLabel: t('copy'),\n                  copiedLabel: t('copied'),\n                  codeLabel: t('codeBlockTitle'),\n                  wrapLabel: t('codeBlockWrap'),\n                  unwrapLabel: t('codeBlockUnwrap'),\n                })}\n              />\n            </MarkdownDelegateProvider>\n          )}\n      </div>\n      <div className={css.taskField}>\n        <span className={css.taskLabel}>{t('teamTaskOwner')}</span>\n        <OwnerPicker\n          members={props.teammates}\n          owner={task.ownerName}\n          disabled={props.busy}\n          onPick={props.onReassign}\n        />\n      </div>\n    </>\n  )\n}\n\n/**\n * The editing body: subject (host Input) + description (our multi-line field).\n *\n * A BLANK subject is the form's only invalid state. Save stays disabled until\n * it is filled, so the state must also be REPORTED — otherwise clearing the\n * field greys the button with no reason given. The input carries\n * `aria-invalid` and points at the hint below it, which reuses the subject's\n * own placeholder copy (no new i18n key): it reads as the field's rule, and it\n * appears only once the reader has been in the field.\n */\nfunction TaskEditBody(props: {\n  subject: string\n  description: string\n  invalid: boolean\n  onSubject(next: string): void\n  onDescription(next: string): void\n}): ReactNode {\n  const subjectHintId = useId()\n  return (\n    <div className={css.taskForm} data-window-no-drag>\n      <label className={css.taskField}>\n        <span className={css.taskLabel}>{t('teamTaskSubject')}</span>\n        <Input\n          className={css.taskInput}\n          value={props.subject}\n          placeholder={t('teamTaskSubjectPlaceholder')}\n          aria-label={t('teamTaskSubject')}\n          aria-invalid={props.invalid ? true : undefined}\n          aria-describedby={props.invalid ? subjectHintId : undefined}\n          onChange={(event) => { props.onSubject(event.target.value) }}\n        />\n        {props.invalid && (\n          <span id={subjectHintId} className={css.popHint}>\n            {t('teamTaskSubjectPlaceholder')}\n          </span>\n        )}\n      </label>\n      <label className={css.taskField}>\n        <span className={css.taskLabel}>{t('teamTaskDescription')}</span>\n        <MultilineField\n          value={props.description}\n          label={t('teamTaskDescription')}\n          placeholder={t('teamTaskDescriptionPlaceholder')}\n          onChange={props.onDescription}\n        />\n      </label>\n    </div>\n  )\n}\n\nexport interface TaskWindowProps {\n  rootId: string\n  /** The task under view/edit; undefined = create mode. */\n  task: SidebarTeamTaskView | undefined\n  members: readonly TeamMemberRow[]\n  /** Client context: the description's markdown surface opens a claimed `.md`\n   *  link through the plugin's own file path. */\n  ctx: Context\n  /** Where the window first appears (the row that opened it). */\n  anchor?: HTMLElement | null\n  /** Close the window (the caller's popover state). */\n  onClose(): void\n}\n\n/**\n * The ONE task window: the plugin's floating shell wrapping the view/edit body\n * and the action row, so reading, writing and the mutation state all stay in\n * one component.\n */\nexport function TaskWindow(props: TaskWindowProps): ReactNode {\n  const { rootId, task, members, ctx, onClose } = props\n  const creating = task === undefined\n  const [editing, setEditing] = useState(creating)\n  const [subject, setSubject] = useState(task?.subject ?? '')\n  const [description, setDescription] = useState(task?.description ?? '')\n  /** The reader has been in the subject field (see TaskEditBody's contract). */\n  const [subjectTouched, setSubjectTouched] = useState(false)\n  const [busy, setBusy] = useState(false)\n  const [note, setNote] = useState<string | undefined>(undefined)\n  const [armedDelete, setArmedDelete] = useState(false)\n  /** Revision the draft was opened against: the projection keeps delivering\n   *  new revisions while the window stays open, and saving with the live one\n   *  would silently overwrite a teammate's write. */\n  const editRevisionRef = useRef<number | undefined>(task?.revision)\n  /** Render-time mirror of the projection's latest revision: `mutate`'s\n   *  closure captures the `task` of the render that began the save, which can\n   *  be stale by the time a conflict comes back. */\n  const latestRevisionRef = useRef<number | undefined>(task?.revision)\n  latestRevisionRef.current = task?.revision\n  /** The revision a rejected Save submitted. The conflict response carries no\n   *  revision of its own, so when the mirror has not moved past it yet the true\n   *  base is the NEXT revision the projection delivers (see the effect below). */\n  const staleFromRef = useRef<number | undefined>(undefined)\n\n  // Re-seed the draft when the caller swaps the subject task: the projection\n  // hands us fresh revisions, and unsaved text must not leak across tasks.\n  // Keyed by id on purpose — a same-id revision bump must NOT clobber the\n  // reader's in-flight edit (the seed rides a render-time ref so the effect\n  // depends on the id alone).\n  const seedRef = useRef({\n    subject: task?.subject ?? '',\n    description: task?.description ?? '',\n    creating: task === undefined,\n  })\n  seedRef.current = {\n    subject: task?.subject ?? '',\n    description: task?.description ?? '',\n    creating: task === undefined,\n  }\n  useEffect(() => {\n    const seed = seedRef.current\n    setSubject(seed.subject)\n    setDescription(seed.description)\n    setSubjectTouched(false)\n    setEditing(seed.creating)\n    // An armed \"confirm delete\" is the first half of a two-step aimed at THIS\n    // task. Carried into the next one it makes that reader's first click the\n    // delete itself.\n    setArmedDelete(false)\n    // A re-base mark belongs to the task that produced it.\n    staleFromRef.current = undefined\n  }, [task?.id])\n\n  // A rejected Save re-bases only once the projection actually overtakes the\n  // revision that was submitted: re-basing to the render-time mirror while it\n  // still shows that same revision would just hand the stale value back and\n  // make the next Save conflict again.\n  useEffect(() => {\n    const staleFrom = staleFromRef.current\n    if (staleFrom === undefined || task?.revision === undefined || task.revision <= staleFrom) return\n    editRevisionRef.current = task.revision\n    staleFromRef.current = undefined\n  }, [task?.revision])\n\n  const teammates = members.filter(member => member.role === 'teammate')\n\n  /** Run one CAS mutation with the shared busy/conflict handling. */\n  const mutate = async (\n    action: () => Promise<MutationOutcome>,\n    options: { close?: boolean } = {},\n  ): Promise<void> => {\n    if (busy) return\n    setBusy(true)\n    setNote(undefined)\n    try {\n      const result = await action()\n      if (result.ok) {\n        if (options.close === true) onClose()\n        else setEditing(false)\n        // No refresh call: the board is read off the Lead Session's\n        // projection, so a committed revision lands in this window's props\n        // by itself.\n      } else {\n        if (result.code === CONFLICT_CODE) {\n          // A stale write is rejected WITHOUT advancing the revision. Use the\n          // mirror once it has overtaken the rejected one; until then the effect\n          // above takes the projection's next revision. The note, the draft and\n          // editing stay put (exiting would lose the draft), and the next Save\n          // submits against the new base — an explicit \"overwrite anyway\".\n          const submitted = editRevisionRef.current ?? task?.revision\n          const latest = latestRevisionRef.current\n          if (submitted !== undefined) {\n            if (latest !== undefined && latest > submitted) editRevisionRef.current = latest\n            else staleFromRef.current = submitted\n          }\n        }\n        setNote(result.code === CONFLICT_CODE\n          ? t('teamTaskConflict')\n          : t('teamTaskError', { message: result.message }))\n      }\n    } catch (error) {\n      // `writeTask` turns every WIRE failure into a result above; this arm is\n      // for a programming error or a caller bug, which must not turn into an\n      // unhandled rejection inside a click handler.\n      setNote(t('teamTaskError', { message: error instanceof Error ? error.message : String(error) }))\n    } finally {\n      setBusy(false)\n    }\n  }\n\n  /** Save the draft (create closes the window; edit returns to the view). */\n  const save = (): void => {\n    const nextSubject = subject.trim()\n    if (nextSubject === '') return\n    void mutate(() => (creating\n      ? api.teamsTaskCreate(rootId, { subject: nextSubject, description: description.trim() })\n      : api.teamsTaskUpdate(rootId, {\n        taskId: task.id,\n        expectedRevision: editRevisionRef.current ?? task.revision,\n        action: 'edit',\n        subject: nextSubject,\n        description: description.trim(),\n      })), { close: creating })\n  }\n\n  /** Reassign the task (or return it to the unowned pool). */\n  const reassign = (owner: string): void => {\n    if (task === undefined || busy) return\n    void mutate(() => api.teamsTaskUpdate(rootId, {\n      taskId: task.id,\n      expectedRevision: task.revision,\n      action: 'reassign',\n      ...(owner === '' ? {} : { owner }),\n    }))\n  }\n\n  return (\n    <FloatingWindow\n      title={creating ? t('taskWindowCreate') : t('taskWindowDetail')}\n      onClose={onClose}\n      initialSize={{ width: 460, height: 360 }}\n      minSize={{ width: 320, height: 240 }}\n      anchor={props.anchor}\n      // The description (or the editor) owns the window's slack: enlarging it\n      // gives the CONTENT more room instead of leaving a gap under it.\n      bodyLayout=\"fill\"\n      footer={(\n        // The action row is the shell's FOOTER, so it never scrolls away from\n        // the body it acts on. One state owner: `busy` and `armedDelete` are\n        // the mutation state above, not a second copy.\n        <div className={css.jobPopActions}>\n          {editing\n            ? (\n              <>\n                <Button\n                  variant=\"primary\"\n                  size=\"sm\"\n                  icon={<IconCheckOutlineRegular size={12} />}\n                  disabled={busy || subject.trim() === ''}\n                  onClick={save}\n                >\n                  {creating ? t('teamTaskCreate') : t('teamTaskSave')}\n                </Button>\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  disabled={busy}\n                  onClick={() => {\n                    if (creating) onClose()\n                    else if (task !== undefined) {\n                      setSubject(task.subject)\n                      setDescription(task.description)\n                      setSubjectTouched(false)\n                      setEditing(false)\n                    }\n                  }}\n                >\n                  {t('teamTaskCancel')}\n                </Button>\n              </>\n            )\n            : task === undefined ? null : (\n              <>\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  icon={<IconEditOutlineRegular size={12} />}\n                  onClick={() => {\n                    // Draft and CAS base from the same read (see editRevisionRef),\n                    // so a pending conflict re-base has nothing left to correct.\n                    editRevisionRef.current = task.revision\n                    staleFromRef.current = undefined\n                    setSubject(task.subject)\n                    setDescription(task.description)\n                    setSubjectTouched(false)\n                    setEditing(true)\n                  }}\n                >\n                  {t('teamTaskEdit')}\n                </Button>\n                {/*\n                  The board's state machine, in the window: pending → claim →\n                  in_progress → complete → completed → reopen. 0.1.7's service\n                  REJECTS `complete` on a queued task (\"only an in-progress\n                  task can complete\"), so the primary action has to follow the\n                  transition rather than promise one that cannot happen. One\n                  primary per window: it is the affirmative change, so 编辑\n                  stays a plain outline and 删除 keeps the danger ink.\n                */}\n                {task.status === 'completed'\n                  ? (\n                    <Button\n                      variant=\"primary\"\n                      size=\"sm\"\n                      icon={<IconRefreshOutlineRegular size={12} />}\n                      disabled={busy}\n                      onClick={() => void mutate(() => api.teamsTaskUpdate(rootId, {\n                        taskId: task.id, expectedRevision: task.revision, action: 'reopen',\n                      }))}\n                    >\n                      {t('teamTaskReopen')}\n                    </Button>\n                  )\n                  : task.status === 'pending'\n                    ? (\n                      <Button\n                        variant=\"primary\"\n                        size=\"sm\"\n                        icon={<IconCheckOutlineRegular size={12} />}\n                        // Claiming is refused while a blocker is open\n                        // (`TEAM_TASK_BLOCKED`); the Tag beside the subject\n                        // already says why, so the button just says \"not yet\".\n                        disabled={busy || taskBlocked(task)}\n                        title={taskBlocked(task) ? t('teamTaskBlocked') : undefined}\n                        onClick={() => void mutate(() => api.teamsTaskUpdate(rootId, {\n                          taskId: task.id, expectedRevision: task.revision, action: 'claim',\n                        }))}\n                      >\n                        {t('teamTaskClaim')}\n                      </Button>\n                    )\n                    : (\n                      <Button\n                        variant=\"primary\"\n                        size=\"sm\"\n                        icon={<IconCheckOutlineRegular size={12} />}\n                        disabled={busy}\n                        onClick={() => void mutate(() => api.teamsTaskUpdate(rootId, {\n                          taskId: task.id, expectedRevision: task.revision, action: 'complete',\n                        }))}\n                      >\n                        {t('teamTaskComplete')}\n                      </Button>\n                    )}\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  className={clsx(css.taskDanger, armedDelete && css.taskDangerArmed)}\n                  icon={<IconTrashOutlineRegular size={12} />}\n                  disabled={busy}\n                  onClick={() => {\n                    if (!armedDelete) { setArmedDelete(true); return }\n                    setArmedDelete(false)\n                    void mutate(() => api.teamsTaskUpdate(rootId, {\n                      taskId: task.id, expectedRevision: task.revision, action: 'delete',\n                    }), { close: true })\n                  }}\n                >\n                  {armedDelete ? t('teamTaskDeleteConfirm') : t('teamTaskDelete')}\n                </Button>\n              </>\n            )}\n        </div>\n      )}\n    >\n      <div className={css.taskBody}>\n      <div className={css.taskHeadRow}>\n        {task !== undefined && <StateDot size={6} state={taskDotState(task)} />}\n        <span className={css.popTitle} title={task?.subject ?? subject}>\n          {task === undefined ? t('taskWindowCreate') : task.subject}\n        </span>\n        {task !== undefined && (\n          <Tag tone={taskTone(task)}>{taskStatusLabel(task)}</Tag>\n        )}\n      </div>\n\n      {editing || task === undefined\n        ? (\n          <TaskEditBody\n            subject={subject}\n            description={description}\n            invalid={subjectTouched && subject.trim() === ''}\n            onSubject={(next) => { setSubjectTouched(true); setSubject(next) }}\n            onDescription={setDescription}\n          />\n        )\n        : (\n          <TaskViewBody\n            task={task}\n            teammates={teammates}\n            busy={busy}\n            ctx={ctx}\n            sessionId={rootId}\n            onReassign={reassign}\n          />\n        )}\n\n      {note !== undefined && <div className={css.teamNote}>{note}</div>}\n      </div>\n    </FloatingWindow>\n  )\n}\n","import { nativeSessionTarget } from './session-target.ts'\n/**\n * Tasks page (task management): the FULL agent topology of the current\n * tree's main session, rendered in the user-approved postmodern style as a\n * workflow GRAPH canvas (default) or the classic indentation TREE — one\n * unified model (tasks-model.ts) feeds both, so the fold state and the\n * bottom-right view toggle never diverge.\n *\n * Beyond the topology this page now folds in:\n * - WORKFLOW RUNS: the host folds `tool-workflow/*` session events of the\n *   whole tree (workflows.list); a run hangs under its origin agent with its\n *   member agents re-parented below it and phase frames behind them;\n * - AGENT TEAMS (experimental host layer): when the root leads a team, its\n *   `agentTeam` Session projection feeds the always-visible team strip and\n *   enriches the matching nodes; the projection is absent without the layer,\n *   so the whole surface hides itself with no banner and no polling;\n * - BACKGROUND JOBS: a bottom drawer replaces the old in-page section and\n *   auto-collapses once the tree has many agents; job output opens as a\n *   persistent floating window (the host's own client jobs service — never\n *   the model's cursor).\n *\n * Node click jumps straight into the transcript (root → main session); the\n * ⓘ button opens the detail popover. Completed leaf agents fold into one\n * aggregate node per GROUP (finished work / waiting members); clicking an\n * aggregate reveals THAT group, while the control cluster's switch keeps the\n * page-level expand/collapse.\n *\n * The shell itself is the page's own module stylesheet plus host primitives:\n * the header's refresh and the failure banner's retry are host `Button`s, the\n * descendant count is mono micro-type, and the canvas / tree / board / drawer\n * own their own chrome.\n */\nimport { useCallback, useEffect, useMemo, useRef, useState, type ReactNode } from 'react'\nimport { useSyncExternalStore } from 'react'\nimport {\n  Button, IconRefreshOutlineRegular,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type {\n  Context,\n  SidebarClientJobsService,\n  SidebarObservedJob,\n  SidebarChildLiveView,\n  SidebarSessionList,\n  SidebarSubagentAddress,\n} from '../context-types.ts'\nimport {\n  countSubagentDescendants,\n  isSideThreadSummary,\n  rootAncestor,\n} from './subagent-detect.ts'\nimport { subagentCatalogs } from './subagent-catalog.ts'\nimport { sessionMetrics } from './session-metrics.ts'\nimport { hasTranscriptAside, openTranscriptAside } from './subagent-chat.ts'\nimport { teamMembersOf, teamProjectionOf } from './team-projection.ts'\nimport { treeSessionIds } from './subagent-lineage.ts'\nimport { orderJobs, type TreeJob } from './subagent-jobs.ts'\nimport { api } from './api.ts'\nimport { usePolling } from './use-polling.ts'\nimport { useNarrowViewport } from './breakpoints.ts'\nimport {\n  clientJobs, collectRows, useJobObservation, useJobWatchers, useJobsSnapshot,\n} from './jobs-client.ts'\nimport { t } from './locales.ts'\nimport { diagnosticAddressOf } from './context-diagnostics-ui.tsx'\nimport type { ContextDiagnosticTarget } from './context-diagnostics.ts'\nimport { buildTasksModel, type TasksAgentNode, type TasksFoldNode, type TasksWorkflowNode } from './tasks-model.ts'\nimport { TasksGraph } from './TasksGraph.tsx'\nimport { TasksTree } from './TasksTree.tsx'\nimport { JobsDrawer, JobOutputWindow } from './JobsDrawer.tsx'\nimport { AnchoredPopover } from './AnchoredPopover.tsx'\nimport { AgentNodePopover, WorkflowNodePopover } from './TasksPopovers.tsx'\nimport { TeamBoard } from './TeamBoard.tsx'\nimport { TaskWindow } from './TaskWindow.tsx'\nimport type { SidebarStore } from './state.ts'\nimport type { WorkflowRunView } from '../workflow-runs.ts'\nimport type { ProcessActivitySummary } from '../process-activity.ts'\nimport { SIDEBAR_PREFS_DEFAULTS } from '../prefs-shared.ts'\nimport legacy from './SubagentView.module.css'\n\n/** Poll cadence of the live \"last text + tool call\" lines while a child runs. */\nconst POLL_MS = 3000\n/** Poll cadence of the workflow-run and team views while the page is visible. */\nconst TELEMETRY_POLL_MS = 5000\n\n/** The empty live map / run list: ONE identity, so a reset that changes\n *  nothing (or a poll that returns nothing) never re-renders the page. */\nconst NO_LIVE: Readonly<Record<string, SidebarChildLiveView>> = {}\nconst NO_RUNS: readonly WorkflowRunView[] = []\n\n/**\n * Whether two activity summaries say the same thing. Every field the cards\n * read is compared — the activity line (`running`, `preparing`,\n * `runningDetail`) and the settled tally (`counts`) — and nothing else, so a\n * re-serialized but equal summary is not a change.\n */\nfunction sameSummary(left: ProcessActivitySummary | undefined, right: ProcessActivitySummary | undefined): boolean {\n  if (left === right) return true\n  if (left === undefined || right === undefined) return false\n  if (left.running !== right.running || left.preparing !== right.preparing\n    || left.runningDetail !== right.runningDetail || left.counts.length !== right.counts.length) return false\n  return left.counts.every((entry, index) => {\n    const other = right.counts[index]!\n    return entry.kind === other.kind && entry.count === other.count\n  })\n}\n\n/** Whether two children's live views say the same thing (see the card render\n *  sites for the fields: the running flag, the detail text, the summary). */\nfunction sameLiveView(left: SidebarChildLiveView | undefined, right: SidebarChildLiveView | undefined): boolean {\n  if (left === right) return true\n  if (left === undefined || right === undefined) return false\n  return left.running === right.running && left.text === right.text\n    && left.lastEventTime === right.lastEventTime && sameSummary(left.summary, right.summary)\n}\n\n/**\n * Whether two `subagents.live` answers are the same map. The route answers with\n * a FRESH object graph on every tick; publishing it unconditionally re-derived\n * the whole agent tree and the graph layout every 3 s although nothing had\n * changed.\n */\nfunction sameLive(\n  left: Readonly<Record<string, SidebarChildLiveView>>,\n  right: Readonly<Record<string, SidebarChildLiveView>>,\n): boolean {\n  if (left === right) return true\n  const keys = Object.keys(left)\n  if (keys.length !== Object.keys(right).length) return false\n  return keys.every(key => Object.prototype.hasOwnProperty.call(right, key) && sameLiveView(left[key], right[key]))\n}\n\n/** Whether two workflow-run answers are the same list (runs → phases →\n *  members, field by field). */\nfunction sameRuns(left: readonly WorkflowRunView[], right: readonly WorkflowRunView[]): boolean {\n  if (left === right) return true\n  if (left.length !== right.length) return false\n  return left.every((run, index) => {\n    const other = right[index]!\n    if (run.runId !== other.runId || run.name !== other.name\n      || run.originSessionId !== other.originSessionId || run.status !== other.status\n      || run.stopReason !== other.stopReason || run.startedSeq !== other.startedSeq\n      || run.startedAt !== other.startedAt || run.finishedAt !== other.finishedAt\n      || run.phases.length !== other.phases.length) return false\n    return run.phases.every((phase, phaseIndex) => {\n      const peer = other.phases[phaseIndex]!\n      if (phase.title !== peer.title || phase.members.length !== peer.members.length) return false\n      return phase.members.every((member, memberIndex) => {\n        const mate = peer.members[memberIndex]!\n        return member.seq === mate.seq && member.label === mate.label && member.phase === mate.phase\n          && member.childId === mate.childId && member.outcome === mate.outcome\n      })\n    })\n  })\n}\n\n/** The per-parent catalog refresh across the two DSH generations. */\ninterface CatalogRefreshFace {\n  refreshProjections?(sessionId: string): Promise<void>\n  refreshSubagents?(sessionId: string): Promise<void>\n}\n\n/**\n * One shared live-preview poller for the whole tree. At most ONE\n * `subagents.live` request in flight (self-scheduling); a response settling\n * after the poller stopped is dropped via the aborted signal.\n */\nfunction useSubagentLive(\n  rootId: string | undefined,\n  active: boolean,\n): Readonly<Record<string, SidebarChildLiveView>> {\n  const [live, setLive] = useState<Readonly<Record<string, SidebarChildLiveView>>>(NO_LIVE)\n  /**\n   * What has been PUBLISHED. An equal answer must not reach React at all: even\n   * handing `setLive` an updater that returns the previous state lets React\n   * render the component once (\"React may still need to render that specific\n   * component again before bailing out\"), and one render re-derives the whole\n   * tasks model and the graph layout hanging off it.\n   */\n  const published = useRef<Readonly<Record<string, SidebarChildLiveView>>>(NO_LIVE)\n\n  // A new tree must never inherit another root's live previews.\n  useEffect(() => {\n    published.current = NO_LIVE\n    setLive(current => (Object.keys(current).length === 0 ? current : NO_LIVE))\n  }, [rootId])\n\n  const poll = useCallback(async (signal: AbortSignal): Promise<void> => {\n    if (rootId === undefined) return\n    const result = await api.subagentsLive(rootId, signal)\n    if (signal.aborted) return\n    // The route answers with FRESH objects every tick; publishing them as-is\n    // re-derived the agent tree (and the graph layout) every 3 s although\n    // nothing had changed.\n    if (sameLive(published.current, result.live)) return\n    published.current = result.live\n    setLive(current => (sameLive(current, result.live) ? current : result.live))\n  }, [rootId])\n  usePolling(rootId !== undefined && active, poll, {\n    intervalMs: POLL_MS,\n    mode: 'self-scheduling',\n    immediate: true,\n  })\n\n  return live\n}\n\n/** The folded workflow runs of the tree (poll-driven; empty when none). */\nfunction useWorkflowRuns(rootId: string | undefined, active: boolean): readonly WorkflowRunView[] {\n  const [runs, setRuns] = useState<readonly WorkflowRunView[]>(NO_RUNS)\n  const published = useRef<readonly WorkflowRunView[]>(NO_RUNS)\n  useEffect(() => {\n    published.current = NO_RUNS\n    setRuns(current => (current.length === 0 ? current : NO_RUNS))\n  }, [rootId])\n  const poll = useCallback(async (signal: AbortSignal): Promise<void> => {\n    if (rootId === undefined) return\n    const result = await api.workflowsList(rootId, signal)\n    if (signal.aborted) return\n    // Same identity rule as the live map: the run list is a model dependency,\n    // so an equal answer (the common case — a run's phases only move when an\n    // event commits) must publish nothing.\n    if (sameRuns(published.current, result.runs)) return\n    published.current = result.runs\n    setRuns(current => (sameRuns(current, result.runs) ? current : result.runs))\n  }, [rootId])\n  usePolling(rootId !== undefined && active, poll, {\n    intervalMs: TELEMETRY_POLL_MS,\n    mode: 'self-scheduling',\n    immediate: true,\n  })\n  return runs\n}\n\n/**\n * The tree's background jobs, read through the HOST's client jobs service\n * (`ctx.jobs` — see jobs-client.ts). Watching is per tree session (the host\n * shares one stream between watchers) and only while the page is on screen;\n * a deployment without the service renders no jobs surface at all.\n */\nfunction useTreeJobs(\n  ctx: Context,\n  byId: SidebarSessionList['byId'],\n  rootId: string | undefined,\n  active: boolean,\n): {\n  rows: TreeJob[]\n  jobs: SidebarClientJobsService | undefined\n  /** The observed output per job id (the panel picks its own entry). */\n  observed: Readonly<Record<string, SidebarObservedJob | undefined>>\n} {\n  const jobs = useMemo(() => clientJobs(ctx), [ctx])\n  const snapshot = useJobsSnapshot(jobs)\n  const treeIds = useMemo(\n    () => (rootId === undefined ? [] : [...treeSessionIds(byId, rootId)]),\n    [byId, rootId],\n  )\n  useJobWatchers(jobs, treeIds, active)\n  const rows = useMemo(\n    () => (rootId === undefined ? [] : orderJobs(collectRows(snapshot, byId, new Set(treeIds)))),\n    [snapshot, byId, rootId, treeIds],\n  )\n  return { rows, jobs, observed: snapshot.observed }\n}\n\n/** The open popover of the page (one at a time, anchored). */\ntype PagePopover =\n  | { kind: 'node'; nodeId: string; anchor: HTMLElement }\n  | { kind: 'workflow'; nodeId: string; anchor: HTMLElement }\n  | { kind: 'job'; jobId: string; anchor: HTMLElement }\n  /** The shared task window; taskId undefined = create mode. */\n  | { kind: 'task'; taskId: string | undefined; anchor: HTMLElement }\n\n/**\n * The sidebar's Tasks page.\n * @param props - current session id, visibility, the client context, the\n *   shared store (the prefs drive the default view mode), and the optional\n *   jump-notify hook fired right before `openSubagent`.\n */\nexport function SubagentView(props: {\n  sessionId: string\n  active: boolean\n  ctx: Context\n  store?: SidebarStore\n  onOpenChild?: (address: SidebarSubagentAddress) => void\n}): ReactNode {\n  const { sessionId, active, ctx, store, onOpenChild } = props\n  const sessions = ctx.sessions\n\n  // The same list feed the official catalog consumes. DSH 0.1.7 publishes the\n  // host-computed `subagentCatalog` projection per session and loads every\n  // session's projections once per connection, so there is no observe/refresh\n  // handshake left to run — the page is a pure reader of the snapshot. A host\n  // without the projection store leaves these surfaces empty and the page\n  // degrades to its empty state.\n  const list = useSyncExternalStore(\n    useMemo(() => (callback: () => void) => sessions.list.subscribe(callback), [sessions]),\n    useCallback(() => sessions.list.getSnapshot(), [sessions]),\n  )\n  const byId = list.byId\n  // The projected per-parent catalogs, already folded into the view shape the\n  // topology consumes (see subagent-catalog.ts).\n  const catalogs = useMemo(() => subagentCatalogs(list.projectionsBySession), [list.projectionsBySession])\n  // Token usage and turn timing ride the same snapshot: the popover's two\n  // extra facts are read here, not fetched (see ./session-metrics.ts).\n  const metrics = useMemo(() => sessionMetrics(list.projectionsBySession), [list.projectionsBySession])\n\n  // The topology root: the main agent of the current session's tree.\n  const rootId = useMemo(() => rootAncestor(byId, sessionId), [byId, sessionId])\n  const rootSummary = rootId === undefined ? undefined : byId[rootId]\n  const live = useSubagentLive(rootId, active)\n  const runs = useWorkflowRuns(rootId, active)\n  // The root-led team, straight off the SAME snapshot the catalogs come from\n  // (see team-projection.ts): undefined = no team here (no experimental layer,\n  // or the root is not a Lead), which is exactly the \"hide the strip\" state.\n  const team = useMemo(\n    () => teamProjectionOf(list.projectionsBySession, rootId),\n    [list.projectionsBySession, rootId],\n  )\n  const teamMembers = useMemo(\n    // A team member IS a direct subagent of the Lead, so the roster comes from\n    // the same catalog rows the topology below already draws.\n    () => teamMembersOf(\n      team,\n      rootId,\n      rootId === undefined ? [] : catalogs[rootId]?.entries ?? [],\n      live,\n      byId,\n    ),\n    [team, rootId, catalogs, live, byId],\n  )\n\n  // The default view mode comes from the side card prefs (settings select);\n  // the in-page toggle overrides it ephemerally. On a NARROW viewport the\n  // `mobileDefaultTree` preference swaps that default to the classic tree —\n  // only the default: the toggle below still flips this session's page.\n  const narrow = useNarrowViewport()\n  // getPrefs() returns a copy; the snapshot's prefs keep their identity until\n  // setPrefs(), so unrelated sidebar updates do not re-render this page.\n  const prefs = useSyncExternalStore(\n    useMemo(() => (callback: () => void) => store?.subscribe(callback) ?? (() => {}), [store]),\n    useCallback(() => store?.getSnapshot().prefs ?? SIDEBAR_PREFS_DEFAULTS, [store]),\n  )\n  const prefsMode = narrow && prefs.mobileDefaultTree ? 'tree' : prefs.tasksViewMode\n  const [modeOverride, setModeOverride] = useState<'graph' | 'tree' | undefined>(undefined)\n  const mode = modeOverride ?? prefsMode\n\n  const [foldOverride, setFoldOverride] = useState<boolean | undefined>(undefined)\n  const autoFoldSettled = foldOverride ?? prefs.tasksAutoFoldSettled\n  const autoFoldBranches = foldOverride ?? prefs.tasksAutoFoldBranches\n  const autoFoldIdle = foldOverride ?? prefs.tasksAutoFoldIdle\n  const folded = autoFoldSettled || autoFoldBranches || autoFoldIdle\n  /**\n   * Nodes the reader folded by hand from their own card bar. Kept apart from\n   * `folded` (the global rule) so the control cluster and a single card never\n   * fight.\n   */\n  const [foldedIds, setFoldedIds] = useState<ReadonlySet<string>>(() => new Set())\n  /**\n   * The fold GROUPS the reader opened by clicking one aggregate card. Expanding\n   * an aggregate reveals that group ONLY — it used to clear the manual folds and\n   * switch the global rule off, so one click unfolded the whole page. The\n   * control cluster keeps the page-level expand/collapse; collapsing there drops\n   * these per-group openings (a global collapse must really collapse).\n   */\n  const [expandedGroups, setExpandedGroups] = useState<ReadonlySet<string>>(() => new Set())\n  const [teamBoardCollapsed, setTeamBoardCollapsed] = useState(false)\n  /**\n   * Tree-mode SUBTREE disclosure: rows whose children the reader folded away.\n   * Kept here (not inside TasksTree) so switching modes and coming back keeps\n   * the shape the reader left, and cleared by 全部展开.\n   */\n  const [collapsedIds, setCollapsedIds] = useState<ReadonlySet<string>>(() => new Set())\n  const [popover, setPopover] = useState<PagePopover | null>(null)\n\n  const model = useMemo(\n    () => (rootId === undefined\n      ? []\n      : buildTasksModel({\n        byId,\n        catalogs,\n        rootId,\n        currentSessionId: sessionId,\n        live,\n        metrics,\n        runs,\n        teamMembers,\n        teamTasks: team?.tasks ?? [],\n        folded,\n        autoFoldSettled,\n        autoFoldBranches,\n        autoFoldIdle,\n        foldedIds,\n        expandedGroups,\n      })),\n    [byId, catalogs, rootId, sessionId, live, metrics, runs, teamMembers, team, folded,\n      autoFoldSettled, autoFoldBranches, autoFoldIdle, foldedIds, expandedGroups],\n  )\n\n  /**\n   * The tree's agent nodes by their session id — the ONLY sanctioned source of\n   * a job's diagnostics target. A jobs row is a roster entry under a WATCHED\n   * session (`row.ownerSessionId`) whose real owner is `job.owner`; a roster\n   * payload without an owner is announced under the watching session, which is\n   * not necessarily the session that owns the job. Resolving through the model\n   * therefore answers both halves at once: whether the owning session is in\n   * this tree at all, and what that node's address is (the root node has none\n   * — it IS the tree's main session — and must be addressed by its own id).\n   */\n  const agentNodeBySession = useMemo((): ReadonlyMap<string, TasksAgentNode> => {\n    const nodes = new Map<string, TasksAgentNode>()\n    for (const node of model) if (node.kind === 'agent') nodes.set(node.id, node)\n    return nodes\n  }, [model])\n\n  /**\n   * The diagnostics target of one conversation, when this tree holds its node.\n   * The label is the NODE's own — the card's durable label, resolved by the\n   * model — never a caller's title: a jobs row only knows the watched\n   * session's display title, which is not the owning agent's name.\n   */\n  const diagnosticsTargetOf = useCallback((ownerId: string): ContextDiagnosticTarget | undefined => {\n    const node = agentNodeBySession.get(ownerId)\n    if (node === undefined) return undefined\n    const address = diagnosticAddressOf(node.id, node.childAddress)\n    if (node.parentId !== undefined && address === undefined) return undefined\n    return { sessionId: node.id, label: node.label, ...(address === undefined ? {} : { address }) }\n  }, [agentNodeBySession])\n\n  /**\n   * Show one conversation in the main view. DSH moved child and session\n   * navigation OFF `ISessions` (0.1.6's `open` / `openSubagent` are gone from\n   * the runtime, and the optional calls this page used were silently dead)\n   * onto the workspace face, which owns the main-view selection. The old\n   * names stay as the fallback for a host that predates the move.\n   */\n  const openConversation = useCallback((target: SidebarSubagentAddress | string): void => {\n    const workspace = ctx.get('uiWorkspace')\n    if (workspace !== undefined) {\n      workspace.openSession(nativeSessionTarget(target))\n      return\n    }\n    if (typeof target === 'string') sessions.open?.(target)\n    else sessions.openSubagent?.(target)\n  }, [ctx, sessions])\n\n  /**\n   * Show one child session. `'right'` (the default) hands the transcript to\n   * the host's OWN right-sidebar tab in its CURRENT pane; `'side'` asks the\n   * host to split a second pane; `'main'` is the old behavior: the shell\n   * re-roots the Tasks page on the child and the main view follows. The\n   * sidebar forms are skipped when the deployment cannot host one (no\n   * `subagentchat` type, no right column, or no mounted seat).\n   */\n  const openChild = useCallback((address: SidebarSubagentAddress, place: 'right' | 'side' | 'main' = 'right'): void => {\n    if (place !== 'main' && openTranscriptAside(ctx, address, place === 'side')) return\n    // Notify the shell first: the jump switches the sidebar to the child\n    // session's own layout, and the shell re-opens the Tasks page on top\n    // of it (the topology stays rooted at the main agent with the child\n    // highlighted) — the README \"page stays open\" contract.\n    onOpenChild?.(address)\n    try {\n      openConversation(address)\n    } catch (error) {\n      console.error('[dsh-better-sidebar] open subagent failed:', error)\n    }\n  }, [ctx, openConversation, onOpenChild])\n\n  /** Jump back to the main agent (the topology root) from its node. */\n  const openMain = useCallback((): void => {\n    if (rootId === undefined) return\n    try {\n      openConversation(rootId)\n    } catch (error) {\n      console.error('[dsh-better-sidebar] open session failed:', error)\n    }\n  }, [openConversation, rootId])\n\n  const refresh = useCallback((parentSessionId: string): void => {\n    // 0.1.7 renamed the per-parent catalog refresh to `refreshProjections`\n    // (the projection store owns every session's values now); calling the\n    // removed 0.1.6 name alone would make this button a silent no-op.\n    const face = sessions as CatalogRefreshFace\n    void (face.refreshProjections ?? face.refreshSubagents)?.(parentSessionId)\n  }, [sessions])\n\n  /** Jump from the detail window into the node's transcript. */\n  const jumpToNode = useCallback((node: TasksAgentNode, place: 'right' | 'side' | 'main' = 'right'): void => {\n    if (node.childAddress !== undefined) {\n      openChild(node.childAddress, place)\n      setPopover(null)\n      return\n    }\n    if (node.parentId === undefined) {\n      openMain()\n      setPopover(null)\n    }\n  }, [openChild, openMain])\n\n  /**\n   * Whether this deployment can host a child transcript in its right column.\n   * Read once per ctx (the services arrive with the profile, not later), and it\n   * drives whether the detail window offers the choice at all.\n   */\n  const asideAvailable = useMemo(() => hasTranscriptAside(ctx), [ctx])\n\n  /** One tree row's disclosure: show or hide that node's own subtree. */\n  const toggleCollapse = useCallback((nodeId: string): void => {\n    setCollapsedIds(current => {\n      const next = new Set(current)\n      if (!next.delete(nodeId)) next.add(nodeId)\n      return next\n    })\n  }, [])\n\n  /** 全部收起: every node that HAS children, so only the roots stay visible. */\n  const collapseAllTree = useCallback((): void => {\n    const parents = new Set<string>()\n    for (const node of model) if (node.parentId !== undefined) parents.add(node.parentId)\n    setCollapsedIds(current => (current.size === parents.size && [...parents].every(id => current.has(id))\n      ? current\n      : parents))\n  }, [model])\n\n  /** 全部展开: forget every subtree fold. */\n  const expandAllTree = useCallback((): void => {\n    setCollapsedIds(current => (current.size === 0 ? current : new Set()))\n  }, [])\n\n  /** Fold one settled node into its parent's aggregate (its card's chevron). */\n  const foldNode = useCallback((node: TasksAgentNode): void => {\n    setFoldedIds(current => {\n      const next = new Set(current)\n      next.add(node.id)\n      return next\n    })\n  }, [])\n\n  /**\n   * Expand ONE aggregate: the group the reader clicked shows its members while\n   * every other group stays folded. The members it held are also released from\n   * the manual per-node set — clicking an aggregate means \"show me these nodes\n   * now\", and a hand-folded member left in `foldedIds` would stay hidden inside\n   * a group the reader just opened.\n   */\n  const expandGroup = useCallback((node: TasksFoldNode): void => {\n    setExpandedGroups(current => {\n      if (current.has(node.id)) return current\n      const next = new Set(current)\n      next.add(node.id)\n      return next\n    })\n    setFoldedIds(current => {\n      if (!node.memberIds.some(id => current.has(id))) return current\n      const next = new Set(current)\n      for (const id of node.memberIds) next.delete(id)\n      return next\n    })\n  }, [])\n\n  /**\n   * The control cluster's page-level switch. COLLAPSING there re-folds every\n   * group, so the per-group openings are dropped with it; expanding leaves them\n   * (an unfolded page already shows everything they would reveal).\n   */\n  const toggleFold = useCallback((): void => {\n    if (!folded) setExpandedGroups(current => (current.size === 0 ? current : new Set()))\n    setFoldOverride(!folded)\n  }, [folded])\n\n  /** Open the shared task window from a board row (undefined = create). */\n  const openTaskFromBoard = useCallback((\n    task: { id: string } | undefined,\n    anchor: HTMLElement,\n  ): void => {\n    setPopover({ kind: 'task', taskId: task?.id, anchor })\n  }, [])\n\n  /** Open the shared task window by id (node task lines, detail lists). */\n  const openTaskById = useCallback((taskId: string, anchor: HTMLElement): void => {\n    setPopover({ kind: 'task', taskId, anchor })\n  }, [])\n\n  const totals = useMemo(\n    () => rootId === undefined\n      ? { count: 0, runningCount: 0 }\n      : countSubagentDescendants(byId, rootId),\n    [byId, rootId],\n  )\n  const agentCount = totals.count + 1\n\n  /** The tree's ordered job rows (owner-labeled, off the host's push roster). */\n  const treeJobs = useTreeJobs(ctx, byId, rootId, active)\n  const jobRows = treeJobs.rows\n  // Only the open panel's job is observed: the host streams output per observer.\n  const openJob = popover?.kind === 'job'\n    ? jobRows.find(row => row.job.id === popover.jobId)\n    : undefined\n  useJobObservation(treeJobs.jobs, openJob?.ownerSessionId, openJob?.job.id)\n  const observedJob = openJob === undefined ? undefined : treeJobs.observed[openJob.job.id]\n\n  /** Catalogs that failed to load (surfaced as one banner in both modes). */\n  const failedParents = useMemo(\n    () => Object.entries(catalogs)\n      .filter(([, catalog]) => catalog?.state === 'error')\n      .map(([parent]) => parent),\n    [catalogs],\n  )\n\n  // Session summaries can announce membership before the descriptor-backed\n  // catalog catches up (or a catalog that just went ready is still empty).\n  const summaryBackedLoading = rootId !== undefined\n    && (catalogs[rootId] === undefined\n      || (catalogs[rootId]?.state === 'ready' && catalogs[rootId]?.entries.length === 0))\n    && Object.values(byId).some(\n      summary => summary.origin === 'subagent' && summary.parentId === rootId\n        && !isSideThreadSummary(summary),\n    )\n  const readyEmpty = rootId !== undefined\n    && catalogs[rootId]?.state === 'ready'\n    && catalogs[rootId]?.entries.length === 0\n    && runs.length === 0\n    && teamMembers.length === 0\n    && !Object.values(byId).some(\n      summary => summary.origin === 'subagent' && summary.parentId === rootId\n        && !isSideThreadSummary(summary),\n    )\n\n  const countLabel = totals.count === 0\n    ? undefined\n    : totals.runningCount > 0\n      ? t('subagentCountRunning', { count: totals.count, running: totals.runningCount })\n      : t('subagentCount', { count: totals.count })\n\n  const closePopover = useCallback((): void => { setPopover(null) }, [])\n\n  // A popover whose subject left the model (a settled job dropped from the\n  // mirror, a tree switch) closes itself.\n  useEffect(() => {\n    if (popover === null) return\n    if (popover.kind === 'job' && !jobRows.some(row => row.job.id === popover.jobId)) setPopover(null)\n    if (popover.kind === 'node' && !model.some(node => node.id === popover.nodeId)) setPopover(null)\n    if (popover.kind === 'workflow' && !model.some(node => node.id === popover.nodeId)) setPopover(null)\n  }, [popover, jobRows, model])\n\n  /** The current popover's resolved content (subjects re-resolve live). */\n  const popoverContent = ((): ReactNode => {\n    if (popover === null) return null\n    if (popover.kind === 'task') {\n      if (team === undefined || rootId === undefined) return null\n      const task = popover.taskId === undefined\n        ? undefined\n        : team.tasks.find(candidate => candidate.id === popover.taskId)\n      // A task that vanished (deleted elsewhere) closes the window instead of\n      // showing a stale card.\n      if (popover.taskId !== undefined && task === undefined) return null\n      return (\n        <TaskWindow\n          rootId={rootId}\n          task={task}\n          members={teamMembers}\n          ctx={ctx}\n          onClose={closePopover}\n          anchor={popover.anchor}\n        />\n      )\n    }\n    if (popover.kind === 'job') {\n      const row = jobRows.find(candidate => candidate.job.id === popover.jobId)\n      if (row === undefined) return null\n      return (\n        <JobOutputWindow\n          jobs={treeJobs.jobs}\n          ownerSessionId={row.ownerSessionId}\n          job={row.job}\n          observed={treeJobs.observed[row.job.id]}\n          anchor={popover.anchor}\n          onClose={closePopover}\n          diagnostics={row.job.owner === undefined ? undefined : diagnosticsTargetOf(row.job.owner)}\n        />\n      )\n    }\n    const node = model.find(candidate => candidate.id === popover.nodeId)\n    if (node === undefined) return null\n    if (popover.kind === 'workflow' && node.kind === 'workflow') {\n      return (\n        <WorkflowNodePopover\n          node={node as TasksWorkflowNode}\n          onJumpMember={(address) => { openChild(address); setPopover(null) }}\n        />\n      )\n    }\n    if (popover.kind === 'node' && node.kind === 'agent') {\n      return (\n        <AgentNodePopover\n          node={node}\n          asideAvailable={asideAvailable}\n          onJump={jumpToNode}\n          onOpenTask={openTaskById}\n          onClose={closePopover}\n        />\n      )\n    }\n    return null\n  })()\n\n  return (\n    <div className={legacy.subagent} style={{ position: 'relative' }}>\n      <div className={legacy.subagentHeader}>\n        <span className={legacy.subagentHeading}>\n          <span className={legacy.subagentTitle}>{t('subagent')}</span>\n          {rootSummary?.displayTitle !== undefined && rootSummary.displayTitle !== '' && (\n            <>\n              <span className={legacy.subagentSep} aria-hidden=\"true\">·</span>\n              {/*\n                The session the tree is rooted at: the header's subject, not the\n                page name. It yields first when the row runs out of room, and\n                carries the full title as a tooltip so a clipped one stays readable.\n              */}\n              <span className={legacy.subagentSubject} title={rootSummary.displayTitle}>\n                {rootSummary.displayTitle}\n              </span>\n            </>\n          )}\n        </span>\n        {countLabel !== undefined && <span className={legacy.subagentCount}>{countLabel}</span>}\n        {/*\n          The refresh control is the host ghost Button (28px) and carries the\n          plugin's control chrome; the module class only keeps it from being\n          squeezed by a long session title. Plain `title` rather than the host\n          Tooltip: the Tooltip anchors by ref and the host Button forwards none.\n        */}\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          className={legacy.subagentRefresh}\n          icon={<IconRefreshOutlineRegular size={14} />}\n          aria-label={t('refresh')}\n          title={t('refresh')}\n          disabled={rootId === undefined}\n          onClick={() => {\n            if (rootId !== undefined) refresh(rootId)\n          }}\n        />\n      </div>\n      {rootId !== undefined && team !== undefined && (\n        <TeamBoard\n          rootId={rootId}\n          members={teamMembers}\n          tasks={team.tasks}\n          onOpenTask={openTaskFromBoard}\n          collapsed={teamBoardCollapsed}\n          onToggleCollapsed={() => { setTeamBoardCollapsed(current => !current) }}\n        />\n      )}\n      {failedParents.length > 0 && (\n        <div className={legacy.subagentError}>\n          <span>{t('catalogLoadFailed', { count: failedParents.length })}</span>\n          {/* Host outline Button (28px); the module class keeps the retry from\n              being squeezed by the banner's message. */}\n          <Button\n            variant=\"outline\"\n            size=\"sm\"\n            className={legacy.subagentErrorRetry}\n            icon={<IconRefreshOutlineRegular size={14} />}\n            onClick={() => { for (const parent of failedParents) refresh(parent) }}\n          >\n            {t('retry')}\n          </Button>\n        </div>\n      )}\n      {readyEmpty && (\n        <div className={legacy.subagentEmpty}>\n          <div>{t('subagentEmpty')}</div>\n          <div className={legacy.subagentEmptyHint}>{t('subagentEmptyDesc')}</div>\n        </div>\n      )}\n      {!readyEmpty && rootId !== undefined && (\n        mode === 'graph'\n          ? (\n            <TasksGraph\n              nodes={model}\n              folded={folded}\n              rootId={rootId}\n              loading={summaryBackedLoading}\n              onNodeInfo={(node, anchor) => { setPopover({ kind: 'node', nodeId: node.id, anchor }) }}\n              onWorkflowInfo={(node, anchor) => { setPopover({ kind: 'workflow', nodeId: node.id, anchor }) }}\n              onOpenTask={openTaskById}\n              onToggleFold={toggleFold}\n              onExpandGroup={expandGroup}\n              onFoldNode={foldNode}\n              mode={mode}\n              onModeChange={setModeOverride}\n            />\n          )\n          : (\n            <TasksTree\n              nodes={model}\n              folded={folded}\n              collapsedIds={collapsedIds}\n              onToggleCollapse={toggleCollapse}\n              onCollapseAll={collapseAllTree}\n              onExpandAll={expandAllTree}\n              loading={summaryBackedLoading}\n              onNodeInfo={(node, anchor) => { setPopover({ kind: 'node', nodeId: node.id, anchor }) }}\n              onWorkflowInfo={(node, anchor) => { setPopover({ kind: 'workflow', nodeId: node.id, anchor }) }}\n              onOpenTask={openTaskById}\n              onToggleFold={toggleFold}\n              onExpandGroup={expandGroup}\n              mode={mode}\n              onModeChange={setModeOverride}\n            />\n          )\n      )}\n      <JobsDrawer\n        rows={jobRows}\n        agentCount={agentCount}\n        autoCollapse={prefs.jobsAutoCollapse}\n        jobs={treeJobs.jobs}\n        observed={observedJob}\n        openJobId={popover?.kind === 'job' ? popover.jobId : undefined}\n        // The page's own visibility, exactly as the pollers read it: a parked\n        // Tasks tab keeps the drawer's rows (they are already rendered) but\n        // runs no per-second clock.\n        visible={active}\n        onOpenOutput={(row, anchor) => {\n          setPopover(popover?.kind === 'job' && popover.jobId === row.job.id\n            ? null\n            : { kind: 'job', jobId: row.job.id, anchor })\n        }}\n      />\n      {/*\n        Two surfaces, two lifecycles: the job output is a PERSISTENT window\n        (its own frame, closed by its button/Escape only), while node and\n        workflow details stay anchored popovers on the 280px card.\n      */}\n      {popover?.kind === 'job'\n        ? popoverContent\n        : popover?.kind === 'task'\n          ? popoverContent\n          : (\n            <AnchoredPopover anchor={popover?.anchor ?? null} onClose={closePopover} width={280}>\n              {popoverContent}\n            </AnchoredPopover>\n          )}\n    </div>\n  )\n}\n","import { useEffect, useState } from 'react'\nimport type { SidechatImageOccurrence } from '../sidechat-images.ts'\nimport { hostRouteUrl } from './host-route-url.ts'\nimport { t } from './locales.ts'\nimport css from './SideChatView.module.css'\n\nfunction SavedImage({ childId, messageId, image, visible }: { childId: string; messageId: string; image: SidechatImageOccurrence; visible: boolean }): React.ReactNode {\n  const [state, setState] = useState<{ url: string } | { unavailable: true } | null>(null)\n  useEffect(() => {\n    if (!visible) return\n    const controller = new AbortController()\n    let url: string | undefined\n    setState(null)\n    const params = new URLSearchParams({ childId, messageId, blockIndex: String(image.blockIndex) })\n    void fetch(hostRouteUrl(`sidebar/sidechat-image?${params}`).href, { credentials: 'include', signal: controller.signal })\n      .then(async response => {\n        if (!response.ok) throw new Error('Image unavailable')\n        const blob = await response.blob()\n        if (controller.signal.aborted) return\n        url = URL.createObjectURL(blob)\n        setState({ url })\n      }).catch(() => { if (!controller.signal.aborted) setState({ unavailable: true }) })\n    return () => { controller.abort(); if (url !== undefined) URL.revokeObjectURL(url) }\n  }, [childId, messageId, image.blockIndex, visible])\n  if (state === null) return <span>{t('sideChatImageLoading')}</span>\n  if ('unavailable' in state) return <span role=\"status\">{t('sideChatImageUnavailable')}</span>\n  return <a href={state.url} target=\"_blank\" rel=\"noreferrer\"><img className={css.sidechatImage} src={state.url} alt={image.name ?? t('sideChatImage')} onError={() => { setState({ unavailable: true }) }} /></a>\n}\n\nexport function SidechatImages({ childId, messageId, images, visible }: { childId?: string; messageId?: string; images?: readonly SidechatImageOccurrence[]; visible: boolean }): React.ReactNode {\n  if (images === undefined || images.length === 0) return null\n  return <div className={css.sidechatImages}>{images.map(image => childId === undefined || messageId === undefined\n    ? <span key={image.blockIndex}>{t('sideChatImageUnavailable')}</span>\n    : <SavedImage key={`${messageId}:${image.blockIndex}`} childId={childId} messageId={messageId} image={image} visible={visible} />)}</div>\n}\n","import { useLayoutEffect, useMemo, useReducer } from 'react'\nimport type { SidechatImageLimits, SidechatImageUpload } from '../sidechat-images.ts'\nimport { t } from './locales.ts'\n\nexport interface DraftImage { id: number; file: File; preview: string }\nexport interface SidechatDraftOwner {\n  childId?: string\n  active: boolean\n  revision: number\n  text: string\n  images: DraftImage[]\n}\nexport interface SidechatSendAttempt {\n  owner: SidechatDraftOwner\n  revision: number\n  text: string\n  images: readonly DraftImage[]\n}\n\n/**\n * How many threads keep a saved draft. Bounded because a saved image holds its\n * object URL alive for as long as the page lives.\n */\nconst DRAFT_CACHE_LIMIT = 8\n\n/** A thread's draft while nothing is bound to it: the words, and the images whose previews it keeps alive. */\ninterface SavedDraft { text: string; images: DraftImage[] }\n\n/** Saved drafts by thread id, least recently used first (`Map` keeps insertion order). */\nconst savedDrafts = new Map<string, SavedDraft>()\n\n/** Owners whose prompt is under way: their draft is dropped, never saved. */\nconst sendingOwners = new WeakSet<SidechatDraftOwner>()\n\n/** Release the previews a dropped draft was the last owner of. */\nfunction releaseDraftImages(images: readonly DraftImage[]): void {\n  images.forEach(image => URL.revokeObjectURL(image.preview))\n}\n\n/**\n * Drop every saved draft and release the previews they kept alive. The app has\n * no reason to call this (a saved draft is bounded and cheap); it exists so a\n * test can start from a clean cache between cases.\n */\nexport function clearSavedSidechatDrafts(): void {\n  for (const draft of savedDrafts.values()) releaseDraftImages(draft.images)\n  savedDrafts.clear()\n}\n\n/**\n * Save the draft of a binding that is going away, then keep the cache bounded\n * (least recently saved first out). An empty draft is not saved: it would evict\n * a real one for a mere visit.\n */\nfunction saveDraft(owner: SidechatDraftOwner): void {\n  const childId = owner.childId\n  if (childId === undefined) return\n  savedDrafts.delete(childId)\n  if (owner.text !== '' || owner.images.length > 0) savedDrafts.set(childId, { text: owner.text, images: [...owner.images] })\n  for (const [id, draft] of savedDrafts) {\n    if (savedDrafts.size <= DRAFT_CACHE_LIMIT) break\n    savedDrafts.delete(id)\n    releaseDraftImages(draft.images)\n  }\n}\n\n/**\n * Give a freshly created owner the draft its thread left behind. The saved copy\n * is taken out of the cache: the live owner holds it until the binding goes.\n * @returns whether a draft came back (the caller has to redraw).\n */\nfunction restoreDraft(owner: SidechatDraftOwner): boolean {\n  if (owner.childId === undefined) return false\n  const saved = savedDrafts.get(owner.childId)\n  if (saved === undefined) return false\n  savedDrafts.delete(owner.childId)\n  owner.text = saved.text\n  owner.images = [...saved.images]\n  // Keep the next `add` above the restored ids, or `remove(id)` could drop two images at once.\n  for (const image of saved.images) {\n    if (image.id > owner.revision) owner.revision = image.id\n  }\n  return true\n}\n\nexport function useSidechatDraft(childId: string | undefined) {\n  const [, redraw] = useReducer((value: number) => value + 1, 0)\n  const owner = useMemo<SidechatDraftOwner>(() => ({ childId, active: true, revision: 0, text: '', images: [] }), [childId])\n  useLayoutEffect(() => {\n    owner.active = true\n    // A draft belongs to its THREAD, not to the binding: pick it back up so\n    // half-written words and their screenshots survive leaving and returning.\n    if (restoreDraft(owner)) redraw()\n    return () => {\n      owner.active = false\n      // An unbound tab has nowhere to save to, and a draft whose prompt is\n      // already under way must not come back (it could be sent twice), so both\n      // release their previews instead of leaving them to a saved copy.\n      if (owner.childId === undefined || sendingOwners.has(owner)) {\n        releaseDraftImages(owner.images)\n        owner.images = []\n        return\n      }\n      saveDraft(owner)\n    }\n  }, [owner])\n  const changed = (): void => { owner.revision++; redraw() }\n  return {\n    owner,\n    setText(text: string) { owner.text = text; changed() },\n    add(files: readonly File[], limits: SidechatImageLimits | undefined) {\n      if (limits === undefined) throw new Error(t('sideChatImagesDisabled'))\n      if (owner.images.length + files.length > limits.maxImagesPerMessage) throw new Error(t('sideChatImageLimit'))\n      let bytes = owner.images.reduce((sum, image) => sum + image.file.size, 0)\n      for (const file of files) {\n        if (!limits.mediaTypes.includes(file.type as never)) throw new Error(t('sideChatImageFormat'))\n        bytes += file.size\n        if (file.size === 0 || file.size > limits.maxImageBytes || bytes > limits.maxMessageImageBytes) throw new Error(t('sideChatImageLimit'))\n      }\n      const added: DraftImage[] = []\n      try {\n        for (const file of files) added.push({ id: ++owner.revision, file, preview: URL.createObjectURL(file) })\n      } catch (error) {\n        added.forEach(image => URL.revokeObjectURL(image.preview))\n        throw error\n      }\n      owner.images = [...owner.images, ...added]\n      changed()\n    },\n    remove(id: number) {\n      owner.images = owner.images.filter(image => {\n        if (image.id !== id) return true\n        URL.revokeObjectURL(image.preview)\n        return false\n      })\n      changed()\n    },\n    capture(): SidechatSendAttempt {\n      // The prompt is under way from here: a binding that goes away mid-flight\n      // must not hand the same words back to be sent a second time. `accept`\n      // (sent) and `abandon` (failed) both clear the mark.\n      sendingOwners.add(owner)\n      return { owner, revision: owner.revision, text: owner.text.trim(), images: [...owner.images] }\n    },\n    /** The prompt never started (the request failed): the draft is the reader's again. */\n    abandon(attempt: SidechatSendAttempt) {\n      if (attempt.owner === owner) sendingOwners.delete(owner)\n    },\n    accept(attempt: SidechatSendAttempt) {\n      if (!owner.active || attempt.owner !== owner) return\n      sendingOwners.delete(owner)\n      const sent = new Set(attempt.images.map(image => image.id))\n      owner.images = owner.images.filter(image => {\n        if (!sent.has(image.id)) return true\n        URL.revokeObjectURL(image.preview)\n        return false\n      })\n      if (attempt.revision === owner.revision) owner.text = ''\n      changed()\n    },\n  }\n}\n\nexport async function encodeSidechatImages(attempt: SidechatSendAttempt): Promise<SidechatImageUpload[]> {\n  // From here on the prompt is under way — the composer's draft for this thread\n  // belongs to that send now, not to a future visit to the thread.\n  sendingOwners.add(attempt.owner)\n  const images: SidechatImageUpload[] = []\n  for (const image of attempt.images) {\n    const data = await new Promise<string>((resolve, reject) => {\n      const reader = new FileReader()\n      reader.onerror = () => { reject(new Error(t('sideChatImageReadError'))) }\n      reader.onload = () => { resolve(String(reader.result).split(',')[1] ?? '') }\n      reader.readAsDataURL(image.file)\n    })\n    if (!attempt.owner.active) throw new Error(t('sideChatImageOwnerChanged'))\n    images.push({ mediaType: image.file.type as SidechatImageUpload['mediaType'], name: image.file.name, data })\n  }\n  return images\n}\n","/**\n * Inline-code file mentions for the Side Chat transcript — the plugin-side\n * mirror of the host's produced-path vocabulary\n * (`ui-deliverables/turn-deliverables.ts`, `producedFileMentions`).\n *\n * The main conversation makes `` `src/client/api.ts` `` clickable because the\n * chat view hands `MarkdownText` a resolver over the paths the turn PRODUCED.\n * The side chat rendered the same answers as dead code, and the host's resolver\n * is deliberately cheap: it never stats the filesystem, it only matches the\n * turn's produced/delivered paths and declines an ambiguous basename. A compact\n * transcript can rebuild exactly that vocabulary from its own rows, which is\n * what this module does — no request per token, no guess at what \"looks like\" a\n * path.\n *\n * Only two row shapes carry evidence of production, and only the MUTATION tools\n * count (see {@link MUTATION_PATH_KEYS}):\n * - a successful `write` / `edit` / `str_replace_editor` call's target path,\n * - a `deliverables` row (`files[].path`, the authoritative delivery record).\n */\nimport type { SidechatTranscriptRow } from './sidechat-transcript.ts'\nimport { parseArgsObject } from './sidechat-transcript.ts'\nimport { baseName } from './paths.ts'\n\n/**\n * The call-argument key naming the target of each MUTATION tool — the plugin's\n * mirror of the host's produced-path set (`ui-deliverables/turn-deliverables.ts`\n * `mutationPath`: write / edit / str_replace_editor). Reads and searches are\n * deliberately absent: a `read` target or a `grep`/`glob` root is not a file\n * this thread PRODUCED, and the directories those calls name would otherwise\n * become openable \"mentions\" that land the editor on a folder.\n */\nconst MUTATION_PATH_KEYS: Readonly<Record<string, string>> = {\n  write: 'file_path',\n  edit: 'file_path',\n  str_replace_editor: 'path',\n}\n\n/** The `str_replace_editor` commands that MUTATE a file (host\n *  `editorMutationPath`): `view` reads, and any other command mutates nothing,\n *  so neither may put its target into the produced vocabulary. */\nconst EDITOR_MUTATION_COMMANDS: ReadonlySet<string> = new Set(['create', 'str_replace', 'insert'])\n\n/** The non-blank path a list of arguments names, or undefined. */\nfunction pathValue(value: unknown): string | undefined {\n  return typeof value === 'string' && value.trim() !== '' ? value : undefined\n}\n\n/**\n * The file one tool row produced, or undefined when the call is not a mutation\n * of a file (see {@link MUTATION_PATH_KEYS} and\n * {@link EDITOR_MUTATION_COMMANDS}).\n * @param row - one mapped `tool` row.\n * @returns the produced path exactly as the call spelled it.\n */\nfunction producedTargetOf(row: Extract<SidechatTranscriptRow, { kind: 'tool' }>): string | undefined {\n  const pathKey = MUTATION_PATH_KEYS[row.name]\n  if (pathKey === undefined) return undefined\n  const args = parseArgsObject(row.args)\n  if (args === undefined) return undefined\n  if (row.name === 'str_replace_editor') {\n    const command = args.command\n    if (typeof command !== 'string' || !EDITOR_MUTATION_COMMANDS.has(command)) return undefined\n  }\n  return pathValue(args[pathKey])\n}\n\n/**\n * Every path this thread produced, in first-seen order and deduplicated: the\n * target of a successful (`failed !== true`) mutation call, plus every\n * delivered file. Nothing else — see {@link MUTATION_PATH_KEYS}.\n * @param rows - the thread's mapped transcript rows.\n * @returns the produced paths exactly as the producing row spelled them\n * (relative call arguments stay relative; delivery events are absolute).\n */\nexport function producedFilePaths(rows: readonly SidechatTranscriptRow[]): string[] {\n  const seen = new Set<string>()\n  const add = (value: unknown): void => {\n    if (typeof value === 'string' && value.trim() !== '') seen.add(value)\n  }\n  for (const row of rows) {\n    if (row.kind === 'tool') {\n      if (row.failed === true) continue\n      add(producedTargetOf(row))\n    } else if (row.kind === 'deliverables') {\n      for (const file of row.files) add(file.path)\n    }\n  }\n  return [...seen]\n}\n\n/**\n * The produced path one inline-code token names, or undefined when it names\n * none — the token must equal the path or its basename, and EXACTLY ONE\n * produced path may match (two `dup.ts` under different directories are\n * ambiguous, so the token stays inert rather than opening a guess).\n * @param paths - the thread's produced paths ({@link producedFilePaths}).\n * @param token - the authored inline-code text, exactly as written.\n * @returns the matching produced path, or undefined for an inert token.\n */\nexport function resolveProducedPath(paths: readonly string[], token: string): string | undefined {\n  const wanted = token.trim()\n  if (wanted === '') return undefined\n  let match: string | undefined\n  for (const path of paths) {\n    if (path !== wanted && baseName(path) !== wanted) continue\n    if (match !== undefined) return undefined\n    match = path\n  }\n  return match\n}\n","/**\n * The main conversation's \"work details\" preference, read from the host's\n * public cross-plugin settings service and applied to the side transcript.\n *\n * The host stores two fields in its `ui-chat` settings namespace — the\n * presentation mode (`transcriptView`) and an independent collapse timing\n * (`collapseTiming`) — and its own chat view folds a settled Turn's process\n * rows behind one control. The side chat rendered every Turn fully expanded and\n * read no preference at all, so the same conversation looked twice as busy in\n * the panel as in the main pane.\n *\n * Source and normalization mirror the host exactly\n * (`ui-chat/src/client/transcript-view.ts` `adopt()` and `chat-settings.ts`):\n * - `ctx.get('configForms')` → `.get('ui-chat')` is the PUBLIC service (a\n *   structural probe — not an `inject`, and no value-import of the settings\n *   package, which the client bundle may not take);\n * - the two legacy saved values (`normal` / `expanded`) read as `detailed`;\n * - a missing service, a form that is not `ready`, or an unusable value keep\n *   the client default (`detailed` on the Web, `standard` on the desktop shell,\n *   exactly like the host's own construction);\n * - `collapseTiming` defaults to `completion`.\n *\n * The reading is LIVE: the form's `subscribe()` drives a state update, so a\n * settings change re-renders the mounted transcript instead of waiting for a\n * remount.\n */\nimport { useEffect, useMemo, useState } from 'react'\nimport type { Context } from '../context-types.ts'\n\n/** Work-details presentation modes (host `TRANSCRIPT_VIEW_MODES`). */\nexport type SidechatWorkDetailsMode = 'compact' | 'standard' | 'detailed' | 'verbose'\n\n/** When a completed Turn returns to its folded presentation. */\nexport type SidechatCollapseTiming = 'completion' | 'next-input'\n\n/** The settings namespace the Chat target owns. */\nconst CHAT_NAMESPACE = 'ui-chat'\n\n/** What the side transcript needs from the preference. */\nexport interface SidechatWorkDetails {\n  mode: SidechatWorkDetailsMode\n  collapseTiming: SidechatCollapseTiming\n}\n\n/** The client default, by shell: the desktop shell opens at `standard`\n *  (host `apply.ts`), every other client at `detailed`. */\nfunction defaultMode(): SidechatWorkDetailsMode {\n  return 'dshDesktop' in globalThis ? 'standard' : 'detailed'\n}\n\n/**\n * Normalize one saved `transcriptView` value the way the host does.\n * @param value - the raw saved value (any JSON).\n * @returns the mode to present.\n */\nexport function workDetailsModeOf(value: unknown): SidechatWorkDetailsMode {\n  if (value === 'compact' || value === 'standard' || value === 'detailed' || value === 'verbose') return value\n  // The two-mode generation's saved values read as `detailed`.\n  if (value === 'normal' || value === 'expanded') return 'detailed'\n  return defaultMode()\n}\n\n/**\n * Normalize one saved `collapseTiming` value.\n * @param value - the raw saved value (any JSON).\n * @returns the timing to present (`completion` when absent or unusable).\n */\nexport function collapseTimingOf(value: unknown): SidechatCollapseTiming {\n  return value === 'next-input' ? 'next-input' : 'completion'\n}\n\n/** Whether this mode folds a settled Turn's process rows at all. */\nexport function foldsSettledTurns(mode: SidechatWorkDetailsMode): boolean {\n  return mode !== 'verbose'\n}\n\n/** Whether this mode puts the RUNNING Turn's process detail on its line\n *  (host `liveProcessDetail`: true for `standard` and `detailed`). */\nexport function showsLiveProcessDetail(mode: SidechatWorkDetailsMode): boolean {\n  return mode === 'standard' || mode === 'detailed'\n}\n\n/** The form face this module reads (host `ConfigForm`, structurally). */\ninterface ConfigFormFace {\n  getSnapshot: () => { status?: unknown; value?: unknown } | undefined\n  subscribe: (listener: () => void) => () => void\n}\n\n/** The settings service face (host `configForms`, structurally). */\ninterface ConfigFormsFace {\n  get: (id: string) => ConfigFormFace | undefined\n}\n\n/** The `ui-chat` form of the composition, or undefined when there is none. */\nfunction chatFormOf(ctx: Context): ConfigFormFace | undefined {\n  try {\n    return (ctx.get('configForms') as ConfigFormsFace | undefined)?.get(CHAT_NAMESPACE)\n  } catch {\n    return undefined\n  }\n}\n\n/**\n * Read the live work-details preference.\n *\n * Deliberately NOT `useSyncExternalStore`: the host form may hand out a fresh\n * snapshot object per call (`getSnapshot()` identity is not part of its\n * contract), which would make React loop. Subscribing through local state keeps\n * the view stable whatever identity the form returns.\n * @param ctx - client context (the settings service is read off it).\n * @returns the mode and collapse timing to present.\n */\nexport function useSidechatWorkDetails(ctx: Context): SidechatWorkDetails {\n  const form = useMemo(() => chatFormOf(ctx), [ctx])\n  const [snapshot, setSnapshot] = useState(() => form?.getSnapshot())\n  useEffect(() => {\n    if (form === undefined) {\n      setSnapshot(undefined)\n      return undefined\n    }\n    const sync = (): void => { setSnapshot(form.getSnapshot()) }\n    sync()\n    return form.subscribe(sync)\n  }, [form])\n  return useMemo(() => {\n    // A form that has not accepted values yet (`status !== 'ready'`, or a ready\n    // form without a value) leaves both fields at their defaults.\n    const section = snapshot?.status === 'ready' && typeof snapshot.value === 'object' && snapshot.value !== null\n      ? snapshot.value as { transcriptView?: unknown; collapseTiming?: unknown }\n      : undefined\n    return {\n      mode: workDetailsModeOf(section?.transcriptView),\n      collapseTiming: collapseTimingOf(section?.collapseTiming),\n    }\n  }, [snapshot])\n}\n","/**\n * Side-chat composer keymap: which gesture submits a message, and the IME\n * guard that outranks it.\n *\n * The submission contract has two modes, picked by the user in the side card\n * settings page and carried into the view as `submitKey`:\n *\n * - `'enter'` (the default): a plain `Enter` submits and the gesture is\n *   CONSUMED (no newline). `Shift+Enter` never submits and keeps the\n *   textarea's native line break.\n * - `'mod-enter'`: exactly `Cmd+Enter` or `Ctrl+Enter` submits; a bare\n *   `Enter` and `Shift+Enter` insert a newline and are NOT consumed.\n *\n * The IME guard follows the host's own composer keymap\n * (`packages/client/ui-conversation/src/client/input/editor/keymap.ts`): a\n * keydown that belongs to a composition must never submit, and the guard wins\n * over a submit chord. Three signals make that decision:\n *\n * - `KeyboardEvent.isComposing` — most engines;\n * - the legacy `keyCode === 229`, which some engines report with\n *   `isComposing === false` while an IME owns the keyboard;\n * - a {@link COMPOSITION_END_GRACE_MS} window after `compositionend`: Safari\n *   delivers the composition-closing keydown AFTER compositionend, so the\n *   state flag is already false by the time the Enter arrives (the host's\n *   \"old textarea's proven window\", same 10 ms).\n *\n * The decisions are pure functions taking the clock as a parameter, so the\n * behavior is pinned without a DOM:\n * {@link compositionPhase} / {@link isComposingKeydown} / {@link isSubmitGesture}.\n * The vocabulary (the modes and their parser) lives with the other preference\n * vocabulary in `prefs-shared.ts`, because the stored value is a preference.\n *\n * Consumption is part of the contract, not just \"don't submit\": a keydown in\n * the composition-CLOSING window is swallowed (no submit, no newline) while a\n * LIVE composition key is left untouched so the candidate picker keeps it.\n *\n * The caller applies the decisions in the host keymap's order:\n *   1. a LIVE composition owns the key outright (no submit, no consumption —\n *      not even when the event also carries Alt or is a repeat);\n *   2. the submit gesture (see {@link isSubmitGesture}) is consumed and sends\n *      unless `repeat` marks it as a held key — a repeated submit gesture is\n *      consumed WITHOUT sending, while a repeated newline gesture keeps its\n *      native line break;\n *   3. a shortcut/layout chord ({@link isGuardedKeydown}) and the closing-window\n *      Enter are consumed without sending.\n */\nimport type { SidechatSubmitKey } from '../prefs-shared.ts'\n\n/** How long after `compositionend` a keydown still belongs to the IME. */\nexport const COMPOSITION_END_GRACE_MS = 10\n\n/** The key-event fields the decisions read (the view feeds the native event's\n *  `isComposing` / `keyCode` / modifiers beside React's flags). */\nexport interface ComposerKeyEvent {\n  /** The key name (`'Enter'`). */\n  key: string\n  shiftKey: boolean\n  metaKey: boolean\n  ctrlKey: boolean\n  /** Option/Alt — on macOS the reader's way to type an accented character. */\n  altKey?: boolean\n  /** `KeyboardEvent.getModifierState('AltGraph')`: the AltGr modifier, which\n   *  some layouts use as a switcher gesture (never a form submit). */\n  altGraph?: boolean\n  /** This keydown is an auto-repeat of a held key, not a fresh press. */\n  repeat?: boolean\n  /** The engine's composition flag (absent on events that do not carry it). */\n  isComposing?: boolean\n  /** The legacy IME key code (229 while an engine hides its composition). */\n  keyCode?: number\n}\n\n/**\n * Whether this keydown is a SHORTCUT / layout gesture rather than a composer\n * gesture: the host keymap's first line (`altKey` / AltGraph / `Ctrl+Meta` /\n * `Shift` with `Ctrl` or `Meta`). Such a keydown must neither submit the draft\n * nor insert a newline — the host returns \"stop the fallback line break\n * without consuming the DOM event\", and a plain textarea only has the one\n * lever, so the caller consumes it.\n * @param event - the keydown's fields.\n * @returns true for a modifier chord the composer must leave alone.\n */\nexport function isGuardedKeydown(event: ComposerKeyEvent): boolean {\n  if (event.altKey === true) return true\n  if (event.altGraph === true) return true\n  if (event.ctrlKey && event.metaKey) return true\n  return event.shiftKey && (event.ctrlKey || event.metaKey)\n}\n\n\n/**\n * How one keydown relates to an IME composition:\n *\n * - `'active'` — the composition is live, or the engine flags the key as its\n *   own (legacy 229). The key belongs to the input method: never submit and\n *   never consume it (`preventDefault()` there fights the candidate picker).\n * - `'closing'` — no composition is live and the event carries no flag, but\n *   `compositionend` fired inside the grace window. This is Safari's late\n *   composition-closing keydown: it must be CONSUMED (the host's composer\n *   \"neither submits nor breaks the line\"), because letting it through inserts\n *   a newline the user never asked for.\n * - `'none'` — an ordinary keydown.\n */\nexport type CompositionPhase = 'none' | 'active' | 'closing'\n\n/**\n * Classify one keydown against the composition window.\n * @param event - the keydown's fields.\n * @param composing - whether a composition is LIVE right now (tracked from\n *   `compositionstart` / `compositionend`; some engines only signal it there).\n * @param composingUntil - the deadline of the composition-end grace window\n *   (`Date.now()` basis, 0 when no composition ever ended).\n * @param now - the current time (injectable for deterministic tests).\n * @returns the keydown's composition phase.\n */\nexport function compositionPhase(\n  event: ComposerKeyEvent,\n  composing: boolean,\n  composingUntil: number,\n  now: number = Date.now(),\n): CompositionPhase {\n  if (event.isComposing === true || composing) return 'active'\n  // The legacy signal counts as ACTIVE, never as 'closing': engines emit 229\n  // without the flag while an IME owns the key, and layout-switcher utilities\n  // emit bare 229s outside any composition — a key this guard cannot place is\n  // left to the browser instead of being consumed.\n  // oxlint-disable-next-line typescript/no-deprecated\n  if (event.keyCode === 229) return 'active'\n  return now < composingUntil ? 'closing' : 'none'\n}\n\n/**\n * Whether this keydown belongs to an IME composition and must therefore be\n * left unsubmitted.\n * @param event - the keydown's fields.\n * @param composing - whether a composition is LIVE right now.\n * @param composingUntil - the deadline of the composition-end grace window.\n * @param now - the current time (injectable for deterministic tests).\n * @returns true while a composition owns the keyboard (active or closing).\n */\nexport function isComposingKeydown(\n  event: ComposerKeyEvent,\n  composing: boolean,\n  composingUntil: number,\n  now: number = Date.now(),\n): boolean {\n  return compositionPhase(event, composing, composingUntil, now) !== 'none'\n}\n\n/**\n * Whether this keydown REPRESENTS the submit gesture under the configured mode.\n *\n * The answer is about the gesture, not about how many times the key has fired:\n * an auto-repeat represents the gesture it repeats, so the caller decides what\n * to do with `repeat` AFTER this question — exactly the host keymap's order,\n * where the plain-Enter newline (`keymap.ts:141`) is settled before the\n * `preventDefault()` + repeat bail-out (`:156-158`). A repeated submit gesture\n * must not send; a repeated NEWLINE gesture must keep its native line break.\n *\n * Priority for the gesture itself (the host keymap's own order): a\n * shortcut/layout modifier chord outranks everything, then `Shift+Enter`'s\n * newline, then the IME guard, and only then the configured submit mode.\n * @param event - the keydown's fields.\n * @param submitKey - the configured submission mode.\n * @param composing - whether a composition is LIVE right now.\n * @param composingUntil - the composition-end grace deadline (see above).\n * @param now - the current time (injectable for deterministic tests).\n * @returns true when the gesture submits (the caller consumes it and, unless\n *   this is a repeat, sends the draft).\n */\nexport function isSubmitGesture(\n  event: ComposerKeyEvent,\n  submitKey: SidechatSubmitKey,\n  composing: boolean,\n  composingUntil: number,\n  now: number = Date.now(),\n): boolean {\n  if (event.key !== 'Enter') return false\n  // A shortcut / layout chord is not a composer gesture at all.\n  if (isGuardedKeydown(event)) return false\n  // Shift+Enter NEVER submits: it is the newline gesture in both modes.\n  if (event.shiftKey) return false\n  if (isComposingKeydown(event, composing, composingUntil, now)) return false\n  if (submitKey === 'mod-enter') return event.metaKey || event.ctrlKey\n  return true\n}\n","/** Keep the host Markdown renderer as the default; a registered consumer may\n * enhance only this real row root while it is visible and durably identified. */\nimport { useLayoutEffect, useRef } from 'react'\nimport { MarkdownText, type MarkdownFileMentions } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { markdownTextProps, type MarkdownCopyLabels } from './markdown-labels.tsx'\nimport { attachSidechatSurface, isSidechatSurfaceIdentity } from './sidechat-surface.ts'\nimport type { SidechatTranscriptRow } from './sidechat-transcript.ts'\nimport css from './SideChatView.module.css'\n\nexport interface SidechatRowSurfaceBinding {\n  service: object | undefined\n  threadId: string | undefined\n  visible: boolean\n  sendPrompt: (text: string) => Promise<void>\n}\n\nexport function SidechatAssistantRow(props: {\n  row: Extract<SidechatTranscriptRow, { kind: 'assistant' }>\n  labels: MarkdownCopyLabels\n  /** The view's row-level prose pass (image destinations first, then local\n   *  links) — takes the ROW so an unchanged row reuses its cached rewrite. */\n  rewrite: (row: Extract<SidechatTranscriptRow, { text: string }>) => string\n  /** The thread's inline-code file-mention vocabulary (see\n   *  sidechat-mentions.ts); absent leaves every token inert code. */\n  fileMentions?: MarkdownFileMentions | undefined\n  surface: SidechatRowSurfaceBinding\n}): React.ReactNode {\n  const rootRef = useRef<HTMLDivElement | null>(null)\n  const { row, labels, rewrite, fileMentions, surface } = props\n  const { service, threadId, visible, sendPrompt } = surface\n  const renderedText = rewrite(row)\n  useLayoutEffect(() => {\n    const root = rootRef.current\n    if (!visible || !row.settled || root === null || threadId === undefined\n      || row.contentBlockIndex === undefined\n      || !isSidechatSurfaceIdentity(threadId, row.seq, row.contentBlockIndex)) return\n    return attachSidechatSurface(service, {\n      root,\n      source: 'dsh-better-sidebar/sidechat',\n      threadId,\n      eventSeq: row.seq,\n      contentBlockIndex: row.contentBlockIndex,\n      text: row.text,\n      sendPrompt,\n    })\n  }, [service, threadId, visible, sendPrompt, row.settled, row.seq, row.contentBlockIndex, row.text, renderedText])\n  return (\n    <div ref={rootRef} className={css.sidechatAssistant} data-genui-surface=\"dsh-better-sidebar/sidechat\">\n      {/* `streaming` keeps the host's incremental parse across chunks\n          instead of restarting it; only the durable (settled) message is\n          the final parse. It rides the row's own flag so a superseded\n          live row never claims to be settled. */}\n      <MarkdownText {...markdownTextProps(renderedText, labels, undefined, fileMentions)} streaming={!row.settled} />\n    </div>\n  )\n}\n","/**\n * `image` / `file` content blocks in the side transcript (D13).\n *\n * The main conversation shows the screenshot a reader attached, the image a\n * tool produced, and a chip for a document the model was given. The side\n * transcript kept only `text` blocks, so those turns claimed to be text-only.\n *\n * BYTES COME FROM THE HOST REMOTE, ADDRESSED TO THE THREAD:\n *   `ctx.get('remote').session.attachment({ sessionId, attachmentId })`\n * with `sessionId` = the thread whose own log references the attachment. The\n * host's `uiConversation.imageUrl` path is deliberately NOT used: it resolves\n * through `sessions.binding()`, which exists only for scopes the client\n * retained — a side thread is not one of them.\n *\n * One read per attachment id, shared by every block that names it, and the\n * object URL the read mints is revoked when the last thumbnail using it\n * unmounts. A read that declines (`{ ok: false }`, a carrier rejection, or no\n * remote namespace at all) renders the localized placeholder instead of a\n * broken image; a `file` block never reads bytes at all.\n */\nimport { useCallback, useSyncExternalStore } from 'react'\nimport { FileTypeIcon, fileSizeText } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { Context } from '../context-types.ts'\nimport type {\n  SidechatAttachment,\n  SidechatFileAttachment,\n  SidechatImageAttachment,\n} from './sidechat-transcript.ts'\nimport { t } from './locales.ts'\nimport css from './SideChatView.module.css'\n\n/** What one attachment read is currently worth rendering. */\ntype AttachmentImageState =\n  | { status: 'loading' }\n  | { status: 'ready'; url: string }\n  | { status: 'failed' }\n\n/** One shared read: its state, the mounted thumbnails using it, and their\n *  re-render tickets. */\ninterface AttachmentImageEntry {\n  state: AttachmentImageState\n  /** Mounted thumbnails. The entry (and its object URL) dies with the last. */\n  users: number\n  listeners: Set<() => void>\n}\n\n/** The pending state. One module-level constant on purpose: `useSyncExternalStore`\n *  compares snapshots by identity, so a fresh object per read would loop. */\nconst LOADING: AttachmentImageState = { status: 'loading' }\n/** The settled-failure state (same identity rule). */\nconst FAILED: AttachmentImageState = { status: 'failed' }\n\n/**\n * The read cache, one entry per (thread, attachment id).\n *\n * Bounded by construction rather than by eviction: an entry exists only while\n * at least one thumbnail uses it (the subscription refcounts it) and is deleted\n * — with its object URL revoked — when the last one unmounts. The transcript\n * mounts a windowed tail, so the live set is the visible image rows.\n */\nconst entries = new Map<string, AttachmentImageEntry>()\n\n/** The host Remote face this module needs (declared structurally: the plugin's\n *  context type does not carry it). */\ninterface RemoteAttachmentFace {\n  session?: {\n    attachment?: (request: { sessionId: string; attachmentId: string }) => Promise<unknown>\n  }\n}\n\n/** The remote namespace, or undefined when the composition has none. */\nfunction remoteOf(ctx: Context): RemoteAttachmentFace | undefined {\n  try {\n    return ctx.get('remote') as RemoteAttachmentFace | undefined\n  } catch {\n    return undefined\n  }\n}\n\n/** One key per (thread, attachment id): the sharing and refcount unit. */\nfunction entryKey(sessionId: string, attachmentId: string): string {\n  return `${sessionId}\\u0000${attachmentId}`\n}\n\n/** Decode the RPC's base64 payload into the Blob the thumbnail shows. */\nfunction blobOf(base64: string, mediaType: string): Blob {\n  const binary = atob(base64)\n  const bytes = new Uint8Array(binary.length)\n  for (let index = 0; index < binary.length; index += 1) bytes[index] = binary.charCodeAt(index)\n  return new Blob([bytes], { type: mediaType })\n}\n\n/**\n * Read one attachment and publish its object URL to every thumbnail waiting on\n * it. Never throws: a failure becomes the placeholder state.\n */\nfunction loadAttachment(\n  ctx: Context,\n  sessionId: string,\n  attachmentId: string,\n  mediaType: string,\n  key: string,\n  entry: AttachmentImageEntry,\n): void {\n  /** Publish one settled state — unless the entry was released meanwhile. */\n  const settle = (state: AttachmentImageState): void => {\n    if (entries.get(key) !== entry) {\n      if (state.status === 'ready') URL.revokeObjectURL(state.url)\n      return\n    }\n    entry.state = state\n    for (const listener of entry.listeners) listener()\n  }\n  const read = remoteOf(ctx)?.session?.attachment\n  if (typeof read !== 'function') {\n    settle(FAILED)\n    return\n  }\n  void (async (): Promise<void> => {\n    try {\n      const answer = await read({ sessionId, attachmentId }) as\n        | { ok?: unknown; value?: { data?: unknown } }\n        | undefined\n      const data = answer?.ok === true ? answer.value?.data : undefined\n      if (typeof data !== 'string' || data === '') {\n        settle(FAILED)\n        return\n      }\n      settle({ status: 'ready', url: URL.createObjectURL(blobOf(data, mediaType)) })\n    } catch {\n      // A carrier rejection is the same reader-visible fact as a declined read.\n      settle(FAILED)\n    }\n  })()\n}\n\n/**\n * The current state of one attachment's shared read, subscribing for the\n * component's lifetime (and starting the read on the first subscriber).\n * @param ctx - client context (the Host Remote is read off it).\n * @param sessionId - the THREAD whose log references the attachment.\n * @param image - the narrowed image block.\n * @returns the state the thumbnail renders.\n */\nexport function useAttachmentImage(\n  ctx: Context,\n  sessionId: string,\n  image: SidechatImageAttachment,\n): AttachmentImageState {\n  const key = entryKey(sessionId, image.attachmentId)\n  const { attachmentId, mediaType } = image\n  const subscribe = useCallback((listener: () => void) => {\n    let entry = entries.get(key)\n    if (entry === undefined) {\n      entry = { state: LOADING, users: 0, listeners: new Set() }\n      entries.set(key, entry)\n      loadAttachment(ctx, sessionId, attachmentId, mediaType, key, entry)\n    }\n    const acquired = entry\n    acquired.users += 1\n    acquired.listeners.add(listener)\n    return () => {\n      acquired.listeners.delete(listener)\n      acquired.users -= 1\n      if (acquired.users > 0) return\n      if (entries.get(key) === acquired) entries.delete(key)\n      if (acquired.state.status === 'ready') URL.revokeObjectURL(acquired.state.url)\n    }\n  }, [key, ctx, sessionId, attachmentId, mediaType])\n  const getSnapshot = useCallback((): AttachmentImageState => entries.get(key)?.state ?? LOADING, [key])\n  return useSyncExternalStore(subscribe, getSnapshot)\n}\n\n/** One image block: its thumbnail, or the localized read-failure placeholder. */\nfunction AttachmentThumbnail(props: {\n  ctx: Context\n  sessionId: string\n  image: SidechatImageAttachment\n}): React.ReactNode {\n  const { ctx, sessionId, image } = props\n  const state = useAttachmentImage(ctx, sessionId, image)\n  if (state.status === 'failed') {\n    return <span className={css.sidechatAttachmentFailed}>{t('sideChatAttachmentImageFailed')}</span>\n  }\n  if (state.status !== 'ready') return null\n  return (\n    <img\n      className={css.sidechatAttachmentThumb}\n      src={state.url}\n      alt={image.name ?? t('sideChatAttachmentImage')}\n    />\n  )\n}\n\n/** One non-image file: the host's name + size chip, with no byte read. */\nfunction FileChip({ file }: { file: SidechatFileAttachment }): React.ReactNode {\n  const size = file.bytes === undefined ? '' : fileSizeText(file.bytes)\n  return (\n    <span className={css.sidechatAttachmentFile} title={file.name}>\n      <FileTypeIcon path={file.name} size={16} />\n      <span className={css.sidechatAttachmentName}>{file.name}</span>\n      {size === '' ? null : <span className={css.sidechatAttachmentSize}>{size}</span>}\n    </span>\n  )\n}\n\n/**\n * Render one row's `image` / `file` blocks in content order.\n * @param props.ctx - client context (Host Remote byte source).\n * @param props.sessionId - the thread that owns the referencing log.\n * @param props.attachments - the narrowed blocks (see sidechat-transcript.ts).\n * @returns the attachment strip, or null when the row has none.\n */\nexport function SidechatAttachments(props: {\n  ctx: Context\n  sessionId: string\n  attachments: readonly SidechatAttachment[]\n}): React.ReactNode {\n  const { ctx, sessionId, attachments } = props\n  if (attachments.length === 0) return null\n  return (\n    <div className={css.sidechatAttachments}>\n      {attachments.map((attachment, index) => attachment.kind === 'image'\n        ? (\n          <AttachmentThumbnail\n            key={`image:${index}:${attachment.image.attachmentId}`}\n            ctx={ctx}\n            sessionId={sessionId}\n            image={attachment.image}\n          />\n        )\n        : <FileChip key={`file:${index}:${attachment.file.name}`} file={attachment.file} />)}\n    </div>\n  )\n}\n","/**\n * Live invalidation push for Side Chat transcripts.\n *\n * The transcript used to advance on a 2s poll while the thread ran, so a\n * claimed message, a settled assistant message or a finished tool call became\n * visible up to two seconds after the host wrote it. DSH's agent pipeline\n * offers no client-side event feed for a hidden child session, so the plugin\n * carries its own channel: one socket per mounted side-chat tab, watching the\n * single thread that tab is bound to.\n *\n * The host's frames are INVALIDATION ONLY — `{ threadId, running? }` says\n * \"this thread's transcript is stale, re-pull `sidechat.events` with your\n * afterSeq\". No event body ever crosses this socket, so the existing delta\n * pull stays the single source of transcript data and a dropped socket\n * self-heals through the same pull (plus the slow fallback poll).\n *\n * Lifecycle mirrors use-dir-watch: one socket for the component's lifetime\n * while the tab is VISIBLE, a full `watch` frame re-announcing the\n * subscription set whenever the id list changes, exponential backoff\n * (1s → 15s) on a drop, and no socket at all while the list is empty or the\n * tab is parked. The host keeps every visited tab body mounted, so an un-gated\n * subscription would leave one socket per side-chat tab the reader ever\n * opened — and a notice delivered to a parked tab re-pulled a transcript\n * nobody could see. A parked tab therefore closes its socket, and a late frame\n * from that dead socket is dropped (`closed`) instead of triggering a pull.\n */\nimport { useEffect, useMemo, useRef } from 'react'\nimport { hostWebSocketUrl } from './host-route-url.ts'\n\n/** One host frame: a watched thread whose transcript is stale. `running` is\n *  the host's own run-state hint; it is deliberately not read here — the\n *  panel re-reads both the transcript and `sidechat.info` on every notice. */\ninterface SidechatPushFrame {\n  threadId?: unknown\n  running?: unknown\n}\n\n/** What the view hands the hook. */\nexport interface SidechatPushOptions {\n  /** Threads to watch; an empty list closes the socket entirely. */\n  threadIds: readonly string[]\n  /**\n   * Whether the owning tab is on screen. Defaults to true; a parked tab has\n   * no socket, and coming back re-subscribes and re-pulls once.\n   */\n  visible?: boolean\n  /**\n   * A watched thread whose transcript should be re-pulled.\n   * @param threadId - the thread the host named, always one of `threadIds`.\n   */\n  onInvalidate: (threadId: string) => void\n}\n\n/** How long to wait before re-opening a dropped socket; failures back off to the cap. */\nconst RETRY_BASE_MS = 1000\nconst RETRY_MAX_MS = 15_000\n\n/**\n * Follow the host's staleness notices for the given side-chat threads.\n * @param options - the watched ids, the tab's visibility, and the invalidation callback.\n */\nexport function useSidechatPush(options: SidechatPushOptions): void {\n  const { threadIds, visible = true, onInvalidate } = options\n  // The id list is a fresh array on every render, so neither the socket effect\n  // nor the invalidation callback may depend on its identity. The CONTENT key\n  // (NUL-joined — no session id can contain one) is what everything derives\n  // from, exactly like use-dir-watch's expanded set.\n  const idsKey = threadIds.join('\\u0000')\n  const wanted = useMemo(() => (idsKey === '' ? [] : idsKey.split('\\u0000')), [idsKey])\n  const wantedRef = useRef(wanted)\n  wantedRef.current = wanted\n  const invalidateRef = useRef(onInvalidate)\n  invalidateRef.current = onInvalidate\n  /** Set by the socket effect; re-announces the current subscription set. */\n  const reconcileRef = useRef<() => void>(() => {})\n  /**\n   * Stable dependency: re-open the socket only when it gains or loses every\n   * id — or when the tab is parked/shown. Visibility is an INPUT here rather\n   * than a second mechanism, so a parked tab is simply \"not subscribed\".\n   */\n  const subscribed = visible && idsKey !== ''\n\n  useEffect(() => {\n    if (!subscribed) return\n    let socket: WebSocket | null = null\n    let retry: number | undefined\n    let closed = false\n    let failures = 0\n\n    /** Push this socket's whole subscription set (a full replacement). */\n    const reconcile = (): void => {\n      if (socket !== null && socket.readyState === WebSocket.OPEN) {\n        socket.send(JSON.stringify({ op: 'watch', threadIds: [...wantedRef.current] }))\n      }\n    }\n    reconcileRef.current = reconcile\n\n    const connect = (): void => {\n      if (closed) return\n      socket = new WebSocket(hostWebSocketUrl('sidebar/ws/sidechat').toString())\n      socket.onopen = () => {\n        failures = 0\n        reconcile()\n      }\n      socket.onmessage = (event) => {\n        // A frame from the socket this effect already tore down (the tab was\n        // parked, the ids emptied) must not re-pull: the transcript it names\n        // is not on screen any more.\n        if (closed) return\n        if (typeof event.data !== 'string') return\n        let frame: SidechatPushFrame\n        try {\n          frame = JSON.parse(event.data) as SidechatPushFrame\n        } catch {\n          return\n        }\n        if (frame === null || typeof frame !== 'object' || typeof frame.threadId !== 'string') return\n        // Only watched ids: a frame for a thread this socket no longer\n        // subscribes to is a late notice, not an invalidation.\n        if (!wantedRef.current.includes(frame.threadId)) return\n        invalidateRef.current(frame.threadId)\n      }\n      socket.onclose = () => {\n        if (closed) return\n        failures += 1\n        retry = window.setTimeout(connect, Math.min(RETRY_BASE_MS * 2 ** (failures - 1), RETRY_MAX_MS))\n      }\n    }\n    connect()\n\n    return () => {\n      closed = true\n      reconcileRef.current = () => {}\n      if (retry !== undefined) window.clearTimeout(retry)\n      socket?.close()\n    }\n  }, [subscribed])\n\n  // A subscription change on the SAME socket only re-sends the watch frame.\n  useEffect(() => {\n    void idsKey\n    reconcileRef.current()\n  }, [idsKey])\n\n  /**\n   * Shown again after being parked: the socket is new (nothing the host\n   * noticed in between was delivered), so the transcript may have moved. Pull\n   * once through the same invalidation path the host's own frames use.\n   */\n  const wasSubscribedRef = useRef(subscribed)\n  useEffect(() => {\n    const previous = wasSubscribedRef.current\n    wasSubscribedRef.current = subscribed\n    if (!subscribed || previous) return\n    for (const id of wantedRef.current) invalidateRef.current(id)\n  }, [subscribed])\n}\n","import type { SessionId } from '@deepseek-ai/dsh-session/types'\n/**\n * Side Chat page: Codex-style side conversations for the current session.\n *\n * EVERY side conversation is its own sidebar tab (侧边对话1/2/3 …): the\n * descriptor's createTab mints a fresh tab flagged `autoCreate` and this\n * view creates the EMPTY thread on mount (one click = one conversation,\n * exactly like the Codex app); the composer owns the first message (the\n * host wraps it with the side boundary + the in-progress snapshot parked\n * at creation, and the thread earns its real label — and the tab its\n * title — from that first message). Closing the tab releases the thread's\n * live agent (its history stays persisted); the composer bar's thread menu\n * reopens any existing thread into a tab (deduped by threadId).\n *\n * Each side thread is a child session the plugin created itself with a\n * custom seed (the parent's full log up to the click moment — see\n * sidechat-core.ts). Transport: EVERY thread operation — creation,\n * follow-up, cancel, dispose, info, and the transcript itself — goes\n * through the plugin's own /sidebar/api sidechat.* routes (subagent-origin\n * identities are fenced from the generic session RPCs, and DSH\n * 0.1.2-alpha.1's Remote-gateway migration removed the client\n * session-history face the transcript used to poll). The transcript route\n * cuts the inherited seed host-side and answers afterSeq deltas; the\n * mapping (boundary row dropped, chunk streaming accumulated) lives in\n * sidechat-transcript.ts.\n *\n * Freshness and visibility (2026-10-12): the transcript advances on the\n * host's own staleness push (use-sidechat-push.ts) with a slow fallback poll;\n * a just-sent message shows as a local echo until the host reports it in the\n * unclaimed inbox; that inbox renders as pending bubbles with a dequeue\n * button; and EVERY thread function (model route, thread menu, save-as-new-\n * session, archive) lives in the COMPOSER BAR, not a top header — the reader's\n * attention is on the input, and a header's actions went unnoticed.\n */\nimport { SidechatImages } from './SidechatImages.tsx'\nimport { useSidechatDraft, encodeSidechatImages } from './sidechat-draft.ts'\nimport { useCallback, useEffect, useLayoutEffect, useMemo, useRef, useState } from 'react'\nimport { useSyncExternalStore } from 'react'\nimport clsx from 'clsx'\nimport {\n  ConnectionIndicator,\n  DiffBlock,\n  FileTypeIcon,\n  IconApiOutlineRegular,\n  IconArchiveOutlineRegular,\n  IconBrowseOutlineRegular,\n  IconChevronRightOutlineRegular,\n  IconCloseFillRegular,\n  IconEditOutlineRegular,\n  IconNewChatOutlineRegular,\n  IconPaperclipOutlineRegular,\n  IconPlusOutlineRegular,\n  IconSearchOutlineRegular,\n  IconSendOutlineRegular,\n  IconSparkleRegular,\n  IconStopFillRegular,\n  MarkdownText,\n  Menu,\n  MarkdownDelegateProvider,\n  ReadBlock,\n  SearchBlock,\n  StateDot,\n  TerminalBlock,\n  Tooltip,\n  WebBlock,\n  classifyFileType,\n  type DiffBlockLabels,\n  type MarkdownFileMentions,\n  type MenuEntry,\n  type ReadBlockLabels,\n  type SearchBlockLabels,\n  type TerminalBlockLabels,\n  type WebBlockLabels,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport { markdownLabels, markdownTextProps } from './markdown-labels.tsx'\nimport { producedFilePaths, resolveProducedPath } from './sidechat-mentions.ts'\nimport {\n  foldsSettledTurns,\n  showsLiveProcessDetail,\n  useSidechatWorkDetails,\n} from './sidechat-work-details.ts'\nimport { COMPOSITION_END_GRACE_MS, compositionPhase, isGuardedKeydown, isSubmitGesture } from './composer-keymap.ts'\nimport { SIDECHAT_IMAGE_MEDIA_TYPES } from '../sidechat-images.ts'\nimport { SidechatAssistantRow, type SidechatRowSurfaceBinding } from './SidechatAssistantRow.tsx'\nimport { SidechatAttachments } from './SidechatAttachments.tsx'\nimport { rewriteProseLocalImageUrls } from './markdown-images.ts'\nimport { hostTransportBase } from './desktop-env.ts'\nimport { baseName, resolveSidebarPath } from './paths.ts'\nimport { openSidebarFile } from './sidebar-file.ts'\nimport { useMarkdownSurface } from './use-markdown-surface.ts'\nimport { IconHistoryOutline16, IconSaveOutline16 } from './icons.tsx'\nimport type { Context, SidebarHistoryEntry, SidebarSessionEvent } from '../context-types.ts'\nimport type { SidechatForkPoint } from '../sidechat-core.ts'\nimport {\n  SIDE_LABEL_PREFIX,\n  SIDE_NEW_THREAD_TITLE,\n  sideThreadRows,\n  threadHasCompletedTurn,\n  threadTrailingPending,\n  type SidechatLiveEvent,\n  type SidechatModelCatalog,\n  type SidechatModelInfo,\n  type SidechatPendingInput,\n  type SidechatThreadInfo,\n  type SideThreadRow,\n} from '../sidechat-core.ts'\nimport {\n  formatDurationMs,\n  formatTokens,\n  toolArgsSummary,\n  transcriptRows,\n  sidechatRowKey,\n  type SidechatAttachment,\n  type SidechatToolCard,\n  type SidechatTranscriptRow,\n} from './sidechat-transcript.ts'\nimport { api, mediaUrl, SidebarApiError } from './api.ts'\nimport { usePolling } from './use-polling.ts'\nimport { useSidechatPush } from './use-sidechat-push.ts'\nimport { t } from './locales.ts'\nimport type { SessionScope } from './api.ts'\nimport type { SidebarTab } from './state.ts'\nimport { SIDECHAT_SUBMIT_KEY_DEFAULT, type SidechatSubmitKey } from '../prefs-shared.ts'\nimport css from './SideChatView.module.css'\n\n/**\n * Fallback poll cadence while the selected thread is running and the tab\n * visible. The push socket is the primary refresh path (see\n * use-sidechat-push.ts); this is the safety net for a socket that cannot be\n * established at all.\n */\nconst POLL_MS = 15_000\n/** Coalescing window for push notices: one pull per burst of host frames.\n *  `fetchThread` already aborts its predecessor, so a shorter window would\n *  only turn one burst into a request storm. */\nconst PUSH_DEBOUNCE_MS = 80\n/** Textarea auto-grow ceiling (px) — the composer scrolls beyond it. */\nconst COMPOSER_MAX_HEIGHT = 132\n/** Transcript rows MOUNTED at once. The mapping still produces every row (see\n *  `transcriptRows`); only the DOM is bounded — a long thread used to mount\n *  every code card, table and image it ever contained. */\nconst TRANSCRIPT_WINDOW_MAX = 50\n/** How many more rows one \"reveal earlier\" activation mounts. */\nconst TRANSCRIPT_REVEAL_STEP = 25\n/** Declared height of ONE hidden row in the top spacer (px). jsdom performs no\n *  layout and a measured height would read 0 there, so the spacer carries its\n *  height inline; the contract only needs it to be linear in the hidden row\n *  count, because a revealed row takes back exactly the height it frees. */\nconst TRANSCRIPT_HIDDEN_ROW_PX = 28\n/** The host's own near-bottom rule: within this distance of the bottom offset\n *  (scrollHeight - clientHeight - scrollTop) the reader is following the tail. */\nconst TRANSCRIPT_FOLLOW_THRESHOLD_PX = 24\n\n/**\n * Run one callback on the next animation frame, or on the next macrotask when\n * the environment has no `requestAnimationFrame` (jsdom without a visual\n * timer). Returns the cancel handle.\n * @param callback - the deferred work.\n * @returns the disposer that cancels a still-pending frame.\n */\nfunction nextFrame(callback: () => void): () => void {\n  if (typeof window !== 'undefined' && typeof window.requestAnimationFrame === 'function') {\n    const handle = window.requestAnimationFrame(() => { callback() })\n    return () => { window.cancelAnimationFrame(handle) }\n  }\n  const handle = window.setTimeout(callback, 0)\n  return () => { window.clearTimeout(handle) }\n}\n\n/** The thread a tab is bound to (durable in tab.meta across refreshes). */\nexport function sidechatThreadIdOf(tab: SidebarTab): string | undefined {\n  const meta = tab.meta as { threadId?: unknown } | undefined\n  return typeof meta?.threadId === 'string' ? meta.threadId : undefined\n}\n\n/** The parked reopen target consumed by the descriptor's createTab (the\n *  service's createTab receives no seed, so a thread-switch parks the id\n *  here and openTab picks it up synchronously — exactly one consume per\n *  park). */\nlet parkedReopen: string | undefined\n\n/** Park a thread id for the NEXT sidechat openTab to reattach. */\nexport function parkSidechatReopen(threadId: string): void {\n  parkedReopen = threadId\n}\n\n/** Consume the parked reopen target (undefined = mint a fresh thread tab). */\nexport function consumeSidechatSeed(): string | undefined {\n  const value = parkedReopen\n  parkedReopen = undefined\n  return value\n}\n\n/** In-flight thread creations keyed by tab id (double-mount guard: React\n *  StrictMode / HMR must not mint two threads for one tab). */\nconst inFlightStarts = new Set<string>()\n\n/** Where the last side-chat thread of each main session is remembered (the\n *  client store's own key space, like the diff pane's redaction flag). */\nconst LAST_THREAD_KEY = 'dsh-sidebar:v1:sidechat-thread'\n\n/**\n * How many sessions keep their remembered thread. The map lives for the life\n * of the page and is serialised WHOLE, so it needs both a bound (LRU: the\n * least recently bound session is forgotten) and — below — a write that is\n * coalesced instead of re-serialising the map on every bind.\n */\nconst LAST_THREAD_MAX = 32\n\n/** The in-memory mirror of {@link LAST_THREAD_KEY}. */\nconst lastThreadBySession = new Map<string, string>()\n\n/** Whether the localStorage mirror has been read into the map yet. */\nlet lastThreadsLoaded = false\n\n/** Pending coalesced write of {@link LAST_THREAD_KEY} (undefined = none). */\nlet lastThreadsWrite: number | undefined\n\n/**\n * Write the whole map once the binds stop coming. A thread switch binds two\n * or three ids in a row (mint, switch, reattach); serialising per bind was\n * pure churn for a value nothing reads back mid-page. Best-effort like the\n * rest of this storage: a denied or full write keeps the in-memory binding.\n */\nfunction scheduleLastThreadsWrite(): void {\n  if (lastThreadsWrite !== undefined) window.clearTimeout(lastThreadsWrite)\n  lastThreadsWrite = window.setTimeout(() => {\n    lastThreadsWrite = undefined\n    try {\n      localStorage.setItem(LAST_THREAD_KEY, JSON.stringify(Object.fromEntries(lastThreadBySession)))\n    } catch {\n      // A full or denied storage keeps the in-memory binding: reattaching\n      // within this page still works, only a reload loses it.\n    }\n  }, 200)\n}\n\n/**\n * A native tab's record and its navigation params live in the host's memory\n * only, so collapsing the sidebar (or restarting DSH) remounts the tab with\n * NO thread bound — the autoCreate path — and the reader would land in a\n * brand-new empty thread instead of the one they were in. Remembering the\n * last thread per session is what makes the reattach below possible; the\n * storage is best-effort (a denied or unparseable entry just means the\n * reattach falls back to the newest thread).\n */\nfunction loadLastThreads(): void {\n  if (lastThreadsLoaded) return\n  lastThreadsLoaded = true\n  try {\n    const raw = localStorage.getItem(LAST_THREAD_KEY)\n    if (raw === null) return\n    const parsed: unknown = JSON.parse(raw)\n    if (parsed === null || typeof parsed !== 'object' || Array.isArray(parsed)) return\n    for (const [sessionId, threadId] of Object.entries(parsed as Record<string, unknown>)) {\n      if (typeof threadId === 'string') lastThreadBySession.set(sessionId, threadId)\n    }\n  } catch {\n    // No storage (or unreadable JSON): nothing was remembered.\n  }\n}\n\n/** The thread a session's side-chat tab was last bound to, if any. */\nfunction lastSidechatThread(sessionId: string): string | undefined {\n  loadLastThreads()\n  return lastThreadBySession.get(sessionId)\n}\n\n/** Remember the side-chat thread a session is bound to (also across reloads). */\nfunction rememberSidechatThread(sessionId: string, threadId: string): void {\n  loadLastThreads()\n  if (lastThreadBySession.get(sessionId) === threadId) return\n  // delete + set: a Map keeps an existing key's position otherwise, and the\n  // cap below drops from the front.\n  lastThreadBySession.delete(sessionId)\n  lastThreadBySession.set(sessionId, threadId)\n  while (lastThreadBySession.size > LAST_THREAD_MAX) {\n    const oldest = lastThreadBySession.keys().next()\n    if (oldest.done === true) break\n    lastThreadBySession.delete(oldest.value)\n  }\n  scheduleLastThreadsWrite()\n}\n\n/** Per-thread transcript cache: thread-own events merged by seq (polls ride\n * the afterSeq delta and never re-download what they already hold). */\ninterface ThreadCache {\n  /** Rows must never be rebound to a different child while a reset is pending. */\n  threadId?: string\n  entries: SidebarHistoryEntry[]\n  /** The CURRENT attempt's live deltas (replaced every pull, never merged). */\n  live: SidechatLiveEvent[]\n  /** The thread's unclaimed inbox as of the last pull (replaced, never merged). */\n  pending: SidechatPendingInput[]\n  /** The FIRST pull of this thread was answered from a capped (tail-sliced)\n   *  log: the transcript opens mid-history and has to say so. */\n  truncated: boolean\n  /** Where the FIRST pull said this thread forked off its parent conversation\n   *  (the route's additive `fork`); absent for an unseeded thread. */\n  fork?: SidechatForkPoint\n}\n\n/** The catalog row of one route: the model picker reads its reasoning efforts\n *  and its default effort. Undefined when the route is not in the catalog\n *  (an inherited route, or a catalog that failed to load). */\nfunction catalogModel(\n  catalog: SidechatModelCatalog | null,\n  provider: string | undefined,\n  model: string | undefined,\n): SidechatModelInfo | undefined {\n  if (catalog === null || provider === undefined || model === undefined) return undefined\n  for (const group of catalog.groups ?? []) {\n    if (group.id !== provider) continue\n    for (const entry of group.models ?? []) if (entry.id === model) return entry\n  }\n  return undefined\n}\n\n/** Row-render labels (locale-dependent, memoized once per mount). */\ninterface RowLabels {\n  copyLabel: string\n  copiedLabel: string\n  /** Code-card chrome (DSH 0.1.7-rc.1's fence toolbar): the markdown rows read\n   *  these three straight off this object, the diff / read cards mix them in. */\n  codeLabel: string\n  wrapLabel: string\n  unwrapLabel: string\n  thinkLabel: string\n  injectionLabel: string\n  terminal: TerminalBlockLabels\n  diff: DiffBlockLabels\n  read: ReadBlockLabels\n  /** The host search card (grep / glob results). */\n  search: SearchBlockLabels\n  /** The host web card (web_search / web_fetch results), whose answer is\n   *  rendered as markdown and therefore carries its own markdown chrome. */\n  web: WebBlockLabels\n}\n\n/** A stable \"nothing is archived\" snapshot: the archive set feeds\n *  `useSyncExternalStore`, and a fresh `[]` per read would re-render forever. */\nconst NO_ARCHIVED_SESSIONS: readonly string[] = []\n\n/** The sessions the host currently hides as archived. A host without the\n *  `workspaces` service (or a context that throws on `get`) reads as \"nothing\n *  is archived\", so the thread menu simply keeps every thread. */\nfunction archivedSessionIdsOf(ctx: Context): readonly string[] {\n  try {\n    const service = ctx.get('workspaces')\n    return service?.list?.getSnapshot?.()?.archivedSessionIds ?? NO_ARCHIVED_SESSIONS\n  } catch {\n    return NO_ARCHIVED_SESSIONS\n  }\n}\n\n/** Subscribe to the host's archive set. DSH hides archived sessions from the\n *  session list, so the thread menu has to follow the same set — otherwise it\n *  would keep offering a thread the host refuses to open. */\nfunction useArchivedSessionIds(ctx: Context): readonly string[] {\n  const subscribe = useMemo(\n    () => (callback: () => void) => {\n      try {\n        const service = ctx.get('workspaces')\n        return service?.list?.subscribe?.(callback) ?? (() => {})\n      } catch {\n        return () => {}\n      }\n    },\n    [ctx],\n  )\n  const getSnapshot = useCallback(() => archivedSessionIdsOf(ctx), [ctx])\n  return useSyncExternalStore(subscribe, getSnapshot)\n}\n\n/** Merge history entries by event seq (newest wins), log order preserved. */\nfunction mergeBySeq(\n  previous: readonly SidebarHistoryEntry[],\n  incoming: readonly SidebarHistoryEntry[],\n): SidebarHistoryEntry[] {\n  const bySeq = new Map<number, SidebarHistoryEntry>()\n  for (const entry of previous) bySeq.set(entry.event.seq, entry)\n  for (const entry of incoming) bySeq.set(entry.event.seq, entry)\n  return [...bySeq.values()].sort((a, b) => a.event.seq - b.event.seq)\n}\n\n/** The display title of a thread: the durable label minus the 'Side: '\n *  prefix, with the fresh-thread placeholder localized. */\nfunction threadDisplayTitle(title: string): string {\n  if (title === SIDE_NEW_THREAD_TITLE) return t('sideChatUntitled')\n  return title.startsWith(SIDE_LABEL_PREFIX) ? title.slice(SIDE_LABEL_PREFIX.length) : title\n}\n\n/** How long a composer-bar control waits before its hover bubble opens. */\nconst TIP_DELAY_MS = 120\n\n/**\n * One composer-bar control with its hover bubble.\n *\n * The bubble anchors on an ENABLED wrapper span, not on the button itself: a\n * disabled control fires no pointer events, and save/archive are disabled\n * exactly when their label matters most (\"至少完成一轮对话后才能保存\" /\n * \"该线程正在运行，停止后才能归档\"). `portal` + `side=\"top\"` keep the bubble\n * inside the viewport from a bar pinned to the panel's bottom edge.\n * @param props.label - bubble text.\n * @param props.children - the control (a button, or a Menu whose trigger is one).\n */\nfunction ComposerTip(props: {\n  label: string\n  children: React.ReactNode\n  /** Extra class on the anchor box (the model capsule needs to be shrinkable). */\n  className?: string\n}): React.ReactNode {\n  return (\n    <Tooltip label={props.label} side=\"top\" portal delayMs={TIP_DELAY_MS} maxWidth={220}>\n      <span className={clsx(css.sidechatTipAnchor, props.className)}>{props.children}</span>\n    </Tooltip>\n  )\n}\n\n/**\n * One collapsible context row — the shared Codex-style chrome of tool\n * calls, thinking and context injections: a single quiet line (chevron +\n * label + one-line summary) that expands into an indented body hung on a\n * hairline thread. Rows with nothing to reveal render as a static line.\n */\nfunction CollapsibleRow(props: {\n  label: string\n  meta?: string\n  mono?: boolean\n  streaming?: boolean\n  failed?: boolean\n  /** 16px leading glyph (tool-kind icon, the main conversation's row head). */\n  icon?: React.ReactNode\n  children?: React.ReactNode\n}): React.ReactNode {\n  const leading = props.icon === undefined ? null : (\n    <span className={css.sidechatRowIcon}>{props.icon}</span>\n  )\n  const label = (\n    <span\n      className={clsx(\n        css.sidechatRowLabel,\n        props.mono === true && css.sidechatRowMono,\n        props.streaming === true && css.sidechatShimmerText,\n      )}\n    >\n      {props.label}\n    </span>\n  )\n  const meta = props.meta !== undefined && props.meta !== ''\n    ? <span className={css.sidechatRowMeta}>{props.meta}</span>\n    : null\n  if (props.children === undefined) {\n    return (\n      <div className={clsx(css.sidechatRowLine, css.sidechatRowStatic, props.failed === true && css.sidechatRowFailed)}>\n        {leading}\n        {label}\n        {meta}\n      </div>\n    )\n  }\n  return (\n    <details className={css.sidechatRow}>\n      <summary\n        className={clsx(\n          css.sidechatRowLine,\n          css.sidechatRowSummary,\n          props.failed === true && css.sidechatRowFailed,\n        )}\n      >\n        <span className={css.sidechatRowChevron}>\n          <IconChevronRightOutlineRegular size={12} />\n        </span>\n        {leading}\n        {label}\n        {meta}\n      </summary>\n      <div className={css.sidechatRowBody}>{props.children}</div>\n    </details>\n  )\n}\n\n/** Whether a row is a WORK-DETAIL row: the only rows a Turn fold wraps (a\n *  question, an answer, a delivery or an attachment is content, not work). */\nfunction isWorkRow(\n  row: SidechatTranscriptRow,\n): row is Extract<SidechatTranscriptRow, { kind: 'reasoning' | 'tool' }> {\n  return row.kind === 'reasoning' || row.kind === 'tool'\n}\n\n/** Longest live-detail snippet a running Turn's line carries. */\nconst RUNNING_LINE_MAX = 80\n\n/**\n * What a RUNNING turn's control line says beyond its label (host\n * `liveProcessDetail`): the running tool with its one-line arguments, or the\n * first line of the reasoning being streamed.\n * @param row - the latest work row of the running turn.\n * @returns the detail, or undefined when the row has nothing to quote.\n */\nfunction runningProcessLine(\n  row: Extract<SidechatTranscriptRow, { kind: 'reasoning' | 'tool' }>,\n): string | undefined {\n  if (row.kind === 'tool') {\n    const summary = toolArgsSummary(row.args)\n    return summary === '' ? row.name : `${row.name} · ${summary}`\n  }\n  const first = row.text.split('\\n', 1)[0]?.trim() ?? ''\n  return first === '' ? undefined : first.slice(0, RUNNING_LINE_MAX)\n}\n\n/**\n * One Turn's work-detail disclosure (the host's `foldCompletedTurns`): the\n * line is the localized label (plus live detail while the turn runs), and its\n * WORK rows live in the body. Question and answer rows never enter it.\n */\nfunction TurnFold(props: {\n  /** The line's copy: the host's own turn-process vocabulary (took / done /\n   *  running), localized by the planner that knows the measured duration. */\n  label: string\n  rows: React.ReactNode[]\n  liveDetail: string | undefined\n  open: boolean\n}): React.ReactNode {\n  return (\n    <details className={css.sidechatTurnFold} data-sidechat-turn-fold=\"\" open={props.open}>\n      {/* The live detail rides the line's TITLE, not its text: the line stays\n          the reader's fixed anchor while a turn runs, and a tool name in the\n          summary text would collide with every \"find the row for tool X\"\n          lookup that keys on summary text. */}\n      <summary\n        className={css.sidechatTurnFoldLine}\n        {...(props.liveDetail === undefined ? {} : { title: props.liveDetail })}\n      >\n        <span className={css.sidechatRowChevron}>\n          <IconChevronRightOutlineRegular size={12} />\n        </span>\n        <span className={css.sidechatRowLabel}>{props.label}</span>\n      </summary>\n      <div className={css.sidechatTurnFoldBody}>{props.rows}</div>\n    </details>\n  )\n}\n\n/**\n * The pre-fork context, tucked behind one divider line.\n *\n * A side thread opens on the side question, as if the conversation began there;\n * the inherited exchange is CONTEXT, not conversation — rendered permanently\n * open it pushes the reader's own question off the first screen and reads as if\n * THIS thread had asked it. So the block is a native disclosure: collapsed it is\n * one line of divider chrome, expanded it is the parent's last exchange between\n * the opening and closing divider lines.\n */\nfunction ForkBlock(props: {\n  /** The parent's last question, verbatim. */\n  user: string | undefined\n  /** The parent's last answer, verbatim; absent when there is none. */\n  answer: string | undefined\n  /** Markdown chrome, the same label bag the transcript rows thread through. */\n  labels: RowLabels\n  /** The view's row prose pass (image destinations, then local links). */\n  rewrite: (text: string) => string\n}): React.ReactNode {\n  // `<details>` is controlled: React would otherwise reset the DOM's own\n  // `open` on the next render (the transcript re-renders on every poll), so the\n  // toggle event — the only reliable report of a native open/close — is the\n  // single source of truth.\n  const [open, setOpen] = useState(false)\n  return (\n    <details\n      className={css.sidechatForkPoint}\n      data-sidechat-fork-point=\"\"\n      open={open}\n      onToggle={event => setOpen(event.currentTarget.open)}\n    >\n      {/* The collapsed line IS the opening divider: the same hairline-and-copy\n          chrome as the closing one, plus the disclosure's own chevron. It never\n          carries inherited text — the line says where the context came from,\n          not what was said in it. */}\n      <summary\n        className={clsx(css.sidechatForkDivider, css.sidechatForkPointLine)}\n        data-sidechat-fork-divider=\"\"\n      >\n        {t('sideChatForkDivider')}\n        <span className={css.sidechatRowChevron}>\n          <IconChevronRightOutlineRegular size={12} />\n        </span>\n      </summary>\n      {/* The body stays mounted (a closed `<details>` hides it natively), so\n          expanding costs no refetch and the exchange is already there. */}\n      <div className={css.sidechatForkPointBody}>\n        {props.user === undefined\n          ? null\n          : (\n            // The same presentation block a user row renders, so the inherited\n            // question can never drift from the thread's own bubbles.\n            <div className={css.sidechatUser} data-sidechat-fork-question=\"\">\n              <MarkdownText {...markdownTextProps(props.rewrite(props.user), props.labels)} />\n            </div>\n          )}\n        {props.answer === undefined || props.answer === ''\n          ? null\n          : (\n            <div className={css.sidechatAssistant}>\n              <MarkdownText {...markdownTextProps(props.rewrite(props.answer), props.labels)} />\n            </div>\n          )}\n        {/* The same line closes the block: the inherited context stops here, so\n            what follows reads as this thread's own conversation again. */}\n        <div className={css.sidechatForkDivider} data-sidechat-fork-divider-end=\"\">\n          {t('sideChatForkDividerEnd')}\n        </div>\n      </div>\n    </details>\n  )\n}\n\n/** The host Block body for a structured tool card (main-conversation atoms:\n *  terminal surface, diff hunks, line-numbered read window). */\nfunction toolCardBody(card: SidechatToolCard, executing: boolean, labels: RowLabels): React.ReactNode {\n  if (card.type === 'terminal') {\n    return (\n      <TerminalBlock\n        command={card.command}\n        cwd={card.cwd}\n        output={card.output}\n        exitCode={card.exitCode}\n        signal={card.signal}\n        running={executing}\n        labels={labels.terminal}\n      />\n    )\n  }\n  if (card.type === 'diff') {\n    return <DiffBlock diffs={card.diffs} labels={labels.diff} />\n  }\n  if (card.type === 'search') {\n    return <SearchBlock {...card.card} labels={labels.search} />\n  }\n  if (card.type === 'web') {\n    return <WebBlock {...card.card} labels={labels.web} />\n  }\n  return <ReadBlock label={card.label} lines={card.lines} totalLines={card.totalLines} lang={card.lang} labels={labels.read} />\n}\n\n/** The tool row's 16px leading slot, the way the main conversation draws it\n *  (GenericToolCard's variant table): the tool-kind glyph at 14, replaced by\n *  an error StateDot on failed rows. */\nfunction toolLeading(name: string, failed: boolean): React.ReactNode {\n  if (failed) return <StateDot state=\"error\" />\n  switch (name) {\n    case 'bash':\n    case 'pwsh':\n      return <IconApiOutlineRegular size={14} />\n    case 'read':\n    case 'web_fetch':\n      return <IconBrowseOutlineRegular size={14} />\n    case 'edit':\n    case 'write':\n      return <IconEditOutlineRegular size={14} />\n    case 'grep':\n    case 'glob':\n    case 'web_search':\n      return <IconSearchOutlineRegular size={14} />\n    default:\n      return <IconSparkleRegular size={14} />\n  }\n}\n\n/** The per-view helpers every row renderer needs, collected in one stable\n *  object so a row body never rebuilds them per render. */\ninterface RowSurface {\n  /** The row's prose pass: local image destinations become session media URLs\n   *  first, then the surface's local-link pass runs (see the view's wiring).\n   *  Takes the ROW (not its text) so the view can reuse an unchanged row's\n   *  rewrite result by object identity. Only prose rows (user / assistant)\n   *  carry `text`; the other kinds never run this pass. */\n  rewrite: (row: Extract<SidechatTranscriptRow, { text: string }>) => string\n  /** Open one delivered file through the plugin's own open path. */\n  openFile: (path: string) => void\n  /** The session-scoped media URL of one image deliverable. */\n  media: (path: string) => string\n  /** The absolute spelling of one delivered path (the row's title tooltip;\n   *  call-argument paths arrive relative to the session cwd). */\n  resolvePath: (path: string) => string\n  /** Inline-code file-mention vocabulary: the paths THIS thread produced (see\n   *  sidechat-mentions.ts). Undefined when the thread has produced nothing, so\n   *  the renderer keeps every token inert code. */\n  mentions: MarkdownFileMentions | undefined\n  /** Render one row's `image` / `file` blocks (D13); the read is bound to the\n   *  thread that owns the referencing log. */\n  attachments: (list: readonly SidechatAttachment[]) => React.ReactNode\n}\n\n/** One row renderer (React keys ride the source event seq). `surface` is the\n *  markdown prose pass the rows run before rendering — the rows are model\n *  prose, so a relative destination resolves against the session cwd (see\n *  use-markdown-surface) — plus the delivered-file open and media helpers.\n *  `genui` binds the rows to the owning child thread: the key remounts every\n *  row when the tab switches threads, and a registered GenUI consumer may\n *  claim a visible, settled assistant row (see SidechatAssistantRow). */\nfunction renderRow(row: SidechatTranscriptRow, labels: RowLabels, surface: RowSurface, genui: SidechatRowSurfaceBinding): React.ReactNode {\n  const key = `${genui.threadId ?? 'unbound'}:${sidechatRowKey(row)}`\n  switch (row.kind) {\n    case 'user':\n      return (\n        <div key={key} className={css.sidechatUser}>\n          {row.text !== '' && <MarkdownText {...markdownTextProps(surface.rewrite(row), labels, undefined, surface.mentions)} />}\n          <SidechatImages visible={genui.visible} childId={genui.threadId} messageId={row.messageId} images={row.images} />\n          {row.attachments === undefined || row.attachments.every(a => a.kind !== 'file')\n            ? null\n            : surface.attachments(row.attachments.filter(a => a.kind === 'file'))}\n        </div>\n      )\n    case 'attachment':\n      // One `image` / `file` content block of an assistant message, kept in\n      // block order as its own row (D13). User-message images do NOT land here\n      // — the user bubble draws them through the upstream `SidechatImages`\n      // surface, and the bubble keeps only its `file` blocks on this path.\n      return (\n        <div key={key} className={css.sidechatAttachmentRow}>\n          {surface.attachments([row.attachment])}\n        </div>\n      )\n    case 'assistant':\n      return (\n        <SidechatAssistantRow\n          key={key}\n          row={row}\n          labels={labels}\n          rewrite={surface.rewrite}\n          fileMentions={surface.mentions}\n          surface={genui}\n        />\n      )\n    case 'reasoning':\n      // Reasoning is PROSE from a model that writes markdown (emphatic lists,\n      // inline code, file references). It renders through the host renderer —\n      // the same component (and the same delegate surface) as the assistant\n      // row, so emphasis/lists/code become elements and a local link is\n      // claimed by the host instead of showing its literal syntax. The\n      // collapsed summary reports how much thinking there is; no duration is\n      // available for a reasoning row, so none is invented.\n      return (\n        <CollapsibleRow\n          key={key}\n          label={labels.thinkLabel}\n          meta={t('sideChatReasoningSummary', { chars: row.text.length })}\n          streaming={!row.settled}\n        >\n          <MarkdownText {...markdownTextProps(surface.rewrite(row), labels, undefined, surface.mentions)} />\n        </CollapsibleRow>\n      )\n    case 'injection':\n      return (\n        <CollapsibleRow key={key} label={labels.injectionLabel}>\n          <div className={css.sidechatRowProse}>{row.text}</div>\n        </CollapsibleRow>\n      )\n    case 'error':\n      // A provider/agent failure: rendered plainly (never markdown) so a raw\n      // provider message with odd punctuation survives verbatim.\n      return (\n        <div key={key} className={css.sidechatErrorRow}>\n          {t('sideChatRunError', { message: row.text })}\n        </div>\n      )\n    case 'terminal':\n      // The turn ended without a normal completion: say which way (the reader\n      // stopped it vs the output limit cut it), because the next thing the\n      // reader does differs — resend, or continue in a fresh turn.\n      return (\n        <div key={key} className={css.sidechatTerminal}>\n          {t(row.reason === 'max-tokens' ? 'sideChatTerminalMaxTokens' : 'sideChatTerminalAborted')}\n        </div>\n      )\n    case 'compaction': {\n      // The row LINE is a label plus the counts it has; the summary body (when\n      // the thread still has it) lives behind the disclosure, because a\n      // compacted summary is a page of prose, not a line.\n      const meta = [\n        row.shadowedItemCount === null ? '' : t('sideChatCompactionItems', { count: row.shadowedItemCount }),\n        row.shadowedTokenCount === null ? '' : t('sideChatCompactionTokens', { tokens: row.shadowedTokenCount }),\n      ].filter(part => part !== '').join(' · ')\n      return (\n        <CollapsibleRow\n          key={key}\n          label={t('sideChatCompactionSummary')}\n          {...(meta === '' ? {} : { meta })}\n        >\n          {row.text === '' ? undefined : <div className={css.sidechatRowProse}>{row.text}</div>}\n        </CollapsibleRow>\n      )\n    }\n    case 'retry':\n      // One quiet line per retry CHAIN: how many attempts, and why the model\n      // call failed. The provider's own failure text is the reason, so it rides\n      // the meta slot rather than a sentence the plugin invents.\n      return (\n        <CollapsibleRow\n          key={key}\n          label={t('sideChatRetryAttempt', { retry: row.retry })}\n          {...(row.failureMessage === undefined ? {} : { meta: row.failureMessage })}\n        />\n      )\n    case 'turnSummary': {\n      // Quiet turn-tail metrics: token usage + wall duration, main-pane\n      // StatsLine formatting. Parts appear only when computable.\n      const parts: string[] = []\n      if (row.inputTokens !== undefined && row.outputTokens !== undefined) {\n        parts.push(t('sideChatTurnUsage', { input: formatTokens(row.inputTokens), output: formatTokens(row.outputTokens) }))\n      }\n      if (row.durationMs !== undefined) parts.push(formatDurationMs(row.durationMs))\n      if (parts.length === 0) return null\n      return (\n        <div key={key} className={css.sidechatTurnSummary}>\n          {parts.join(' · ')}\n        </div>\n      )\n    }\n    case 'deliverables': {\n      return (\n        <div key={`${row.kind}:${row.seq}`} className={css.sidechatDeliverables}>\n          <div className={css.sidechatDeliverablesHead}>{t('sideChatDeliverables')}</div>\n          <ul className={css.sidechatDeliverablesList}>\n            {row.files.map((file, index) => {\n              const name = baseName(file.path)\n              // The visible description is part of the button's accessible\n              // name too: an `Open {name}` label alone would hide it from\n              // assistive tech while sighted readers see it.\n              const openLabel = file.description === undefined\n                ? t('sideChatDeliverableOpen', { name })\n                : `${t('sideChatDeliverableOpen', { name })}: ${file.description}`\n              return (\n                <li key={`${String(index)}:${file.path}`} className={css.sidechatDeliverableItem}>\n                  {/* One row per delivered file: the type glyph (and an image's\n                      own thumbnail) plus the basename, the description, and a\n                      click that opens the file through the plugin's editor\n                      path — the same open the transcript's file links use. */}\n                  <button\n                    type=\"button\"\n                    className={css.sidechatDeliverable}\n                    title={surface.resolvePath(file.path)}\n                    aria-label={openLabel}\n                    onClick={() => { surface.openFile(file.path) }}\n                  >\n                    {classifyFileType(file.path) === 'image'\n                      ? <img className={css.sidechatDeliverableThumb} src={surface.media(file.path)} alt=\"\" loading=\"lazy\" />\n                      : null}\n                    <FileTypeIcon path={file.path} size={16} />\n                    <span className={css.sidechatDeliverableName}>{name}</span>\n                    {file.description !== undefined && (\n                      <span className={css.sidechatDeliverableDesc}>{file.description}</span>\n                    )}\n                  </button>\n                </li>\n              )\n            })}\n          </ul>\n        </div>\n      )\n    }\n    case 'tool': {\n      // A tool WITHOUT a structured card (grep/glob/web_search and every host\n      // tool this view does not know): the collapsed line carries the one-line\n      // argument summary, and the disclosed body splits into two LABELLED\n      // sections — raw arguments, then raw output — so a reader who expands\n      // always knows which block is which (two unlabelled <pre>s of JSON next\n      // to raw output was a wall of escaped quotes).\n      const resultAttachments = row.resultAttachments === undefined || row.resultAttachments.length === 0\n        ? null\n        : surface.attachments(row.resultAttachments)\n      const body = (\n        <>\n          {row.card !== undefined\n            ? toolCardBody(row.card, row.executing === true, labels)\n            : (\n              <>\n                {row.args !== undefined && (\n                  <>\n                    <div className={css.sidechatToolSectionLabel}>{t('sideChatToolArguments')}</div>\n                    <pre className={css.sidechatRowCode}>{row.args}</pre>\n                  </>\n                )}\n                {row.resultText !== undefined && (\n                  <>\n                    <div className={css.sidechatToolSectionLabel}>{t('sideChatToolResult')}</div>\n                    <pre className={css.sidechatRowCode}>{row.resultText}</pre>\n                  </>\n                )}\n              </>\n            )}\n          {resultAttachments}\n        </>\n      )\n      return (\n        <CollapsibleRow\n          key={key}\n          label={row.name}\n          meta={toolArgsSummary(row.args)}\n          icon={toolLeading(row.name, row.failed)}\n          mono\n          streaming={row.executing === true}\n          failed={row.failed}\n          {...(row.args === undefined && row.resultText === undefined && row.card === undefined\n            && resultAttachments === null ? {} : { children: body })}\n        />\n      )\n    }\n  }\n}\n\n/** One side conversation tab (one thread per tab, Codex-style). */\nexport function SideChatView(props: {\n  ctx: Context\n  scope: SessionScope\n  tab: SidebarTab\n  visible: boolean\n  /** Which gesture submits the draft: a plain `Enter` (the default, host\n   *  semantics) or exactly `Cmd+Enter` / `Ctrl+Enter`. The side card settings\n   *  page feeds it from the side-chat feature's own preferences (see\n   *  `sidechatSubmitKeyOf` in prefs.ts); absent reads the default, which keeps\n   *  every existing composition unchanged. */\n  submitKey?: SidechatSubmitKey\n}): React.ReactNode {\n  const { ctx, scope, tab, visible } = props\n  const submitKey = props.submitKey ?? SIDECHAT_SUBMIT_KEY_DEFAULT\n  /** The main conversation's work-details preference, read live (see\n   *  sidechat-work-details.ts): the two transcripts of one conversation must\n   *  agree about how much process detail to show. */\n  const workDetails = useSidechatWorkDetails(ctx)\n  const rowLabels = useMemo<RowLabels>(() => {\n    // Shared Block chrome: copy buttons reuse the sidebar's copy pair, the\n    // collapse/expand family is common to every Block kind.\n    const shared = {\n      copy: t('copy'),\n      copied: t('copied'),\n      collapse: t('sideChatBlockCollapse'),\n      collapseAria: t('sideChatBlockCollapseAria'),\n      expand: (hidden: number) => t('sideChatBlockExpand', { hidden }),\n      expandAria: (hidden: number) => t('sideChatBlockExpandAria', { hidden }),\n    }\n    // DSH 0.1.7-rc.1 widened the diff / read cards into code cards and DELETED\n    // `DiffBlockLabels.files`, so the old \"N files\" footer is gone and these\n    // three strings are required by both cards.\n    const codeCard = {\n      codeLabel: t('codeBlockTitle'),\n      wrapLabel: t('codeBlockWrap'),\n      unwrapLabel: t('codeBlockUnwrap'),\n    }\n    return {\n      copyLabel: t('copy'),\n      copiedLabel: t('copied'),\n      ...codeCard,\n      thinkLabel: t('sideChatThink'),\n      injectionLabel: t('sideChatInjection'),\n      terminal: {\n        ...shared,\n        commandLine: (line: number) => t('sideChatBlockCommandLine', { line }),\n        signal: (signal: string) => t('sideChatBlockSignal', { signal }),\n        exitCode: (exitCode: number) => t('sideChatBlockExitCode', { code: exitCode }),\n        // DSH 0.1.6-alpha.2 added this pill text: a settle the view cannot\n        // name (killed by an unknown signal, or never started).\n        noExitCode: t('sideChatBlockNoExitCode'),\n        running: t('sideChatBlockRunning'),\n        failed: t('sideChatBlockFailed'),\n        done: t('sideChatBlockDone'),\n        noOutput: t('sideChatBlockNoOutput'),\n      },\n      diff: { ...shared, ...codeCard },\n      read: { ...shared, ...codeCard, window: (shown: number, total: number) => t('sideChatBlockWindow', { shown, total }) },\n      // The host cards' summaries are FUNCTIONS (the shown/total pair folds\n      // into one clause), so the two count pairs stay separate keys rather than\n      // a template with six placeholders. `noResults` is shared: an empty grep\n      // and an empty web search say the same thing to the reader.\n      search: {\n        ...shared,\n        pathsSummary: (shown: number, total: number, truncated: boolean) => t(\n          truncated ? 'sideChatSearchPathsTruncated' : 'sideChatSearchPaths',\n          { shown, total },\n        ),\n        matchesSummary: (shown: number, total: number, files: number, truncated: boolean) => t(\n          truncated ? 'sideChatSearchMatchesTruncated' : 'sideChatSearchMatches',\n          { shown, total, files },\n        ),\n        noResults: t('sideChatSearchNoResults'),\n      },\n      web: {\n        noResults: t('sideChatSearchNoResults'),\n        sourcesTruncated: t('sideChatWebSourcesTruncated'),\n        http: t('sideChatWebHttp'),\n        contentTruncated: t('sideChatWebContentTruncated'),\n        // The card renders the provider's answer as markdown of its own, so it\n        // needs the same nested chrome (and the cached identity) as the rows.\n        markdown: markdownLabels({ copyLabel: t('copy'), copiedLabel: t('copied'), ...codeCard }),\n      },\n    }\n  }, [])\n  /**\n   * Remote-image previews: the host's `MarkdownImage` wraps an `<img>` in its\n   * preview button and mounts `ImageLightbox` ONLY when the surrounding\n   * `MarkdownDelegateProvider` supplies `fileImages` — the main conversation\n   * always did, the side chat never did, so the same screenshot enlarged in the\n   * main pane and did nothing here.\n   *\n   * `resolve` declines on purpose. It is the LOCAL-image vocabulary (a decoded\n   * workspace path → displayable URL); the transcript already rewrites local\n   * destinations into session media URLs before rendering (markdown-images.ts),\n   * and the host only grows a hover preview card on an image LINK when\n   * `resolve` answers with a URL — declining is what keeps a `[shot](a.png)`\n   * link a plain file button.\n   *\n   * Identity matters: the provider memoizes its delegate on this object, and a\n   * fresh one per render would push a new context value through every memoized\n   * markdown row on every keystroke.\n   *\n   * `fileDrag` (DSH 0.2.2) is the handle the host's `useImageDrag` asks before\n   * it starts a drag. The side chat owns no file transport of its own — a drag\n   * out of this transcript is the browser's own image drag — so `start` answers\n   * `true` WITHOUT writing a transfer payload (the contract's \"browser dragging\"\n   * branch) and there is never a prepared resource to release. `reportFailure`\n   * reuses the transcript's existing image-error surface, so a refused\n   * preparation is visible instead of silent.\n   */\n  const fileImages = useMemo(() => ({\n    fileDrag: {\n      prepare: async () => ({ start: () => true, release: () => {} }),\n      reportFailure: () => { setError(t('sideChatImageFailed')) },\n    },\n    resolve: (): string | undefined => undefined,\n    labels: {\n      open: t('sideChatImageOpen'),\n      loading: t('sideChatImageLoading'),\n      failed: t('sideChatImageFailed'),\n      dialog: t('sideChatImageDialog'),\n      close: t('sideChatImageClose'),\n    },\n  }), [])\n\n  // The session list feed: thread rows (the composer-bar thread menu) + running states.\n  const list = useSyncExternalStore(\n    useMemo(() => (callback: () => void) => ctx.sessions.list.subscribe(callback), [ctx]),\n    useCallback(() => ctx.sessions.list.getSnapshot(), [ctx]),\n  )\n  // Archived threads are dropped from the menu (and from the switch targets):\n  // the host hides archived sessions itself, and binding a tab to one would\n  // strand the panel on a session it refuses to open.\n  const archivedIds = useArchivedSessionIds(ctx)\n  const threads = useMemo(() => {\n    const archived = new Set(archivedIds)\n    return sideThreadRows(list.byId, scope.sessionId).filter(row => !archived.has(row.id))\n  }, [list, scope.sessionId, archivedIds])\n\n  /** The newest thread of `candidates`: the session list carries the thread\n   *  rows but not their age, so the creation order comes from the host's\n   *  subagent catalog. An untouched \"new thread\" placeholder only wins when\n   *  nothing else is left. */\n  const newestThreadId = useCallback((candidates: readonly SideThreadRow[]): string | undefined => {\n    const catalog = list.projectionsBySession?.[scope.sessionId]?.values.subagentCatalog\n    const createdAt = new Map((catalog ?? []).map(entry => [entry.id, entry.createdAt]))\n    const rank = (id: string): number => createdAt.get(id) ?? 0\n    const real = candidates.filter(row => row.title !== SIDE_NEW_THREAD_TITLE)\n    const pool = real.length > 0 ? real : candidates\n    if (pool.length === 0) return undefined\n    return pool.reduce((newest, row) => (rank(row.id) > rank(newest.id) ? row : newest)).id\n  }, [list, scope.sessionId])\n\n  // The thread this tab is bound to rides tab.meta (refresh-restored).\n  const threadId = sidechatThreadIdOf(tab)\n  const autoCreate = (tab.meta as { autoCreate?: unknown } | undefined)?.autoCreate === true\n\n  const draft = useSidechatDraft(threadId)\n  const composer = draft.owner.text\n  const setComposer = draft.setText\n  const fileInputRef = useRef<HTMLInputElement | null>(null)\n  const [busy, setBusy] = useState<'starting' | 'sending' | 'saving' | 'archiving' | null>(null)\n  const [error, setError] = useState<string | null>(null)\n  const [saved, setSaved] = useState(false)\n  const [revision, setRevision] = useState(0)\n  const [info, setInfo] = useState<SidechatThreadInfo | null>(null)\n  const [menuOpen, setMenuOpen] = useState(false)\n  const [modelMenuOpen, setModelMenuOpen] = useState(false)\n  const [catalog, setCatalog] = useState<SidechatModelCatalog | null>(null)\n  /** Rows the reader explicitly revealed above the tail window (one\n   *  {@link TRANSCRIPT_REVEAL_STEP} per activation). */\n  const [revealedRows, setRevealedRows] = useState(0)\n  /** Whether the reader is following the tail (the host's near-bottom rule,\n   *  re-read from the scroller's own `scroll` events). It is an INTENT: the\n   *  stream pins the scroller only while it holds, so a reader who scrolled up\n   *  to re-read an answer is not yanked back by the next host push. */\n  const [followingTail, setFollowingTail] = useState(true)\n  /** Local echo of the message just sent: shown until the host reports it\n   *  pending or logs it durably (see the drop effect below). The echo is\n   *  retired by the host-assigned `messageId`, so an OLDER identical message\n   *  cannot retire it. */\n  const [echo, setEcho] = useState<{ text: string; messageId: string; hasImages: boolean } | null>(null)\n\n  const cacheRef = useRef<ThreadCache>({ entries: [], live: [], pending: [], truncated: false })\n  // The previous poll's rows (see the mapping's reuse pass below).\n  const prevRowsRef = useRef<SidechatTranscriptRow[]>([])\n  const controllerRef = useRef<AbortController | null>(null)\n  /** The pending push-driven pull (one per burst of host frames). */\n  const invalidateRef = useRef