/client/builtins/tab-icons.tsx","../../../src/client/locales.ts","../../../src/client/address-base.ts","../../../src/client/resource-address.ts","../../../src/client/sidebar-file.ts","../../../node_modules/.pnpm/clsx@2.1.1/node_modules/clsx/dist/clsx.mjs","../../../src/html-route.ts","../../../src/client/api.ts","../../../src/client/binary-download.tsx","../../../src/client/editor-load.ts","../../../src/client/markdown-path-repair.ts","../../../src/client/editor-draft-backup.ts","../../../src/client/editor-dirty.ts","../../../node_modules/.pnpm/react-icons@5.7.0_react@18.2.0/node_modules/react-icons/si/index.mjs","../../../src/client/file-tree-compact.ts","../../../src/client/file-tree-sort.ts","../../../src/client/icons.tsx","../../../src/client/ime-guard.ts","../../../src/client/ui/kit.tsx","../../../src/client/ui/git-status.ts","../../../src/client/upload.ts","../../../src/client/use-dir-watch.ts","../../../src/client/use-polling.ts","../../../src/client/FileTree.tsx","../../../src/client/frame-batcher.ts","../../../src/client/open-with.ts","../../../src/client/changes/ops.ts","../../../src/client/ops-stream.ts","../../../src/client/prefs.ts","../../../src/client/plugin-settings.ts","../../../src/client/open-in-app.ts","../../../src/client/UploadOverlay.tsx","../../../src/client/TreePanel.tsx","../../../src/client/tree-mutations.ts","../../../src/client/EditorHost.tsx","../../../src/client/open-with-settings.tsx","../../../src/client/changes/CommitModelSettings.tsx","../../../src/client/viewport-inset.ts","../../../src/client/AnchoredPopover.tsx","../../../src/client/changes/graph-layout.ts","../../../src/client/changes/git-graph-windowing.ts","../../../src/client/changes/GitGraphSection.tsx","../../../src/client/changes/change-tree.ts","../../../src/client/changes/GitLens.tsx","../../../src/client/markdown-labels.tsx","../../../src/client/changes/CommitDetails.tsx","../../../src/client/diff/rows.ts","../../../src/client/changes/SessionLens.tsx","../../../src/cli