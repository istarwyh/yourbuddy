line ranges. The rewrite pairing applies within\n * each hunk, exactly like session-op diffs.\n */\nexport function unifiedSegments(file: DiffFile): DiffSegment[] {\n  const segments: DiffSegment[] = []\n  file.hunks.forEach((hunk, index) => {\n    const rows = pairMods(hunk.lines.map(rowOfLine))\n    const prev = file.hunks[index - 1]\n    if (prev !== undefined) {\n      // The gap git never emitted: rows are unknown (non-expandable), but\n      // the ranges are derivable from the surrounding hunk headers/counts.\n      const prevOldEnd = prev.oldStart + prev.lines.filter(line => line.oldNum !== null).length - 1\n      const prevNewEnd = prev.newStart + prev.lines.filter(line => line.newNum !== null).length - 1\n      const oldGap = hunk.oldStart - prevOldEnd - 1\n      const newGap = hunk.newStart - prevNewEnd - 1\n      if (oldGap > 0 || newGap > 0) {\n        segments.push({\n          kind: 'fold',\n          count: Math.max(oldGap, newGap, 0),\n          oldStart: prevOldEnd + 1,\n          oldEnd: Math.max(hunk.oldStart - 1, prevOldEnd),\n          newStart: prevNewEnd + 1,\n          newEnd: Math.max(hunk.newStart - 1, prevNewEnd),\n        })\n      }\n    } else if (hunk.oldStart > 1 || hunk.newStart > 1) {\n      // Leading context git trimmed (e.g. -U0 diffs).\n      segments.push({\n        kind: 'fold',\n        count: Math.max(hunk.oldStart - 1, hunk.newStart - 1, 0),\n        oldStart: 1,\n        oldEnd: hunk.oldStart - 1,\n        newStart: 1,\n        newEnd: hunk.newStart - 1,\n      })\n    }\n    segments.push({ kind: 'hunk', rows })\n  })\n  return segments\n}\n\n/** Build the untracked-file shape: one file, one hunk of pure additions. */\nexport function untrackedFile(path: string, content: string): DiffFile {\n  const lines: DiffLine[] = []\n  const body = content.endsWith('\\n') ? content.slice(0, -1) : content\n  if (body !== '') {\n    let num = 1\n    for (const line of body.split('\\n')) {\n      lines.push({ kind: 'add', text: line, oldNum: null, newNum: num })\n      num += 1\n    }\n  }\n  return { oldPath: '/dev/null', newPath: `b/${path}`, binary: false, hunks: [{ oldStart: 0, newStart: 1, header: '', lines }] }\n}\n\n/**\n * Materialize a git gap fold's hidden rows from the two sides' full file\n * contents, by the fold's known line ranges: the old side drives context\n * rows (each mapped onto the new side through the fold's offset — a gap is\n * an unchanged run, so the sides align), and new-side lines the old range\n * never reaches become pure additions. Line numbers clip to the actual\n * content (a no-newline file's ranges can overrun by one); `\\r` endings\n * survive verbatim, like git's own context lines.\n */\nexport function foldRowsFromContents(fold: FoldSegment, oldContent: string, newContent: string): DiffRow[] {\n  const oldLines = oldContent.length === 0 ? [] : oldContent.split('\\n')\n  const newLines = newContent.length === 0 ? [] : newContent.split('\\n')\n  const offset = fold.newStart - fold.oldStart\n  const rows: DiffRow[] = []\n  const oldFrom = Math.max(fold.oldStart, 1)\n  const oldTo = Math.min(fold.oldEnd, oldLines.length)\n  for (let oldLine = oldFrom; oldLine <= oldTo; oldLine += 1) {\n    const text = oldLines[oldLine - 1]!\n    const newLine = oldLine + offset\n    rows.push(\n      newLine >= fold.newStart && newLine <= fold.newEnd && newLine <= newLines.length\n        ? { kind: 'context', oldLine, newLine, text }\n        : { kind: 'context', oldLine, text },\n    )\n  }\n  // New-side lines beyond what the old range reached (a pure-addition gap):\n  // rows carrying only the new-side number, exactly like added lines.\n  const newFrom = Math.max(fold.newStart, 1)\n  const newTo = Math.min(fold.newEnd, newLines.length)\n  for (let newLine = Math.max(newFrom, oldTo + offset + 1); newLine <= newTo; newLine += 1) {\n    rows.push({ kind: 'add', newLine, text: newLines[newLine - 1]! })\n  }\n  return rows\n}\n\n/** Strip the `a/` / `b/` prefix git puts on diff paths (not on /dev/null). */\nexport function displayPath(path: string): string {\n  if (path === '/dev/null') return path\n  if (path.startsWith('a/') || path.startsWith('b/')) return path.slice(2)\n  return path\n}\n\n/**\n * The diff's insert/delete counts (the \"+n −m\" header chips), in git's\n * accounting: one rewritten line is one insertion plus one deletion. It\n * renders as a pair of `mod` rows (one per side), so count SIDES rather than\n * rows — counting each `mod` row as both an add and a delete reported a\n * single-line rewrite as +2 −2, which matched neither `git diff --numstat`\n * nor the `-old` / `+new` pair drawn on screen.\n */\nexport function diffStats(segments: readonly DiffSegment[]): { added: number; deleted: number } {\n  let added = 0\n  let deleted = 0\n  for (const segment of segments) {\n    if (segment.kind !== 'hunk') continue\n    for (const row of segment.rows) {\n      const onNewSide = row.kind === 'add' || (row.kind === 'mod' && row.newLine !== undefined)\n      const onOldSide = row.kind === 'del' || (row.kind === 'mod' && row.oldLine !== undefined)\n      if (onNewSide) added += 1\n      if (onOldSide) deleted += 1\n    }\n  }\n  return { added, deleted }\n}\n","/**\n * The session lens of the changes tab: agent truth — every file the model\n * read, wrote, or edited in this session, one operation per row, newest first,\n * with kind filters. Clicking an op previews it in the tab's shared bottom\n * pane (see {@link DiffPane}): writes and edits as line diffs, reads as a\n * line-numbered content view, failures as their real error text. The ops\n * arrive pre-folded from the tab (which owns the event poll); this\n * component is purely presentational.\n */\nimport { useMemo, useState } from 'react'\nimport { relativeTime, t } from '../locales.ts'\nimport type { FileOp, FileOpKind } from './ops.ts'\nimport { formatBytes } from '../diff/rows.ts'\nimport { Chip, Notice, StatusBadge } from '../ui/index.ts'\nimport css from './changes.module.css'\n\n/** The op-kind filter chips: 'all' or one concrete kind. */\ntype OpFilter = 'all' | FileOpKind\n\nconst KIND_LABEL = { read: 'changesRead', write: 'changesWrite', edit: 'changesEdit' } as const\n\nexport interface SessionLensProps {\n  /** The folded file operations, newest first (the tab's poll owns them). */\n  ops: readonly FileOp[]\n  /** Every poll failed and nothing loaded: an inline notice, not an empty\n   *  state that would read as \"no operations\". */\n  loadError: boolean\n  /** Preview one op in the shared bottom pane. */\n  onPreview: (path: string, op: FileOp) => void\n  /** The op currently previewed (row highlight); null when the pane is closed. */\n  selectedCallId: string | null\n}\n\nexport function SessionLens({ ops, loadError, onPreview, selectedCallId }: SessionLensProps) {\n  const [filter, setFilter] = useState<OpFilter>('all')\n  const filteredOps = useMemo(\n    () => (filter === 'all' ? ops : ops.filter(op => op.kind === filter)),\n    [ops, filter],\n  )\n  const counts = useMemo(() => {\n    const map = new Map<FileOpKind, number>([['read', 0], ['write', 0], ['edit', 0]])\n    for (const op of ops) map.set(op.kind, (map.get(op.kind) ?? 0) + 1)\n    return map\n  }, [ops])\n\n  // Sizing a row's content constructs a Blob (a UTF-8 encode of the whole\n  // edit) — that was per row PER RENDER, re-encoding every field on every\n  // poll tick. ops keeps its identity between unchanged polls (see the\n  // tab's opsRef), so one pass per changed fold covers every render.\n  const opSizes = useMemo(() => {\n    const sizes = new Map<string, string>()\n    for (const op of ops) {\n      if (op.kind !== 'read' && !op.isError) {\n        sizes.set(op.callId, formatBytes(new Blob([op.edit?.newString ?? op.content ?? '']).size))\n      }\n    }\n    return sizes\n  }, [ops])\n\n  return (\n    <div className={css.session}>\n      <div className={css.filterRow} role=\"group\" aria-label={t('changesSessionLens')}>\n        <Chip active={filter === 'all'} count={ops.length} onClick={() => { setFilter('all') }}>\n          {t('changesFilterAll')}\n        </Chip>\n        {(['write', 'edit', 'read'] as const).map(kind => (\n          <Chip\n            key={kind}\n            active={filter === kind}\n            count={counts.get(kind) ?? 0}\n            onClick={() => { setFilter(kind) }}\n          >\n            {t(KIND_LABEL[kind])}\n          </Chip>\n        ))}\n      </div>\n      <div className={css.sessionList}>\n        {loadError && <Notice kind=\"error\" role=\"alert\">{t('changesLoadError')}</Notice>}\n        {ops.length === 0 && !loadError && <Notice kind=\"empty\" tone=\"page\">{t('changesSessionEmpty')}</Notice>}\n        {ops.length > 0 && filteredOps.length === 0 && <Notice kind=\"empty\" tone=\"page\">{t('changesFilterEmpty')}</Notice>}\n        {filteredOps.map(op => (\n          <button\n            type=\"button\"\n            key={op.callId}\n            className={css.opRow}\n            data-op-kind={op.kind}\n            data-op-error={op.isError ? 'true' : undefined}\n            data-selected={selectedCallId === op.callId ? 'true' : undefined}\n            onClick={() => { onPreview(op.path, op) }}\n          >\n            <StatusBadge tone={op.kind}>{t(KIND_LABEL[op.kind])}</StatusBadge>\n            {op.running && <span className={css.opFlag}>{t('changesRunning')}</span>}\n            {op.isError && <span className={css.opFlagError}>{t('changesError')}</span>}\n            <span className={css.filePath} title={op.path}>{op.path}</span>\n            <span className={css.opMeta}>\n              {opSizes.get(op.callId) !== undefined && (\n                <span className={css.opSize}>\n                  {opSizes.get(op.callId)}\n                </span>\n              )}\n              <span className={css.opTime}>{relativeTime(new Date(op.time).toISOString())}</span>\n            </span>\n          </button>\n        ))}\n      </div>\n    </div>\n  )\n}\n","/**\n * Shared vocabulary of the sidebar's HTML preview surfaces (the editor's\n * html viewer and the changes tab's op render preview): the sandbox tokens\n * both preview iframes load with.\n */\n\n/**\n * The sandbox tokens of an HTML preview iframe. NO allow-same-origin (the\n * preview must stay in an opaque origin — with the route's own origin it\n * could read session data) and NO allow-top-navigation (a previewed page\n * must not hijack the GUI). The editor viewer can disable the sandbox\n * per-feature in the side card settings (warned); the changes tab's op\n * render preview always stays sandboxed.\n */\nexport const HTML_IFRAME_SANDBOX = 'allow-scripts allow-popups allow-downloads allow-modals'\n","/**\n * Desktop-shell HTML preview inlining.\n *\n * The shell only injects its `x-dsh-desktop-renderer` header for a subframe\n * whose origin is literally `dsh-app://app`; a sandboxed HTML preview frame is\n * an opaque origin, so both the document navigation and every resource it\n * requests from `dsh-app:` are rejected by the shell before they reach the\n * plugin's routes (#1143). The sanctioned shape (the host's own document\n * preview uses it) is a self-contained document in a sandboxed `blob:` frame:\n * the trusted top frame fetches the HTML and its local resources through the\n * plugin routes, rewrites them to `data:` URLs / inline style and script\n * blocks, and the frame then needs no `dsh-app:` request at all.\n *\n * This module is pure on purpose (no fetch, no React): the caller supplies\n * `fetchResource`, so the resolution and rewriting rules are unit-testable and\n * the component owns transport, aborting and object-URL lifetime.\n *\n * Only same-origin resources are inlined. External http(s) URLs, `data:`,\n * `blob:` and `file:` are left exactly as authored; a failed local fetch also\n * leaves the authored reference (the page still renders, the one resource\n * may not). The returned document is always UTF-8 and keeps the route's\n * `object-src 'none'` defense as a meta CSP; the iframe sandbox attribute\n * remains the primary boundary (no `allow-same-origin` is ever added).\n */\n\n/** One fetched local resource, already in memory. */\nexport interface InlineResource {\n  readonly bytes: Uint8Array\n  readonly mediaType: string\n}\n\n/**\n * Fetch one same-origin resource. The caller decides how (the component uses\n * `fetch` with same-origin credentials and an abort signal); returning\n * undefined means \"leave the authored reference alone\".\n */\nexport type FetchInlineResource = (url: string) => Promise<InlineResource | undefined>\n\n/** Same protocol, credentials, host and port — `URL.origin` is `null` for\n *  custom schemes such as `dsh-app:`, so it cannot be used here. */\nfunction sameOrigin(a: URL, b: URL): boolean {\n  return a.protocol === b.protocol\n    && a.username === b.username\n    && a.password === b.password\n    && a.hostname === b.hostname\n    && a.port === b.port\n}\n\n/**\n * Resolve a same-origin resource reference. Returns undefined for empty /\n * fragment destinations, external origins, and every non-http(s)/non-custom\n * protocol this preview cannot inline.\n */\nexport function inlineableUrl(reference: string, baseUrl: string): URL | undefined {\n  const trimmed = reference.trim()\n  if (trimmed === '' || trimmed.startsWith('#')) return undefined\n  let url: URL\n  let base: URL\n  try {\n    base = new URL(baseUrl)\n    url = new URL(trimmed, base)\n  } catch {\n    return undefined\n  }\n  if (url.protocol === 'data:' || url.protocol === 'blob:' || url.protocol === 'file:' || url.protocol === 'javascript:') {\n    return undefined\n  }\n  if (!sameOrigin(url, base)) return undefined\n  return url\n}\n\n/** Base64 in bounded chunks so a multi-megabyte asset cannot overflow the\n *  argument stack through `String.fromCharCode(...bytes)`. */\nexport function bytesToBase64(bytes: Uint8Array): string {\n  let binary = ''\n  const chunk = 0x8000\n  for (let offset = 0; offset < bytes.length; offset += chunk) {\n    binary += String.fromCharCode(...bytes.subarray(offset, offset + chunk))\n  }\n  return btoa(binary)\n}\n\n/** The displayable `data:` URL for one fetched resource. */\nfunction dataUrlOf(resource: InlineResource): string {\n  const mediaType = resource.mediaType === '' ? 'application/octet-stream' : resource.mediaType\n  return `data:${mediaType};base64,${bytesToBase64(resource.bytes)}`\n}\n\n/** Decode a text resource (HTML is fetched separately by the caller). */\nfunction decodeText(bytes: Uint8Array): string {\n  return new TextDecoder('utf-8').decode(bytes)\n}\n\n/**\n * Per-document resource cache: the same image/CSS URL used twice is fetched\n * once, and every failure is memoized as \"not inlined\" instead of retried.\n */\nclass ResourceCache {\n  private readonly entries = new Map<string, Promise<InlineResource | undefined>>()\n\n  constructor(private readonly fetchResource: FetchInlineResource) {}\n\n  get(url: string): Promise<InlineResource | undefined> {\n    let entry = this.entries.get(url)\n    if (entry === undefined) {\n      entry = this.fetchResource(url).catch(() => undefined)\n      this.entries.set(url, entry)\n    }\n    return entry\n  }\n}\n\n/** `url(...)` in CSS, with or without quotes. */\nconst CSS_URL_RE = /url\\(\\s*(?:([\"'])(.*?)\\1|([^'\")\\s]+))\\s*\\)/gi\n/** `@import \"x\";` / `@import url(x) screen;`. */\nconst CSS_IMPORT_RE = /@import\\s+(?:url\\(\\s*)?(?:([\"'])(.*?)\\1|([^'\")\\s;]+))\\s*\\)?\\s*([^;]*);/gi\n\n/** The referenced URL of one `url(...)` match. */\nfunction cssUrlOf(match: RegExpMatchArray): string | undefined {\n  return match[2] ?? match[3]\n}\n\n/**\n * Rewrite one stylesheet's `@import` and `url(...)` references to inlined\n * content. Imported stylesheets are recursively expanded; a cycle yields an\n * empty expansion. Failures leave the authored reference untouched.\n * @param css - The stylesheet source.\n * @param cssUrl - The stylesheet's own URL (base for relative references).\n * @param cache - Per-document resource cache.\n * @param seen - Stylesheet URLs already on the current import chain.\n * @returns The rewritten CSS.\n */\nasync function inlineCss(css: string, cssUrl: string, cache: ResourceCache, seen: ReadonlySet<string> = new Set()): Promise<string> {\n  if (seen.has(cssUrl)) return ''\n  const chain = new Set(seen)\n  chain.add(cssUrl)\n\n  const importReplacements = new Map<string, string>()\n  for (const match of [...css.matchAll(CSS_IMPORT_RE)]) {\n    const reference = cssUrlOf(match)\n    if (reference === undefined) continue\n    const url = inlineableUrl(reference, cssUrl)\n    if (url === undefined) continue\n    const resource = await cache.get(url.href)\n    if (resource === undefined) continue\n    const nested = await inlineCss(decodeText(resource.bytes), url.href, cache, chain)\n    const media = (match[4] ?? '').trim()\n    importReplacements.set(match[0], media === '' ? nested : `@media ${media} {\\n${nested}\\n}`)\n  }\n  const withImports = css.replace(CSS_IMPORT_RE, (match) => importReplacements.get(match) ?? match)\n\n  const urlReplacements = new Map<string, string>()\n  const references = new Set<string>()\n  for (const match of withImports.matchAll(CSS_URL_RE)) {\n    const reference = cssUrlOf(match)\n    if (reference === undefined || reference.startsWith('#')) continue\n    references.add(reference)\n  }\n  await Promise.all([...references].map(async (reference) => {\n    const url = inlineableUrl(reference, cssUrl)\n    if (url === undefined) return\n    const resource = await cache.get(url.href)\n    if (resource === undefined) return\n    urlReplacements.set(reference, `url(\"${dataUrlOf(resource)}\")`)\n  }))\n  return withImports.replace(CSS_URL_RE, (match, _quote: string | undefined, quoted: string | undefined, bare: string | undefined) => {\n    const reference = quoted ?? bare\n    if (reference === undefined) return match\n    return urlReplacements.get(reference) ?? match\n  })\n}\n\n/** Inline one attribute that holds a single resource URL. */\nasync function inlineAttribute(element: Element, attribute: string, baseUrl: string, cache: ResourceCache): Promise<void> {\n  const reference = element.getAttribute(attribute)\n  if (reference === null) return\n  const url = inlineableUrl(reference, baseUrl)\n  if (url === undefined) return\n  const resource = await cache.get(url.href)\n  if (resource === undefined) return\n  element.setAttribute(attribute, dataUrlOf(resource))\n}\n\n/** Rewrite a `srcset` attribute. A value already carrying an inline/data URL\n *  is left alone: splitting it on commas would mangle the payload. */\nasync function inlineSrcset(value: string, baseUrl: string, cache: ResourceCache): Promise<string> {\n  if (/\\b(?:data|blob):/i.test(value)) return value\n  const candidates = value.split(',').map(candidate => candidate.trim()).filter(candidate => candidate !== '')\n  const rewritten: string[] = []\n  for (const candidate of candidates) {\n    const match = /^(\\S+)(\\s+.*)?$/.exec(candidate)\n    if (match === null) {\n      rewritten.push(candidate)\n      continue\n    }\n    const url = inlineableUrl(match[1] ?? '', baseUrl)\n    if (url === undefined) {\n      rewritten.push(candidate)\n      continue\n    }\n    const resource = await cache.get(url.href)\n    rewritten.push(resource === undefined ? candidate : `${dataUrlOf(resource)}${match[2] ?? ''}`)\n  }\n  return rewritten.join(', ')\n}\n\n/** Inline one stylesheet `<link>` as a `<style>` element. */\nasync function inlineStylesheet(link: Element, baseUrl: string, cache: ResourceCache): Promise<void> {\n  const reference = link.getAttribute('href')\n  if (reference === null) return\n  const url = inlineableUrl(reference, baseUrl)\n  if (url === undefined) return\n  const resource = await cache.get(url.href)\n  if (resource === undefined) return\n  const style = link.ownerDocument.createElement('style')\n  const media = link.getAttribute('media')\n  if (media !== null && media !== '') style.setAttribute('media', media)\n  style.textContent = await inlineCss(decodeText(resource.bytes), url.href, cache)\n  link.replaceWith(style)\n}\n\n/** Inline one external script as its own text. */\nasync function inlineScript(script: Element, baseUrl: string, cache: ResourceCache): Promise<void> {\n  const reference = script.getAttribute('src')\n  if (reference === null) return\n  const url = inlineableUrl(reference, baseUrl)\n  if (url === undefined) return\n  const resource = await cache.get(url.href)\n  if (resource === undefined) return\n  script.removeAttribute('src')\n  script.removeAttribute('integrity')\n  script.removeAttribute('crossorigin')\n  script.removeAttribute('async')\n  script.removeAttribute('defer')\n  script.textContent = decodeText(resource.bytes).replace(/<\\/script/gi, '<\\\\/script')\n}\n\n/** Whether a `link` element is a stylesheet. */\nfunction isStylesheet(link: Element): boolean {\n  const rel = (link.getAttribute('rel') ?? '').toLowerCase().split(/\\s+/)\n  return rel.includes('stylesheet') && link.hasAttribute('href')\n}\n\n/**\n * Build the self-contained document for one HTML file.\n * @param html - The authored HTML text.\n * @param documentUrl - The file's absolute route URL (the base for relatives).\n * @param fetchResource - Same-origin resource fetcher (injected; may fail).\n * @returns The rewritten, UTF-8, self-contained HTML.\n */\nexport async function inlineHtmlDocument(\n  html: string,\n  documentUrl: string,\n  fetchResource: FetchInlineResource,\n): Promise<string> {\n  const doc = new DOMParser().parseFromString(html, 'text/html')\n  const baseElement = doc.querySelector('base[href]')\n  let baseUrl = documentUrl\n  const authoredBase = baseElement?.getAttribute('href')\n  if (authoredBase !== undefined && authoredBase !== null && authoredBase !== '') {\n    try {\n      baseUrl = new URL(authoredBase, documentUrl).href\n    } catch {\n      // A malformed base falls back to the document URL.\n    }\n  }\n  baseElement?.removeAttribute('href')\n\n  const cache = new ResourceCache(fetchResource)\n  const tasks: Promise<void>[] = []\n\n  for (const link of [...doc.querySelectorAll('link')]) {\n    if (isStylesheet(link)) tasks.push(inlineStylesheet(link, baseUrl, cache))\n  }\n  for (const script of [...doc.querySelectorAll('script[src]')]) {\n    tasks.push(inlineScript(script, baseUrl, cache))\n  }\n  for (const image of [...doc.querySelectorAll('img[src]')]) {\n    tasks.push(inlineAttribute(image, 'src', baseUrl, cache))\n  }\n  for (const image of [...doc.querySelectorAll('img[srcset]')]) {\n    tasks.push(inlineSrcset(image.getAttribute('srcset') ?? '', baseUrl, cache).then((value) => image.setAttribute('srcset', value)))\n  }\n  for (const source of [...doc.querySelectorAll('source[src]')]) {\n    tasks.push(inlineAttribute(source, 'src', baseUrl, cache))\n  }\n  for (const source of [...doc.querySelectorAll('source[srcset]')]) {\n    tasks.push(inlineSrcset(source.getAttribute('srcset') ?? '', baseUrl, cache).then((value) => source.setAttribute('srcset', value)))\n  }\n  for (const video of [...doc.querySelectorAll('video[src]')]) {\n    tasks.push(inlineAttribute(video, 'src', baseUrl, cache))\n  }\n  for (const video of [...doc.querySelectorAll('video[poster]')]) {\n    tasks.push(inlineAttribute(video, 'poster', baseUrl, cache))\n  }\n  for (const audio of [...doc.querySelectorAll('audio[src]')]) {\n    tasks.push(inlineAttribute(audio, 'src', baseUrl, cache))\n  }\n  for (const track of [...doc.querySelectorAll('track[src]')]) {\n    tasks.push(inlineAttribute(track, 'src', baseUrl, cache))\n  }\n  for (const input of [...doc.querySelectorAll('input[type=\"image\"][src]')]) {\n    tasks.push(inlineAttribute(input, 'src', baseUrl, cache))\n  }\n  for (const image of [...doc.querySelectorAll('image')]) {\n    for (const attribute of ['href', 'xlink:href']) {\n      if (image.hasAttribute(attribute)) tasks.push(inlineAttribute(image, attribute, baseUrl, cache))\n    }\n  }\n\n  const styleElements = [...doc.querySelectorAll('style')]\n  const styledElements = [...doc.querySelectorAll('[style]')]\n  for (const style of styleElements) {\n    const source = style.textContent ?? ''\n    tasks.push(inlineCss(source, baseUrl, cache).then((css) => { style.textContent = css }))\n  }\n  for (const element of styledElements) {\n    const source = element.getAttribute('style') ?? ''\n    tasks.push(inlineCss(source, baseUrl, cache).then((css) => element.setAttribute('style', css)))\n  }\n\n  await Promise.all(tasks)\n\n  // The route declared UTF-8 for the document; the blob has no HTTP header to\n  // carry that, so the meta must. A conflicting authored charset is removed.\n  for (const meta of [...doc.querySelectorAll('meta[charset], meta[http-equiv]')]) {\n    if (meta.hasAttribute('charset')) {\n      meta.remove()\n      continue\n    }\n    if ((meta.getAttribute('http-equiv') ?? '').toLowerCase() === 'content-type') {\n      meta.setAttribute('content', 'text/html; charset=utf-8')\n    }\n  }\n  const head = doc.head ?? doc.documentElement\n  const charset = doc.createElement('meta')\n  charset.setAttribute('charset', 'utf-8')\n  head.prepend(charset)\n  const csp = doc.createElement('meta')\n  csp.setAttribute('http-equiv', 'Content-Security-Policy')\n  csp.setAttribute('content', \"object-src 'none'\")\n  head.prepend(csp)\n\n  return `<!DOCTYPE html>\\n${doc.documentElement.outerHTML}`\n}\n","/**\n * The HTML preview iframe shared by the editor's html viewer and the changes\n * tab. In a normal web deployment it is the historical route-src frame. In the\n * desktop shell with the sandbox ON it must be self-contained: the shell\n * rejects every `dsh-app:` request from an opaque-origin subframe (#1143),\n * so the trusted top frame fetches the document and its local resources,\n * rewrites them through `html-preview-inline.ts`, and frames the result as a\n * sandboxed `blob:` document. The sandbox attribute never gains\n * `allow-same-origin`.\n */\nimport { useEffect, useState, type ReactNode } from 'react'\nimport { hostHttpBase, isDesktopShell } from './desktop-env.ts'\nimport { HTML_IFRAME_SANDBOX } from './html-preview.ts'\nimport { inlineHtmlDocument } from './html-preview-inline.ts'\n\n/** One preview frame; `src` is the route URL of the saved HTML file. */\nexport interface HtmlPreviewFrameProps {\n  /** Absolute (or page-relative) `/sidebar/html/...` URL. */\n  src: string\n  title: string\n  className?: string\n  /** Whether the sandbox attribute is applied. Off is the explicit unsafe\n   *  escape hatch owned by the editor settings; the changes surface always\n   *  sandboxes. */\n  sandboxed: boolean\n  /** The page base; injected for tests. Defaults to `hostHttpBase()`. */\n  baseUrl?: string\n}\n\n/** Fetch one same-origin resource for the inliner. */\nasync function fetchInlineResource(url: string, signal: AbortSignal): Promise<{ bytes: Uint8Array; mediaType: string } | undefined> {\n  const response = await fetch(url, { credentials: 'same-origin', cache: 'no-cache', signal })\n  if (!response.ok) return undefined\n  const mediaType = (response.headers.get('content-type') ?? '').split(';')[0]?.trim() || 'application/octet-stream'\n  return { bytes: new Uint8Array(await response.arrayBuffer()), mediaType }\n}\n\n/**\n * Render the HTML preview. Browser / unsandboxed desktop: route-src iframe,\n * exactly as before. Sandboxed desktop: fetch the saved document and its local\n * assets from the top frame, then frame an inlined blob. A fetch failure falls\n * back to route-src rather than inventing a new error surface.\n */\nexport function HtmlPreviewFrame(props: HtmlPreviewFrameProps): ReactNode {\n  const { src, title, className, sandboxed } = props\n  const baseUrl = props.baseUrl ?? hostHttpBase()\n  const inline = sandboxed && isDesktopShell(baseUrl)\n  const [blobUrl, setBlobUrl] = useState<string | undefined>(undefined)\n  const [failed, setFailed] = useState(false)\n\n  useEffect(() => {\n    if (!inline || src === '') {\n      setBlobUrl(undefined)\n      setFailed(false)\n      return\n    }\n    const controller = new AbortController()\n    let cancelled = false\n    let objectUrl: string | undefined\n    setBlobUrl(undefined)\n    setFailed(false)\n    void (async () => {\n      try {\n        const documentUrl = new URL(src, baseUrl).href\n        const response = await fetch(documentUrl, {\n          credentials: 'same-origin',\n          cache: 'no-cache',\n          signal: controller.signal,\n        })\n        if (!response.ok) throw new Error(`html preview fetch failed: ${response.status}`)\n        const source = await response.text()\n        const inlined = await inlineHtmlDocument(source, documentUrl, (url) => fetchInlineResource(url, controller.signal))\n        if (cancelled || controller.signal.aborted) return\n        objectUrl = URL.createObjectURL(new Blob([inlined], { type: 'text/html;charset=utf-8' }))\n        setBlobUrl(objectUrl)\n      } catch {\n        if (cancelled || controller.signal.aborted) return\n        setFailed(true)\n      }\n    })()\n    return () => {\n      cancelled = true\n      controller.abort()\n      if (objectUrl !== undefined) URL.revokeObjectURL(objectUrl)\n    }\n  }, [inline, src, baseUrl])\n\n  const frameSrc = inline ? (failed ? src : blobUrl) : src\n  return (\n    <iframe\n      className={className}\n      src={frameSrc}\n      sandbox={sandboxed ? HTML_IFRAME_SANDBOX : undefined}\n      referrerPolicy=\"no-referrer\"\n      allow=\"\"\n      title={title}\n    />\n  )\n}\n","/**\n * Lightweight syntax highlighting for the shared diff renderer: extension-\n * based language detection plus a single-pass line tokenizer that colors\n * comments, strings, numbers, keywords, types, functions, and preprocessor\n * directives for common languages (C/C++, Java, C#, JS/TS, Python, Go, Rust,\n * shell, batch, PowerShell, and config formats