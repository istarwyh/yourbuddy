 so the source window is\n * the primary identity check; the origin allowlist keeps a same-origin page\n * that happens to reuse the message shape from being accepted.\n * @param event - the incoming message event (or a test double of it).\n * @param expectedWindow - the frame's `contentWindow`; `null` rejects all.\n * @returns the validated message, or `null` when it must be ignored.\n */\nexport function acceptFrameMessage(event: MessageEventLike, expectedWindow: Window | null): FrameMessage | null {\n  if (expectedWindow === null || event.source !== expectedWindow) return null\n  if (event.origin !== 'null' && event.origin !== '') return null\n  const data = event.data as { type?: unknown; id?: unknown; svg?: unknown; message?: unknown } | null\n  if (data === null || typeof data !== 'object') return null\n  if (data.type !== 'mermaid-result' && data.type !== 'mermaid-error') return null\n  if (typeof data.id !== 'number' || !Number.isInteger(data.id) || data.id <= 0) return null\n  if (data.type === 'mermaid-result') {\n    return typeof data.svg === 'string' ? { kind: 'result', id: data.id, svg: data.svg } : null\n  }\n  return typeof data.message === 'string'\n    ? { kind: 'error', id: data.id, message: data.message }\n    : null\n}\n\n/** Route the frame's result/error messages to their pending render. */\nfunction installMessageListener(): void {\n  if (messageListenerInstalled) return\n  messageListenerInstalled = true\n  window.addEventListener('message', (event: MessageEvent) => {\n    const message = acceptFrameMessage(event, frame?.contentWindow ?? null)\n    if (message === null) return\n    const entry = pending.get(message.id)\n    if (entry === undefined) return\n    pending.delete(message.id)\n    window.clearTimeout(entry.timer)\n    if (message.kind === 'result') entry.resolve(message.svg)\n    else entry.reject(new MermaidDiagramError(message.message))\n  })\n}\n\n/** Reject every in-flight render (frame replaced/disposed) instead of leaving\n * them to their timeouts. */\nfunction failPending(error: Error): void {\n  for (const [id, entry] of pending) {\n    pending.delete(id)\n    window.clearTimeout(entry.timer)\n    entry.reject(error)\n  }\n}\n\n/** Drop the current frame (failed load, page teardown) and its blob URL. */\nfunction disposeFrame(): void {\n  failPending(new MermaidFrameError('mermaid frame was reset'))\n  frameReady = null\n  if (frame !== null) {\n    frame.remove()\n    frame = null\n  }\n  if (frameObjectUrl !== null) {\n    URL.revokeObjectURL(frameObjectUrl)\n    frameObjectUrl = null\n  }\n}\n\n/** Create the hidden frame and resolve once its protocol posted `ready`. */\nfunction ensureFrame(): Promise<void> {\n  if (frameReady !== null) return frameReady\n  installMessageListener()\n  frameReady = new Promise<void>((resolve, reject) => {\n    const iframe = document.createElement('iframe')\n    // Opaque-origin sandbox: the frame runs only our inlined mermaid bundle and\n    // not the host origin's APIs. postMessage is the only bridge.\n    iframe.setAttribute('sandbox', 'allow-scripts')\n    iframe.setAttribute('aria-hidden', 'true')\n    iframe.tabIndex = -1\n    iframe.style.cssText = `position:fixed;left:-12000px;top:0;width:${FRAME_WIDTH}px;height:${FRAME_HEIGHT}px;border:0;visibility:hidden;pointer-events:none`\n    let settled = false\n    const settle = (error?: Error): void => {\n      if (settled) return\n      settled = true\n      window.removeEventListener('message', onReady)\n      window.clearTimeout(timer)\n      if (error !== undefined) {\n        disposeFrame()\n        reject(error)\n        return\n      }\n      resolve()\n    }\n    const onReady = (event: MessageEvent): void => {\n      if (event.source !== iframe.contentWindow) return\n      if (event.origin !== 'null' && event.origin !== '') return\n      const data = event.data as { type?: unknown } | null\n      if (data !== null && typeof data === 'object' && data.type === 'mermaid-frame-ready') settle()\n    }\n    const timer = window.setTimeout(() => {\n      settle(new MermaidFrameError('mermaid frame did not become ready'))\n    }, FRAME_READY_TIMEOUT_MS)\n    window.addEventListener('message', onReady)\n    frameObjectUrl = URL.createObjectURL(new Blob([MERMAID_FRAME_HTML], { type: 'text/html' }))\n    iframe.src = frameObjectUrl\n    document.body.appendChild(iframe)\n    frame = iframe\n  })\n  return frameReady\n}\n\n/** Ask the frame to render one diagram and resolve with the raw SVG markup. */\nasync function renderInFrame(code: string, theme: MermaidTheme): Promise<string> {\n  await ensureFrame()\n  const target = frame?.contentWindow\n  if (target === null || target === undefined) throw new MermaidFrameError('mermaid frame disappeared')\n  const id = ++requestSeq\n  return new Promise<string>((resolve, reject) => {\n    const timer = window.setTimeout(() => {\n      pending.delete(id)\n      reject(new MermaidFrameError('mermaid frame render timed out'))\n    }, FRAME_RENDER_TIMEOUT_MS)\n    pending.set(id, { resolve, reject, timer })\n    target.postMessage({ type: 'mermaid-render', id, code, theme }, '*')\n  })\n}\n\n/**\n * Render one mermaid diagram off the host document's layout.\n *\n * A `MermaidDiagramError` is final for that one diagram (no retry, no breaker);\n * a transport failure gets one retry with a fresh frame, then flips the\n * page-level breaker so later diagrams fail fast instead of paying a timeout\n * each.\n * @param code - the diagram source (one fenced block body).\n * @param theme - mermaid theme to render with (follows the color scheme).\n * @returns the raw SVG markup (sanitized by the caller before injection).\n */\nexport async function renderMermaidDiagram(code: string, theme: MermaidTheme): Promise<string> {\n  if (testRenderer !== null) return testRenderer(code, theme)\n  if (code.length > MAX_DIAGRAM_SOURCE_LENGTH) {\n    throw new MermaidDiagramError(`diagram source is too large (${code.length} chars)`)\n  }\n  if (frameUnavailable) throw new MermaidFrameError('mermaid rendering frame is unavailable')\n  const renderOnce = async (): Promise<string> => (\n    testTransport !== null ? testTransport(code, theme) : renderInFrame(code, theme)\n  )\n  try {\n    return await renderOnce()\n  } catch (firstError) {\n    // A bad diagram is not a broken frame: report it and leave the frame alone.\n    if (firstError instanceof MermaidDiagramError) throw firstError\n    disposeFrame()\n    try {\n      return await renderOnce()\n    } catch (secondError) {\n      if (secondError instanceof MermaidDiagramError) throw secondError\n      frameUnavailable = true\n      throw new MermaidFrameError(\n        `mermaid frame unavailable: ${secondError instanceof Error ? secondError.message : String(secondError)}`,\n        { cause: secondError },\n      )\n    }\n  }\n}\n","/**\n * Mermaid diagram renderer for the markdown preview, resident in the\n * `mermaid` lazy chunk (src/client/chunks/mermaid.tsx): the mermaid library\n * and its transitive graph deps (d3/dagre/cytoscape) are inlined into\n * lib/client-mermaid.js and fetched only when a previewed markdown file\n * actually contains a mermaid fence (see mermaid-blocks.ts).\n *\n * Rendering architecture: the whole document is rendered ONCE through the\n * DSH `MarkdownText` (so cross-fence semantics — reference-style links,\n * footnotes, ordered-list continuity — stay intact), then a layout effect\n * swaps every rendered `language-mermaid` CodeBlock for a diagram. The\n * swap keeps the React-managed `.md-code-block` host node in the tree and\n * only replaces its children (display:contents suppresses the code-block\n * chrome), so React reconciliation never loses the host; when a swapped\n * block stops being a mermaid fence, the original children are restored.\n *\n * Security: mermaid.render → sanitized SVG injected into the block.\n * `bindFunctions` is intentionally NOT applied (static diagrams; no\n * flowchart click handlers), `securityLevel` stays 'strict' (labels are\n * escaped, no raw-HTML foreignObject), `htmlLabels: false` keeps node text\n * as real SVG <text>, and the emitted SVG is re-sanitized (see\n * mermaid-sanitize.ts) before it reaches dangerouslySetInnerHTML. Clicking\n * a rendered diagram opens a zoom/pan modal (borrowed interaction design\n * from the mermaid PR #75, reimplemented on top of the sanitized SVG —\n * the clone carries no event surface, so the modal adds no attack surface).\n */\nimport { useCallback, useEffect, useLayoutEffect, useRef, useState, type MouseEvent as ReactMouseEvent } from 'react'\nimport { createPortal } from 'react-dom'\nimport { createRoot, type Root } from 'react-dom/client'\nimport { IconCopyOutlineRegular, MarkdownText, writeClipboard } from '@deepseek-ai/dsh-client-ui-primitives'\nimport { isDarkScheme, subscribeColorScheme } from './theme.ts'\nimport { markdownTextProps } from './markdown-labels.tsx'\nimport { t } from './locales.ts'\nimport { sanitizeSvg } from './mermaid-sanitize.ts'\nimport { useViewportInsetTop } from './viewport-inset.ts'\nimport type { MermaidMarkdownProps } from './mermaid-blocks.ts'\nimport { splitMermaidBlocks } from './mermaid-blocks.ts'\nimport { renderMermaidDiagram, type MermaidTheme } from './mermaid-frame.ts'\nimport css from './sidebar.module.css'\n\n/** Render queue priorities: a diagram the reader can see goes first, the rest\n * render while the browser is idle. */\ntype MermaidPriority = 0 | 1\n\n/** One mounted preview's visibility. Background diagrams of a hidden preview\n *  (parked tab, collapsed dock) must not warm-render: they would spend CPU on\n *  content nobody can see and make the visible document's scrolling compete\n *  with diagrams from other tabs. */\ninterface MermaidPreviewHandle {\n  visible: boolean\n  wake: () => void\n}\n\ninterface MermaidTask {\n  priority: MermaidPriority\n  run: () => Promise<void>\n  /** The preview this render belongs to. */\n  owner: MermaidPreviewHandle\n}\n\n/** Pending renders, shared by every mounted preview on the page. */\nconst mermaidQueue: MermaidTask[] = []\nlet mermaidPumping = false\n/** Incremented when a test tears the queue down; a drain loop from an older\n * epoch stops at its next await instead of driving the fresh queue. */\nlet mermaidQueueEpoch = 0\n\n/** How long after the last scroll event background rendering stays paused.\n *  Scrolling must not compete with diagram layout for the main thread. */\nconst SCROLL_QUIET_MS = 350\n/** Timestamp of the most recent captured scroll event on the page. */\nlet lastScrollAt = 0\nif (typeof window !== 'undefined') {\n  window.addEventListener('scroll', () => { lastScrollAt = performance.now() }, { capture: true, passive: true })\n}\n\n/** Resolve once the page has stopped scrolling for {@link SCROLL_QUIET_MS}. */\nasync function waitForScrollQuiet(): Promise<void> {\n  while (performance.now() - lastScrollAt < SCROLL_QUIET_MS) {\n    await new Promise<void>((resolve) => { setTimeout(resolve, 120) })\n  }\n}\n\n/** Register one preview's visibility gate (see {@link MermaidPreviewHandle}). */\nfunction createPreviewHandle(): MermaidPreviewHandle {\n  return {\n    visible: true,\n    wake: () => { void drainMermaidQueue() },\n  }\n}\n\n/** Drop queued renders that belong to a preview that is going away. */\nfunction dropPreviewTasks(handle: MermaidPreviewHandle): void {\n  for (let index = mermaidQueue.length - 1; index >= 0; index -= 1) {\n    const task = mermaidQueue[index]\n    if (task !== undefined && task.owner === handle) mermaidQueue.splice(index, 1)\n  }\n}\n\n/** Drop every queued render and detach the current drain loop (test seam:\n * module state persists across specs in one vitest file). */\nexport function resetMermaidRenderQueueForTests(): void {\n  mermaidQueueEpoch += 1\n  mermaidQueue.length = 0\n  mermaidPumping = false\n  lastScrollAt = 0\n}\n\n/** Run a callback once the main thread is idle (bounded, so diagrams cannot\n * starve