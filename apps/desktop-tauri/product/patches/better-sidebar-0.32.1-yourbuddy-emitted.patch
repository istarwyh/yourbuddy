 workflowFailed: 'Échoué',\n  workflowPhaseUnnamed: 'Phase sans nom',\n  workflowMembers: '{done}/{total} membres',\n  jobsAutoCollapsed: 'Replié automatiquement (nombreux agents)',\n  contextDiagnostics: 'Diagnostic du contexte',\n  contextDiagnosticsTarget: 'Session actuelle',\n  contextDiagnosticsFailed: 'Impossible d’ouvrir le diagnostic du contexte pour « {label} »',\n  contextDiagnosticsUnavailable: 'La page « Contexte » de dsh-context est indisponible (non installée ou non enregistrée)',\n  contextDiagnosticsNavigation: 'Impossible de localiser cette conversation',\n  contextDiagnosticsTimeout: 'Délai d’ouverture dépassé — réessayez',\n  contextDiagnosticsOpenFailed: 'La page n’a pas pu être ouverte',\n  contextDiagnosticsDismiss: 'Fermer',\n  catalogLoadFailed: '{count} branches n’ont pas pu être chargées',\n  addPluginsTabCard: 'Ajouter un plugin d’onglet',\n  addPluginsTabCardDesc: 'Enregistrer une nouvelle page de la barre latérale',\n  addPluginsViewerCard: 'Ajouter un plugin d’aperçu',\n  addPluginsViewerCardDesc: 'Enregistrer un aperçu d’un type de fichier',\n  addPluginsTabDesc: 'Les pages de la barre latérale (onglets) peuvent être étendues par des plugins. Les plugins s’enregistrent via le service ctx.betterSidebar ; cliquez sur « Installer » pour copier la commande d’installation, collez-la dans un terminal de l’environnement DSH et exécutez-la.',\n  addPluginsViewerDesc: 'Les aperçus de fichiers peuvent être étendus par des plugins. Les plugins s’enregistrent via le service ctx.betterSidebar ; cliquez sur « Installer » pour copier la commande d’installation, collez-la dans un terminal de l’environnement DSH et exécutez-la.',\n  addPluginsBrowseMore: 'Parcourir plus de plugins sur GitHub (topic : dsh-better-sidebar)',\n  addPluginsSearch: 'Rechercher par nom / description de plugin…',\n  addPluginsNoMatch: 'Aucun plugin correspondant',\n  addPluginsRecommended: 'Plugins recommandés',\n  addPluginsEmpty: 'Aucun plugin référencé pour l’instant, publiez le vôtre sous le topic GitHub',\n  openPlugin: 'Aller',\n  copyInstall: 'Copier la commande d’installation',\n  pluginOfficeDesc: 'Aperçu de la suite Office (.docx / .xlsx / .pptx) pour l’éditeur better-sidebar, avec les lourdes bibliothèques de rendu Office extraites du package principal et installées à la demande',\n  pluginFlowglassDesc: 'Schéma de flux de session en temps réel : trois couloirs pour l’utilisateur, l’assistant et les appels d’outils, avec regroupement en parallèle, branches de sous-agents, exploration par niveau et états en temps réel ; enregistre l’onglet natif « Flowglass » une fois better-sidebar installé, sinon conserve un tiroir indépendant',\n  pluginGitForgeDesc: 'Onglet « Identifiants Git » de better-sidebar : bibliothèque de comptes GitHub/Gitea (et autres forges) + autorisations par projet + blocage strict des stratégies push ; les tokens restent dans les secrets locaux, jamais dans le contexte du modèle ; fournit un outil GitForge en lecture seule et un helper HTTPS de credentials pour l’agent',\n  pluginGithubWorkbenchDesc: 'Onglet « GitHub Workbench » de better-sidebar : arborescence du dépôt distant + Issues / Pull requests / Actions avec prise en charge complète en écriture — création d’issue/PR, commentaire, édition, fermeture/réouverture, merge squash·merge·rebase (confirmation renforcée), relance/annulation de la CI ; le sélecteur de dépôt liste automatiquement les dépôts accessibles et recherche les dépôts publics ; sans better-sidebar, il bascule sur un panneau latéral droit autonome',\n  pluginIdeGitDesc: 'Onglet Git pour better-sidebar : arbre des branches (badges ahead/behind, marqueur worktree), graphe des commits avec filtres texte/branche/auteur/date/chemin, diff ligne à ligne par fichier, liste des modifications et zone de commit, plus merge, rebase, cherry-pick, reset, stash et tags ; les actions destructrices demandent confirmation et les suppressions ou abandons sont réversibles. Sans better-sidebar, il s\\'enregistre dans la barre latérale droite native de DSH et fonctionne seul',\n  pluginAgentPersonaDesc: 'Personas de prompt système par espace de travail ou par session : une même persona peut couvrir plusieurs répertoires d’espace de travail et plusieurs sessions, appariée exactement, par préfixe, par sous-chaîne ou par expression rationnelle — la plus spécifique l’emporte, et une persona peut être marquée par défaut ; gérée depuis une page de réglages et un onglet « Persona » dans la conversation, effective dès le message suivant',\n  pluginMdExportDesc: 'Ajoute un bouton « Exporter » à la barre d’outils Markdown de better-sidebar : rend en un clic le .md courant en HTML autonome (tableaux/blocs de code/diagrammes Mermaid en ligne, mise en page fidèle au thème d’aperçu) et l’enregistre à côté du .md, ou exporte en PDF via la boîte de dialogue d’impression',\n  pluginCodeNavDesc: 'Navigation de prévisualisation de code : détecte le langage selon le type de fichier et colore la syntaxe, plan des symboles (filtres classes/méthodes/variables + saut en un clic) et recherche dans le fichier (toutes les correspondances surlignées, précédent/suivant, respect de la casse) — prend en charge l’aperçu des fichiers de code dans l’éditeur better-sidebar',\n  pluginSuhuangScrollDesc: 'Connecte le Runtime Suhuang Scroll local aux réglages DSH et à better-sidebar pour configurer le modèle, tester la connexion et contrôler la correction continue ; nécessite Suhuang Scroll Runtime et dsh-better-sidebar',\n  pluginBetterOverleafDesc: 'Onglet Overleaf pour better-sidebar : connexion directe via navigateur CDP (Chromium tiers pris en charge), liste/sélection de projets, miroirs git locaux sous <workspace>/overleaf/, synchronisation git bidirectionnelle avec repli API en lecture seule, et aperçu des fichiers via l’atelier de la barre latérale',\n  pluginSentinelDesc: 'Système de réveil d’agent piloté par conditions : capteurs fichier/processus/port/HTTP/commande/webhook, les sessions en veille se réveillent automatiquement lorsque les conditions sont remplies ; enregistre l’onglet « Sentinel » affichant le tableau de surveillance global du serveur',\n  pluginServerDeckDesc: 'Tableau de bord de serveurs en cartes : une carte par hôte avec statut en ligne, OS, durée de fonctionnement, utilisation CPU/RAM/disque et latence ; cliquez sur une carte pour ouvrir un terminal xterm.js interactif ; import du ~/.ssh/config en un clic (alias d’hébergement Git ignorés automatiquement). Enregistre un onglet « Serveurs » natif quand better-sidebar est installé, sinon conserve le tiroir latéral autonome',\n  pluginSidebarQaDesc: 'Onglet de questions sur sélection basé sur better-sidebar : sélection dans la discussion → question dans le panneau de droite → session de relance indépendante du même espace de travail (❓ relance · thème) : un modèle rapide sans réflexion compresse le contexte de la discussion principale puis l’injecte avec la citation, sans interrompre la discussion principale ; les relances peuvent être imbriquées, poursuivies et archivées',\n  pluginSidenoteDesc: 'Side chat façon Codex + annotations sur sélection : forker la session en cours dans un panneau latéral persistant (archivée hors de la liste des sessions, plusieurs instances, commande /side, survit au rechargement, le modèle suit la session principale) ; sélectionner un texte assistant → badge numéroté + éditeur de notes → un chip « N annotations » qui accompagne votre prochain message, ou poser sa question directement dans un side chat',\n  pluginSshTunnelDesc: 'Onglet « Tunnel SSH » de better-sidebar : inventaire multi-machines + autorisations par projet + clés conservées localement ; outil de modèle SSHManager (exec/SFTP/stratégies de session) ; terminal interactif central et SFTP à deux volets',\n  pluginVideoPreviewDesc: 'Aperçu vidéo en ligne dans l’éditeur better-sidebar (.mp4/.webm/.mov/.mkv/.avi, etc.), avec une route hôte /video prenant en charge HTTP Range (206) ; la barre de progression est déplaçable et la lecture démarre avant le téléchargement complet du fichier',\n  pluginAudioDesc: \"Prévisualiser les fichiers audio (.mp3/.wav/.flac/.ogg/.m4a/.aac/.opus) dans l'éditeur better-sidebar : lecteur de forme d'onde zoomable (clic/glisser pour se déplacer, boucle A-B, choix du canal), spectre en direct et spectrogramme du fichier entier — sa propre route média gère HTTP Range, donc déplaçable quelle que soit la taille\",\n  pluginDevGitGraphDesc: 'A faithful vscode-git-graph port as a sidebar tab: the only entry is a native better-sidebar tab, auto-bound to the session workspace, full git operations (checkout/merge/rebase/push/tag/stash), light/dark theming, file diffs open in the built-in DiffTab; requires dsh-better-sidebar',\n  pluginDocsPanelDesc: '« Documentation globale » dans la barre latérale DSH : notes Markdown globales, lisibles depuis n’importe quel espace de travail — sélection dans la liste, saut via le plan flottant, ouverture externe Chrome / VS Code, copie de code, répertoire configurable (défaut ~/.dsh/docs)',\n  pluginTylinaDesc: 'Un éditeur de documents Typst partageant l’espace de travail de la session en cours : composition WYSIWYG de documents Typst, pour rédiger et mettre en page articles, rapports, sujets d’examen, CV, graphiques, posters, partitions et diapositives exportées en PPTX',\n  pluginEgoBrowserDesc: 'Le navigateur d’agent pour DeepSeek Harness : 32 outils ego_* pilotent un vrai Chromium ; un onglet natif « ego browser » dans la barre latérale montre en direct chaque page visitée par l’agent — cliquez, glissez et tapez pour reprendre la main. Enregistre l’onglet automatiquement si better-sidebar est présent, sinon une bulle flottante',\n  pluginBilingualReaderDesc: 'Lire des PDF dans la barre latérale DSH : affichage PDF natif, sélectionnez du texte pour le traduire avec le LLM, avec contexte et totalement isolé de la conversation principale',\n  changesRedactOn: \"Masquage actif : les secrets s'affichent en [REDACTED] ; cliquez pour désactiver (à vos risques)\",\n  changesRedactOff: \"Masquage désactivé : le contenu s'affiche tel quel ; cliquez pour activer\",\n  changesRedactOnLabel: \"Masquage\",\n  changesRedactOffLabel: \"Sans masquage\",\n  changesRedactBanner: \"Masqué\",\n  pluginAgentPersonaName: 'dsh-agent-persona Personas',\n  pluginSentinelName: 'dsh-sentinel Système de réveil',\n  pluginFileTraceName: 'dsh-file-trace Suivi de fichiers',\n  pluginFileTraceDesc: 'Enregistre chaque fichier lu, écrit ou modifié par le modèle ; liste groupée avec contenus et diffs ligne à ligne, mode lecture Markdown et masquage des secrets ; fenêtre flottante autonome sans better-sidebar',\n  pluginMnemeName: 'dsh-mneme Bibliothèque de mémoire',\n  pluginMnemeDesc: 'Moteur de mémoire inter-sessions : consolidation en arrière-plan autoDream, résumés de session et profil utilisateur ; SQLite + miroirs Markdown modifiables à la main, entièrement hors ligne et privé. Enregistre un onglet « Bibliothèque de mémoire » (vues mémoires/entités/état/paramètres) quand better-sidebar est présent, sinon conserve son panneau latéral indépendant',\n  pluginEgoBrowserName: 'ego-browser Navigateur d’agents',\n  pluginBetterOverleafName: 'dsh-better-overleaf Onglet Overleaf',\n  pluginDocsPanelName: 'dsh-docs-panel Docs globales',\n  pluginTylinaName: 'dsh-tylina Éditeur de documents Typst',\n  pluginFlowglassName: 'dsh-flowglass Flowglass',\n  pluginGitForgeName: 'dsh-git-forge Identifiants Git',\n  pluginGithubWorkbenchName: 'dsh-github-workbench Atelier GitHub',\n  pluginIdeGitName: 'dsh-ide-git Fenêtre Git',\n  pluginSidebarQaName: 'dsh-sidebar-qa Sélectionner & demander',\n  pluginSidenoteName: 'dsh-sidenote Chat latéral',\n  pluginServerDeckName: 'dsh-server-deck Tableau de bord serveurs',\n  pluginSuhuangScrollName: 'dsh-suhuang-scroll Suhuang Scroll',\n  pluginSshTunnelName: 'dsh-ssh-tunnel Tunnel SSH',\n  pluginBilingualReaderName: 'dsh-bilingual-reader Lecteur bilingue',\n  pluginOfficeName: 'Aperçu Office',\n  pluginMdExportName: 'Exportation Markdown',\n  pluginCodeNavName: 'Navigateur d’aperçu de code',\n  pluginVideoPreviewName: 'Aperçu vidéo',\n  pluginAudioName: 'Aperçu audio',\n  pluginTurnOutlineName: \"dsh-turn-outline Plan des tours\",\n  pluginTurnOutlineDesc: \"Plie la session en tours utilisateur (entrée + étapes d'outil + sortie) ; un clic sur une étape ramène à l'endroit exact de la conversation — sans LLM, en lecture seule\",\n  pluginDshMemoryDeltaName: 'dsh-memory-delta Mémoire',\n  pluginDshMemoryDeltaDesc: 'Mémoire inter-sessions : seuls les changements sont injectés (rien du tout si rien ne change), avec rappel de révision, recherche classée par pertinence et onglet latéral.',\n}\n","export const pt: Record<string, string> = {\n  files: 'Arquivos',\n  guideDescFiles: 'Navegue pela árvore do workspace; um clique abre a pré-visualização ou a edição',\n  guideDescGit: 'Alterações do Git e edições desta sessão em um único separador',\n  guideDescSubagent: 'Grafo do workflow, quadro de tarefas da equipe e tarefas em segundo plano, ao vivo',\n  guideDescSidechat: 'Uma conversa paralela independente que herda o contexto desta sessão',\n  guideDescTerminal: 'Um shell real (xterm + pty) com reconexão',\n  guideDescBrowser: 'Navegador incorporado, que pode abrir links do chat',\n  changesSessionEmpty: 'Ainda sem operações de arquivo nesta sessão',\n  changesRead: 'Leitura',\n  changesMdReading: 'Leitura',\n  changesHtmlRender: \"Renderizar\",\n  changesHtmlRaw: \"Fonte\",\n  changesMdRaw: 'Bruto',\n  changesWrite: 'Escrita',\n  changesEdit: 'Edição',\n  changesRunning: 'em execução',\n  changesError: 'erro',\n  changesFold: '{count} linhas… clique para expandir',\n  changesFoldLoading: 'Expandindo…',\n  changesFoldUnavailable: 'Contexto indisponível',\n  changesContext: 'contexto',\n  changesPriorUnknown: 'O conteúdo anterior está fora da janela; mostrado como totalmente adicionado',\n  explorer: 'Explorador',\n  terminal: 'Terminal',\n  edi