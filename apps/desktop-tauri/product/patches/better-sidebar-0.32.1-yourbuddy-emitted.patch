 sideChatPendingDrop: 'Die letzte unbeantwortete Nachfrage wird in der gespeicherten Sitzung nicht enthalten sein',\n  sideChatQueued: 'In der Warteschlange',\n  sideChatSending: 'Wird gesendet…',\n  sideChatRevealEarlier: '{hidden} ältere Zeilen anzeigen',\n  sideChatToLatest: 'Zurück zum Neuesten',\n  sideChatDequeue: 'Aus der Warteschlange entfernen',\n  sideChatRunError: 'Ausführung fehlgeschlagen: {message}',\n  sideChatTerminalAborted: 'Dieser Durchlauf wurde gestoppt',\n  sideChatTerminalMaxTokens: 'Ausgabelimit erreicht — die Antwort ist abgeschnitten',\n  sideChatToolArguments: 'Argumente',\n  sideChatToolResult: 'Ergebnis',\n  sideChatTruncatedNotice: 'Frühere Verläufe sind in dieser Ansicht nicht geladen',\n  sideChatModel: 'Modell',\n  sideChatModelInherit: 'Hauptunterhaltung übernehmen (kein Modellkatalog verfügbar)',\n  sideChatReasoning: 'Denkaufwand',\n  sideChatFirstPlaceholder: 'Stellen Sie die erste Frage – der Kontext ist geerbt…',\n  sideChatComposerPlaceholder: 'Nachfrage stellen…',\n  sideChatThinking: 'Denkt vertieft…',\n  sideChatThink: 'Denkvorgang',\n  sideChatReasoningSummary: '{chars} Zeichen Gedanken',\n  sideChatInjection: 'Kontext eingespielt',\n  sideChatAddImages: \"Bilder hinzufügen\",\n  sideChatRemoveImage: \"{name} entfernen\",\n  sideChatImagesDisabled: \"Bildanhänge sind nicht verfügbar\",\n  sideChatImageFormat: \"PNG, JPEG, WebP oder GIF wählen\",\n  sideChatImageLimit: \"Bildanzahl oder Größe überschritten\",\n  sideChatImageReadError: \"Bild konnte nicht gelesen werden\",\n  sideChatImageOwnerChanged: \"Unterhaltung während des Sendens gewechselt\",\n  sideChatSendUncertain: \"Verbindung unterbrochen. Die Nachricht wurde möglicherweise angenommen. Dein Entwurf bleibt erhalten; prüfe die Unterhaltung vor einem erneuten Versuch.\",\n  sideChatImageLoading: \"Bild wird geladen…\",\n  sideChatImageUnavailable: \"Bild nicht verfügbar\",\n  sideChatImage: \"Bild\",\n  sideChatSend: 'Senden',\n  sideChatCancelTitle: 'Laufende Run