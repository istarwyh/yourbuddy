urnOffset, firstKeptTurn)\n    if (rebased === DROPPED) return\n    if (rebased === undefined) {\n      aborted = true\n      return\n    }\n    rebase.set(event.seq, seed.length)\n    seed.push(rebased)\n  }\n  for (const event of headEvents) emit(event)\n  emit(checkpoint)\n  for (let index = keepStart; index < cut; index++) {\n    const event = events[index]\n    if (event === undefined || isCompactionGroupEvent(event, groupId)) continue\n    if (consumedSeqs.has(event.seq)) continue\n    if (keepSkip(event)) continue\n    if (droppedGroups.has(String(dataOf(event).compactionId))) continue\n    if (droppedDones.has(event.seq)) continue\n    emit(event)\n  }\n  for (let index = cut + 1; index < events.length; index++) {\n    const event = events[index]\n    if (event === undefined || isCompactionGroupEvent(event, groupId)) continue\n    if (consumedSeqs.has(event.seq)) continue\n    if (droppedGroups.has(String(dataOf(event).compactionId))) continue\n    if (droppedDones.has(event.seq)) continue\n    emit(event)\n  }\n  if (aborted) return undefined\n  // Prove equivalence before the caller relies on it: the rebased sequence\n  // must fold without error and to the same visible nodes as the parent,\n  // and its turn/step skeleton must satisfy the host's relational counter\n  // rules (turn/start runs 1, 2, …; steps open and close inside their turn;\n  // a trailing open turn is the caller's to close).\n  try {\n    const child = foldSurface(seed)\n    if (!sameVisibleSequence(events, parentNodes, child.nodes, seed)) return undefined\n  } catch {\n    return undefined\n  }\n  if (!turnSequenceValid(seed)) return undefined\n  if (!inboxSplicesValid(seed)) return undefined\n  if (!bracketsValid(seed)) return undefined\n  return seed\n}\n\n/**\n * Relational pre-check mirroring the host's grouped-record rules: a\n * successful `compaction/end` requires a `compaction/summary` of the same\n * compactionId earlier in the log, and a `command/done` requires its\n * `command/run` (same commandId) before it. Dropping a summary or a run\n * with the forgotten span while keeping its partner would ship a seed the\n * host's invariant companions reject, so any unmatched partner falls back\n * to the full copy.\n */\nfunction bracketsValid(seed: readonly SeedEvent[]): boolean {\n  const summarized = new Set<string>()\n  const ranCommands = new Set<string>()\n  for (const event of seed) {\n    const data = dataOf(event)\n    if (event.type === 'compaction/summary') {\n      const id = data.compactionId\n      if (typeof id === 'string') summarized.add(id)\n    } else if (event.type === 'compaction/end') {\n      const id = data.compactionId\n      if (data.error === undefined && (typeof id !== 'string' || !summarized.has(id))) return false\n    } else if (event.type === 'command/run') {\n      const id = data.commandId\n      if (typeof id === 'string') ranCommands.add(id)\n    } else if (event.type === 'command/done') {\n      const id = data.commandId\n      if (typeof id !== 'string' || !ranCommands.has(id)) return false\n    }\n  }\n  return true\n}\n\n/**\n * Relational pre-check mirroring the host's durable-inbox fold: every kept\n * `agent/inbox/spliced` event replays POSITIONALLY over the pending inbox\n * (splice.start/removedCount must stay in range, message ids unique). A\n * seed whose splice history cannot replay from an empty inbox falls back\n * to the full copy.\n */\nfunction inboxSplicesValid(seed: readonly SeedEvent[]): boolean {\n  const nextTurn: Array<Record<string, unknown>> = []\n  const nextStep: Array<Record<string, unknown>> = []\n  for (const event of seed) {\n    if (event.type !== 'agent/inbox/spliced') continue\n    const data = dataOf(event)\n    // Host strictness: only the two known targets, a numeric start and\n    // removedCount, and an array of messages with string ids.\n    if (data.target !== 'next-turn' && data.target !== 'next-step') return false\n    const inbox = data.target === 'next-step' ? nextStep : nextTurn\n    const rawStart = data.start\n    // The host contract makes removedCount optional and defaults it to 0\n    // (its own writer omits it for pure inserts — 54% of real splices).\n    const removedCount = typeof data.removedCount === 'number' ? data.removedCount : 0\n    const inserted = Array.isArray(data.inserted) ? data.inserted as Array<Record<string, unknown>> : undefined\n    const start = typeof rawStart === 'number' ? rawStart : Number.NaN\n    if (inserted === undefined\n      || !Number.isSafeInteger(start) || start < 0 || start > inbox.length\n      || !Number.isSafeInteger(removedCount) || removedCount < 0\n      || start + removedCount > inbox.length) return false\n    inbox.splice(start, removedCount, ...inserted)\n    const ids = new Set<string>()\n    for (const message of [...nextTurn, ...nextStep]) {\n      const id = message.id\n      if (typeof id !== 'string') return false\n      if (ids.has(id)) return false\n      ids.add(id)\n    }\n  }\n  return true\n}\n\n/**\n * Relational pre-check mirroring the CORE of the session invariant's\n * counters and tool pairing: turn numbers run 1, 2, … with no nested open\n * turn; steps run 1, 2, … inside the open turn and close before their turn;\n * in-turn message and tool/call events name the open turn/step when they\n * carry numbers — except a NON-append tool/result, which the host exempts\n * from step naming (pruner replacements carry their original step); a\n * tool/result must consume a pending call of its step, and a step cannot\n * close with calls pending. A trailing open turn or step is legal — the\n * caller closes it. This is a core mirror, not the full host contract;\n * anything it cannot prove falls back to the full copy.\n */\nfunction turnSequenceValid(seed: readonly SeedEvent[]): boolean {\n  let nextTurn = 1\n  let nextStep = 1\n  let openTurn: number | undefined\n  let openStep: number | undefined\n  let pendingCalls = new Set<string>()\n  for (const event of seed) {\n    const data = dataOf(event)\n    if (event.type === 'turn/start') {\n      if (openTurn !== undefined || data.turn !== nextTurn) return false\n      openTurn = nextTurn\n      nextTurn += 1\n      nextStep = 1\n      openStep = undefined\n      pendingCalls = new Set()\n    } else if (event.type === 'turn/end') {\n      if (openTurn === undefined || data.turn !== openTurn || openStep !== undefined) return false\n      openTurn = undefined\n    } else if (event.type === 'step/start') {\n      if (openTurn === undefined || data.turn !== openTurn || openStep !== undefined) return false\n      if (data.step !== nextStep) return false\n      openStep = nextStep\n      nextStep += 1\n      pendingCalls = new Set()\n    } else if (event.type === 'step/end') {\n      if (openTurn === undefined || openStep === undefined || data.turn !== openTurn || data.step !== openStep) return false\n      if (pendingCalls.size > 0) return false\n      openStep = undefined\n    } else if (event.type === 'tool/call') {\n      if (typeof data.turn === 'number' && data.turn !== openTurn) return false\n      if (typeof data.step === 'number' && data.step !== openStep) return false\n      const callId = data.callId\n      if (typeof callId === 'string' && callId !== '') pendingCalls.add(callId)\n    } else if (event.type === 'tool/result') {\n      const op = (event as { surfaceOp?: unknown }).surfaceOp\n      if (op !== 'append') {\n        // The host exempts a replacing tool/result from step naming and\n        // pairing: it shadows the original call's slot, not a new one.\n        if (openTurn === undefined) return false\n        continue\n      }\n      if (typeof data.turn === 'number' && data.turn !== openTurn) return false\n      if (typeof data.step === 'number' && data.step !== openStep) return false\n      const callId = toolResultCallIdOf(event)\n      if (callId !== undefined && !pendingCalls.delete(callId)) return false\n    } else if (isSurfaceEligibleType(event.type)) {\n      if (typeof data.turn === 'number' && data.turn !== openTurn) return false\n      if (typeof data.step === 'number' && data.step !== openStep) return false\n    }\n  }\n  return true\n}\n\n/** The callId a tool/result event's message cites, when it carries one. */\nfunction toolResultCallIdOf(event: SidechatLogEvent): string | undefined {\n  if (event.type !== 'tool/result') return undefined\n  const message = dataOf(event).message as { source?: { callId?: unknown } } | undefined\n  const callId = message?.source?.callId\n  return typeof callId === 'string' && callId !== '' ? callId : undefined\n}\n\n/** Bound on a system-prompt replacement chain; real chains are 2-4 hops. */\nconst MAX_HEAD_REPLACEMENTS = 16\n\n/**\n * One head slot before the checkpoint. The anchor is the pre-cut event the\n * checkpoint left outside its shadowed set; the effective event is what the\n * parent surface shows in that slot — the anchor itself, or the latest\n * replacement of it (a model switch rewrites the system prompt). The\n * replacement-chain events the head consumes must not be emitted again.\n */\ninterface HeadSlot {\n  /** Seq of the anchor event that owns the slot. */\n  anchor: number\n  /** Event the child emits in the slot (the anchor or its latest replacement). */\n  effective: SessionEvent\n  /** Replacement-chain events the head consumes (the effective included); keep/tail loops skip them. */\n  consumed: readonly number[]\n}\n\n/** The span a replace surface marker targets, when it is a valid one. */\nfunction surfaceReplaceSpan(event: SidechatLogEvent): { start: number; end: number } | undefined {\n  const op = (event as { surfaceOp?: unknown }).surfaceOp\n  if (op === null || typeof op !== 'object' || (op as { op?: unknown }).op !== 'replace') return undefined\n  const start = (op as { startSeq?: unknown }).startSeq\n  const end = (op as { endSeq?: unknown }).endSeq\n  if (typeof start !== 'number' || typeof end !== 'number' || start > end) return undefined\n  return { start, end }\n}\n\n/**\n * Resolve one surface node before the checkpoint to the head slot the child\n * must carry. A node at or after the cut can still sit ahead of the\n * checkpoint when a later event replaced the protected system head (a model\n * switch rewrites the system prompt): the surface keeps the LATEST\n * replacement in the head slot, so the child carries that replacement and\n * drops the chain it replaced — the switched model saw the same\n * post-compaction surface as the original one.\n *\n * The chain is representable only when every step is a single-node\n * replacement of the system head and the anchor predates the cut and is not\n * one of the entries the checkpoint removed. Membership uses the checkpoint's\n * recorded shadowed set, not its declared numeric range: a replacement inside\n * that range may still be a surviving keep-window entry. A range replace, a\n * removed target, a non-system node, a forward/cyclic chain, or a missing\n * anchor returns undefined and degrades to the verbatim full copy.\n * @param events - the parent's log.\n * @param seq - the surface node seq to resolve.\n * @param cut - the checkpoint's log index.\n * @param checkpointShadowed - the checkpoint's actual shadowed entries, when the fold recorded them.\n * @returns the resolved slot, or undefined when the shape is not representable.\n */\nfunction headSlotOf(\n  events: readonly SessionEvent[],\n  seq: number,\n  cut: number,\n  checkpointShadowed: ReadonlySet<number> | undefined,\n): HeadSlot | undefined {\n  const surface = events[seq]\n  if (surface === undefined) return undefined\n  if (seq < cut) return { anchor: seq, effective: surface, consumed: [] }\n  // A post-cut node in the head slot needs the checkpoint's actual shadowed\n  // set: membership, not the declared numerical range, decides whether a\n  // replacement target was already removed by the checkpoint.\n  if (checkpointShadowed === undefined || checkpointShadowed.size === 0) return undefined\n  const consumed: number[] = []\n  const seen = new Set<number>()\n  let current: SessionEvent | undefined = surface\n  while (current !== undefined) {\n    if (seen.has(current.seq) || seen.size > MAX_HEAD_REPLACEMENTS) return undefined\n    seen.add(current.seq)\n    if (current.type !== 'system/message') return undefined\n    const replace = surfaceReplaceSpan(current)\n    if (replace === undefined) {\n      // The chain ends at the surviving anchor: it must predate the cut and\n      // must not be one of the entries the checkpoint removed.\n      if (current.seq >= cut || checkpointShadowed.has(current.seq)) return undefined\n      return { anchor: current.seq, effective: surface, consumed }\n    }\n    if (replace.start !== replace.end || replace.start >= current.seq) return undefined\n    if (checkpointShadowed.has(replace.start)) return undefined\n    consumed.push(current.seq)\n    current = events[replace.start]\n  }\n  return undefined\n}\n\n/**\n * The surviving head as a state-machine-complete event list: the head slots\n * (surface order; a slot is its pre-cut anchor, or the latest replacement of\n * it) wrapped in a turn/step skeleton NORMALIZED to turn 1 step 1 — the seed\n * is a fresh log, the host's turn/step counters must start there, and the\n * emitted node's original numbers are envelope metadata the rebase is free to\n * rewrite (the protected system head can be a mid-session rewrite living in a\n * later turn/step, including a replacement written after the checkpoint).\n * Closers are recovered from the log when the skeleton's own closers were\n * dropped with the span. A head wider than one step/turn (or numbers that\n * disagree) is not a shape this builder represents and falls back to the full\n * copy.\n * @param events - the parent's log.\n * @param slots - the resolved head slots before the checkpoint's surface slot.\n * @returns the head segment's events, or undefined when the shape is not\n *  representable.\n */\nfunction headSkeleton(events: readonly SessionEvent[], slots: readonly HeadSlot[]): SessionEvent[] | undefined {\n  if (slots.length === 0) return []\n  const first = events[slots[0]!.anchor]\n  const last = events[slots[slots.length - 1]!.anchor]\n  if (first === undefined || last === undefined) return undefined\n  let turnStart: SessionEvent | undefined\n  let stepStart: SessionEvent | undefined\n  for (let index = first.seq - 1; index >= 0; index--) {\n    const event = events[index]\n    if (event === undefined) break\n    if (event.type === 'turn/end') break\n    // The NEAREST step/start below the node is the one that encloses it.\n    if (event.type === 'step/start' && stepStart === undefined) stepStart = event\n    if (event.type === 'turn/start') {\n      turnStart = event\n      break\n    }\n  }\n  // Rewrite envelope turn/step in place of the originals — only where the\n  // event already carries numbers (a user/message never does, and its whole\n  // data object IS the model-visible message, so injecting fields there\n  // would change the child's context) — keeping the data losslessly\n  // JSON-serializable (never writing explicit undefined).\n  const parts: SessionEvent[] = []\n  if (turnStart !== undefined) {\n    const turn = dataOf(turnStart).turn\n    if (typeof turn !== 'number') return undefined\n    const step = stepStart !== undefined ? dataOf(stepStart).step : undefined\n    if (stepStart !== undefined && typeof step !== 'number') return undefined\n    // The ANCHORS must all sit in this ONE step/turn (by their ORIGINAL\n    // numbers); a replacement slot carries the anchor's slot position, so it\n    // is checked by the anchor's numbers, not the replacement's. A wider head\n    // is not a shape this builder represents.\n    for (const slot of slots) {\n      const node = events[slot.anchor]\n      if (node === undefined) return undefined\n      const nodeData = dataOf(node)\n      if (nodeData.turn !== turn && nodeData.turn !== undefined) return undefined\n      if (stepStart !== undefined && nodeData.step !== step && nodeData.step !== undefined) return undefined\n    }\n    parts.push(normalizeEventCounters(turnStart, { turn: 1 }))\n    if (stepStart !== undefined) parts.push(normalizeEventCounters(stepStart, { turn: 1, step: 1 }))\n    for (const slot of slots) parts.push(normalizeEventCounters(slot.effective, { turn: 1, ...(stepStart !== undefined ? { step: 1 } : {}) }))\n    // Close the skeleton when its closers are dropped with the span: the\n    // first step/end / turn/end of this step/turn after the last anchor.\n    let closedStep = false\n    for (let index = last.seq + 1; index < events.length; index++) {\n      const event = events[index]\n      if (event === undefined) break\n      if (!closedStep && event.type === 'step/end' && typeof step === 'number'\n        && dataOf(event).step === step && dataOf(event).turn === turn) {\n        parts.push(normalizeEventCounters(event, { turn: 1, step: 1 }))\n        closedStep = true\n        continue\n      }\n      if (event.type === 'turn/end' && dataOf(event).turn === turn) {\n        parts.push(normalizeEventCounters(event, { turn: 1 }))\n        break\n      }\n      if (event.type === 'turn/start') break\n    }\n    return closedStep || step === undefined ? parts : undefined\n  }\n  // No enclosing turn: out-of-turn events are legal as-is. A replacement slot\n  // has no turn to normalize into, so it is not representable here.\n  for (const slot of slots) {\n    const node = events[slot.anchor]\n    if (node === undefined || slot.effective !== node) return undefined\n    parts.push(node)\n  }\n  return parts\n}\n\n/** Log index of the turn/start enclosing one seq, the seq itself when the\n *  node sits between turns (the keep window then starts verbatim at its own\n *  skeleton root), or the log length when there is no keep window at all. */\nfunction enclosingTurnStart(events: readonly SidechatLogEvent[], seq: number | undefined): number {\n  if (seq === undefined) return events.length\n  for (let index = seq - 1; index >= 0; index--) {\n    const event = events[index]\n    if (event === undefined) return seq\n    if (event.type === 'turn/start') return index\n    if (event.type === 'turn/end') return seq\n  }\n  return seq\n}\n\n/** Whether one event belongs to the compaction group being consumed (its\n *  log-only start/summary/end records leave with the span they priced).\n *  Other groups' records stay — they meter history the child keeps. A\n *  summary without a `compactionId` is malformed; nothing is excluded for\n *  it and the equivalence check decides. */\nfunction isCompactionGroupEvent(event: SidechatLogEvent, groupId: unknown): boolean {\n  if (!event.type.startsWith('compaction/')) return false\n  if (typeof groupId !== 'string') return false\n  return dataOf(event).compactionId === groupId\n}\n\n/** Index of the checkpoint user/message of the last summarizing compaction:\n *  the event right after a `compaction/summary` — that adjacency is the\n *  shadow-price contract. An orphaned summary (its replacement never\n *  landed) is skipped in favor of the previous complete one. */\nfunction lastCheckpointIndex(events: readonly SidechatLogEvent[]): number | undefined {\n  for (let index = events.length - 1; index >= 0; index--) {\n    if (events[index]?.type !== 'compaction/summary') continue\n    if (events[index + 1]?.type === 'user/message') return index + 1\n  }\n  return undefined\n}\n\n/** One `type` + model-visible-content token per visible node, mirroring the\n *  renderer's projection: a user/message IS its whole data object, every\n *  other surface event projects `data.message` (its envelope turn/step and\n *  headerSeq are rewritten by the rebase and never reach the model). */\nfunction visibleToken(event: SidechatLogEvent | undefined): string {\n  if (event === undefined) return 'missing'\n  if (event.type === 'user/message') return `${event.type}:${JSON.stringify(dataOf(event))}`\n  const message = dataOf(event).message\n  return `${event.type}:${JSON.stringify(message ?? null)}`\n}\n\n/** Compare the parent's visible nodes with the rebased child's by content. */\nfunction sameVisibleSequence(\n  parent: readonly SidechatLogEvent[],\n  parentNodes: readonly number[],\n  childNodes: readonly number[],\n  child: readonly SidechatLogEvent[],\n): boolean {\n  if (parentNodes.length !== childNodes.length) return false\n  for (let index = 0; index < parentNodes.length; index++) {\n    if (visibleToken(parent[parentNodes[index] as number]) !== visibleToken(child[childNodes[index] as number])) {\n      return false\n    }\n  }\n  return true\n}\n\n/**\n * Copy one kept event into the rebased sequence: envelope seq references\n * are remapped through the rebase map, `data.turn` numbers at or past the\n * first kept turn shift down by the gap the dropped span left (the host's\n * turn counter must stay contiguous), and a seq reference the map cannot\n * serve (it points into the dropped span) degrades the event honestly — a\n * replace whose shadowed nodes are gone becomes an append, dropped\n * citations vanish — except `developer/message.headerSeq`, whose referent\n * cannot be degraded: that aborts the whole tail.\n * @param event - the kept event to copy.\n * @param seq - the event's position in the rebased sequence.\n * @param rebase - old seq → rebased position over the kept set.\n * @param turnOffset - turns removed before the keep window (0 = no shift).\n * @param firstKeptTurn - the first kept turn number; smaller numbers are\n *  head-side and never shift.\n * @returns the rebased event, or undefined when the tail is not provable.\n */\n/** Sentinel: the event is log-only metering whose referenced span did not\n *  survive the rebase — drop it instead of aborting the whole tail. */\nconst DROPPED: unique symbol = Symbol('dropped')\n\ntype RebasedEvent = SeedEvent | undefined | typeof DROPPED\n\nfunction normalizeEventCounters<T extends SessionEvent>(event: T, over: { turn?: number; step?: number }): T {\n  const data = { ...event.data }\n  if (over.turn !== undefined && 'turn' in data && typeof data.turn === 'number') data.turn = over.turn\n  if (over.step !== undefined && 'step' in data && typeof data.step === 'number') data.step = over.step\n  return { ...event, data }\n}\n\nfunction rebaseEvent(\n  event: SessionEvent,\n  seq: number,\n  rebase: Map<number, number>,\n  turnOffset: number,\n  firstKeptTurn: number | undefined,\n): RebasedEvent {\n  let seed: SeedEvent = { ...event, seq: seq as SessionSeq }\n  const sourceData = dataOf(event)\n  if (turnOffset > 0 && typeof sourceData.turn === 'number'\n    && firstKeptTurn !== undefined && sourceData.turn >= firstKeptTurn) {\n    seed = normalizeEventCounters(seed, { turn: sourceData.turn - turnOffset })\n  }\n  // A settled command cites an earlier non-command event by seq; remap it\n  // alongside, and drop the done when the cited event did not survive — a\n  // stale citation is something the host's commands invariant rejects.\n  if (seed.type === 'command/done' && typeof sourceData.sourceEventSeq === 'number') {\n    const mapped = rebase.get(sourceData.sourceEventSeq)\n    if (mapped === undefined) return DROPPED\n    seed.data = { ...seed.data, sourceEventSeq: mapped as SessionSeq }\n  }\n  // Compaction metering records cite the surface span they priced. When the\n  // span survived the rebase, remap the citations; when it did not (the\n  // record predates the consumed compaction and its span lies in the\n  // dropped region), the record meters nothing that exists in the child —\n  // drop it rather than shipping stale seq references.\n  if (seed.type === 'compaction/summary' || seed.type === 'compaction/prune') {\n    const range = sourceData.shadowedRange as { start?: unknown; end?: unknown } | undefined\n    const cited = sourceData.shadowedSeqs\n    if (range === null || typeof range !== 'object' || !Array.isArray(cited)) return seed\n    const start = typeof range.start === 'number' ? rebase.get(range.start) : undefined\n    const end = typeof range.end === 'number' ? rebase.get(range.end) : undefined\n    const mapped = cited.map(item => typeof item === 'number' ? rebase.get(item) : undefined)\n    if (start === undefined || end === undefined || mapped.includes(undefined)) return DROPPED\n    seed.data = {\n      ...seed.data,\n      shadowedRange: { start: start as SessionSeq, end: end as SessionSeq },\n      shadowedSeqs: mapped as SessionSeq[],\n    }\n  }\n  // The DeepSeek log ledger cites an ABSOLUTE watermark: `throughSeq` is\n  // the last event whose upload a request confirmed, and the host's v4 reader\n  // requires it to precede its own marker. Renumbering without it ships a\n  // seed the reader rejects outright (\"delivery throughSeq must precede its\n  // marker\") — the child then stays permanently unreadable. Carry the\n  // watermark through the same map; one that names an event inside the\n  // dropped span has no child-side equivalent, so the record drops rather\n  // than citing a delivery that never happened.\n  if (seed.type === 'session-log-deepseek/delivery-accepted' && typeof sourceData.throughSeq === 'number') {\n    const mapped = rebase.get(sourceData.throughSeq)\n    if (mapped === undefined) return DROPPED\n    seed.data = { ...seed.data, throughSeq: mapped as SessionSeq }\n  }\n  const headerSeq = sourceData.headerSeq\n  if (seed.type === 'developer/message' && typeof headerSeq === 'number') {\n    const mapped = rebase.get(headerSeq)\n    if (mapped === undefined) return undefined\n    seed.data = { ...seed.data, headerSeq: mapped as SessionSeq }\n  }\n  const op = (event as { surfaceOp?: unknown }).surfaceOp\n  if (op === 'append') {\n    seed.surfaceOp = 'append'\n  } else if (op !== null && typeof op === 'object' && 'op' in op && (op as { op: unknown }).op === 'replace') {\n    const replace = op as { startSeq?: unknown; endSeq?: unknown }\n    const start = typeof replace.startSeq === 'number' ? rebase.get(replace.startSeq) : undefined\n    const end = typeof replace.endSeq === 'number' ? rebase.get(replace.endSeq) : undefined\n    // A range the rebase cannot resolve lost its shadowed nodes with the\n    // dropped span; appending the replacement is exactly what remains\n    // visible (the equivalence check still has to confirm it).\n    seed.surfaceOp = start !== undefined && end !== undefined && start <= end\n      ? { op: 'replace', startSeq: start as SessionSeq, endSeq: end as SessionSeq }\n      : 'append'\n  }\n  const cited = (event as { sourceEventSeqs?: unknown }).sourceEventSeqs\n  if (Array.isArray(cited)) {\n    const mapped = cited.map(item => typeof item === 'number' ? rebase.get(item) : undefined)\n    // Citations the rebase cannot serve referenced the dropped span; the\n    // field is optional and only has to cover a live replace range.\n    if (!mapped.includes(undefined)) seed.sourceEventSeqs = mapped as SessionSeq[]\n    else delete seed.sourceEventSeqs\n  }\n  return seed\n}\n\n/**\n * Build the side-thread inheritance for one parent log: the full event log\n * up to the click moment, honestly closed when it ends inside an open turn.\n * When the parent has compacted, the log is first rebased onto its last\n * summarizing compaction (`compactionTail`) — same model-visible surface, a\n * fraction of the durable copy.\n * @param events - the parent's log (live or persisted).\n * @param live - the parent's in-flight stream chunks (DSH 0.1.5+ publishes\n *   them outside the log); used only by the snapshot fallback.\n */\nexport function buildSidechatInheritance(\n  events: readonly SessionEvent[],\n  live: readonly AssistantLiveChunk[] = [],\n): SidechatInheritance {\n  if (events.length === 0) return { seed: [], snapshot: null }\n  const trimmed = compactionTail(events)\n  const log = trimmed ?? events\n  const boundary = lastTurnBoundary(log)\n  if (boundary < 0 || log[boundary]?.type === 'turn/end') {\n    // Ends outside any turn (or has no turns at all): the whole log is a\n    // valid, balanced seed — possibly ending with a pending user message.\n    return { seed: copyEvents(log), snapshot: null }\n  }\n  // Ends inside the open turn starting at `boundary`.\n  if (hasDanglingToolCall(log, boundary)) {\n    // Cannot close honestly: cut before the open turn; the caller attaches\n    // the structured snapshot to the boundary prompt instead.\n    return {\n      seed: copyEvents(log.slice(0, boundary)),\n      snapshot: buildOpenTurnSnapshot(log, live),\n    }\n  }\n  const seed = copyEvents(log)\n  const last = log[log.length - 1]\n  const turn = numberAt(dataOf(log[boundary]!), 'turn')\n  const now = last?.time ?? 0\n  const openStep = openStepInTurn(log, boundary)\n  if (openStep !== undefined) {\n    seed.push({ type: 'step/end', seq: seed.length as SessionSeq, time: now, data: { turn, step: openStep } })\n  }\n  seed.push({\n    type: 'turn/end',\n    seq: seed.length as SessionSeq,\n    time: now,\n    data: { turn, reason: { kind: 'interrupted' } },\n  })\n  return { seed, snapshot: null }\n}\n\n/** One assistant content block reduced to the text the snapshot shows. */\nfunction messageTexts(message: unknown): { text: string; reasoning: string } {\n  const content = (message as { content?: unknown } | undefined)?.content\n  let text = ''\n  let reasoning = ''\n  if (!Array.isArray(content)) return { text, reasoning }\n  for (const block of content) {\n    if (block === null || typeof block !== 'object') continue\n    const candidate = block as { type?: unknown; text?: unknown }\n    if (typeof candidate.text !== 'string' || candidate.text === '') continue\n    if (candidate.type === 'text') text += candidate.text\n    else if (candidate.type === 'reasoning') reasoning += candidate.text\n  }\n  return { text, reasoning }\n}\n\n/**\n * Expand one attempt's compact `AssistantStreamRecord[]` (the durable stream\n * DSH 0.1.5 embeds in `assistant/message.stream` and `assistant/attempt.stream`)\n * into the text/reasoning it carried. Tool-call records contribute no text.\n */\nfunction streamTexts(stream: unknown): { text: string; reasoning: string } {\n  let text = ''\n  let reasoning = ''\n  if (!Array.isArray(stream)) return { text, reasoning }\n  for (const record of stream) {\n    if (record === null || typeof record !== 'object') continue\n    const entry = record as { type?: unknown; texts?: unknown; chunk?: unknown }\n    if (entry.type === 'text-chunks' || entry.type === 'reasoning-chunks') {\n      if (!Array.isArray(entry.texts)) continue\n      const joined = entry.texts.filter((part): part is string => typeof part === 'string').join('')\n      if (entry.type === 'text-chunks') text += joined\n      else reasoning += joined\n      continue\n    }\n    if (entry.type === 'chunk') {\n      const chunk = entry.chunk as { type?: unknown; text?: unknown } | undefined\n      if (chunk === null || typeof chunk !== 'object' || typeof chunk.text !== 'string') continue\n      if (chunk.type === 'text-delta') text += chunk.text\n      else if (chunk.type === 'reasoning-delta') reasoning += chunk.text\n    }\n  }\n  return { text, reasoning }\n}\n\n/** One live delta's contribution to the snapshot. */\nfunction liveTexts(chunk: Record<string, unknown>): { text: string; reasoning: string } {\n  if (typeof chunk.text !== 'string' || chunk.text === '') return { text: '', reasoning: '' }\n  if (chunk.type === 'text-delta') return { text: chunk.text, reasoning: '' }\n  if (chunk.type === 'reasoning-delta') return { text: '', reasoning: chunk.text }\n  return { text: '', reasoning: '' }\n}\n\n/**\n * Structured text snapshot of the parent's OPEN turn (from its `turn/start`\n * to the log tail): the assistant/reasoning output so far and the tool\n * activity — executed tools with their result text, the still-executing one\n * marked. Returns null when there is no open turn or nothing to show.\n *\n * The in-flight step's text is NOT in the log on DSH 0.1.5 (the model stream\n * is process-local until it settles), so it comes from `live`; settled steps\n * read their durable `assistant/message` content, and a failed attempt reads\n * its embedded `assistant/attempt.stream`.\n * @param events - the parent's log.\n * @param live - the parent's in-flight stream chunks, in index order.\n */\nexport function buildOpenTurnSnapshot(\n  events: readonly SidechatLogEvent[],\n  live: readonly AssistantLiveChunk[] = [],\n): string | null {\n  const boundary = lastTurnBoundary(events)\n  if (boundary < 0 || events[boundary]?.type !== 'turn/start') return null\n  const openTurn = numberAt(dataOf(events[boundary]!), 'turn')\n  let text = ''\n  let reasoning = ''\n  const tools: string[] = []\n  const pendingCalls = new Map<string, { name: string; args: string }>()\n  for (let index = boundary + 1; index < events.length; index++) {\n    const event = events[index]\n    if (event === undefined) continue\n    const data = dataOf(event)\n    if (event.type === 'step/end') {\n      pendingCalls.clear()\n      continue\n    }\n    if (event.type === 'assistant/message') {\n      const settled = messageTexts(data.message)\n      text += settled.text\n      reasoning += settled.reasoning\n      continue\n    }\n    if (event.type === 'assistant/attempt') {\n      const attempt = streamTexts(data.stream)\n      text += attempt.text\n      reasoning += attempt.reasoning\n      continue\n    }\n    if (event.type === 'tool/call') {\n      const callId = data.callId\n      if (typeof callId === 'string') {\n        pendingCalls.set(callId, {\n          name: typeof data.name === 'string' ? data.name : 'tool',\n          args: typeof data.arguments === 'string' ? data.arguments : '',\n        })\n      }\n      continue\n    }\n    if (event.type === 'tool/result') {\n      const source = data.message as { source?: { callId?: unknown } } | undefined\n      const callId = typeof source?.source?.callId === 'string' ? source.source.callId : undefined\n      const name = callId !== undefined ? pendingCalls.get(callId)?.name : undefined\n      const args = callId !== undefined ? pendingCalls.get(callId)?.args : undefined\n      if (callId !== undefined) pendingCalls.delete(callId)\n      const result = toolResultText(data).slice(0, SNAPSHOT_RESULT_CAP)\n      const failed = data.error !== undefined\n      const line = [\n        `- \\`${name ?? 'tool'}\\`${failed ? ' (failed)' : ''}`\n          + (args !== undefined && args !== '' ? ` — arguments: \\`${args}\\`` : ''),\n        ...(result === '' ? [] : [`  Result: ${result}`]),\n      ].join('\\n')\n      tools.push(line)\n    }\n  }\n  for (const [, call] of pendingCalls) {\n    const line = `- \\`${call.name}\\` (executing) — arguments: \\`${call.args}\\``\n    tools.push(line)\n  }\n  // The in-flight step: its deltas never reached the log.\n  for (const delta of live) {\n    if (delta.turn !== openTurn) continue\n    const contribution = liveTexts(delta.chunk)\n    text += contribution.text\n    reasoning += contribution.reasoning\n  }\n  const sections: string[] = []\n  if (text.trim() !== '') sections.push(`Assistant output so far:\\n\\n${text}`)\n  if (reasoning.trim() !== '') sections.push(`Reasoning so far:\\n\\n${reasoning}`)\n  if (tools.length > 0) sections.push(`Tool activity:\\n${tools.join('\\n')}`)\n  if (sections.length === 0) return null\n  const body = sections.join('\\n\\n')\n  return body.length > SNAPSHOT_TOTAL_CAP\n    ? `Parent session in-progress turn (reference only):\\n\\n${body.slice(0, SNAPSHOT_TOTAL_CAP)}…`\n    : `Parent session in-progress turn (reference only):\\n\\n${body}`\n}\n\n/** One side-thread row in the client's thread list. */\nexport interface SideThreadRow {\n  id: string\n  /** The durable thread title ('Side: …'). */\n  title: string\n  /** Whether the thread's agent is currently running. */\n  running: boolean\n}\n\n/**\n * Derive the side threads of one parent session from the client session list:\n * durable `origin: 'subagent'` children of the parent whose pinned title\n * carries the thread label prefix (our creation path pins it via\n * sessionTitle.rename; dsh-sidechain threads share the convention, so they\n * are visible here too).\n */\nexport function sideThreadRows(\n  byId: Readonly<Record<string, SidebarSessionSummary>>,\n  sessionId: string,\n): SideThreadRow[] {\n  const rows: SideThreadRow[] = []\n  for (const summary of Object.values(byId)) {\n    if (summary.origin !== 'subagent' || summary.parentId !== sessionId) continue\n    if (!summary.displayTitle.startsWith(SIDE_LABEL_PREFIX)) continue\n    rows.push({ id: summary.id, title: summary.displayTitle, running: summary.running === true })\n  }\n  return rows\n}\n\n/** Truncate + prefix a question into a durable thread label. */\nexport function sideLabel(question: string): string {\n  const flat = question.replace(/\\s+/g, ' ').trim()\n  const max = Math.max(1, LABEL_MAX_CHARS - SIDE_LABEL_PREFIX.length)\n  const body = flat.length > max ? `${flat.slice(0, max - 1)}…` : flat\n  return `${SIDE_LABEL_PREFIX}${body}`\n}\n\n/**\n * Whether the thread log already carries the side boundary message — i.e.\n * the first prompt was delivered. Tolerant to the content shape (block\n * array or bare string) and to inherited seed messages (only an OWN\n * boundary message starts with the prefix; seed messages came from the\n * parent's log, which never contains one).\n */\nexport function boundaryDelivered(events: readonly SidechatLogEvent[]): boolean {\n  for (const event of events) {\n    if (event.type !== 'user/message') continue\n    if (messageLeadText(dataOf(event)).startsWith(SIDE_BOUNDARY_PREFIX)) return true\n  }\n  return false\n}\n\n/** The leading text of a user/message's content (block array or bare string). */\nfunction messageLeadText(data: Record<string, unknown>): string {\n  const content = data.content\n  const first = Array.isArray(content) ? content[0] : content\n  return typeof first === 'string'\n    ? first\n    : (typeof first === 'object' && first !== null && 'text' in first\n      ? String((first as { text: unknown }).text)\n      : '')\n}\n\n/**\n * Whether a logged user/message is a CONTEXT INJECTION (the boundary prompt\n * plus the parked in-progress snapshot) rather than a real user message.\n * New threads deliver the injection via `agent.inject` stamped with a\n * non-'user' source kind; threads created before that split carry\n * boundary+question in ONE 'user' message, recognized by the boundary\n * prefix. Both render as one collapsible injection row — never as a user\n * bubble.\n */\nexport function isContextInjectionMessage(data: Record<string, unknown>): boolean {\n  const source = data.source as { kind?: unknown } | null | undefined\n  if (source?.kind !== undefined && source.kind !== 'user') return true\n  return messageLeadText(data).startsWith(SIDE_BOUNDARY_PREFIX)\n}\n\n/** The info the thread header shows (live runtime state + agent identity). */\nexport interface SidechatThreadInfo {\n  images?: { available: boolean; limits?: SidechatImageLimits }\n  /** A live agent drives the thread right now (false = cold/persisted). */\n  live: boolean\n  /** Live lifecycle state; absent on cold threads. */\n  status?: 'idle' | 'running'\n  /** Provider route the thread actually requests with (see\n   *  {@link parentModelSelection} — NOT the frozen creation-time default). */\n  provider?: string\n  /** Model id the thread actually requests with. */\n  model?: string\n  /** Reasoning effort of the effective selection, when the log records one. */\n  reasoningEffort?: string\n  /** The recorded agent preset (live header, or persisted on cold reads). */\n  preset?: string\n}\n\n/**\n * One UNCLAIMED inbox message of a live side thread — the queue the next step\n * or turn will claim. The transcript renders these as pending user bubbles\n * (with a spinner and a dequeue affordance) instead of leaving accepted input\n * invisible until a claim logs it as a durable `user/message`.\n */\nexport interface SidechatPendingInput {\n  images?: SidechatImageOccurrence[]\n  removable?: boolean\n  /** Durable message identity — the `sidechat.dequeue` key. */\n  id: string\n  /** Which boundary will claim it; `next-step` entries are claimed first. */\n  target: 'next-turn' | 'next-step'\n  /** Flattened text of the message content ('' when it carries no text). */\n  text: string\n}\n\n/** One routable model in the host model catalog (a structural slice of the\n *  session controller's own `modelCatalog` rows). */\nexport interface SidechatModelInfo {\n  id: string\n  name?: string\n  description?: string\n  /** Provider-declared reasoning efforts, when the model has any. */\n  reasoning?: {\n    efforts: readonly { id: string; name?: string; description?: string }[]\n    defaultEffort?: string\n  }\n}\n\n/** One provider group of the host model catalog. */\nexport interface SidechatModelGroup {\n  id: string\n  name?: string\n  models: readonly SidechatModelInfo[]\n}\n\n/**\n * The host model catalog as the side-chat model picker consumes it. Sourced\n * from the host's own `sessionController.modelCatalog()` (the exact catalog\n * the main composer lists), degraded to `available: false` when that service\n * is absent — the picker then offers only \"inherit the parent\".\n */\nexport interface SidechatModelCatalog {\n  /** Whether a host catalog was readable at all. */\n  available: boolean\n  /** The deployment default selection, when readable. */\n  default?: SidechatModelSelection\n  /** Provider groups with at least one routable model. */\n  groups: readonly SidechatModelGroup[]\n  /** Providers whose catalog read failed (kept so the picker can say so). */\n  failures: readonly { id: string; name?: string; message: string }[]\n}\n\n/** The identity one inbox message carries (`MessageId`, a branded string). */\nexport function pendingInputId(message: unknown): string | undefined {\n  const id = (message as { id?: unknown } | undefined)?.id\n  return typeof id === 'string' && id !== '' ? id : undefined\n}\n\n/**\n * Project one agent's inbox into wire rows, in CLAIM order: every `next-step`\n * entry first, then the queued turns (the host's `Inbox.claim` drains exactly\n * that way). Messages without an identity are skipped — they could not be\n * dequeued, so showing them as pending would offer a dead button.\n */\nexport function pendingInputs(\n  nextStep: readonly unknown[],\n  nextTurn: readonly unknown[],\n): SidechatPendingInput[] {\n  const rows: SidechatPendingInput[] = []\n  const add = (message: unknown, target: SidechatPendingInput['target']): void => {\n    const id = pendingInputId(message)\n    if (id === undefined) return\n    rows.push({ id, target, ...projectSidechatContent((message as { content?: unknown }).content) })\n  }\n  for (const message of nextStep) add(message, 'next-step')\n  for (const message of nextTurn) add(message, 'next-turn')\n  return rows\n}\n\n/**\n * Fold a log's `agent/inbox/spliced` events into the message ids STILL pending\n * after it — the durable record of the inbox (the host's own\n * `inboxProjectionDefinition` semantics: apply every splice in order).\n *\n * This is the reading the ghost sweep needs: a seeded thread's inherited\n * prefix can leave messages \"pending\" that the parent had already claimed\n * (the claim splice sits inside the parent's open turn, which the seed\n * truncation cuts away), and those must never be delivered as the child's\n * own input.\n * @param events - the log (or any prefix of it), contiguous from seq 0.\n * @param limit - exclusive upper bound of event count to fold (the inherited\n *   prefix length, or the whole log).\n * @returns the ids of messages still pending after the folded events.\n */\nexport function inboxInLog(events: readonly SidechatLogEvent[], limit?: number): { nextStep: unknown[]; nextTurn: unknown[] } {\n  const nextTurn: unknown[] = []\n  const nextStep: unknown[] = []\n  const end = limit === undefined ? events.length : Math.min(limit, events.length)\n  for (let index = 0; index < end; index++) {\n    const event = events[index]\n    if (event === undefined || event.type !== 'agent/inbox/spliced') continue\n    const data = dataOf(event)\n    const target = data.target === 'next-step' ? nextStep : data.target === 'next-turn' ? nextTurn : undefined\n    if (target === undefined) continue\n    const start = typeof data.start === 'number' && Number.isSafeInteger(data.start) ? data.start : 0\n    const removed = typeof data.removedCount === 'number' && Number.isSafeInteger(data.removedCount) ? data.removedCount : 0\n    const inserted = Array.isArray(data.inserted) ? data.inserted : []\n    target.splice(Math.max(0, Math.min(start, target.length)), Math.max(0, removed), ...inserted)\n  }\n  return { nextStep, nextTurn }\n}\n\nexport function pendingIdsInLog(events: readonly SidechatLogEvent[], limit?: number): string[] {\n  const { nextStep, nextTurn } = inboxInLog(events, limit)\n  const ids: string[] = []\n  for (const message of [...nextStep, ...nextTurn]) {\n    const id = pendingInputId(message)\n    if (id !== undefined) ids.push(id)\n  }\n  return ids\n}\n\n/**\n * The message ids a seeded thread INHERITED as still-pending but never\n * actually owned: fold only the inherited prefix (`[0, inheritedEventCount)`),\n * which is exactly the region the parent's own claim splices may have been\n * cut out of. The caller removes precisely these from the live inbox, so a\n * user's genuinely queued side-thread input is never touched.\n * @param events - the thread's log.\n * @param inheritedEventCount - the thread's inherited prefix length.\n * @returns the ghost message ids present in the prefix fold.\n */\nexport function inheritedPendingIds(\n  events: readonly SidechatLogEvent[],\n  inheritedEventCount: number,\n): string[] {\n  return pendingIdsInLog(events, Math.max(0, Math.trunc(inheritedEventCount)))\n}\n\nexport function coldPendingMessages(events: readonly SidechatLogEvent[], inheritedEventCount?: number): { nextStep: unknown[]; nextTurn: unknown[] } {\n  const boundary = inheritedEventCount ?? events.findLastIndex(event => event.type === 'session/end-seed' && (event.data as { inherited?: boolean }).inherited === true)\n  const ghosts = new Set(inheritedPendingIds(events, Math.max(0, boundary)))\n  const inbox = inboxInLog(events)\n  const owned = (message: unknown): boolean => !ghosts.has(pendingInputId(message) ?? '')\n  return { nextStep: inbox.nextStep.filter(owned), nextTurn: inbox.nextTurn.filter(owned) }\n}\n\n/**\n * The thread's effective model selection: `pending ?? lastUsed` of its own\n * `model/selection` / `request/header` fold (see {@link parentModelSelection},\n * which this is the same projection as). Used by the routes to report what the\n * thread will actually request with.\n */\nexport function effectiveModelSelection(\n  events: readonly SidechatLogEvent[],\n): SidechatModelSelection | undefined {\n  return parentModelSelection(events)\n}\n\n/** The index of the first event a thread produced ITSELF: its last\n *  `session/end-seed { inherited: true }` fork boundary + 1, or 0 when the log\n *  carries no inherited marker (an already-cut payload). Untagged markers\n *  delimit restore/replay lifecycles, not inherited history.\n *\n *  Exported because the cut is not private to the transcript: the fork-point\n *  summary reads the prefix this index excludes. */\nexport function threadOwnCutIndex(events: readonly SidechatLogEvent[]): number {\n  for (let index = events.length - 1; index >= 0; index--) {\n    const event = events[index]\n    if (event?.type === 'session/end-seed' && typeof event.data === 'object' && event.data !== null\n      && 'inherited' in event.data && event.data.inherited === true) return index + 1\n  }\n  return 0\n}\n\n/** The events a thread produced itself: everything after its last\n *  `session/end-seed { inherited: true }` fork boundary. A log with no\n *  inherited marker (including an already-cut route payload) is returned whole. */\nexport function threadOwnLogEvents(events: readonly SidechatLogEvent[]): SidechatLogEvent[] {\n  return events.slice(threadOwnCutIndex(events))\n}\n\n/** What the thread forked OFF: the seq of the cut marker, plus the parent's\n *  last exchange before it. The prefix itself never crosses the wire — only\n *  these parts, and they travel VERBATIM: no cap, no ellipsis, because the\n *  reader asked to read the parent's own words (the block scrolls). */\nexport interface SidechatForkPoint {\n  /** Log seq of the inherited `session/end-seed` marker the transcript cuts at. */\n  cutSeq: number\n  /** The last real user message before the cut, in full. */\n  user?: { seq: number; text: string; messageId?: string }\n  /** The last assistant answer before the cut (text blocks only), in full. */\n  assistant?: { seq: number; text: string; messageId?: string }\n}\n\n/** One content list's text blocks joined (`''` when it carries none). */\nfunction textBlocksOf(content: unknown): string {\n  if (!Array.isArray(content)) return ''\n  const parts: string[] = []\n  for (const block of content) {\n    if (block === null || typeof block !== 'object') continue\n    const candidate = block as { type?: unknown; text?: unknown }\n    if (candidate.type === 'text' && typeof candidate.text === 'string') parts.push(candidate.text)\n  }\n  return parts.join('\\n\\n')\n}\n\n/** A message's durable identity (`data.id` on a `user/message`, `message.id` on\n *  an `assistant/message`), or undefined when the log records none (older logs)\n *  — the fork part then simply omits the field instead of carrying `''`. */\nfunction messageIdOf(message: unknown): string | undefined {\n  const id = (message as { id?: unknown } | undefined)?.id\n  return typeof id === 'string' && id !== '' ? id : undefined\n}\n\n/** Spread an optional message id into a fork part, keeping it ABSENT (not\n *  `undefined`) when the log carries none. */\nfunction withMessageId(messageId: string | undefined): { messageId?: string } {\n  return messageId === undefined ? {} : { messageId }\n}\n\n/** Whether a `user/message` is a surface REPLACEMENT (a compaction checkpoint or\n *  another shadowing node), never a message the reader typed. */\nfunction isReplacementMessage(event: SidechatLogEvent & { surfaceOp?: unknown }): boolean {\n  const op = event.surfaceOp\n  return op !== undefined && op !== 'append'\n}\n\n/**\n * Summarise the parent conversation a seeded thread forked from.\n *\n * The whole point is to stay honest about the cut: the transcript shows only the\n * tail, so the reader cannot otherwise tell which question they were asking in\n * the main pane. Everything is read from BEFORE the cut marker — computed on the\n * FULL log, never on the already-cut tail.\n * @param events - the thread's complete decoded log (parent prefix + own tail).\n * @returns the fork point, or undefined when the log carries no inherited marker.\n */\nexport function sidechatForkPoint(events: readonly SidechatLogEvent[]): SidechatForkPoint | undefined {\n  const cutIndex = threadOwnCutIndex(events)\n  if (cutIndex === 0) return undefined\n  const prefix = events.slice(0, cutIndex)\n  const fork: SidechatForkPoint = { cutSeq: events[cutIndex - 1]?.seq ?? 0 }\n  // The part describes the moment the reader branched off, so it is the last\n  // message of its kind that SAYS something before the cut — and only that one.\n  // A QUESTION with no text (an image-only prompt) leaves the part out: falling\n  // back to an earlier question would misdate the fork. An ANSWER is different:\n  // the log records one `assistant/message` per STEP, so the message right\n  // before the cut is routinely textless (a tool call, or reasoning only) — that\n  // step is SKIPPED and the scan keeps walking back, because stopping there\n  // would report \"no answer\" for a parent whose last exchange plainly had one.\n  //\n  // Two things that LOOK like a user message are not one, and both are skipped\n  // by CONTINUING the scan (a runtime injection routinely lands right after the\n  // reader's real question, so stopping here would put a reminder in the\n  // banner): a surface replacement (a compaction checkpoint), and a runtime\n  // context injection, whose `source.kind` is the loader's own (`time-context`,\n  // `tmux-context`, `plugin:…`) — the same predicate the transcript classifies\n  // injections by, so a log whose source is absent still counts as the reader's.\n  for (let index = prefix.length - 1; index >= 0; index--) {\n    const event = prefix[index]\n    if (event === undefined || event.type !== 'user/message') continue\n    if (isReplacementMessage(event as SidechatLogEvent & { surfaceOp?: unknown })) continue\n    if (isContextInjectionMessage(event.data as Record<string, unknown>)) continue\n    const text = textBlocksOf((event.data as { content?: unknown }).content)\n    if (text !== '') fork.user = { seq: event.seq, text, ...withMessageId(messageIdOf(event.data)) }\n    break\n  }\n  for (let index = prefix.length - 1; index >= 0; index--) {\n    const event = prefix[index]\n    if (event === undefined || event.type !== 'assistant/message') continue\n    const message = (event.data as { message?: { content?: unknown; id?: unknown } }).message\n    const text = textBlocksOf(message?.content)\n    if (text !== '') {\n      fork.assistant = { seq: event.seq, text, ...withMessageId(messageIdOf(message)) }\n      break\n    }\n  }\n  return fork\n}\n\n/** {@link threadOwnLogEvents} over history rows (the client cache shape). */\nexport function threadOwnEvents(entries: readonly SidebarHistoryEntry[]): SidechatLogEvent[] {\n  return threadOwnLogEvents(entries.map(entry => entry.event))\n}\n\n/**\n * Whether the thread has at least one completed turn — the save-as-new-\n * session precondition (`session.fork` refuses to fork before the first\n * `turn/end`).\n */\nexport function threadHasCompletedTurn(entries: readonly SidebarHistoryEntry[]): boolean {\n  return threadOwnEvents(entries).some(event => event.type === 'turn/end')\n}\n\n/** Whether the thread ends with a user message that no completed turn\n *  answered yet — such a pending follow-up is NOT carried into the saved\n *  session (the fork cut is the last `turn/end`). */\nexport function threadTrailingPending(entries: readonly SidebarHistoryEntry[]): boolean {\n  const own = threadOwnEvents(entries)\n  let lastUser = -1\n  let lastTurnEnd = -1\n  own.forEach((event, index) => {\n    if (event.type === 'user/message') lastUser = index\n    if (event.type === 'turn/end') lastTurnEnd = index\n  })\n  return lastUser > lastTurnEnd\n}\n\n/**\n * The agent preset a session actually runs: newest `agent-preset/selected`\n * event wins, else the creation header (mirror of the dsh-agent-presets\n * resolveSessionPreset helper — replicated here to avoid a host dependency\n * on that package).\n */\nexport function resolvePresetId(\n  header: { agentPreset?: string },\n  events: readonly SidechatLogEvent[],\n): string | undefined {\n  for (let index = events.length - 1; index >= 0; index--) {\n    const event = events[index]\n    if (event?.type !== 'agent-preset/selected') continue\n    const preset = dataOf(event).agentPreset\n    if (typeof preset === 'string') return preset\n  }\n  return header.agentPreset\n}\n\n/** One model route as the durable log records it (the shape of a\n *  `model/selection` event payload and of the core `modelSelection`\n *  projection rows). */\nexport interface SidechatModelSelection {\n  provider: string\n  model: string\n  reasoningEffort?: string\n}\n\n/**\n * The model selection a session CURRENTLY runs, projected from its durable\n * log (mirror of the core `modelSelection` projection — replicated here\n * like resolvePresetId to avoid a host dependency). An explicit\n * `model/selection` event stays PENDING until a same-route `request/header`\n * consumes it; the value the composer's model selector shows is\n * `pending ?? lastUsed`.\n *\n * This is NOT what `agent.options.provider/model` holds: those freeze the\n * creation-time deployment default and are never rewritten by a UI model\n * switch — DSH 0.1.5 routes requests through the session-local selection\n * and its `agent/request` waterfall instead. Anyone inheriting \"the\n * parent's current model\" must read this projection; inheriting\n * `parent.options` verbatim silently ships the stale creation default\n * (issue #368).\n *\n * A `request/header` contributes provider/model/effort, EXCEPT when its\n * effort is marked as an adapter default (`adapterDefaults.reasoningEffort`)\n * which the core selection getter deliberately does not adopt as a sticky pick.\n */\nexport function parentModelSelection(\n  events: readonly SidechatLogEvent[],\n): SidechatModelSelection | undefined {\n  let pending: SidechatModelSelection | undefined\n  let lastUsed: SidechatModelSelection | undefined\n  for (const event of events) {\n    if (event.type === 'model/selection') {\n      const selection = looseSelection(dataOf(event))\n      if (selection !== undefined) pending = selection\n      continue\n    }\n    if (event.type !== 'request/header') continue\n    const header = (dataOf(event).header as {\n      config?: unknown\n      adapterDefaults?: { reasoningEffort?: boolean }\n    } | undefined)\n    const config = header?.config\n    if (config === null || typeof config !== 'object') continue\n    const selection = looseSelection(config as Record<string, unknown>)\n    if (selection === undefined) continue\n    const isDefaultEffort = header?.adapterDefaults?.reasoningEffort === true\n    lastUsed = {\n      provider: selection.provider,\n      model: selection.model,\n      ...(!isDefaultEffort && selection.reasoningEffort !== undefined ? { reasoningEffort: selection.reasoningEffort } : {}),\n    }\n    if (sameSelection(pending, lastUsed)) pending = undefined\n  }\n  return pending ?? lastUsed\n}\n\nfunction sameSelection(\n  left: SidechatModelSelection | undefined,\n  right: SidechatModelSelection | undefined,\n): boolean {\n  if (left === right) return true\n  if (left === undefined || right === undefined) return false\n  return left.provider === right.provider\n    && left.model === right.model\n    && left.reasoningEffort === right.reasoningEffort\n}\n\n/** Narrow one loose record into a model selection (non-empty strings only). */\nfunction looseSelection(data: Record<string, unknown>): SidechatModelSelection | undefined {\n  const { provider, model, reasoningEffort } = data\n  if (typeof provider !== 'string' || provider === '') return undefined\n  if (typeof model !== 'string' || model === '') return undefined\n  return {\n    provider,\n    model,\n    ...(typeof reasoningEffort === 'string' && reasoningEffort !== '' ? { reasoningEffort } : {}),\n  }\n}\n","/**\n * The shared subagent-lineage walks over the sessions list feed (structural\n * mirror world — no runtime imports). Every public walk here answers a\n * topology question by following the DURABLE subagent-origin chain upward\n * (child → parent → …); one private generator ({@link subagentOriginChain})\n * is the single implementation of that walk, seen-set guarded so cycles fail\n * soft (the walk just stops; nothing throws).\n *\n * subagent-detect.ts and subagent-jobs.ts re-export these for their\n * established import sites — the auto-activation triggers and the Subagent\n * page both consume them through the original module paths.\n */\nimport type { SidebarSessionList, SidebarSessionSummary } from '../context-types.ts'\nimport { SIDE_LABEL_PREFIX } from '../sidechat-core.ts'\n\n/**\n * Side Chat threads ride the subagent origin (main-list hiding + the RPC\n * ownership fence) but they are NOT subagent topology: they carry the\n * durable 'Side: ' label and live as sidebar tabs. Excluding them here\n * keeps the auto-open trigger and the Subagent page counts clean.\n */\nexport function isSideThreadSummary(summary: SidebarSessionSummary): boolean {\n  return summary.origin === 'subagent' && summary.displayTitle.startsWith(SIDE_LABEL_PREFIX)\n}\n\n/**\n * Yield `start`'s uninterrupted subagent-origin chain upward: each summary\n * while it is a subagent with a known parent, then its parent row, and so\n * on. A revisited id ends the walk (cycles fail soft); the row that BREAKS\n * the chain — the first non-subagent ancestor, or a parent id with no row —\n * is deliberately NOT yielded: callers observe it through where the walk\n * stopped (the row after the last yielded one is `byId[last.parentId]`).\n */\nfunction* subagentOriginChain(\n  byId: SidebarSessionList['byId'],\n  start: SidebarSessionSummary,\n): Generator<SidebarSessionSummary> {\n  const seen = new Set<string>()\n  let current: SidebarSessionSummary | undefined = start\n  while (current?.origin === 'subagent' && current.parentId !== undefined && !seen.has(current.id)) {\n    seen.add(current.id)\n    yield current\n    current = byId[current.parentId]\n  }\n}\n\n/**\n * The main agent of the current session's tree: walk the durable parent\n * chain upward until the first non-subagent session. The Subagent page shows\n * THIS root's full topology regardless of how deep the current selection is\n * (a session whose row is still hydrating, or a broken chain, degrades to\n * the session itself).\n */\nexport function rootAncestor(\n  byId: SidebarSessionList['byId'],\n  sessionId: string | undefined,\n): string | undefined {\n  if (sessionId === undefined) return undefined\n  const start = byId[sessionId]\n  // A hydrating (or unknown) row degrades to the session itself.\n  if (start === undefined) return sessionId\n  let last: SidebarSessionSummary | undefined\n  for (const node of subagentOriginChain(byId, start)) last = node\n  if (last === undefined) return start.id\n  // The walk stopped one row past the last chain node: that parent row is\n  // the root (still missing from the feed → the session itself). Every\n  // yielded node carries a parent id (the generator's walk condition).\n  return byId[last.parentId!]?.id ?? sessionId\n}\n\n/** Descendant totals of one session through an uninterrupted subagent-origin chain. */\nexport interface SubagentDescendantTotals {\n  count: number\n  runningCount: number\n}\n\n/**\n * Index every subagent descendant under each ancestor it reaches through an\n * uninterrupted subagent-origin chain (same semantics as the official\n * `indexSubagentDescendants`; cycles fail soft).\n */\nexport function countSubagentDescendants(\n  byId: SidebarSessionList['byId'],\n  sessionId: string,\n): SubagentDescendantTotals {\n  const totals: SubagentDescendantTotals = { count: 0, runningCount: 0 }\n  for (const descendant of Object.values(byId)) {\n    if (descendant.origin !== 'subagent' || isSideThreadSummary(descendant)) continue\n    for (const node of subagentOriginChain(byId, descendant)) {\n      if (node.parentId === sessionId) {\n        totals.count += 1\n        if (descendant.running === true) totals.runningCount += 1\n        break\n      }\n    }\n  }\n  return totals\n}\n\n/**\n * Every session id of the topology tree rooted at `rootId` (the root plus\n * each session whose uninterrupted subagent-origin chain reaches it — same\n * lineage semantics as {@link countSubagentDescendants}; cycles fail soft).\n * Sessions outside the tree (orphans, other trees) are excluded, so the\n * jobs section never shows foreign work.\n */\nexport function treeSessionIds(\n  byId: SidebarSessionList['byId'],\n  rootId: string | undefined,\n): Set<string> {\n  const ids = new Set<string>()\n  // A root with no row in the feed cannot be reached by walking: only real\n  // rows anchor tree membership (a parent pointer naming a hydrating root\n  // does not pull the orphaned branch into the tree).\n  if (rootId === undefined || byId[rootId] === undefined) return ids\n  for (const summary of Object.values(byId)) {\n    // The root row itself belongs to its own tree even though it is not a\n    // subagent (it is usually the main agent).\n    if (summary.id === rootId) {\n      ids.add(summary.id)\n      continue\n    }\n    for (const node of subagentOriginChain(byId, summary)) {\n      if (node.parentId === rootId) {\n        ids.add(summary.id)\n        break\n      }\n    }\n  }\n  return ids\n}\n","/**\n * Pure subagent-membership helpers over the sessions list feed (structural\n * mirror world — no runtime imports). Used by the sidebar's auto-activation\n * effect and the Subagent page:\n *\n * - {@link directSubagentCount}: direct durable children of one session,\n * - {@link detectNewDirectSubagent}: the 0 → N transition that means \"a new\n *   subagent just spawned under the current session\" (the auto-open trigger),\n * - {@link countSubagentDescendants}: uninterrupted subagent-origin lineage\n *   totals (mirror of the official `indexSubagentDescendants` over the\n *   plugin's own summary rows).\n *\n * The lineage walks themselves ({@link isSideThreadSummary}, {@link\n * rootAncestor}, {@link countSubagentDescendants}) live in\n * ./subagent-lineage.ts — the single shared walk implementation — and are\n * re-exported below for their established import sites.\n */\nimport type { SidebarSessionList } from '../context-types.ts'\nimport { countSubagentDescendants, isSideThreadSummary, rootAncestor } from './subagent-lineage.ts'\n\nexport { countSubagentDescendants, isSideThreadSummary, rootAncestor }\nexport type { SubagentDescendantTotals } from './subagent-lineage.ts'\n\n/** Count the direct subagent children of one session (durable `origin` rows). */\nexport function directSubagentCount(\n  byId: SidebarSessionList['byId'],\n  sessionId: string,\n): number {\n  let count = 0\n  for (const summary of Object.values(byId)) {\n    if (summary.origin === 'subagent' && summary.parentId === sessionId\n      && !isSideThreadSummary(summary)) count += 1\n  }\n  return count\n}\n\n/**\n * Whether a new direct subagent appeared under `sessionId` between two\n * consecutive list snapshots (the count crossed 0 → >0). Switching to a\n * session that already has subagents yields `false` (its baseline starts at\n * the current count), so the auto-open never fights an existing layout.\n */\nexport function detectNewDirectSubagent(\n  prev: SidebarSessionList,\n  next: SidebarSessionList,\n  sessionId: string,\n): boolean {\n  return directSubagentCount(prev.byId, sessionId) === 0\n    && directSubagentCount(next.byId, sessionId) > 0\n}\n","/**\n * The plugin's view of DSH 0.1.7's host-computed session projections — the\n * subagent catalog the Tasks page's topology renders, plus the two facts the\n * projection row does not carry.\n *\n * 0.1.6 published a per-parent lazy catalog through the sessions snapshot\n * (`subagentsByParent`, entries carrying `activity` / `hasChildren`) and the\n * page had to OBSERVE every parent it drew, releasing them when it hid. 0.1.7\n * replaced that whole handshake: the client loads every session's projections\n * once per connection, `SessionListState.projectionsBySession` publishes the\n * finished values, and a row is exactly `{ id, createdAt, mode, label? }`\n * (see the subagent catalog projection's `viewSchema`). So this module is a\n * pure adapter — no request, no subscription, no per-parent bookkeeping.\n *\n * The two dropped facts are derived, not invented:\n *\n * - a row HAS CHILDREN unless the child's own catalog is known-empty\n *   ({@link isKnownLeaf} — upstream's own disclosure rule, which keeps a\n *   branch open while its catalog is still loading instead of flapping it\n *   into a leaf);\n * - `activity` comes from the live channel (`subagents.live`, which folds the\n *   host's RUNNING children): a child the live map does not mention is not\n *   running ({@link childActivity}).\n *\n * What the projection genuinely does not carry any more is the 0.1.6\n * `diagnostic` row (a child whose descriptor was corrupt / unsupported /\n * unavailable): the host's fold publishes healthy identities only, so an\n * unreadable child is not a row at all and the page has nothing to show for\n * it. See the module report — no local equivalent exists.\n */\nimport type {\n  SidebarSessionList,\n  SidebarSubagentCatalogEntry,\n} from '../context-types.ts'\nimport type { SidebarChildLiveView } from '../context-types.ts'\n\n/** One parent's direct-child catalog, as the topology consumes it. */\nexport interface SubagentCatalogView {\n  entries: readonly SidebarSubagentCatalogEntry[]\n  state: 'loading' | 'ready' | 'error'\n  error: { code?: string; message?: string } | null\n}\n\n/**\n * Fold the snapshot's projection values into per-parent catalog views.\n *\n * An `idle` row has been published but not read yet (the manager seeds rows\n * from the persisted checkpoint before the connection's read lands): it is\n * `loading` when it carries no value at all and `ready` when a value is\n * already there — the same reading upstream's own catalog view uses.\n *\n * @param projections - `SessionListState.projectionsBySession` (optional: a\n *   host without the projection store leaves every catalog empty).\n * @returns one view per session the snapshot knows about.\n */\nexport function subagentCatalogs(\n  projections: SidebarSessionList['projectionsBySession'],\n): Readonly<Record<string, SubagentCatalogView>> {\n  const views: Record<string, SubagentCatalogView> = {}\n  for (const [sessionId, snapshot] of Object.entries(projections ?? {})) {\n    const entries = snapshot.values.subagentCatalog\n    views[sessionId] = {\n      entries: entries ?? [],\n      state: snapshot.state === 'idle'\n        ? entries === undefined ? 'loading' : 'ready'\n        : snapshot.state,\n      error: snapshot.error ?? null,\n    }\n  }\n  return views\n}\n\n/**\n * Whether a child is a KNOWN LEAF: its own catalog finished loading and holds\n * no children. Everything else (a catalog still loading, one that failed, or\n * one this snapshot does not carry yet) keeps its disclosure — the topology\n * then draws the child's own level, whose rows hydrate when the projection\n * lands.\n *\n * @param catalogs - the views of one snapshot ({@link subagentCatalogs}).\n * @param childSessionId - the child row whose own catalog decides.\n */\nexport function isKnownLeaf(\n  catalogs: Readonly<Record<string, SubagentCatalogView | undefined>>,\n  childSessionId: string,\n): boolean {\n  const catalog = catalogs[childSessionId]\n  return catalog?.state === 'ready' && catalog.entries.length === 0\n}\n\n/**\n * One child's live view, or undefined when the batch has not reported it yet\n * (the first poll of a freshly rooted tree).\n *\n * The `subagents.live` route reports EVERY tree child with an explicit\n * `running` flag — the previous \"absent means not running\" reading cannot\n * survive a route that also reports settled children's summaries.\n *\n * @param live - the batch live map (`session id → live view`).\n * @param childSessionId - the child row being drawn.\n */\nexport function childLive(\n  live: Readonly<Record<string, SidebarChildLiveView | undefined>>,\n  childSessionId: string,\n): SidebarChildLiveView | undefined {\n  return live[childSessionId]\n}\n","/**\n * The Tasks page's per-session METRICS: how much a node consumed (tokens) and\n * how long it actually worked (its own turn timing) — the two facts the node\n * detail popover adds beside the state.\n *\n * Both come from the host's session projections, which the client publishes in\n * `SessionListState.projectionsBySession` (see the mirror in\n * ../context-types.ts). This module is the pure adapter between that snapshot\n * and the shape the view model carries, plus the two display rules, so the\n * popover never re-derives them:\n *\n * - **Tokens** are a session TOTAL in four disjoint buckets. The reader wants\n *   one number plus a breakdown, so {@link totalTokens} sums them (input\n *   buckets + output) and {@link inputTokens} keeps the billed-input half.\n * - **Duration** is `settledMs` (closed turns) plus the live part of an open\n *   turn. `active.through` only advances when an event commits, so a running\n *   node's elapsed time is measured to `Date.now()` and refreshed by the page's\n *   own poll — never by a timer of this module's own.\n *\n * Everything degrades silently: a session with no events, a host without the\n * projection, or a key the fold omitted simply reports nothing, and the caller\n * hides the row rather than printing a zero it cannot justify.\n */\nimport type {\n  SidebarProjectionSnapshot,\n  SidebarSubagentTiming,\n  SidebarTokenUsage,\n} from '../context-types.ts'\n\n/** One session's metrics, as the view model carries them on its node. */\nexport interface SessionMetrics {\n  usage?: SidebarTokenUsage\n  timing?: SidebarSubagentTiming\n}\n\n/** The billed input tokens: every bucket that is not output. */\nexport function inputTokens(usage: SidebarTokenUsage): number {\n  return usage.uncachedInputTokens + usage.cacheReadTokens + usage.cacheWriteTokens\n}\n\n/** The session's total tokens (input buckets + output). */\nexport function totalTokens(usage: SidebarTokenUsage): number {\n  return inputTokens(usage) + usage.outputTokens\n}\n\n/**\n * The node's elapsed working time in ms, or undefined when the host published\n * no timing for it.\n *\n * @param timing - the session's `subagentTiming`.\n * @param now - the clock the caller's render is pinned to.\n */\nexport function elapsedMs(timing: SidebarSubagentTiming | undefined, now: number): number | undefined {\n  if (timing === undefined) return undefined\n  const active = timing.active === undefined ? 0 : Math.max(0, now - timing.active.since)\n  const total = timing.settledMs + active\n  // 0 means \"no closed turn and no open one\" — the projection's init state,\n  // which is indistinguishable from \"this session never worked\". Show nothing.\n  return total > 0 ? total : undefined\n}\n\n/**\n * Fold the projection snapshot into one metrics row per session.\n *\n * Sessions the snapshot does not carry are simply absent (the page's own poll\n * fills them in), and a session carrying neither key is omitted so the caller's\n * map stays small.\n *\n * @param projections - `SessionListState.projectionsBySession`.\n */\nexport function sessionMetrics(\n  projections: Readonly<Record<string, SidebarProjectionSnapshot>> | undefined,\n): Readonly<Record<string, SessionMetrics>> {\n  const out: Record<string, SessionMetrics> = {}\n  for (const [sessionId, snapshot] of Object.entries(projections ?? {})) {\n    const usage = snapshot.values.tokenUsage\n    const timing = snapshot.values.subagentTiming\n    if (usage === undefined && timing === undefined) continue\n    out[sessionId] = {\n      ...(usage === undefined ? {} : { usage }),\n      ...(timing === undefined ? {} : { timing }),\n    }\n  }\n  return out\n}\n","/**\n * The host's OWN \"subagent transcript in the right sidebar\" affordance.\n *\n * DSH ships a native right-sidebar tab type for child transcripts\n * (`@deepseek-ai/dsh-client-ui-subagent`, kind `subagentchat`, registered at the\n * `builtin` band) and its subagent list already uses it: clicking a row opens\n * the transcript in the MAIN view, and the small chevron beside it opens the\n * same transcript in the sidebar. The Tasks page therefore hands the child over\n * instead of re-implementing a transcript pane — one click opens the native tab,\n * and the main column keeps whatever the reader was looking at.\n *\n * The address is `dsh-resource://subagentchat/session/<childId>?parent=&mode=`.\n * The host exports neither its builder nor its parser to third parties, so the\n * two lines below are a deliberate copy of the host's own formula; the parser\n * (`parseSubagentChatAddress`) is the contract that keeps them honest.\n *\n * Every failure path answers `false` so the caller can fall back to the\n * main-view jump it used before: a deployment without `ui-subagent` has no such\n * tab type at all, and the public write face THROWS when no session seat is\n * mounted (a global panel, a column that was never mounted).\n */\nimport type { Context, SidebarSubagentAddress } from '../context-types.ts'\n\n/** The host's tab kind for an embedded child conversation. */\nexport const SUBAGENT_CHAT_KIND = 'subagentchat'\n\n/** The host's `dsh-resource://` prefix for that tab type. */\nexport const SUBAGENT_CHAT_ADDRESS = 'dsh-resource://subagentchat/session/'\n\n/**\n * The host's own subagent-chat resource address for one child session.\n * @param address - the child's lineage (parent, child, mode).\n */\nexport function subagentChatAddress(address: SidebarSubagentAddress): string {\n  const query = new URLSearchParams({ parent: address.parentSessionId, mode: address.mode })\n  return `${SUBAGENT_CHAT_ADDRESS}${encodeURIComponent(address.childSessionId)}?${query}`\n}\n\n/** Whether the host can host a child transcript in its right column. */\nexport function hasTranscriptAside(ctx: Context): boolean {\n  try {\n    const tabs = ctx.get('sidebarRightTabs')\n    if (tabs?.get(SUBAGENT_CHAT_KIND) === undefined) return false\n    return ctx.get('sidebarRight') !== undefined\n  } catch {\n    return false\n  }\n}\n\n/**\n * Open one child's transcript in the native right sidebar.\n *\n * @param ctx - the client context.\n * @param address - the child to open.\n * @returns whether the sidebar took it; `false` means the caller must fall back\n *   to the main-view jump (no such tab type, no right column, or the host threw\n *   because no session seat is mounted).\n */\nexport function openTranscriptAside(\n  ctx: Context,\n  address: SidebarSubagentAddress,\n  preferNewPane = false,\n): boolean {\n  if (!hasTranscriptAside(ctx)) return false\n  try {\n    const right = ctx.get('sidebarRight')\n    if (right === undefined) return false\n    // `preferNewPane` mirrors the host's own subagent list: the transcript sits\n    // beside whatever the reader already has open, and degrades to the target\n    // pane when splitting is not allowed.\n    right.openResource(subagentChatAddress(address), {\n      kind: SUBAGENT_CHAT_KIND,\n      // The default is the SAME right-sidebar pane: a transcript jump must not\n      // silently split the column. The explicit \"open to the side\" gesture\n      // passes true.\n      ...(preferNewPane ? { preferNewPane: true } : {}),\n    })\n    return true\n  } catch (error) {\n    console.error('[dsh-better-sidebar] open the child transcript in the sidebar failed:', error)\n    return false\n  }\n}\n","/**\n * The plugin's view of the host's `agentTeam` Session projection — the Lead\n * Session's shared task board — plus the roster the board draws beside it.\n *\n * DSH 0.2.2 reshaped that projection: the wire value is now\n * `{ enabled, tasks, failure? }` and no longer carries `members`\n * (upgrade-guide v0.2.1-rc.2 \"agentTeam.members is removed\"; the Team package\n * migration 122dc3af42 moved the roster out of the Team projection for good).\n * A team member IS a direct subagent of the Lead, so the roster this module\n * publishes is the Lead's `subagentCatalog` — the projection\n * ./subagent-catalog.ts already folds for the topology — with the Lead row\n * prepended.\n *\n * Two facts the projection used to carry are genuinely gone, and this module\n * does not fake them:\n *\n * - there is no durable `phase`: `provisioning` / `failed` were the old roster\n *   lifecycle, and a spawn that never produced a catalog entry has no row to\n *   draw at all;\n * - there is no per-member `error`: the only failure left is the board-wide\n *   `failure` string, which the board itself reports.\n *\n * Turn activity is derived, not invented: the session list's `running` bit is\n * authoritative, the live channel's flag is the catalog's RESIDENCY and only\n * stands in when the summaries do not carry the field (issue #800 — a retained\n * session reads `running` in the live map while no agent drives it).\n */\nimport type {\n  SidebarChildLiveView,\n  SidebarSessionList,\n  SidebarSessionSummary,\n  SidebarSubagentCatalogEntry,\n  SidebarTeamProjection,\n} from '../context-types.ts'\n\n/**\n * The root agent's fixed name (the host's `ROOT_AGENT_NAME`). Named here\n * rather than imported: a client bundle may not value-import the host's\n * subagent package, and the Lead is the only row whose name is not a catalog\n * entry.\n */\nconst ROOT_AGENT_NAME = 'lead'\n\n/** One roster row as this page consumes it: identity plus the derived runtime status. */\nexport interface TeamMemberRow {\n  /** The member's session id (the Lead itself, or a direct child under it). */\n  id: string\n  /** The member's agent name: `lead` at the root, the catalog name below it. */\n  name: string\n  role: 'lead' | 'teammate'\n  /** Derived display status: the session's own run bit, live flag as the fallback. */\n  status: 'running' | 'idle'\n}\n\n/**\n * The team board led by `rootId`, or undefined when that session leads none.\n *\n * ABSENT MEANS NO TEAM, and there are three ways to get there: the deployment\n * never mounted the Team layer (no projection key at all), the session leads no\n * team (`enabled: false` — the durable mode selection), or the root is a\n * teammate rather than the Lead. All three collapse into \"the page draws no\n * Teams block\", which is the same silent degradation the 0.1.6 route expressed\n * as `{available:false}` and `{team:null}`.\n *\n * A host that still publishes the pre-0.2.2 value carries no `enabled` flag;\n * that reads as enabled, which keeps the board visible exactly where it used\n * to be.\n *\n * @param projections - `SessionListState.projectionsBySession`.\n * @param rootId - the tree's root session (the only session that can be Lead).\n */\nexport function teamProjectionOf(\n  projections: SidebarSessionList['projectionsBySession'],\n  rootId: string | undefined,\n): SidebarTeamProjection | undefined {\n  if (rootId === undefined) return undefined\n  const team = projections?.[rootId]?.values.agentTeam\n  return team?.enabled === false ? undefined : team\n}\n\n/**\n * Build the roster: the Lead, then the Lead's direct children from its catalog.\n *\n * The catalog is the ONLY roster source now (see the module header), so a child\n * that the catalog does not list is not a member — there is no second list to\n * disagree with, which is what kept the old `members` drift invisible.\n *\n * @param team - the Lead's projection ({@link teamProjectionOf}).\n * @param rootId - the tree's root session id.\n * @param entries - the Lead's `subagentCatalog` rows, in catalog order.\n * @param live - the `subagents.live` map (`session id → live view`).\n * @param byId - the session list by id (the Lead's own running flag lives here).\n */\nexport function teamMembersOf(\n  team: SidebarTeamProjection | undefined,\n  rootId: string | undefined,\n  entries: readonly SidebarSubagentCatalogEntry[],\n  live: Readonly<Record<string, SidebarChildLiveView | undefined>>,\n  byId: Readonly<Record<string, SidebarSessionSummary | undefined>>,\n): TeamMemberRow[] {\n  if (team === undefined || rootId === undefined) return []\n  const statusOf = (id: string): TeamMemberRow['status'] =>\n    (byId[id]?.running ?? live[id]?.running) === true ? 'running' : 'idle'\n  return [\n    { id: rootId, name: ROOT_AGENT_NAME, role: 'lead', status: statusOf(rootId) },\n    ...entries.map(entry => ({\n      id: entry.id,\n      name: entry.name ?? entry.label ?? entry.id,\n      role: 'teammate' as const,\n      status: statusOf(entry.id),\n    })),\n  ]\n}\n","/**\n * Pure derivations for the Subagent page's background-job section. Kept\n * framework-free so the node test environment can unit-test them: the job\n * rows are collected from the per-session lists the client reads through the\n * plugin's `jobs.list` route (DSH 0.1.7 dropped the harness `session/jobs`\n * push mirror that used to feed `jobsBySession`, and the registry's access\n * fence admits a job only to its OWNER session — so the caller fans one read\n * out per tree session). Nothing here issues requests, and the row ordering /\n * status mapping mirror the official ui-jobs header list.\n */\nimport type {\n  SidebarJobStatus,\n  SidebarJobView,\n} from '../context-types.ts'\nimport type { CopyKey } from './locales.ts'\nimport { treeSessionIds } from './subagent-lineage.ts'\n\n/** One row of the jobs section: the job plus its owning session's title. */\nexport interface TreeJob {\n  ownerSessionId: string\n  ownerTitle: string\n  job: SidebarJobView\n}\n\n/** Whether the registry still holds the job open (its duration ticks). */\nexport function isJobLive(job: SidebarJobView): boolean {\n  return job.status === 'running' || job.status === 'stopping'\n}\n\n// The lineage walk itself lives in ./subagent-lineage.ts (the single shared\n// subagent-origin chain implementation); re-exported for the established\n// import sites of this module.\nexport { treeSessionIds }\n\n/**\n * Whether a NEW background job appeared for the current session between two\n * roster frames (a job id the previous frame lacked). Unlike the subagent\n * auto-open (0 → N only), ANY new job id triggers: the agent may start\n * several jobs over a session, and each new one should surface the Tasks page\n * that contains the background-jobs section.\n *\n * `since` (epoch ms) is the moment the caller STARTED watching the roster, and\n * it is what keeps a page load honest now that the roster arrives as a push\n * stream: the host's client jobs model drops a session's key when it sees no\n * jobs, so an empty first frame is indistinguishable from \"not delivered yet\".\n * A job that already existed when the watcher opened therefore looks brand new\n * to an id-set diff — comparing its start time against `since` filters it out,\n * while a job the agent starts afterwards still triggers.\n *\n * @param prev - the previous frame's rows.\n * @param next - the current frame's rows.\n * @param since - epoch ms the watch began; omitted skips the age test.\n * @returns whether genuinely new work appeared.\n */\nexport function detectNewJob(\n  prev: readonly SidebarJobView[],\n  next: readonly SidebarJobView[],\n  since?: number,\n): boolean {\n  const prevIds = new Set(prev.map(job => job.id))\n  return next.some(job => !prevIds.has(job.id) && (since === undefined || job.startedAt >= since))\n}\n\n/**\n * Live rows first in start order, then settled rows newest-first (mirror of\n * the official ui-jobs ordering); a tie falls back to start order so the\n * sort never depends on the host's map iteration.\n */\nexport function orderJobs(rows: readonly TreeJob[]): TreeJob[] {\n  return [...rows].sort((left, right) => {\n    const liveLeft = isJobLive(left.job)\n    if (liveLeft !== isJobLive(right.job)) return liveLeft ? -1 : 1\n    if (liveLeft) return left.job.startedAt - right.job.startedAt\n    const finished = (right.job.finishedAt ?? right.job.startedAt) - (left.job.finishedAt ?? left.job.startedAt)\n    return finished !== 0 ? finished : left.job.startedAt - right.job.startedAt\n  })\n}\n\n/** The sidebar's StateDot states for the five wire statuses. */\nexport type JobDotState = 'ongoing' | 'warning' | 'done' | 'error'\n\n/**\n * Status marker semantics. `stopping` and `killed` share the attention\n * color: both mean the work ended (or is ending) on request rather than on\n * its own.\n */\nexport function jobDotState(status: SidebarJobStatus): JobDotState {\n  switch (status) {\n    case 'running': return 'ongoing'\n    case 'stopping': return 'warning'\n    case 'completed': return 'done'\n    case 'killed': return 'warning'\n    case 'failed': return 'error'\n  }\n}\n\n/** Human status word of one wire status (localized through the passed translator). */\nexport function jobStatusLabel(\n  status: SidebarJobStatus,\n  t: (key: CopyKey, params?: Record<string, string | number>) => string,\n): string {\n  switch (status) {\n    case 'running': return t('jobStatusRunning')\n    case 'stopping': return t('jobStatusStopping')\n    case 'completed': return t('jobStatusCompleted')\n    case 'killed': return t('jobStatusKilled')\n    case 'failed': return t('jobStatusFailed')\n  }\n}\n\n/**\n * Elapsed time in at most two adjacent units (mirror of the official\n * ui-jobs duration wording). A background job that outlives an hour is\n * already exceptional, so hours is the widest unit.\n */\nexport function formatJobDuration(\n  elapsedMs: number,\n  t: (key: CopyKey, params?: Record<string, string | number>) => string,\n): string {\n  const total = Math.max(0, Math.floor(elapsedMs / 1_000))\n  const seconds = total % 60\n  const minutes = Math.floor(total / 60) % 60\n  const hours = Math.floor(total / 3_600)\n  if (hours > 0) return t('jobDurationHours', { hours, minutes })\n  if (minutes > 0) return t('jobDurationMinutes', { minutes, seconds })\n  return t('jobDurationSeconds', { seconds })\n}\n","/**\n * Narrow-viewport (\"mobile\") breakpoint for the sidebar. Width-based, shared\n * by the layout logic (JS) and the style gates (CSS). The CSS side pairs\n * with this file via `@media (max-width: 767px)` rules (sidebar.module.css)\n * — 767px ≡ widths below NARROW_MAX_WIDTH, documented at both ends.\n *\n * \"Real narrow\" on purpose: the mobile layout (one full-screen drawer, the\n * bottom panel's tabs merged into the right sidebar) is a phone / portrait\n * tablet experience. The value is deliberately NOT aligned to the DSH app\n * shell's own 1024px breakpoint — 1024px windows (small laptops, split\n * panes) keep the desktop two-panel layout.\n */\nimport { useEffect, useState } from 'react'\n\n/** Viewport widths strictly below this are \"mobile\" (paired CSS: max-width: 767px). */\nexport const NARROW_MAX_WIDTH = 768\n\n/** Whether a viewport width is narrow (mobile). */\nexport function isNarrowWidth(width: number): boolean {\n  return width < NARROW_MAX_WIDTH\n}\n\nexport interface ViewportSize {\n  width: number\n  height: number\n}\n\n/**\n * Live narrow-viewport flag for components. Reads `window.innerWidth` and\n * re-measures on resize (rAF-throttled, the repo's existing drag pattern).\n * Deliberately avoids `matchMedia` (jsdom does not implement it) — the\n * resize listener is equally exact for a breakpoint that never changes\n * while the page is open.\n */\nexport function useViewportSize(): ViewportSize {\n  const [size, setSize] = useState<ViewportSize>(() => ({\n    width: typeof window === 'undefined' ? 0 : window.innerWidth,\n    height: typeof window === 'undefined' ? 0 : window.innerHeight,\n  }))\n  useEffect(() => {\n    if (typeof window === 'undefined') return\n    let frame: number | null = null\n    const measure = (): void => {\n      frame = null\n      setSize({ width: window.innerWidth, height: window.innerHeight })\n    }\n    const onResize = (): void => {\n      if (frame === null) frame = requestAnimationFrame(measure)\n    }\n    window.addEventListener('resize', onResize)\n    return () => {\n      window.removeEventListener('resize', onResize)\n      if (frame !== null) cancelAnimationFrame(frame)\n    }\n  }, [])\n  return size\n}\n\nexport function useNarrowViewport(): boolean {\n  return isNarrowWidth(useViewportSize().width)\n}\n","/**\n * The Tasks page's read of the HOST's client jobs service (`ctx.jobs`).\n *\n * The plugin used to carry its own three-route jobs transport: a per-session\n * `jobs.list` fan-out every 3s, a `job_output` trace replayed from the owner\n * session's event log (the registry's only read is the model's CONSUMING\n * cursor, which a human pane must never move), and a kill passthrough. The\n * host service replaces all three — and this module is the whole data layer of\n * that swap, kept apart from the DRAWER so the auto-open trigger in\n * `sidebar/use-host-feeds.ts` reads the same feed the page renders.\n *\n * Structural detection only (the plugin never imports the host package): a\n * deployment without the service sees `undefined` and renders no jobs surface.\n */\nimport { useCallback, useEffect, useMemo, useSyncExternalStore } from 'react'\nimport type { SidebarSessionList } from '../context-types.ts'\nimport type {\n  Context,\n  SidebarClientJobsService,\n  SidebarJobsSnapshot,\n} from '../context-types.ts'\nimport { type TreeJob } from './subagent-jobs.ts'\n\n/** The empty snapshot a deployment without the jobs service reads. */\nconst EMPTY_JOBS: SidebarJobsSnapshot = { rows: {}, observed: {} }\n\n/**\n * The client jobs service, when this deployment mounts the host jobs UI.\n * @param ctx - the client context.\n */\nexport function clientJobs(ctx: Context): SidebarClientJobsService | undefined {\n  const service = ctx.get('jobs') as SidebarClientJobsService | undefined\n  if (service === undefined) return undefined\n  if (typeof service.watchRows !== 'function' || typeof service.observe !== 'function') return undefined\n  if (typeof service.kill !== 'function' || service.state === undefined) return undefined\n  return service\n}\n\n/**\n * Subscribe to the jobs snapshot (roster + observations).\n * @param jobs - the client jobs service (absent → an empty snapshot forever).\n */\nexport function useJobsSnapshot(jobs: SidebarClientJobsService | undefined): SidebarJobsSnapshot {\n  const subscribe = useMemo(\n    () => (callback: () => void) => (jobs === undefined ? () => {} : jobs.state.subscribe(callback)),\n    [jobs],\n  )\n  const read = useCallback(() => (jobs === undefined ? EMPTY_JOBS : jobs.state.getSnapshot()), [jobs])\n  return useSyncExternalStore(subscribe, read)\n}\n\n/**\n * Watch (and release) one roster per session, while the page is on screen. The\n * host shares a single stream between watchers of one session, so this is\n * cheap; the key is the joined id list so a re-render with the same tree does\n * not re-subscribe.\n * @param jobs - the client jobs service.\n * @param sessionIds - the tree's sessions (the root included).\n * @param active - whether the page is visible at all.\n */\nexport function useJobWatchers(\n  jobs: SidebarClientJobsService | undefined,\n  sessionIds: readonly string[],\n  active: boolean,\n): void {\n  const key = sessionIds.join(',')\n  useEffect(() => {\n    if (jobs === undefined || !active || key === '') return\n    const releases = key.split(',').map(sessionId => jobs.watchRows(sessionId))\n    return () => {\n      for (const release of releases) release()\n    }\n  }, [jobs, key, active])\n}\n\n/**\n * Observe ONE job's output while its panel is open; the release runs on close.\n * @param jobs - the client jobs service.\n * @param ownerSessionId - the session the roster carried the job under.\n * @param jobId - the observed job (undefined closes the observation).\n */\nexport function useJobObservation(\n  jobs: SidebarClientJobsService | undefined,\n  ownerSessionId: string | undefined,\n  jobId: string | undefined,\n): void {\n  useEffect(() => {\n    if (jobs === undefined || jobId === undefined) return\n    return jobs.observe(ownerSessionId, jobId)\n  }, [jobs, ownerSessionId, jobId])\n}\n\n/**\n * One job's rows as the drawer renders them, deduped across the tree.\n *\n * An UNOWNED job is visible to every watched session, so the union of rosters\n * repeats it: rows are keyed by job id and attributed to the watched session\n * whose roster carried them (which is also the session the observation and the\n * kill go through). Jobs owned by a session outside the tree are dropped.\n *\n * @param snapshot - the client service snapshot.\n * @param byId - the session mirror (owner labels).\n * @param treeIds - the tree's session ids (root included).\n */\nexport function collectRows(\n  snapshot: SidebarJobsSnapshot,\n  byId: SidebarSessionList['byId'],\n  treeIds: ReadonlySet<string>,\n): TreeJob[] {\n  const rows: TreeJob[] = []\n  const seen = new Set<string>()\n  for (const [watched, jobs] of Object.entries(snapshot.rows)) {\n    for (const job of jobs) {\n      if (seen.has(job.id)) continue\n      if (job.owner !== undefined && !treeIds.has(job.owner)) continue\n      seen.add(job.id)\n      rows.push({\n        ownerSessionId: watched,\n        ownerTitle: byId[job.owner ?? watched]?.displayTitle ?? job.owner ?? watched,\n        job,\n      })\n    }\n  }\n  return rows\n}\n","import type { Context as ClientContext } from '@deepseek-ai/cordis'\nimport type {} from '@deepseek-ai/dsh-client-ui-renderer/client'\nimport { nativeSessionTarget } from './session-target.ts'\n/** Optional dsh-context navigation, owned by one better-sidebar activation. */\nimport type { Context, SidebarSubagentAddress } from '../context-types.ts'\n\n// dsh-context 0.72.0 registers this type and keyed body; it exposes no service.\nconst CONTEXT_KIND = 'dsh-context'\nconst BODY_SLOT = 'sidebar.right.pane.tab'\nconst TIMEOUT_MS = 10_000\nconst RETRY_MS = 50\n\nexport interface ContextDiagnosticTarget {\n  sessionId: string\n  label?: string\n  address?: SidebarSubagentAddress\n}\n\nexport interface ContextDiagnosticError {\n  reason: 'unavailable' | 'navigation' | 'timeout' | 'open'\n  targetLabel: string\n}\n\nexport interface ContextDiagnosticsSnapshot {\n  available: boolean\n  busy: boolean\n  error?: ContextDiagnosticError\n}\n\nexport interface ContextDiagnostics {\n  getSnapshot(): ContextDiagnosticsSnapshot\n  subscribe(listener: () => void): () => void\n  open(target: ContextDiagnosticTarget): void\n  dismissError(): void\n  dispose(): void\n}\n\ninterface Faces {\n  right: Context['sidebarRight']\n  registry: Context['sidebarRightTabs']\n  slots: ClientContext['slots']\n  workspace: Context['uiWorkspace']\n  layout: Context['layout']\n}\n\ninterface Request {\n  target: ContextDiagnosticTarget\n  cleanups: Array<() => void>\n  ready: boolean\n  working: boolean\n  opened: boolean\n  signal?: AbortSignal\n  retry?: ReturnType<typeof setTimeout>\n}\n\n/** Read optional services from their registered public APIs. */\nfunction facesOf(ctx: Context): Faces | undefined {\n  const right = ctx.get('sidebarRight')\n  const registry = ctx.get('sidebarRightTabs')\n  const workspace = ctx.get('uiWorkspace')\n  const layout = ctx.get('layout')\n  const client: ClientContext = ctx\n  const slots = client.get('slots')\n  if (right === undefined || registry === undefined || workspace === undefined\n    || layout === undefined || slots === undefined) return undefined\n  return { right, registry, workspace, layout, slots }\n}\n\nfunction available(faces: Faces | undefined): boolean {\n  if (faces === undefined) return false\n  try {\n    const type = faces.registry.get(CONTEXT_KIND)\n    return type?.kind === CONTEXT_KIND && typeof type.id === 'string' && type.id !== ''\n      && faces.slots.entriesOfSlot(BODY_SLOT).some(entry => entry.options.key === type.id)\n  } catch {\n    return false\n  }\n}\n\n/** Create once in apply(), not once per keepMounted view. No idle timers or requests. */\nexport function createContextDiagnostics(ctx: Context): ContextDiagnostics {\n  let snapshot: ContextDiagnosticsSnapshot = { available: false, busy: false }\n  const listeners = new Set<() => void>()\n  let faces: Faces | undefined\n  let pending: Request | undefined\n  let disposed = false\n\n  const publish = (next: ContextDiagnosticsSnapshot): void => {\n    if (disposed || (snapshot.available === next.available && snapshot.busy === next.busy && snapshot.error === next.error)) return\n    snapshot = next\n    for (const listener of listeners) listener()\n  }\n\n  const finish = (request: Request, reason?: ContextDiagnosticError['reason']): void => {\n    if (pending !== request) return\n    pending = undefined\n    if (request.retry !== undefined) clearTimeout(request.retry)\n    for (const cleanup of request.cleanups.splice(0).reverse()) cleanup()\n    publish({\n      available: available(faces), busy: false,\n      ...(reason === undefined ? {} : { error: { reason, targetLabel: request.target.label ?? request.target.sessionId } }),\n    })\n  }\n\n  const own = (request: Request, cleanup: () => void): void => {\n    if (pending === request) request.cleanups.push(cleanup)\n    else cleanup()\n  }\n\n  const refresh = (): void => {\n    const ready = available(faces)\n    if (!ready && pending !== undefined) finish(pending, 'unavailable')\n    else publish({ ...snapshot, available: ready })\n  }\n\n  const retry = (request: Request): void => {\n    if (pending !== request || request.retry !== undefined) return\n    request.retry = setTimeout(() => {\n      request.retry = undefined\n      attempt(request)\n    }, RETRY_MS)\n  }\n\n  const attempt = (request: Request): void => {\n    if (pending !== request || !request.ready || request.working) return\n    if (request.signal?.aborted === true) { finish(request); return }\n    const current = faces\n    if (current === undefined || !available(current)) { finish(request, 'unavailable'); return }\n    request.working = true\n    try {\n      // mounted changes before React adopts the arriving session's sidebar store.\n      if (current.right.mounted.getSnapshot() !== request.target.sessionId) return\n      let tab = current.right.openTabs.getSnapshot().find(row => row.sessionId === request.target.sessionId && row.kind === CONTEXT_KIND)\n      if (tab === undefined && !request.opened) {\n        current.right.openTab(CONTEXT_KIND)\n        request.opened = true\n        tab = current.right.openTabs.getSnapshot().find(row => row.sessionId === request.target.sessionId && row.kind === CONTEXT_KIND)\n      }\n      if (pending !== request || request.signal?.aborted) return\n      if (tab !== undefined) {\n        // Native page deduplication is pane-local; focus the session's existing page.\n        current.right.focus(tab.tabId)\n        if (!current.right.isExpanded()) current.right.toggleExpanded()\n        if (current.right.mounted.getSnapshot() === request.target.sessionId\n          && current.right.active()?.id === tab.tabId && current.right.isExpanded()) {\n          finish(request)\n          return\n        }\n      }\n      retry(request)\n    } catch (error) {\n      if (error instanceof Error && error.message === 'sidebarRight: no session surface is mounted') retry(request)\n      else finish(request, 'open')\n    } finally {\n      request.working = false\n    }\n  }\n\n  // These dependencies suspend only this child fiber, never the main plugin.\n  const integration = ctx.inject(['sidebarRightTabs', 'sidebarRight', 'uiWorkspace', 'layout', 'slots'], (injected) => {\n    const connected = facesOf(injected as Context)\n    if (disposed || connected === undefined) return\n    faces = connected\n    const cleanups: Array<() => void> = []\n    try {\n      cleanups.push(connected.registry.subscribe(refresh))\n      cleanups.push(connected.slots.subscribe(BODY_SLOT, refresh))\n      refresh()\n    } catch {\n      faces = undefined\n      for (const cleanup of cleanups.reverse()) cleanup()\n      refresh()\n      return\n    }\n    return () => {\n      faces = undefined\n      for (const cleanup of cleanups.reverse()) cleanup()\n      refresh()\n    }\n  })\n\n  return {\n    getSnapshot: () => snapshot,\n    subscribe: (listener) => {\n      if (disposed) return () => {}\n      listeners.add(listener)\n      return () => { listeners.delete(listener) }\n    },\n    open: (target) => {\n      if (disposed || pending !== undefined) return\n      const current = faces\n      if (current === undefined || !available(current)) {\n        publish({ available: false, busy: false, error: { reason: 'unavailable', targetLabel: target.label ?? target.sessionId } })\n        return\n      }\n      if (target.sessionId === '' || (target.address !== undefined\n        && (target.address.childSessionId !== target.sessionId || target.address.parentSessionId === ''))) {\n        publish({ available: true, busy: false, error: { reason: 'navigation', targetLabel: target.label ?? target.sessionId } })\n        return\n      }\n      const request: Request = { target: { ...target }, ready: false, working: false, opened: false, cleanups: [] }\n      pending = request\n      publish({ available: true, busy: true })\n      if (pending !== request) return\n      const deadline = setTimeout(() => { finish(request, 'timeout') }, TIMEOUT_MS)\n      own(request, () => { clearTimeout(deadline) })\n      try {\n        own(request, current.right.mounted.subscribe(() => { attempt(request) }))\n        own(request, current.right.openTabs.subscribe(() => { attempt(request) }))\n        if (current.right.mounted.getSnapshot() !== target.sessionId) current.workspace.openSession(nativeSessionTarget(target.address ?? target.sessionId))\n        if (pending !== request) return\n        // openSession itself selects the conversation panel, aborting older signals.\n        const signal = current.layout.beginNavigation()\n        request.signal = signal\n        const cancel = (): void => { finish(request) }\n        signal.addEventListener('abort', cancel, { once: true })\n        own(request, () => { signal.removeEventListener('abort', cancel) })\n        request.ready = true\n        attempt(request)\n      } catch {\n        finish(request, 'navigation')\n      }\n    },\n    dismissError: () => { publish({ available: snapshot.available, busy: snapshot.busy }) },\n    dispose: () => {\n      if (disposed) return\n      disposed = true\n      if (pending !== undefined) finish(pending)\n      snapshot = { available: false, busy: false }\n      void integration?.dispose()\n      listeners.clear()\n    },\n  }\n}\n","/** Session-targeted writes and FIFO deferred opens for the native right Sidebar. */\nimport { brandString } from '@deepseek-ai/dsh-brand'\nimport { SessionId } from '@deepseek-ai/dsh-session/types'\nimport type { ISidebarRight, TabId } from '@deepseek-ai/dsh-client-ui-sidebar-right/client'\nimport type {} from '@deepseek-ai/dsh-client-ui-sidebar-documentpreview/client'\nimport type { Context } from '../../context-types.ts'\nimport { addressBaseOf } from '../address-base.ts'\nimport { fileAddressFor } from '../resource-address.ts'\nimport type { NativePathTab, NativeTabKind, NativeTabParams, SidebarSurface } from '../service.ts'\nimport type { NativeTabRecords } from './tab-adapter.tsx'\n\n/** One open retained until its target Session adopts a Sidebar store. */\ntype Pending =\n  | { kind: 'tab'; sessionId: string; tabKind: string; params: NativeTabParams; revealIfOpened: boolean; preferNewPane: boolean }\n  | { kind: 'resource'; sessionId: string; address: string; line: number | undefined; revealIfOpened: boolean; preferNewPane: boolean }\n\n/** The Session currently displayed by the native Sidebar controller. */\nexport interface MountedSessions {\n  getSnapshot(): string | undefined\n  subscribe(listener: () => void): () => void\n}\n\ndeclare module '@deepseek-ai/dsh-client-ui-sidebar-right/client' {\n  /** Page parameters owned by Better Sidebar's descriptor adapter. */\n  interface SidebarRightTabParamsMap extends Record<NativeTabKind, NativeTabParams> {}\n}\n\n/** Native operations and the observer cleanup owned by this adapter. */\nexport interface NativeSurface extends SidebarSurface {\n  /** Retry queued opens after a host store is adopted. */\n  flushPending(): void\n  /** Release observers and pending opens. */\n  dispose(): void\n  /** Every native tab associated with a path. */\n  pathTabs(): NativePathTab[]\n}\n\n/** Read the optional controller at the time of an operation. */\nfunction controllerOf(ctx: Context): ISidebarRight | undefined {\n  return ctx.get('sidebarRight')\n}\n\n/**\n * Observe the on-screen Session; the list also discovers a late controller.\n * @param ctx - client context.\n * @returns current Session observation.\n */\nexport function mountedSessions(ctx: Context): MountedSessions {\n  return {\n    getSnapshot: () => controllerOf(ctx)?.mounted.getSnapshot(),\n    subscribe: listener => {\n      let stopMounted = controllerOf(ctx)?.mounted.subscribe(listener)\n      const stopList = ctx.sessions.list.subscribe(() => {\n        stopMounted ??= controllerOf(ctx)?.mounted.subscribe(listener)\n        listener()\n      })\n      return () => { stopList(); stopMounted?.() }\n    },\n  }\n}\n\n/**\n * Read the Session whose native panel is on screen.\n * @param ctx - client context.\n * @returns on-screen Session, or undefined.\n */\nexport function mountedSessionId(ctx: Context): string | undefined {\n  return controllerOf(ctx)?.mounted.getSnapshot()\n}\n\n/**\n * Bind native records to Session-targeted controller operations.\n * @param ctx - client context.\n * @param records - per-Session tab records.\n * @returns surface with observer cleanup.\n */\nexport function createNativeSurface(ctx: Context, records: NativeTabRecords): NativeSurface {\n  const pending: Pending[] = []\n  const place = (entry: Pending): boolean => {\n    const api = controllerOf(ctx)\n    if (api === undefined) return false\n    const options = {\n      revealIfOpened: entry.revealIfOpened,\n      ...(entry.preferNewPane ? { preferNewPane: true } : {}),\n    }\n    const sessionId = SessionId(entry.sessionId)\n    return entry.kind === 'tab'\n      ? api.openTabIn(sessionId, brandString<NativeTabKind>(entry.tabKind), { ...options, params: entry.params })\n      : api.openResourceIn(sessionId, entry.address, {\n          ...options,\n          ...(entry.line === undefined ? {} : { params: { line: entry.line } }),\n        })\n  }\n  const flushPending = (): void => {\n    const retained = pending.filter(entry => !place(entry))\n    pending.splice(0, pending.length, ...retained)\n  }\n  const enqueue = (entry: Pending): void => {\n    flushPending()\n    if (!place(entry)) pending.push(entry)\n  }\n  const sessionOf = (tabId: string, sessionId?: string): string | undefined => {\n    if (sessionId !== undefined) return records.has(sessionId, tabId) ? sessionId : undefined\n    const mounted = mountedSessionId(ctx)\n    if (mounted !== undefined && records.has(mounted, tabId)) return mounted\n    let found: string | undefined\n    for (const candidate of Object.keys(ctx.sessions.list.getSnapshot().byId)) {\n      if (!records.has(candidate, tabId)) continue\n      if (found !== undefined) return undefined\n      found = candidate\n    }\n    return found\n  }\n  const evictGoneSessions = (): void => {\n    const live = new Set(Object.keys(ctx.sessions.list.getSnapshot().byId))\n    const mounted = mountedSessionId(ctx)\n    if (mounted !== undefined) live.add(mounted)\n    records.retain(live)\n  }\n  let stopAdoption = controllerOf(ctx)?.onSessionAdopted(flushPending)\n  const stopList = ctx.sessions.list.subscribe(() => {\n    stopAdoption ??= controllerOf(ctx)?.onSessionAdopted(flushPending)\n    flushPending()\n    evictGoneSessions()\n  })\n  const stopMounted = mountedSessions(ctx).subscribe(flushPending)\n  evictGoneSessions()\n  return {\n    openTab({ sessionId, kind, params, revealIfOpened, preferNewPane }) {\n      enqueue({ kind: 'tab', sessionId, tabKind: kind, params, revealIfOpened, preferNewPane: preferNewPane === true })\n    },\n    openResource({ sessionId, address, line, revealIfOpened, preferNewPane }) {\n      enqueue({ kind: 'resource', sessionId, address, line, revealIfOpened, preferNewPane: preferNewPane === true })\n    },\n    fileAddress: (sessionId, cwd, path) => fileAddressFor(sessionId, addressBaseOf(ctx, sessionId) ?? cwd, path),\n    tabTypeOf: (sessionId, tabId) => records.get(sessionId, tabId)?.tab.type,\n    close(sessionId, tabId) {\n      const record = records.get(sessionId, tabId)\n      if (record === undefined) return undefined\n      records.drop(sessionId, tabId)\n      controllerOf(ctx)?.closeIn(SessionId(sessionId), brandString<TabId>(tabId))\n      return {\n        type: record.tab.type,\n        title: record.tab.title,\n        ...(record.tab.meta === undefined ? {} : { meta: record.tab.meta }),\n      }\n    },\n    update(tabId, patch, sessionId) {\n      const owner = sessionOf(tabId, sessionId)\n      if (owner === undefined) return false\n      records.update(owner, tabId, patch)\n      return true\n    },\n    activate(tabId, sessionId) {\n      const owner = sessionOf(tabId, sessionId)\n      if (owner === undefined || owner !== mountedSessionId(ctx)) return false\n      controllerOf(ctx)?.focus(brandString<TabId>(tabId))\n      return true\n    },\n    has: (tabId, sessionId) => sessionOf(tabId, sessionId) !== undefined,\n    pathTabs: () => records.pathTabs(),\n    flushPending,\n    dispose: () => { stopList(); stopAdoption?.(); stopMounted(); pending.length = 0 },\n  }\n}\n","/**\n * The UI half of the optional dsh-context diagnostics: three entry points into\n * ONE conversation's \"Context\" view (an agent node's detail card, a background\n * job's output window, the session header's utilities row) and the frame-wide\n * error alert they share.\n *\n * Availability comes from the controller (./context-diagnostics.ts), never from\n * a guess here: it re-proves the optional runtime faces and answers `available`\n * (the tab type AND its keyed body), and its single `busy` flag disables all\n * three entry points for the duration of an open.\n *\n * The controller is threaded PER ACTIVATION — created in ./index.tsx, handed to\n * the host's two slots by closure, to the plugin's tree through the provider,\n * and to the native bodies through the native surface's deps bag. No\n * module-level store on purpose: two activations must never share one, and a\n * body unmounting must never clear another entry point's controller.\n */\nimport { createContext, useContext, useSyncExternalStore, type ReactNode } from 'react'\nimport {\n  Button, IconCloseOutlineRegular, IconContextInjectionOutlineRegular, IconWarningTriangleOutlineRegular,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { Context, SidebarSubagentAddress } from '../context-types.ts'\nimport {\n  createContextDiagnostics,\n  type ContextDiagnosticError,\n  type ContextDiagnosticTarget,\n  type ContextDiagnostics,\n  type ContextDiagnosticsSnapshot,\n} from './context-diagnostics.ts'\nimport { mountedSessionId } from './native/surface.ts'\nimport { t, type CopyKey } from './locales.ts'\nimport css from './context-diagnostics.module.css'\n\n/** The entry id both slot registrations use. */\nexport const HEADER_ENTRY_ID = 'dsh-better-sidebar:context-diagnostics'\n\n/** The three entry points, as the e2e lane tells them apart. */\nexport type DiagnosticsEntryKind = 'session' | 'agent' | 'job'\n\n/** Testid of an entry point's control; ABSENT while the control is not offered. */\nexport const DIAGNOSTICS_ENTRY_ATTR = 'data-dsh-ctx-entry'\n\n/** Testid of the frame-wide alert. */\nexport const DIAGNOSTICS_ALERT_ATTR = 'data-dsh-ctx-alert'\n\n/** The controller's carrier; `undefined` = this tree has no diagnostics. */\nconst DiagnosticsStoreContext = createContext<ContextDiagnostics | undefined>(undefined)\n\n/** Thread one activation's controller into a subtree (shell, native tab body). */\nexport function ContextDiagnosticsHost(props: {\n  controller?: ContextDiagnostics\n  children?: ReactNode\n}): ReactNode {\n  return (\n    <DiagnosticsStoreContext.Provider value={props.controller}>\n      {props.children}\n    </DiagnosticsStoreContext.Provider>\n  )\n}\n\n/** The controller in scope for this tree (undefined = no entry point renders). */\nfunction useDiagnosticsStore(): ContextDiagnostics | undefined {\n  return useContext(DiagnosticsStoreContext)\n}\n\nfunction useDiagnosticsSnapshot(store: ContextDiagnostics | undefined): ContextDiagnosticsSnapshot | undefined {\n  return useSyncExternalStore(store?.subscribe ?? NO_SUBSCRIBE, store?.getSnapshot ?? NO_SNAPSHOT)\n}\n\nconst NO_SUBSCRIBE = (): (() => void) => () => {}\nconst NO_SNAPSHOT = (): undefined => undefined\n\n/**\n * One entry point's control, shared so the three surfaces cannot drift apart:\n * the gate (capability available AND a resolved target), the single-open\n * disable, and the e2e handle.\n */\nexport function ContextDiagnosticsButton(props: {\n  kind: DiagnosticsEntryKind\n  /** `undefined` = this surface has nothing addressable to offer. */\n  target: ContextDiagnosticTarget | undefined\n  /** The host glyph's size (the header uses 14, the floating window 12). */\n  iconSize: number\n  /** The caller's box class, when the glyph must not take row width. */\n  className?: string\n  /** Dismiss source UI after dispatch; the controller owns the pending request. */\n  onNavigate?(): void\n}): ReactNode {\n  const { kind, target, iconSize, className } = props\n  const store = useDiagnosticsStore()\n  const snapshot = useDiagnosticsSnapshot(store)\n  if (store === undefined || target === undefined || snapshot?.available !== true) return null\n  const busy = snapshot.busy === true\n  return (\n    <Button\n      variant=\"ghost\"\n      size=\"sm\"\n      {...(className === undefined ? {} : { className })}\n      {...{ [DIAGNOSTICS_ENTRY_ATTR]: kind }}\n      // Busy is announced as well as enforced: one open at a time disables\n      // every entry point while it runs.\n      aria-busy={busy ? 'true' : undefined}\n      icon={<IconContextInjectionOutlineRegular size={iconSize} />}\n      aria-label={t('contextDiagnostics')}\n      title={t('contextDiagnostics')}\n      disabled={busy}\n      onClick={() => {\n        store.open(target)\n        props.onNavigate?.()\n      }}\n    />\n  )\n}\n\n/**\n * The header's control: an entry is drawn for the session the SLOT was mounted\n * with and can outlive it by a moment while the host rebuilds the row, so the\n * click re-checks `sidebarRight.mounted` and refuses to act once that session\n * left the screen — a stale header must never navigate into the previous\n * conversation.\n */\nfunction ContextDiagnosticsHeader(props: {\n  controller: ContextDiagnostics\n  sessionId: string\n  isCurrent(): boolean\n}): ReactNode {\n  const { controller, sessionId, isCurrent } = props\n  const snapshot = useDiagnosticsSnapshot(controller)\n  if (snapshot?.available !== true) return null\n  const busy = snapshot.busy === true\n  return (\n    <Button\n      variant=\"ghost\"\n      size=\"sm\"\n      className={css.headerButton}\n      {...{ [DIAGNOSTICS_ENTRY_ATTR]: 'session' satisfies DiagnosticsEntryKind }}\n      aria-busy={busy ? 'true' : undefined}\n      icon={<IconContextInjectionOutlineRegular size={14} />}\n      aria-label={t('contextDiagnostics')}\n      title={t('contextDiagnostics')}\n      disabled={busy}\n      onClick={() => {\n        if (!isCurrent()) return\n        controller.open({ sessionId, label: t('contextDiagnosticsTarget') })\n      }}\n    />\n  )\n}\n\n/** The copy key of one failure reason. */\nfunction reasonKey(reason: ContextDiagnosticError['reason']): CopyKey {\n  switch (reason) {\n    case 'navigation': return 'contextDiagnosticsNavigation'\n    case 'timeout': return 'contextDiagnosticsTimeout'\n    case 'open': return 'contextDiagnosticsOpenFailed'\n    case 'unavailable': return 'contextDiagnosticsUnavailable'\n  }\n}\n\n/**\n * The ONE error alert (`shell.overlay`), dismissed by the controller's own\n * `dismissError()` — never a timer. Gated on the ERROR only, not on\n * `available`: an open already in flight when the capability went away must\n * still report why it failed.\n */\nexport function ContextDiagnosticsAlert(props: { controller: ContextDiagnostics }): ReactNode {\n  const { controller } = props\n  const snapshot = useDiagnosticsSnapshot(controller)\n  const error = snapshot?.error\n  if (error === undefined) return null\n  return (\n    <div className={css.alertLayer} {...{ [DIAGNOSTICS_ALERT_ATTR]: '' }}>\n      <div className={css.alert} role=\"alert\">\n        <span className={css.alertIcon} aria-hidden=\"true\">\n          <IconWarningTriangleOutlineRegular size={14} />\n        </span>\n        <span className={css.alertText}>\n          <span className={css.alertTitle}>\n            {t('contextDiagnosticsFailed', { label: error.targetLabel })}\n          </span>\n          <span className={css.alertReason}>{t(reasonKey(error.reason))}</span>\n        </span>\n        <Button\n          variant=\"ghost\"\n          size=\"sm\"\n          className={css.alertClose}\n          icon={<IconCloseOutlineRegular size={12} />}\n          aria-label={t('contextDiagnosticsDismiss')}\n          title={t('contextDiagnosticsDismiss')}\n          onClick={() => { controller.dismissError() }}\n        />\n      </div>\n    </div>\n  )\n}\n\n/**\n * Contribute the header control and the frame-wide alert. Both ride\n * `slots.inject`: neither declaration is guaranteed to be on the ledger at\n * activation (the header and the frame come from other entries), and the\n * callback re-runs if one collapses and is re-declared.\n * @param ctx - the client context (slots + the native right column probe).\n * @param controller - the controller of this activation.\n * @returns a disposer unregistering both entries.\n */\nexport function registerContextDiagnosticsUI(ctx: Context, controller: ContextDiagnostics): () => void {\n  const disposers: Array<() => void> = []\n  try {\n    disposers.push(ctx.slots.inject('conversation.session.header.utilities', () => ctx.slots.register({\n      name: 'conversation.session.header.utilities',\n      id: HEADER_ENTRY_ID,\n      // After the host's own utilities and after the bottom-workbench toggle\n      // (order 10), so the two plugin controls sit together at the row's edge.\n      order: 20,\n      registrant: 'dsh-better-sidebar',\n      inject: (sessionId: string) => ({\n        controller,\n        sessionId,\n        isCurrent: () => mountedSessionId(ctx) === sessionId,\n      }),\n    }, ContextDiagnosticsHeader)))\n    disposers.push(ctx.slots.inject('shell.overlay', () => ctx.slots.register({\n      name: 'shell.overlay',\n      id: HEADER_ENTRY_ID,\n      order: 20,\n      registrant: 'dsh-better-sidebar',\n      inject: () => ({ controller }),\n    }, ContextDiagnosticsAlert)))\n  } catch (error) {\n    for (const dispose of disposers.reverse()) dispose()\n    throw error\n  }\n  return () => {\n    for (const dispose of disposers.reverse()) dispose()\n    disposers.length = 0\n  }\n}\n\n/** The activation's diagnostics controller (one per client activation). */\nexport function createContextDiagnosticsHost(ctx: Context): ContextDiagnostics {\n  return createContextDiagnostics(ctx)\n}\n\n/** A tree node's navigable address, when the tree really has one: the ROOT node\n *  carries none (it IS the main session) and is addressed by its own id, and an\n *  incomplete pair (a stale parent, a synthesized member) yields no control. */\nexport function diagnosticAddressOf(\n  nodeId: string,\n  address: SidebarSubagentAddress | undefined,\n): SidebarSubagentAddress | undefined {\n  return address !== undefined && address.parentSessionId !== '' && address.childSessionId === nodeId\n    ? address\n    : undefined\n}\n","/**\n * The unified view model of the Tasks page: one ordered node list the graph\n * canvas AND the tree mode both render (same data, same fold state). Pure\n * derivation over the sessions list feed (byId lineage + the host's\n * per-session `subagentCatalog` projection views), the live activity map, the\n * folded workflow runs, and the optional team view — kept framework-free for\n * node-environment unit tests.\n *\n * Shape rules:\n * - agent rows walk the per-parent catalog views in pre-order (the same\n *   recursion the classic tree used); Side Chat threads never become nodes;\n * - a workflow run hangs under its ORIGIN agent; member agents that already\n *   exist as the origin's catalog children are RE-PARENTED under the run\n *   node, members without a catalog row are synthesized from the run's own\n *   member data (so a finished run still shows its members);\n * - team members enrich matching agent nodes in place (role/phase/status);\n *   the lead's roster row lands on the root node;\n * - fold: per parent, settled agent leaves and fully settled known branches\n *   (never the current session or its ancestors) collapse into one\n *   trailing `fold` node per GROUP (finished work / waiting members) carrying\n *   the member ids and label previews; a group the reader opened\n *   ({@link TasksModelInput.expandedGroups}) keeps its members visible while\n *   its sibling group stays folded.\n */\nimport type {\n  SidebarSessionSummary,\n  SidebarSubagentAddress,\n  SidebarSubagentCatalogEntry,\n  SidebarTeamTaskView,\n} from '../context-types.ts'\nimport type { SidebarChildLiveView } from '../context-types.ts'\nimport type { WorkflowRunView } from '../workflow-runs.ts'\nimport { isSideThreadSummary } from './subagent-detect.ts'\nimport { childLive, isKnownLeaf, type SubagentCatalogView } from './subagent-catalog.ts'\nimport type { SessionMetrics } from './session-metrics.ts'\nimport type { TeamMemberRow } from './team-projection.ts'\n\n/** Display state of one agent node (drives the dot + fold candidacy). */\nexport type TasksNodeState = 'running' | 'idle' | 'done' | 'error'\n\n/** One shared task as a node shows it (the board owns the full editing). */\nexport interface TasksNodeTask {\n  id: string\n  subject: string\n  status: 'pending' | 'in_progress' | 'completed'\n  /** Not ready = blocked by another task. */\n  ready: boolean\n}\n\n/** One agent node (root, subagent, teammate, or synthesized workflow member). */\nexport interface TasksAgentNode {\n  kind: 'agent'\n  id: string\n  parentId?: string\n  /** Card line 1: durable label, else summary title, else the id. */\n  label: string\n  /** The summary's display title when it differs from the label. */\n  title?: string\n  /** The catalog row's mode; `unknown` claims neither and renders nothing. */\n  mode?: SidebarSubagentCatalogEntry['mode']\n  state: TasksNodeState\n  /** The catalog's raw activity word (the secondary line localizes it). */\n  activity: 'running' | 'inactive'\n  /** The on-screen session (the \"you are here\" marker). */\n  current: boolean\n  /** Live tail of a running child (the merged activity + newest text). */\n  live?: SidebarChildLiveView\n  /** Token usage + turn timing of the node's own session (see ./session-metrics.ts). */\n  metrics?: SessionMetrics\n  /** Team enrichment (roster row matched by session id). */\n  team?: {\n    role: 'lead' | 'teammate'\n    name: string\n    /** The member's derived display status (see ./team-projection.ts). */\n    status: TeamMemberRow['status']\n  }\n  /**\n   * Tree depth (the root is 0). Drives the card's GROUP COLOUR: every node of\n   * one level wears the same left edge, so a wide graph still reads as bands.\n   */\n  depth: number\n  /** Workflow phase this node is a member of (workflow runs only). */\n  phase?: { key: string; index: number; title?: string }\n  /** Unknown/nonempty catalog signal (known branches are checked as subtrees). */\n  hasChildren?: boolean\n  /** Shared tasks owned by this agent (team boards only; empty otherwise). */\n  tasks?: TasksNodeTask[]\n  /** Synthesized from a workflow run's member row (no catalog entry). */\n  synthesized?: boolean\n  /** Jump target of the row (absent on the root node). */\n  childAddress?: SidebarSubagentAddress\n}\n\n/** One workflow run node (its members hang below as agent children). */\nexport interface TasksWorkflowNode {\n  kind: 'workflow'\n  id: string\n  parentId: string\n  /** Tree depth (see {@link TasksAgentNode.depth}). */\n  depth: number\n  run: WorkflowRunView\n}\n\n/**\n * Which kind of state one fold aggregate holds. The two are SEPARATE rows:\n * mixing them meant the aggregate had to explain itself with a tally and its\n * badge had to hedge (\"✓ N 已完成 · N 待命\"), and a reader who wanted to sweep\n * the waiting teammates away had to take the finished work with them.\n */\nexport type TasksFoldKind = 'done' | 'idle'\n\n/** One fold aggregate node (the settled or the waiting children of one parent). */\nexport interface TasksFoldNode {\n  kind: 'fold'\n  /** Which group this row is: finished work, or members waiting for a turn. */\n  foldKind: TasksFoldKind\n  id: string\n  parentId: string\n  /** Tree depth (see {@link TasksAgentNode.depth}). */\n  depth: number\n  count: number\n  /** How many of {@link count} are done (the badge's own count). */\n  doneCount: number\n  /** How many are waiting for a turn (待命 idle members, never executing). */\n  idleCount: number\n  /** How many ended in a failure (出错); they belong to the `done` group. */\n  errorCount: number\n  /** All hidden agent ids, including descendants, in topology order. */\n  memberIds: string[]\n  /** Up to two label previews for the collapsed subtitle. */\n  previews: string[]\n}\n\nexport type TasksNode = TasksAgentNode | TasksWorkflowNode | TasksFoldNode\n\n/** Inputs of the model build (all already-resolved client mirrors). */\nexport interface TasksModelInput {\n  byId: Readonly<Record<string, SidebarSessionSummary>>\n  /** Per-parent catalog views (DSH 0.1.7 projectors, see {@link subagentCatalogs}). */\n  catalogs: Readonly<Record<string, SubagentCatalogView | undefined>>\n  rootId: string\n  currentSessionId: string\n  live: Readonly<Record<string, SidebarChildLiveView | undefined>>\n  /**\n   * Per-session token usage and turn timing, keyed by session id (the same\n   * shape as {@link TasksModelInput.live}). Both are host projections, so a\n   * session the snapshot does not carry simply has no metrics and the popover\n   * hides the row.\n   */\n  metrics?: Readonly<Record<string, SessionMetrics | undefined>>\n  runs: readonly WorkflowRunView[]\n  teamMembers: readonly TeamMemberRow[]\n  /** The team's shared tasks; each lands on its OWNER's node. */\n  teamTasks?: readonly SidebarTeamTaskView[]\n  /** Global gate for automatic folding; manual foldedIds remain independent. */\n  folded: boolean\n  /** Automatically aggregate settled leaves (default true). */\n  autoFoldSettled?: boolean\n  /** Automatically aggregate fully settled, known branches (default true). */\n  autoFoldBranches?: boolean\n  /** Automatically aggregate idle members at the existing threshold (default true). */\n  autoFoldIdle?: boolean\n  /**\n   * Nodes the READER folded by hand (a settled card's bar chevron). This is a\n   * PER-NODE trigger, not a second copy of the global rule, so it only has to\n   * satisfy the existing per-node guards: never a\n   * running node, never the current session. It is deliberately NOT subject to\n   * the automatic subtree rule — the chevron is drawn on every settled card, and a\n   * trigger that cannot fire is a dead control.\n   */\n  foldedIds?: ReadonlySet<string>\n  /**\n   * The fold GROUPS the reader expanded by clicking their aggregate card\n   * ({@link foldGroupId}). A group listed here shows its members while every\n   * other group stays folded — expanding one aggregate must never unfold the\n   * page. It is consulted only where a member would otherwise be folded, and it\n   * yields to {@link foldedIds}: folding one node back by hand is the reader's\n   * newest explicit intent, and a group that ignored it would leave that card's\n   * own chevron dead.\n   */\n  expandedGroups?: ReadonlySet<string>\n}\n\n/** Human label of one catalog child (the classic rule). */\nfunction childLabel(\n  entry: SidebarSubagentCatalogEntry,\n  summary: SidebarSessionSummary | undefined,\n): string {\n  return entry.label ?? summary?.displayTitle ?? entry.id\n}\n\n/** Manual folds preserve the existing per-node running/current guards. */\nfunction nodeFoldable(node: TasksAgentNode, currentSessionId: string): boolean {\n  return !node.current && node.id !== currentSessionId && node.state !== 'running'\n}\n\n/**\n * How many IDLE team members one parent needs before the page-level rule\n * sweeps them into the aggregate too.\n *\n * A teammate that has finished its turn is `idle`: it is not executing, has\n * nothing in flight, and can be resumed later — the same fact a plain\n * subagent reports as `done`. It used to stay out of the aggregate entirely,\n * so a wide team kept a card per member forever. The count is kept at three\n * on purpose: one or two idle members are the team's working set (and their\n * cards are where a task line shows up), while three or more is a roster the\n * reader is scanning rather than watching. Nothing is lost either way — the\n * aggregate row names the counts and expands on one click.\n */\nexport const FOLD_IDLE_MIN = 3\n\n/** The state tally of one fold group. */\ninterface FoldTally {\n  done: number\n  idle: number\n  error: number\n}\n\n/** Count one future fold group's members by display state. */\nfunction tally(folded: readonly TasksAgentNode[]): FoldTally {\n  const counts: FoldTally = { done: 0, idle: 0, error: 0 }\n  for (const node of folded) {\n    if (node.state === 'done') counts.done += 1\n    else if (node.state === 'idle') counts.idle += 1\n    else if (node.state === 'error') counts.error += 1\n  }\n  return counts\n}\n\n/**\n * The id of one fold GROUP (the aggregate card a set of folded members\n * collapses into). Derived from the parent and the group kind only, so the id\n * is stable while membership changes underneath it — the page keys the\n * reader's per-group expansions by exactly this string.\n *\n * @param foldKind - which group (`done` = finished/failed, `idle` = waiting).\n * @param parentId - the parent whose children were folded.\n */\nexport function foldGroupId(foldKind: TasksFoldKind, parentId: string): string {\n  return foldKind === 'idle' ? `fold:${parentId}:idle` : `fold:${parentId}`\n}\n\n/**\n * Build one aggregate row for the given group of children.\n *\n * `foldKind` decides which members the row owns: the `done` group takes the\n * finished and failed ones, the `idle` group the waiting members. The caller\n * passes only its own members, so the counts and previews come straight off\n * that list.\n *\n * @param foldKind - which group this row is.\n * @param parentId - the row's parent (its tree position).\n * @param depth - the row's tree depth.\n * @param members - the children this group swallowed, in page order.\n */\nfunction foldNode(\n  foldKind: TasksFoldKind,\n  parentId: string,\n  depth: number,\n  members: readonly TasksAgentNode[],\n): TasksFoldNode {\n  const counts = tally(members)\n  return {\n    kind: 'fold',\n    foldKind,\n    id: foldGroupId(foldKind, parentId),\n    parentId,\n    depth,\n    count: members.length,\n    doneCount: counts.done,\n    idleCount: counts.idle,\n    errorCount: counts.error,\n    memberIds: members.map(member => member.id),\n    previews: members.slice(0, 2).map(member => member.label),\n  }\n}\n\n/**\n * Map a team member's derived status onto the node display state. The status\n * already folds in the session's own run bit (./team-projection.ts), so this\n * is a vocabulary translation and nothing more.\n */\nfunction teamState(status: TeamMemberRow['status']): TasksNodeState {\n  return status === 'running' ? 'running' : 'idle'\n}\n\n/** The workflow member's display state from its outcome (undefined = live). */\nfunction memberOutcomeState(outcome: 'completed' | 'failed' | 'cancelled' | undefined): TasksNodeState {\n  switch (outcome) {\n    case undefined: return 'running'\n    case 'completed': return 'done'\n    case 'cancelled': return 'done'\n    case 'failed': return 'error'\n  }\n}\n\n/**\n * Build the ordered (pre-order) node list of the Tasks page. The result is\n * stable for a stable input set: catalog order is preserved, runs follow\n * their origin's agent children in startedSeq order, and each fold node\n * trails its parent's remaining children.\n */\nexport function buildTasksModel(input: TasksModelInput): TasksNode[] {\n  const {\n    byId, catalogs, rootId, currentSessionId, live, runs, teamMembers, folded, foldedIds,\n  } = input\n  const expandedGroups = input.expandedGroups\n  const metrics = input.metrics\n  const teamTasks = input.teamTasks ?? []\n  const teamById = new Map(teamMembers.map(member => [member.id, member]))\n  /** Owner display name → node id (the board assigns by member name). */\n  const nodeByOwner = new Map<string, string>()\n  for (const member of teamMembers) nodeByOwner.set(member.name, member.id)\n  // The Lead's own agent path is the EMPTY string, while its roster name is\n  // `lead`; the board spells the same owner both ways.\n  nodeByOwner.set('', rootId)\n  const tasksByNode = new Map<string, TasksNodeTask[]>()\n  for (const task of teamTasks) {\n    if (task.status === 'deleted' || task.ownerName === undefined) continue\n    const nodeId = nodeByOwner.get(task.ownerName)\n    if (nodeId === undefined) continue\n    const list = tasksByNode.get(nodeId)\n    const entry: TasksNodeTask = {\n      id: task.id, subject: task.subject, status: task.status, ready: task.ready,\n    }\n    if (list === undefined) tasksByNode.set(nodeId, [entry])\n    else list.push(entry)\n  }\n  const runsByOrigin = new Map<string, WorkflowRunView[]>()\n  for (const run of runs) {\n    const list = runsByOrigin.get(run.originSessionId)\n    if (list === undefined) runsByOrigin.set(run.originSessionId, [run])\n    else list.push(run)\n  }\n\n  const teamOf = (id: string): TasksAgentNode['team'] => {\n    const member = teamById.get(id)\n    return member === undefined\n      ? undefined\n      : { role: member.role, name: member.name, status: member.status }\n  }\n\n  const out: (TasksAgentNode | TasksWorkflowNode)[] = []\n  const seen = new Set<string>([rootId])\n\n  /**\n   * Every session id the catalogs know about, anywhere in the tree. A\n   * workflow member whose `childId` is listed under a DIFFERENT parent (or\n   * whose catalog row is missing from the run's origin) must NOT be\n   * synthesized into a second node with the same id: duplicate ids collide in\n   * React keys and in the edge map. Known ids keep their single real node;\n   * unknown ones are synthesized below.\n   */\n  const knownAgentIds = new Set<string>()\n  for (const catalog of Object.values(catalogs)) {\n    if (catalog?.state !== 'ready') continue\n    for (const entry of catalog.entries) knownAgentIds.add(entry.id)\n  }\n  // The local children lists of `buildChildren` are built lazily per parent,\n  // so this global set is what makes the guard below order-independent.\n\n  /** The agent children of one parent, in catalog order (side threads\n   *  excluded), with workflow runs appended in start order. */\n  const buildChildren = (parentId: string, depth: number): (TasksAgentNode | TasksWorkflowNode)[] => {\n    const catalog = catalogs[parentId]\n    const entries = catalog?.state === 'ready' ? catalog.entries : []\n    const agentChildren: TasksAgentNode[] = []\n    for (const entry of entries) {\n      if (seen.has(entry.id)) continue\n      const summary = byId[entry.id]\n      if (summary !== undefined && isSideThreadSummary(summary)) continue\n      if (entry.label?.startsWith('Side: ') ?? false) continue\n      seen.add(entry.id)\n      const team = teamOf(entry.id)\n      // DSH 0.1.7's catalog row carries the identity only: the live channel\n      // reports EVERY child with an explicit `running` flag, and a row keeps\n      // its disclosure unless its own catalog is known-empty.\n      const view = childLive(live, entry.id)\n      // …but that flag is SESSION RESIDENCY, not \"an agent is running\": the\n      // host's own field doc says it means \"recursive catalog listing observed\n      // a resident Session … does not encode a durable outcome or guarantee\n      // continuation delivery\". After a crash-restart, opening a child's\n      // history retains its session WITHOUT starting an agent, so residency\n      // reads `running` for a child nothing is driving (issue #800: the card\n      // showed 运行中 with a live preview line for an interrupted subagent).\n      // The session summary's `running` is the authoritative run bit — the root\n      // card below reads it, so does DSH's own subagent dropdown, and\n      // ./subagent-lineage.ts already counts descendants from it — so it wins\n      // whenever the host reports the field; the catalog flag stays the\n      // fallback for a deployment whose summaries do not carry it.\n      const running = summary?.running ?? (view?.running === true)\n      const activity: 'running' | 'inactive' = running ? 'running' : 'inactive'\n      const state: TasksNodeState = activity === 'running'\n        ? 'running'\n        : team !== undefined ? teamState(team.status) : 'done'\n      agentChildren.push({\n        kind: 'agent',\n        id: entry.id,\n        parentId,\n        depth: depth + 1,\n        label: childLabel(entry, summary),\n        ...(summary?.displayTitle !== undefined && summary.displayTitle !== entry.label\n          ? { title: summary.displayTitle } : {}),\n        mode: entry.mode,\n        state,\n        activity,\n        current: entry.id === currentSessionId,\n        ...(view !== undefined ? { live: view } : {}),\n        ...(metrics?.[entry.id] !== undefined ? { metrics: metrics[entry.id] } : {}),\n        ...(team !== undefined ? { team } : {}),\n        ...(tasksByNode.get(entry.id) !== undefined ? { tasks: tasksByNode.get(entry.id) } : {}),\n        hasChildren: !isKnownLeaf(catalogs, entry.id),\n        childAddress: { parentSessionId: parentId, childSessionId: entry.id, mode: entry.mode },\n      })\n    }\n\n    const agentChildrenById = new Map(agentChildren.map(node => [node.id, node]))\n    // Workflow runs of this agent: member agents with a catalog row are\n    // re-parented under the run; the rest are synthesized from run data.\n    const runNodes: TasksWorkflowNode[] = []\n    const memberNodes: TasksAgentNode[][] = []\n    for (const run of runsByOrigin.get(parentId) ?? []) {\n      const runNode: TasksWorkflowNode = {\n        kind: 'workflow', id: `run:${run.runId}`, parentId, depth: depth + 1, run,\n      }\n      if (seen.has(runNode.id)) continue\n      seen.add(runNode.id)\n      runNodes.push(runNode)\n      const members: TasksAgentNode[] = []\n      for (const [phaseIndex, phase] of run.phases.entries()) {\n        for (const member of phase.members) {\n          const existing = member.childId !== ''\n            ? agentChildrenById.get(member.childId)\n            : undefined\n          const phaseRef = {\n            key: `${run.runId}:${phaseIndex}`,\n            index: phaseIndex,\n            ...(phase.title === undefined ? {} : { title: phase.title }),\n          }\n          if (existing !== undefined && existing.phase === undefined) {\n            existing.parentId = runNode.id\n            existing.depth = runNode.depth + 1\n            existing.phase = phaseRef\n            if (tasksByNode.get(existing.id) !== undefined) existing.tasks = tasksByNode.get(existing.id)\n            members.push(existing)\n          } else if (member.childId !== '' && (knownAgentIds.has(member.childId) || seen.has(member.childId))) {\n            // Its real node exists elsewhere in the tree: the run's popover\n            // already lists the member, so no card is duplicated here.\n          } else {\n            const childKnown = member.childId !== ''\n            const id = childKnown ? member.childId : `wfmember:${run.runId}:${member.seq}`\n            if (seen.has(id)) continue\n            seen.add(id)\n            const team = teamOf(id)\n            const view = childLive(live, id)\n            const running = byId[id]?.running ?? (view?.running === true)\n            const state = running ? 'running' : team !== undefined ? teamState(team.status) : memberOutcomeState(member.outcome)\n            members.push({\n              kind: 'agent',\n              id,\n              parentId: runNode.id,\n              depth: runNode.depth + 1,\n              phase: phaseRef,\n              label: member.label,\n              state,\n              activity: state === 'running' ? 'running' : 'inactive',\n              ...(team !== undefined ? { team } : {}),\n              ...(view !== undefined ? { live: view } : {}),\n              ...(childKnown && catalogs[id] !== undefined ? { hasChildren: !isKnownLeaf(catalogs, id) } : {}),\n              current: member.childId !== '' && member.childId === currentSessionId,\n              synthesized: true,\n              ...(childKnown && metrics?.[member.childId] !== undefined\n                ? { metrics: metrics[member.childId] } : {}),\n              ...(childKnown && tasksByNode.get(member.childId) !== undefined\n                ? { tasks: tasksByNode.get(member.childId) } : {}),\n              ...(childKnown\n                ? { childAddress: { parentSessionId: parentId, childSessionId: member.childId, mode: 'one-shot' as const } }\n                : {}),\n            })\n          }\n        }\n      }\n      memberNodes.push(members)\n    }\n    const visibleAgentChildren = agentChildren.filter(child => child.parentId === parentId)\n\n    const children: (TasksAgentNode | TasksWorkflowNode)[] = [...visibleAgentChildren]\n    for (let index = 0; index < runNodes.length; index += 1) {\n      const runNode = runNodes[index]\n      if (runNode === undefined) continue\n      children.push(runNode, ...(memberNodes[index] ?? []))\n    }\n    return children\n  }\n\n  const rootSummary = byId[rootId]\n  const rootTeam = teamOf(rootId)\n  // The topology root carries its live view like every child: the live route\n  // folds the root's own range into the same map (the `subagents` service\n  // cannot classify an agent it did not spawn, so its `running` flag is absent\n  // there — the summary and text are not). Without it the main agent's card and\n  // tree row fell back to the hardcoded thinking wording no matter what the\n  // session was actually doing.\n  const rootLive = childLive(live, rootId)\n  out.push({\n    kind: 'agent',\n    id: rootId,\n    depth: 0,\n    label: rootSummary?.displayTitle !== undefined && rootSummary.displayTitle !== ''\n      ? rootSummary.displayTitle\n      : rootId,\n    state: rootSummary?.running === true ? 'running' : 'done',\n    activity: rootSummary?.running === true ? 'running' : 'inactive',\n    current: rootId === currentSessionId,\n    ...(rootLive !== undefined ? { live: rootLive } : {}),\n    ...(metrics?.[rootId] !== undefined ? { metrics: metrics[rootId] } : {}),\n    ...(rootTeam !== undefined ? { team: rootTeam } : {}),\n    ...(tasksByNode.get(rootId) !== undefined ? { tasks: tasksByNode.get(rootId) } : {}),\n  })\n  // Explicit stacks preserve pre-order without a call-stack limit on deep trees.\n  const pending = buildChildren(rootId, 0).reverse()\n  while (pending.length > 0) {\n    const node = pending.pop()!\n    out.push(node)\n    if (node.kind === 'workflow') continue\n    const children = buildChildren(node.id, node.depth)\n    for (let index = children.length - 1; index >= 0; index -= 1) pending.push(children[index]!)\n  }\n\n  const childrenById = new Map<string, (TasksAgentNode | TasksWorkflowNode)[]>()\n  for (const node of out) {\n    if (node.parentId === undefined) continue\n    const children = childrenById.get(node.parentId)\n    if (children === undefined) childrenById.set(node.parentId, [node])\n    else children.push(node)\n  }\n\n  // Reverse pre-order means every child's facts are ready before its parent.\n  // Subtree ranges also let aggregates collect hidden agents once, including\n  // descendants that would have formed their own groups when visible.\n  const settled = new Map<string, boolean>()\n  const subtreeEnd = new Map<string, number>()\n  const indexById = new Map(out.map((node, index) => [node.id, index]))\n  for (let index = out.length - 1; index >= 0; index -= 1) {\n    const node = out[index]!\n    const children = childrenById.get(node.id) ?? []\n    const known = node.kind === 'workflow' || catalogs[node.id]?.state === 'ready'\n      || (node.synthesized === true && node.childAddress === undefined && catalogs[node.id] === undefined)\n    const ownSettled = node.kind === 'workflow'\n      ? node.run.status !== 'running'\n      : nodeFoldable(node, currentSessionId) && node.state !== 'idle' && known\n    // An opened child group keeps this branch reachable under automatic rules;\n    // manual folds below still override it without consulting subtree facts.\n    settled.set(node.id, ownSettled\n      && expandedGroups?.has(foldGroupId('done', node.id)) !== true\n      && expandedGroups?.has(foldGroupId('idle', node.id)) !== true\n      && children.every(child => settled.get(child.id) === true))\n    const last = children.at(-1)\n    subtreeEnd.set(node.id, last === undefined ? index + 1 : subtreeEnd.get(last.id)!)\n  }\n\n  const projectChildren = (parent: TasksAgentNode | TasksWorkflowNode): TasksNode[] => {\n    const visible: TasksNode[] = []\n    const children = childrenById.get(parent.id) ?? []\n    const idleCount = children.filter(child => child.kind === 'agent' && child.state === 'idle' && child.team !== undefined).length\n    const foldIdle = parent.kind === 'workflow' || idleCount >= FOLD_IDLE_MIN\n    const groups: Record<TasksFoldKind, TasksAgentNode[]> = { done: [], idle: [] }\n    const workflows: TasksWorkflowNode[] = []\n    for (const child of children) {\n      if (child.kind === 'workflow') {\n        workflows.push(child)\n        continue\n      }\n      const group: TasksFoldKind = child.state === 'idle' ? 'idle' : 'done'\n      const descendants = childrenById.get(child.id) ?? []\n      const branch = descendants.length > 0 || child.hasChildren === true\n      const idleSafe = child.state === 'idle' && !branch && nodeFoldable(child, currentSessionId)\n        && (catalogs[child.id]?.state === 'ready'\n          || (child.synthesized === true && child.childAddress === undefined && catalogs[child.id] === undefined))\n      const auto = folded && (group === 'idle'\n        ? input.autoFoldIdle !== false && foldIdle && idleSafe\n        : settled.get(child.id) === true && (branch ? input.autoFoldBranches !== false : input.autoFoldSettled !== false)\n          // Keep the existing roster guard for failed members below threshold.\n          && (child.team === undefined || foldIdle))\n      const manual = foldedIds?.has(child.id) === true && nodeFoldable(child, currentSessionId)\n      const expanded = expandedGroups?.has(foldGroupId(group, parent.id)) === true\n      if (manual || (auto && !expanded)) {\n        const start = indexById.get(child.id)!\n        const end = subtreeEnd.get(child.id)!\n        for (let index = start; index < end; index += 1) {\n          const hidden = out[index]!\n          if (hidden.kind === 'agent') groups[group].push(hidden)\n        }\n      } else {\n        visible.push(child)\n      }\n    }\n    for (const group of ['done', 'idle'] as const) {\n      if (groups[group].length > 0) visible.push(foldNode(group, parent.id, parent.depth + 1, groups[group]))\n    }\n    visible.push(...workflows)\n    return visible\n  }\n  const projected: TasksNode[] = []\n  const pendingProjection: TasksNode[] = [out[0]!]\n  while (pendingProjection.length > 0) {\n    const node = pendingProjection.pop()!\n    projected.push(node)\n    if (node.kind === 'fold') continue\n    const children = projectChildren(node)\n    for (let index = children.length - 1; index >= 0; index -= 1) pendingProjection.push(children[index]!)\n  }\n  return projected\n}\n\n/** The parent→child edges of a model (derived, kept out of the build). */\nexport interface TasksEdge {\n  from: string\n  to: string\n  /** Visual class: teammate links and workflow relations get the accent. */\n  kind: 'agent' | 'team' | 'workflow'\n}\n\n/** Derive the edge list of a built model (pre-order preserved). */\nexport function tasksEdges(nodes: readonly TasksNode[]): TasksEdge[] {\n  const byNodeId = new Map(nodes.map(node => [node.id, node]))\n  const edges: TasksEdge[] = []\n  for (const node of nodes) {\n    if (node.parentId === undefined || !byNodeId.has(node.parentId)) continue\n    const parent = byNodeId.get(node.parentId)\n    const kind: TasksEdge['kind'] = node.kind === 'workflow' || parent?.kind === 'workflow'\n      ? 'workflow'\n      : node.kind === 'agent' && node.team?.role === 'teammate'\n        ? 'team'\n        : 'agent'\n    edges.push({ from: node.parentId, to: node.id, kind })\n  }\n  return edges\n}\n","/**\n * The layered top-down layout of the Tasks graph canvas: a tidy-tree pass\n * with a NARROW-PANEL rule — a parent's children wrap into bands of at most\n * {@link LayoutOptions.maxBandCols} columns, stacking extra rows below it.\n * Without wrapping a five-child level is ~770px wide and the whole graph\n * shrinks to ~40% inside the 360px native sidebar, which is unreadable; with\n * wrapping the canvas keeps a ~1:1 scale and the reader pans far less.\n *\n * Pure and dependency-free (the bundle-purity rule forbids a graph library in\n * the core bundle; <100-node trees need no virtualisation).\n */\nimport type { TasksNode } from './tasks-model.ts'\nimport { tasksEdges } from './tasks-model.ts'\n\n/** Geometry constants of the canvas (px, pre-scale). The design target is the\n *  NARROW native right sidebar (~360px): a 190px card fits two per row plus\n *  the gutter, and the card's own rows stay readable at the fit's floor. */\nexport const GRAPH_NODE_W = 190\n\n/**\n * The card's heights are the SUM OF THE ROWS THE CARD RENDERS, in the real\n * metrics of the page's type scale (the same numbers the rules in\n * tasks-graph.module.css are written with). They are derived rather than\n * hand-tuned because the card is a fixed-geometry box: its height is `auto`\n * with `min-height: box.h`, so an under-reserved card does not stay inside the\n * box the layout handed it — it RENDERS TALLER, and everything the layout\n * derives from `box.h` (the row pitch, the phase frames, the canvas extent)\n * then disagrees with the pixels on screen.\n *\n * The card is TWO SEGMENTS (tasks-card.tsx): a top segment carrying the kind\n * badge, the clamped name, the mono meta (and, for a team member, the shared\n * task line) and a bottom state bar carrying the state dot, the state word and\n * the merged process activity. Every node kind reserves the SAME base height —\n * a settled node shows its activity summary in that bar just like a running\n * one, so the two can never disagree with the layout.\n *\n * Measured on the rendered page before this structure existed: a running\n * teammate card carrying a two-line title, its meta, a live row and a task line\n * rendered 100px while the base reserve handed it 68 — `min-height` cannot hold\n * it down, so the card ate 32px of the 53px gutter to the next row and poked\n * out of its phase frame.\n */\nconst NODE_EDGE_H = 1\n/** The card's own border only: the two segments carry their own padding. */\nconst NODE_CHROME_H = 2 * NODE_EDGE_H\n/** `.cardTop`'s vertical padding (6px top / 5px bottom). */\nconst NODE_PAD_TOP = 6\nconst NODE_PAD_BOTTOM = 5\n/** One badge row — `--dsw-font-xxxs-11` (11px/14px) plus its 2px lead. */\nconst NODE_BADGE_H = 14 + 2\n/** One title line — `--dsw-font-xxs-strong-12` (12px/18px). */\nconst NODE_TITLE_LINE_H = 18\n/** Title lines the card reserves: the clamp in tasks-graph.module.css. */\nconst NODE_TITLE_LINES = 2\n/** The mono meta line — `--dsw-font-xxxs-11` (11px/14px) plus its 2px lead. */\nconst NODE_META_H = 14 + 2\n/** The state bar — `.cardBar`'s fixed height (its top border sits inside it). */\nconst NODE_BAR_H = 22\n/** One line of the card's text tail — `.cardText`'s 10px/1.3 box. */\nconst NODE_TEXT_LINE_H = 13\n/** The text tail's lead above the first line (`margin-top` in `.cardText`). */\nconst NODE_TEXT_LEAD_H = 2\n/** Lines the text tail may show at most. */\nexport const NODE_TEXT_MAX_LINES = 3\n/** The most a card's text tail can add to its height. */\nexport const GRAPH_TEXT_MAX_H = NODE_TEXT_MAX_LINES * NODE_TEXT_LINE_H + NODE_TEXT_LEAD_H\n/** The shared-task row: its 10px/1.3 line plus the 3px lead, sized for the\n *  `+N` chip's own 1px outline (the tallest shape the row can take). */\nconst NODE_TASK_H = 15 + 3\n\n/**\n * An AGENT card: badges + TWO title lines + the state bar. Long agent names are\n * clamped to two lines instead of ellipsizing to a couple of characters (see\n * `.cardName` in tasks-graph.module.css), so the reserve covers that second\n * line. The mode word moved into the badge row, so an agent card carries no\n * mono meta line — reserving one left a visible 16px hole above the bar.\n */\nexport const GRAPH_AGENT_NODE_H = NODE_CHROME_H + NODE_PAD_TOP + NODE_BADGE_H\n  + NODE_TITLE_LINES * NODE_TITLE_LINE_H + NODE_PAD_BOTTOM + NODE_BAR_H\n/**\n * The tallest card on the canvas: a workflow RUN keeps its mono meta line\n * (status · member tally), which no badge can express. {@link rowStrideFor}\n * narrows the row pitch back to {@link GRAPH_AGENT_NODE_H} for a model without\n * runs, so agent-only trees do not grow 16px of empty gutter per row.\n */\nexport const GRAPH_NODE_H = GRAPH_AGENT_NODE_H + NODE_META_H\n/** Extra height of an agent node carrying a shared-task line (team members). */\nexport const GRAPH_TASK_H = NODE_TASK_H\n\n/**\n * The readability floor the fit honours: the canvas may shrink to this scale\n * before the layout starts wrapping (TasksGraph's fit and {@link bandColsFor}'s\n * column budget must agree, so the constant lives here, next to the geometry).\n */\nexport const GRAPH_FIT_MIN_SCALE = 0.78\nexport const GRAPH_GAP_X = 28\nexport const GRAPH_GAP_Y = 53\nexport const GRAPH_PAD = 16\n/** The tallest row stride (the run card plus the vertical gutter). */\nexport const GRAPH_ROW_STRIDE = GRAPH_NODE_H + GRAPH_GAP_Y\n\n/**\n * The row pitch one model actually needs: the tallest card it draws plus the\n * gutter. Card heights differ by kind and by content (a run keeps its meta line;\n * an agent may add a task row and up to {@link NODE_TEXT_MAX_LINES} lines of text\n * tail), so the pitch is measured from the model instead of hard-picked — a card\n * taller than the pitch would overlap the row below it and its phase frame.\n *\n * @param nodes - the model's node list.\n */\nexport function rowStrideFor(nodes: readonly TasksNode[]): number {\n  let tallest = GRAPH_AGENT_NODE_H\n  for (const node of nodes) tallest = Math.max(tallest, nodeHeight(node))\n  return tallest + GRAPH_GAP_Y\n}\n\n/** One laid-out node. */\nexport interface GraphBox {\n  id: string\n  x: number\n  y: number\n  w: number\n  h: number\n}\n\n/** The layout result: one box per node plus the canvas extent. */\nexport interface GraphLayout {\n  boxes: ReadonlyMap<string, GraphBox>\n  width: number\n  height: number\n}\n\n/** Layout knobs. */\nexport interface LayoutOptions {\n  /** Columns per sibling band before it wraps to the next row (default 4). */\n  maxBandCols?: number\n}\n\n/**\n * The display height of one node: the base card, plus the text-tail lines a\n * running/settled child renders under its name, plus the shared-task row a team\n * member renders. The merged activity lives in the state bar every card draws,\n * so it costs no height.\n *\n * The tail's reservation is computed from the TEXT, not fixed at the maximum:\n * a card that reserved three lines to show one would wear a 26px hole above its\n * bar (the reader's own \"空荡荡\" report, in a different place), so the estimate\n * is deliberately conservative — it floors the wrapped line count, which means\n * a long tail is clamped one line short rather than overflowing the box.\n */\nfunction nodeHeight(node: TasksNode): number {\n  if (node.kind !== 'agent') return GRAPH_NODE_H\n  const base = GRAPH_AGENT_NODE_H\n  const lines = textTailLines(node.live?.text)\n  const text = lines * NODE_TEXT_LINE_H + (lines === 0 ? 0 : NODE_TEXT_LEAD_H)\n  return base + text + ((node.tasks?.length ?? 0) > 0 ? GRAPH_TASK_H : 0)\n}\n\n/**\n * How many lines a card's text tail takes, 0 when the node has none.\n *\n * An ESTIMATE by character width, because the layout runs before the browser\n * wraps anything: CJK reads at the font's full size and latin at a bit over\n * half of it, over the card's inner width. Floored on purpose (see\n * {@link nodeHeight}), and capped at {@link NODE_TEXT_MAX_LINES}.\n *\n * @param text - the child's newest assistant text (flattened by the caller).\n * @param cardWidth - the card's outer width (defaults to the graph's).\n */\nexport function textTailLines(text: string | undefined, cardWidth: number = GRAPH_NODE_W): number {\n  if (text === undefined || text === '') return 0\n  // `.cardTop`'s 8px left + 10px right padding, minus the tail's own lead.\n  const usable = Math.max(40, cardWidth - 18)\n  // 10px font: a CJK glyph is ~10px wide, latin ~5.5px (measured against the\n  // page's own stack; the ×0.9 keeps the estimate from cutting a line short).\n  let units = 0\n  for (const char of text) {\n    units += /[\\u3000-\\u9fff\\uff00-\\uffef]/.test(char) ? 10 : 5.5\n  }\n  const lines = Math.ceil((units * 0.9) / usable)\n  return Math.max(1, Math.min(NODE_TEXT_MAX_LINES, lines))\n}\n\n/**\n * Chunk one sibling band into rows of at most `cols` children. Counting (not\n * width-packing) keeps the graph SHAPE: a level stays a row of siblings, and\n * a nested subtree never forces its aunts into a ladder of one-child rows.\n * Wide subtrees are handled by the fit scale instead.\n */\nfunction bands(children: readonly TasksNode[], cols: number): TasksNode[][] {\n  if (children.length <= cols) return [children.slice()]\n  const out: TasksNode[][] = []\n  for (let index = 0; index < children.length; index += cols) {\n    out.push(children.slice(index, index + cols))\n  }\n  return out\n}\n\n/**\n * Lay out the model top-down, wrapping wide sibling bands.\n * @param nodes - the model's pre-order node list (roots = parentless rows).\n * @param options - see {@link LayoutOptions}.\n */\nexport function layoutTasksGraph(nodes: readonly TasksNode[], options: LayoutOptions = {}): GraphLayout {\n  const cols = Math.max(1, options.maxBandCols ?? 4)\n  const stride = rowStrideFor(nodes)\n  const nodeById = new Map(nodes.map(node => [node.id, node]))\n  const roots = nodes.filter(node => node.parentId === undefined || !nodeById.has(node.parentId))\n  const childrenOf = new Map<string, TasksNode[]>()\n  for (const edge of tasksEdges(nodes)) {\n    const child = nodeById.get(edge.to)\n    if (child === undefined) continue\n    const list = childrenOf.get(edge.from)\n    if (list === undefined) childrenOf.set(edge.from, [child])\n    else list.push(child)\n  }\n\n  // Collect an explicit traversal, then visit it backwards so every child's\n  // dimensions are available before its parent, even if input is not pre-order.\n  const order: TasksNode[] = []\n  const pending = roots.slice()\n  while (pending.length > 0) {\n    const node = pending.pop()!\n    order.push(node)\n    for (const child of childrenOf.get(node.id) ?? []) pending.push(child)\n  }\n  const subtrees = new Map<string, { width: number; rows: number }>()\n  for (let index = order.length - 1; index >= 0; index -= 1) {\n    const node = order[index]!\n    let width = GRAPH_NODE_W\n    let rows = 1\n    const children = childrenOf.get(node.id) ?? []\n    for (const band of bands(children, cols)) {\n      let bandWidth = GRAPH_GAP_X * (band.length - 1)\n      let bandRows = 0\n      for (const child of band) {\n        const subtree = subtrees.get(child.id)!\n        bandWidth += subtree.width\n        bandRows = Math.max(bandRows, subtree.rows)\n      }\n      width = Math.max(width, bandWidth)\n      rows += bandRows\n    }\n    subtrees.set(node.id, { width, rows })\n  }\n\n  const boxes = new Map<string, GraphBox>()\n  // Cached subtree row counts let each wrapped band start below the deepest\n  // previous band without waiting for recursive placement to return.\n  const placements: { node: TasksNode; centerX: number; row: number }[] = []\n  let offset = GRAPH_PAD\n  for (const root of roots) {\n    const width = subtrees.get(root.id)!.width\n    placements.push({ node: root, centerX: offset + width / 2, row: 0 })\n    offset += width + GRAPH_GAP_X\n  }\n  placements.reverse()\n  let width = GRAPH_PAD * 2 + GRAPH_NODE_W\n  let height = GRAPH_PAD * 2 + GRAPH_AGENT_NODE_H\n  while (placements.length > 0) {\n    const { node, centerX, row } = placements.pop()!\n    const box = {\n      id: node.id,\n      x: Math.round(centerX - GRAPH_NODE_W / 2),\n      y: GRAPH_PAD + row * stride,\n      w: GRAPH_NODE_W,\n      h: nodeHeight(node),\n    }\n    boxes.set(node.id, box)\n    width = Math.max(width, box.x + box.w + GRAPH_PAD)\n    height = Math.max(height, box.y + box.h + GRAPH_PAD)\n    const children = childrenOf.get(node.id) ?? []\n    const next: typeof placements = []\n    let bandRow = row + 1\n    for (const band of bands(children, cols)) {\n      let bandWidth = GRAPH_GAP_X * (band.length - 1)\n      let bandRows = 0\n      for (const child of band) {\n        const subtree = subtrees.get(child.id)!\n        bandWidth += subtree.width\n        bandRows = Math.max(bandRows, subtree.rows)\n      }\n      let cursor = centerX - bandWidth / 2\n      for (const child of band) {\n        const childWidth = subtrees.get(child.id)!.width\n        next.push({ node: child, centerX: cursor + childWidth / 2, row: bandRow })\n        cursor += childWidth + GRAPH_GAP_X\n      }\n      bandRow += bandRows\n    }\n    // Preserve the original depth-first box insertion order as well as pixels.\n    for (let index = next.length - 1; index >= 0; index -= 1) placements.push(next[index]!)\n  }\n  return { boxes, width, height }\n}\n\n/**\n * How many sibling columns fit the given container width at ~1:1 scale. The\n * canvas keeps its readability floor instead of shrinking: at 360px two cards\n * per row, at 720px four.\n */\nexport function bandColsFor(containerWidth: number, minScale = GRAPH_FIT_MIN_SCALE): number {\n  // Columns are budgeted at the readability floor, not at 1:1: the fit may\n  // scale the canvas DOWN to `minScale` and still be readable, so a narrow\n  // panel keeps two columns (scaled ~0.86 at 360px) instead of degenerating\n  // into a one-card-per-row ladder. `layoutTasksGraphForWidth` re-checks the\n  // real width against the same budget, so a too-wide pick is still narrowed.\n  const usable = (containerWidth <= 0 ? 360 : containerWidth) / minScale - GRAPH_PAD * 2\n  const cols = Math.floor((usable + GRAPH_GAP_X) / (GRAPH_NODE_W + GRAPH_GAP_X))\n  return Math.min(4, Math.max(1, cols))\n}\n\n/**\n * The layout for one container width: the WIDEST sibling arrangement whose\n * canvas still fits `containerWidth / minScale` — i.e. the least-tall layout\n * the reader can see without zooming below the readability floor. Wrapping\n * more than needed turns the graph into a ladder; wrapping too little forces\n * an unreadable scale, so the loop tries the widest first and narrows.\n *\n * @param nodes - the model's node list.\n * @param containerWidth - the canvas viewport width in px.\n * @param minScale - the readability floor the fit honours (default 0.78).\n */\nexport function layoutTasksGraphForWidth(\n  nodes: readonly TasksNode[],\n  containerWidth: number,\n  minScale = 0.78,\n): GraphLayout {\n  const budget = containerWidth <= 0 ? Number.POSITIVE_INFINITY : (containerWidth - 24) / minScale\n  const widest = bandColsFor(containerWidth <= 0 ? 360 : containerWidth)\n  const layouts = new Map<number, GraphLayout>()\n  const layoutFor = (cols: number): GraphLayout => {\n    let layout = layouts.get(cols)\n    if (layout === undefined) {\n      layout = layoutTasksGraph(nodes, { maxBandCols: cols })\n      layouts.set(cols, layout)\n    }\n    return layout\n  }\n  // Pass 1: the least-tall arrangement that FITS the readability budget at\n  // two or more columns (below two the graph degenerates into a ladder).\n  for (let cols = widest; cols >= 2; cols -= 1) {\n    const layout = layoutFor(cols)\n    if (layout.width <= budget) return layout\n  }\n  // Pass 2: nothing flat fits — accept a slight horizontal overflow (the\n  // reader pans a little) rather than stacking every child vertically.\n  const tolerant = budget * 1.2\n  for (let cols = widest; cols >= 2; cols -= 1) {\n    const layout = layoutFor(cols)\n    if (layout.width <= tolerant) return layout\n  }\n  return layoutFor(1)\n}\n","/**\n * The Tasks graph's layout TWEEN: the canvas animates in ITS OWN coordinate\n * space (each card's `x` / `y` / height), not with screen-space transforms.\n *\n * Why not a FLIP library: the card layer carries the fit's\n * `transform: scale(k)`, so a library that measures `getBoundingClientRect()`\n * and replays `translate()` in unscaled units is off by k on every move — and\n * `@formkit/auto-animate` additionally pins a leaving card with absolute\n * `left/top` derived from those rects, a box the scaled layer cannot express at\n * all (the card jumps). Measured live, both read as \"折叠展开的动效都特别怪\".\n *\n * Animating the layout coordinates has neither problem: `left`/`top` are the\n * canvas's own units, so the fit's scale applies to the tween exactly as it\n * applies to the final positions. And because every derived surface — the\n * connector paths, the phase frames — is a pure function of the boxes, they\n * follow the cards frame by frame instead of snapping to the new geometry while\n * the cards are still travelling.\n *\n * Scope: this animates POSITION only (x / y / height). A card that ENTERS gets\n * its CSS entrance (see tasks-graph.module.css) and a card that LEAVES is\n * removed at once — a ghost layer for exits is not worth its bookkeeping here,\n * and the aggregate that replaces the members is itself an entering card.\n */\nimport { useEffect, useMemo, useRef, useState } from 'react'\nimport type { GraphBox, GraphLayout } from './tasks-graph-layout.ts'\n\n/** How long one layout change takes to settle (ms). */\nexport const TWEEN_MS = 220\n\n/** The tween's easing: fast out of the gate, gently into place (ease-out cubic). */\nexport function easeOut(progress: number): number {\n  const t = Math.min(1, Math.max(0, progress))\n  return 1 - (1 - t) ** 3\n}\n\n/** One box's geometry, the part a tween interpolates. */\ninterface BoxGeometry {\n  x: number\n  y: number\n  w: number\n  h: number\n}\n\n/** Geometry of one box, or undefined when the tween has no previous slot for it. */\nfunction geometryOf(box: GraphBox | undefined): BoxGeometry | undefined {\n  return box === undefined ? undefined : { x: box.x, y: box.y, w: box.w, h: box.h }\n}\n\n/**\n * Interpolate one box between two geometries. A box with no `from` (it just\n * entered) stays at its target — the entrance animation owns that moment, and\n * sliding it in from a slot it never had would be a lie.\n *\n * @param from - the previously displayed geometry (undefined = just entered).\n * @param to - the target box.\n * @param progress - 0…1, already eased by the caller.\n */\nexport function tweenBox(from: BoxGeometry | undefined, to: GraphBox, progress: number): GraphBox {\n  if (from === undefined) return to\n  const mix = (a: number, b: number): number => a + (b - a) * progress\n  return {\n    id: to.id,\n    x: mix(from.x, to.x),\n    y: mix(from.y, to.y),\n    w: mix(from.w, to.w),\n    h: mix(from.h, to.h),\n  }\n}\n\n/**\n * The layout as it should be DRAWN right now: the target for a first render and\n * for a reader who asked for less motion, a tweened copy after that.\n *\n * @param layout - the freshly computed layout (the tween's target).\n * @returns boxes to render, plus the target canvas extent (the canvas never\n *   resizes mid-flight: the tween only moves the cards inside it).\n */\nexport function useTweenedLayout(layout: GraphLayout): GraphLayout {\n  /** The geometry the current animation starts from (the last drawn state). */\n  const fromRef = useRef<ReadonlyMap<string, GraphBox> | undefined>(undefined)\n  const [drawnBoxes, setDrawnBoxes] = useState<ReadonlyMap<string, GraphBox>>(layout.boxes)\n\n  useEffect(() => {\n    const from = fromRef.current\n    // First paint, or a reader who opted out of motion: snap to the target.\n    if (from === undefined || prefersReducedMotion()) {\n      fromRef.current = layout.boxes\n      setDrawnBoxes(layout.boxes)\n      return\n    }\n    // Nothing moved (a poll that changed only labels/state): keep the boxes we\n    // have, so React does not re-render every card for an identical Map.\n    if (sameGeometry(from, layout.boxes)) {\n      fromRef.current = layout.boxes\n      return\n    }\n    let frame = 0\n    const started = performance.now()\n    const step = (): void => {\n      const progress = easeOut((performance.now() - started) / TWEEN_MS)\n      const next = interpolate(from, layout.boxes, progress)\n      // The ref follows the DRAWN state, not the target: a layout change that\n      // interrupts a running tween then resumes from where the cards actually\n      // are instead of snapping them back to the previous target.\n      fromRef.current = progress < 1 ? next : layout.boxes\n      setDrawnBoxes(next)\n      if (progress < 1) frame = requestAnimationFrame(step)\n    }\n    frame = requestAnimationFrame(step)\n    return () => { cancelAnimationFrame(frame) }\n  }, [layout])\n\n  useEffect(() => () => { fromRef.current = undefined }, [])\n\n  /**\n   * What to draw. The tween's boxes are completed with the TARGET geometry for\n   * any node they do not carry yet: a node that just entered has no previous\n   * slot to travel from, and the render that introduces it must already have a\n   * box for it (its CSS entrance is that moment — leaving it out for the one\n   * render before the effect runs would blink the whole node away).\n   */\n  const boxes = useMemo(() => {\n    for (const id of layout.boxes.keys()) if (!drawnBoxes.has(id)) {\n      const merged = new Map(drawnBoxes)\n      for (const [targetId, box] of layout.boxes) if (!merged.has(targetId)) merged.set(targetId, box)\n      return merged\n    }\n    return drawnBoxes\n  }, [drawnBoxes, layout])\n\n  // The extent is always the target's: a canvas that resized while the cards\n  // were still travelling would move the reader's frame under them.\n  return useMemo(\n    () => ({ boxes, width: layout.width, height: layout.height }),\n    [boxes, layout.width, layout.height],\n  )\n}\n\n/** Whether the reader asked the platform for less motion. */\nfunction prefersReducedMotion(): boolean {\n  return typeof window !== 'undefined'\n    && typeof window.matchMedia === 'function'\n    && window.matchMedia('(prefers-reduced-motion: reduce)').matches\n}\n\n/** Whether two box maps already agree on every geometry. */\nfunction sameGeometry(\n  a: ReadonlyMap<string, GraphBox>,\n  b: ReadonlyMap<string, GraphBox>,\n): boolean {\n  if (a.size !== b.size) return false\n  for (const [id, box] of b) {\n    const previous = a.get(id)\n    if (previous === undefined) return false\n    if (previous.x !== box.x || previous.y !== box.y || previous.w !== box.w || previous.h !== box.h) {\n      return false\n    }\n  }\n  return true\n}\n\n/** One tweened copy of `to`, using `from` for the boxes that were on screen. */\nfunction interpolate(\n  from: ReadonlyMap<string, GraphBox>,\n  to: ReadonlyMap<string, GraphBox>,\n  progress: number,\n): ReadonlyMap<string, GraphBox> {\n  const out = new Map<string, GraphBox>()\n  for (const [id, box] of to) {\n    out.set(id, tweenBox(geometryOf(from.get(id)), box, progress))\n  }\n  return out\n}\n","/**\n * The Tasks canvas's VIEW transforms: where the auto-fit puts the frame, and\n * how the frame travels when that answer changes.\n *\n * Kept pure and separate because the graph itself cannot be measured in a test\n * (jsdom reports every container as 0×0): the centring rule and the glide's\n * interpolation are the two things worth pinning, and both are just arithmetic\n * over numbers the caller already has.\n *\n * The rule the fit follows: scale so the CONTENT box (never the padded canvas)\n * fills the container, never below the readability floor and never above the\n * cap, then centre it on both axes. Centring the padded box is what makes a\n * narrow panel look off-centre, so the padding is subtracted before the scale\n * is chosen and folded back into the offset.\n */\n/** One canvas transform: translation in px plus the scale. */\nexport interface ViewTransform {\n  x: number\n  y: number\n  k: number\n}\n\n/** How long the frame takes to glide to a new auto-fit (ms). */\nexport const GLIDE_MS = 220\n\n/** The inputs of the auto-fit (all px, pre-scale). */\nexport interface FitInput {\n  /** The canvas viewport. */\n  containerW: number\n  containerH: number\n  /** The layout's extent, padding included. */\n  layoutW: number\n  layoutH: number\n  /** The layout's own padding (breathing room, not content). */\n  pad: number\n  /** The smallest content box the fit will measure (one card). */\n  minContentW: number\n  minContentH: number\n  /** Breathing room the fit leaves around the content, per axis. */\n  margin: number\n  /** The readability floor and the ballooning cap. */\n  minScale: number\n  maxScale: number\n}\n\n/**\n * The transform that fits and centres the content, or undefined when the\n * container has no size yet (the sidebar mounts hidden at zero size, so a fit\n * before its first measure must do nothing rather than divide by zero).\n */\nexport function fitTransform(input: FitInput): ViewTransform | undefined {\n  const { containerW, containerH } = input\n  if (containerW === 0 || containerH === 0) return undefined\n  const contentW = Math.max(input.minContentW, input.layoutW - input.pad * 2)\n  const contentH = Math.max(input.minContentH, input.layoutH - input.pad * 2)\n  const k = Math.max(\n    input.minScale,\n    Math.min(\n      (containerW - input.margin * 2) / contentW,\n      (containerH - input.margin * 2) / contentH,\n      input.maxScale,\n    ),\n  )\n  return {\n    x: (containerW - contentW * k) / 2 - input.pad * k,\n    y: Math.max(input.margin / 2, (containerH - contentH * k) / 2) - input.pad * k,\n    k,\n  }\n}\n\n/**\n * One frame of a glide between two transforms.\n *\n * @param from - where the frame is.\n * @param to - where it is going.\n * @param progress - 0…1, already eased by the caller.\n */\nexport function lerpTransform(from: ViewTransform, to: ViewTransform, progress: number): ViewTransform {\n  const mix = (a: number, b: number): number => a + (b - a) * progress\n  return { x: mix(from.x, to.x), y: mix(from.y, to.y), k: mix(from.k, to.k) }\n}\n","/**\n * The two labels the Tasks page borrows from the main conversation's merged\n * activity display: the LIVE line (\"正在运行命令 · npm run build\") and the\n * DONE title for a settled range (\"已读取文件、执行了命令\").\n *\n * Both are ports of the host's own composition\n * (`dsh-client-ui-chat`'s `ProcessGroupHeader` + `step-process.js`\n * `processTitle`), reading the host's `chat` dictionary through\n * {@link chatT} so the wording — and every language the host ships — matches\n * what the main chat shows for the same work.\n *\n * The translator is injectable for tests; the default is the host bridge. When\n * a key does not resolve (a host that renamed it, or a deployment where the\n * chat target never mounted) the call answers undefined and the card falls\n * back to the tool detail it already has, never to a raw `message.…` key.\n */\nimport type { ProcessActivitySummary } from '../process-activity.ts'\nimport { chatT } from './locales.ts'\n\n/** A host-namespace translator; undefined means \"this key is not available\". */\nexport type ChatTranslate = (key: string, params?: Record<string, string | number>) => string | undefined\n\n/** The host's `' · '` line separator (`message.turnProcess.separator`). */\nfunction separator(t: ChatTranslate): string {\n  return t('message.turnProcess.separator') ?? ' · '\n}\n\n/**\n * The live line of one stage: the running category's `…ing` wording plus the\n * running call's detail, or the \"thinking\" default while nothing is dispatched\n * (exactly the host's `ProcessGroupHeader` label rule).\n *\n * @param summary - the newest stage's summary (absent while the child has none).\n * @param t - host translator (defaults to the `chat` namespace bridge).\n * @returns the line, or undefined when there is nothing to say.\n */\nexport function liveActivityLabel(\n  summary: ProcessActivitySummary | undefined,\n  t: ChatTranslate = chatT,\n): string | undefined {\n  const activity = summary?.running ?? 'thinking'\n  const preparing = summary?.preparing === true\n  // The host maps its `thinking` fallback onto `prepare.tools` (there is no\n  // `prepare.thinking` key).\n  const label = preparing\n    ? t(`message.stepProcess.prepare.${activity === 'thinking' ? 'tools' : activity}`)\n    : t(`message.stepProcess.${activity}`)\n  if (label === undefined) {\n    // No host wording for this category: the detail is the honest fallback.\n    return summary?.runningDetail === undefined || summary.runningDetail === ''\n      ? undefined\n      : summary.runningDetail\n  }\n  const detail = preparing ? '' : summary?.runningDetail ?? ''\n  return detail === '' ? label : `${label}${separator(t)}${detail}`\n}\n\n/**\n * The last-resort activity text: the ranked categories spelled out as\n * `kind ×count`. It keeps a card informative when the host's `chat` wording is\n * unavailable (renamed keys, or a deployment where the chat target never\n * mounted) without inventing a second vocabulary for the normal case — the\n * category names are the host's own, and they are language-neutral.\n *\n * @param summary - a stage's summary.\n * @returns the counts text, or undefined when the stage called nothing.\n */\nexport function activityCountsText(\n  summary: ProcessActivitySummary | undefined,\n): string | undefined {\n  const counts = summary?.counts ?? []\n  if (counts.length === 0) return undefined\n  return counts.map(entry => `${entry.kind} ×${entry.count}`).join(' · ')\n}\n\n/**\n * The settled range's title: the top three categories' `done.*` wording joined\n * the way the host joins it (two labels share the \"已\" prefix; more than three\n * append the \"等\" suffix). Counts are never printed.\n *\n * @param summary - a stage's summary.\n * @param t - host translator (defaults to the `chat` namespace bridge).\n * @returns the title, or undefined when the host wording is unavailable.\n */\nexport function doneActivityTitle(\n  summary: ProcessActivitySummary | undefined,\n  t: ChatTranslate = chatT,\n): string | undefined {\n  const counts = summary?.counts ?? []\n  if (counts.length === 0) return t('message.stepProcess.done.thinking')\n  const labels: string[] = []\n  for (const { kind } of counts.slice(0, 3)) {\n    const label = t(`message.stepProcess.done.${kind}`)\n    if (label === undefined) return undefined\n    labels.push(label)\n  }\n  const first = labels[0]\n  if (first === undefined) return undefined\n  const second = labels[1]\n  if (second === undefined) return first\n  // The host lowercases every label after the first for latin languages; a\n  // Chinese label is unaffected by that.\n  const continuation = (label: string): string => label.charAt(0).toLowerCase() + label.slice(1)\n  if (labels.length === 2) {\n    const prefix = t('message.stepProcess.sharedPrefix') ?? ''\n    const stripped = prefix !== '' && first.startsWith(prefix) && second.startsWith(prefix)\n      ? second.slice(prefix.length)\n      : second\n    return t('message.stepProcess.joinTwo', { first, second: continuation(stripped) })\n      ?? `${first}${separator(t)}${continuation(stripped)}`\n  }\n  const joined = [first, ...labels.slice(1).map(continuation)].join(t('message.stepProcess.comma') ?? ', ')\n  if (counts.length > 3) return t('message.stepProcess.more', { title: joined }) ?? joined\n  return joined\n}\n","/**\n * The glyph of one MERGED ACTIVITY line on the Tasks page — the icon the tree\n * mode's live row draws beside the host's own wording (\"正在读取文件\",\n * \"正在运行命令 · npm run build\", …).\n *\n * The key is the host's `ProcessActivity` category (the same union\n * `process-activity.ts` reproduces from the chat bundle), not a tool name: the\n * row shows a MERGED summary of the newest range, which is a category, and the\n * previous fixed terminal glyph made every row claim to be running a shell\n * command. The `Record` type keeps the map TOTAL — a category added upstream\n * fails the build here instead of silently falling back.\n *\n * All icons are the host's own components (currentColor — zero color literals,\n * the theme contract stays intact).\n */\nimport type { ReactNode } from 'react'\nimport {\n  IconCodeOutlineRegular,\n  IconEditOutlineRegular,\n  IconEllipsisOutlineRegular,\n  IconGlobeOutlineRegular,\n  IconPlanOutlineRegular,\n  IconPlayOutlineRegular,\n  IconQuestionOutlineRegular,\n  IconSearchOutlineRegular,\n  IconThinkOutlineRegular,\n  IconUsersOutlineRegular,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { ProcessActivity } from '../process-activity.ts'\n\n/** One glyph renderer (host icon components accept a pixel size). */\ntype Glyph = (size: number) => ReactNode\n\n/** The explicit category map, one family per kind of work. */\nconst ACTIVITY_GLYPHS: Record<ProcessActivity, Glyph> = {\n  read: size => <IconCodeOutlineRegular size={size} />,\n  readImage: size => <IconCodeOutlineRegular size={size} />,\n  search: size => <IconSearchOutlineRegular size={size} />,\n  write: size => <IconEditOutlineRegular size={size} />,\n  edit: size => <IconEditOutlineRegular size={size} />,\n  commands: size => <IconPlayOutlineRegular size={size} />,\n  code: size => <IconPlayOutlineRegular size={size} />,\n  webSearch: size => <IconGlobeOutlineRegular size={size} />,\n  webFetch: size => <IconGlobeOutlineRegular size={size} />,\n  subagents: size => <IconUsersOutlineRegular size={size} />,\n  plan: size => <IconPlanOutlineRegular size={size} />,\n  questions: size => <IconQuestionOutlineRegular size={size} />,\n  tools: size => <IconEllipsisOutlineRegular size={size} />,\n}\n\n/**\n * The glyph of one activity line.\n *\n * @param kind - the newest range's running category, or undefined while\n *   nothing is dispatched (the host's \"thinking\" wording, which is what the\n *   live line prints in that case).\n */\nexport function activityGlyph(kind: ProcessActivity | undefined): Glyph {\n  if (kind === undefined) return size => <IconThinkOutlineRegular size={size} />\n  return ACTIVITY_GLYPHS[kind]\n}\n","/**\n * Shared presentation bits of the Tasks page's two modes (graph + tree):\n * the state dot, the agent/workflow/task GLYPHS (host primitive icons — the\n * page draws no glyphs of its own), the short mono meta line, the node task\n * line, and the iconified live activity row (\"activity glyph + wording\").\n *\n * Card content contract (the page's answer to \"everything is ellipsized\"):\n *   line 1  state dot + agent icon + name   (11px semibold, one line)\n *   line 2  mode/model · activity           (9px mono, one line)\n *   line 3  live activity line              (running nodes only)\n *   line 4  owned shared task               (team members only)\n * Everything else lives in the popovers.\n *\n * {@link activityLine} is the ONE rule that resolves a node's merged activity\n * wording: the card's bottom bar and the node detail popover both read it, so\n * the two surfaces can never disagree about what a node is doing.\n */\nimport type { ReactNode } from 'react'\nimport {\n  IconAgentPresetOutlineRegular, IconBranchOutlineRegular, IconChecklistOutlineRegular, IconUserOutlineRegular,\n  type StateDotState,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { SidebarChildLiveView } from '../context-types.ts'\nimport { doneActivityTitle, liveActivityLabel } from './process-labels.ts'\nimport type {\n  TasksAgentNode, TasksFoldNode, TasksNodeState, TasksNodeTask, TasksWorkflowNode,\n} from './tasks-model.ts'\nimport { activityGlyph } from './activity-icons.tsx'\nimport { t, type CopyKey } from './locales.ts'\nimport css from './tasks-graph.module.css'\n\n/** Preview cap of one tool-call argument line. */\nconst ARGS_PREVIEW = 48\n/** Preview cap of one text line. */\nconst TEXT_PREVIEW = 72\n\n/** The host StateDot semantic of a node display state. */\nexport function nodeDotState(state: TasksNodeState): StateDotState {\n  switch (state) {\n    case 'running': return 'ongoing'\n    case 'idle': return 'idle'\n    case 'done': return 'done'\n    case 'error': return 'error'\n  }\n}\n\n/** The short state word of a node (the meta line's second token). */\nexport function stateLabel(state: TasksNodeState): string {\n  const key: CopyKey = state === 'running'\n    ? 'tasksStateRunning'\n    : state === 'idle'\n      ? 'subagentInactive'\n      : state === 'error' ? 'tasksStateError' : 'tasksStateDone'\n  return t(key)\n}\n\n/**\n * The merged activity line of one agent node — the ONE rule both surfaces\n * read (the card's bottom bar and the node detail popover).\n *\n * - a RUNNING node shows the host's own live wording for its newest range\n *   (\"正在读取文件 · main.ts\"), which is what the main conversation shows for\n *   the same work;\n * - a settled one shows the same summary in its completed form (the host's\n *   `done.*` phrasing) — running wording on a finished node would claim it is\n *   analysing something it already answered;\n * - a node the live channel carries NO summary for answers undefined, and the\n *   callers fall back to the state word. That case must stay distinguishable:\n *   the host's `thinking` wording is what a range with nothing dispatched\n *   reads as, not what \"we know nothing about this node\" reads as.\n */\nexport function activityLine(node: TasksAgentNode): string | undefined {\n  const summary = node.live?.summary\n  if (summary === undefined) return undefined\n  return node.state === 'running' ? liveActivityLabel(summary) : doneActivityTitle(summary)\n}\n\n/**\n * The two facts every task display rule reads. Deliberately NARROWER than\n * either carrier (`TasksNodeTask` on the graph, `SidebarTeamTaskView` in the\n * board and the task window) so one rule serves all of them — the window sees\n * a `deleted` status the graph never draws, and only the shared rule needs to\n * know that a deleted task is not \"blocked\".\n */\nexport interface TaskStatusFacts {\n  status: 'pending' | 'in_progress' | 'completed' | 'deleted'\n  ready: boolean\n}\n\n/** The task status label key. */\nexport function taskStatusKey(status: TaskStatusFacts['status']): CopyKey {\n  switch (status) {\n    case 'pending': return 'teamTaskPending'\n    case 'in_progress': return 'teamTaskInProgress'\n    case 'completed': return 'teamTaskCompleted'\n    case 'deleted': return 'teamTaskDeleted'\n  }\n}\n\n/**\n * Whether a shared task is HELD UP by its blockers.\n *\n * The service's `ready` flag means exactly one thing: \"a pending task whose\n * every blocker completed, so it can be CLAIMED\". It is therefore false for\n * every task that is not queued — which makes `!ready` the wrong test for\n * \"blocked\": a claimed task (in_progress) and a finished one both report\n * `ready: false`, and reading the flag alone labelled a task that is actively\n * being worked on as 阻塞 (reproduced on the real board: claiming a task made\n * its Tag flip from 待办 to 阻塞).\n */\nexport function taskBlocked(task: TaskStatusFacts): boolean {\n  return task.status === 'pending' && !task.ready\n}\n\n/** The status word of a task row: its own status, or 阻塞 when held up. */\nexport function taskStatusLabel(task: TaskStatusFacts): string {\n  return t(taskBlocked(task) ? 'teamTaskBlocked' : taskStatusKey(task.status))\n}\n\n/** The tone of a task's status Tag (or dot) — the same three-way rule. */\nexport function taskTone(task: TaskStatusFacts): 'success' | 'info' | 'warning' {\n  if (task.status === 'completed') return 'success'\n  return taskBlocked(task) ? 'warning' : 'info'\n}\n\n/** The host StateDot semantic of a task row/line. */\nexport function taskDotState(task: TaskStatusFacts): StateDotState {\n  if (task.status === 'completed') return 'done'\n  return taskBlocked(task) ? 'warning' : 'ongoing'\n}\n\n/** First `limit` characters with an ellipsis when truncated. */\nexport function preview(text: string, limit: number = ARGS_PREVIEW): string {\n  return text.length > limit ? `${text.slice(0, limit)}…` : text\n}\n\n/** Collapse whitespace for single-line previews. */\nexport function flatten(text: string): string {\n  return text.replace(/\\s+/g, ' ').trim()\n}\n\n/** The host icon of one agent node (the lead and plain children share one). */\nexport function AgentGlyph(props: { node: TasksAgentNode; size?: number }): ReactNode {\n  const size = props.size ?? 11\n  if (props.node.team?.role === 'teammate') return <IconUserOutlineRegular size={size} />\n  return <IconAgentPresetOutlineRegular size={size} />\n}\n\n/** The workflow-run glyph. */\nexport function WorkflowGlyph(props: { size?: number }): ReactNode {\n  return <IconBranchOutlineRegular size={props.size ?? 11} />\n}\n\n/** The fold aggregate glyph. */\nexport function FoldGlyph(props: { size?: number }): ReactNode {\n  return <IconChecklistOutlineRegular size={props.size ?? 11} />\n}\n\n/**\n * The mode word of one catalog row, or undefined when it names no mode. DSH\n * 0.1.7 added `unknown` (a child the host's catalog fold kept without a\n * readable descriptor): it claims NEITHER mode, so the segment is omitted\n * rather than mislabelled.\n */\nexport function modeLabel(mode: TasksAgentNode['mode']): string | undefined {\n  switch (mode) {\n    case 'one-shot': return t('subagentModeOneShot')\n    case 'continuable': return t('subagentModeContinuable')\n    case 'unknown':\n    case undefined: return undefined\n  }\n}\n\n/**\n * The mono meta line of an agent card — at most two short tokens:\n * - the topology root: 主代理 · 状态\n * - any other agent: 模式 · 状态 (a teammate without a catalog mode falls back\n *   to its team role, the one durable identity the roster still carries — the\n *   `agentTeam` projection has no model field to print, see team-projection.ts)\n */\nexport function agentMeta(node: TasksAgentNode): string {\n  const state = stateLabel(node.state)\n  if (node.parentId === undefined) return `${t('subagentMainAgent')} · ${state}`\n  const mode = modeLabel(node.mode)\n  if (mode !== undefined) return `${mode} · ${state}`\n  const fallback = node.team === undefined ? undefined : teamRoleLabel(node.team)\n  return fallback === undefined ? state : `${fallback} · ${state}`\n}\n\n/**\n * The identity CHIP of an agent card: the word that rides BESIDE the kind badge\n * (一次性 / 可持续), or the one team state the badge cannot express (准备中 /\n * 出错).\n *\n * It is a chip and not a line of its own because the mode is the same word on\n * every card of its kind: as a mono meta line it cost a 16px row to repeat\n * itself, and the reader's report was exactly \"模型一次性的子代理一直显示一次性\".\n * A plain teammate answers undefined — the badge already reads 成员 — and the\n * root answers undefined too (its badge reads 主代理).\n *\n * The state stays out of it: the card's bottom bar carries it (its dot, and its\n * word whenever no activity line takes that place), and the accessible name\n * keeps {@link agentMeta} with the state included, because a screen reader\n * never sees the bar's dot.\n */\nexport function agentChip(node: TasksAgentNode): string | undefined {\n  if (node.parentId === undefined) return undefined\n  const mode = modeLabel(node.mode)\n  if (mode !== undefined) return mode\n  return undefined\n}\n\n/** The roster row's own identity word (the fallback for a modelless teammate). */\nfunction teamRoleLabel(team: NonNullable<TasksAgentNode['team']>): string | undefined {\n  if (team.role === 'lead') return undefined\n  return t('tasksKindTeammate')\n}\n\n/** The mono meta line of a workflow run card: status · member tally. */\nexport function workflowMeta(node: TasksWorkflowNode): string {\n  const { run } = node\n  let done = 0\n  let total = 0\n  for (const phase of run.phases) {\n    for (const member of phase.members) {\n      total += 1\n      if (member.outcome !== undefined) done += 1\n    }\n  }\n  return `${t(workflowStatusKey(run.status))} · ${t('workflowMembers', { done, total })}`\n}\n\n/** The workflow run status label key. */\nexport function workflowStatusKey(status: TasksWorkflowNode['run']['status']): CopyKey {\n  switch (status) {\n    case 'running': return 'workflowRunning'\n    case 'completed': return 'workflowCompleted'\n    case 'cancelled': return 'workflowCancelled'\n    case 'failed': return 'workflowFailed'\n  }\n}\n\n/** The task a node surfaces first: in-progress, else pending, else the last. */\nexport function primaryTask(tasks: readonly TasksNodeTask[]): TasksNodeTask | undefined {\n  return tasks.find(task => task.status === 'in_progress')\n    ?? tasks.find(task => task.status === 'pending')\n    ?? tasks[tasks.length - 1]\n}\n\n/**\n * The node's shared-task line: an icon, the primary task's subject, its\n * status word, and a `+N` tail when the agent owns more. Renders nothing\n * without tasks, so non-team nodes keep the three-line shape.\n */\nexport function TaskLine(props: {\n  tasks: readonly TasksNodeTask[] | undefined\n  onOpenTask(taskId: string, anchor: HTMLElement): void\n}): ReactNode {\n  const tasks = props.tasks ?? []\n  const primary = primaryTask(tasks)\n  if (primary === undefined) return null\n  return (\n    <span\n      role=\"button\"\n      tabIndex={0}\n      className={css.taskLine}\n      title={tasks.map(task => `${task.subject}（${taskStatusLabel(task)}）`).join('\\n')}\n      onClick={(event) => {\n        event.stopPropagation()\n        props.onOpenTask(primary.id, event.currentTarget)\n      }}\n      onKeyDown={(event) => {\n        if (event.key !== 'Enter' && event.key !== ' ') return\n        event.preventDefault()\n        event.stopPropagation()\n        props.onOpenTask(primary.id, event.currentTarget)\n      }}\n    >\n      <span className={css.taskGlyph} aria-hidden=\"true\"><IconChecklistOutlineRegular size={9} /></span>\n      <span className={css.taskSubject}>{primary.subject}</span>\n      <span className={css.taskState}>{taskStatusLabel(primary)}</span>\n      {tasks.length > 1 && <span className={css.taskMore}>{`+${tasks.length - 1}`}</span>}\n    </span>\n  )\n}\n\n/**\n * The live activity row of a RUNNING agent: the merged process summary the\n * main conversation would show for the child's newest range (category wording\n * + the running call's detail), plus the flattened last text line underneath.\n * A running node with neither reads as thinking.\n *\n * The glyph follows the summary's own CATEGORY (the host's `ProcessActivity`),\n * so \"正在读取文件\" is prefixed by the read family and \"正在运行命令\" by the\n * command one — one fixed glyph made every row claim to be a shell command.\n */\nexport function LiveLine(props: { live: SidebarChildLiveView | undefined }): ReactNode {\n  const { live } = props\n  const activity = liveActivityLabel(live?.summary)\n  if (activity === undefined && live?.text === undefined) {\n    return <span className={css.nodeMeta}>{t('subagentThinking')}</span>\n  }\n  return (\n    <>\n      {activity !== undefined && (\n        <span className={css.live}>\n          <span className={css.liveGlyph} aria-hidden=\"true\">\n            {activityGlyph(live?.summary?.running)(9)}\n          </span>\n          <span className={css.liveTool} title={activity}>{activity}</span>\n        </span>\n      )}\n      {live?.text !== undefined && (\n        <span className={css.liveText}>{preview(flatten(live.text), TEXT_PREVIEW)}</span>\n      )}\n    </>\n  )\n}\n\n/**\n * The fold aggregate's name line: two label previews, plus `+N` when the group\n * holds more.\n *\n * A roster aggregate can swallow dozens of members, and the card has one line\n * for them. Naming two and saying how many are left over is what keeps that\n * line honest at any size — the exact `+N` the team task line already uses,\n * not a second convention. The group's total is also on the badge, so `+N` is\n * a tail, never the only count.\n *\n * @param previews - member labels, in page order (see {@link TasksFoldNode.previews}).\n * @param count - how many members the group holds in total.\n */\nexport function foldPreviews(previews: readonly string[], count: number): string {\n  const tail = count > previews.length ? ` +${count - previews.length}` : ''\n  return `${previews.join(' / ')}${tail}`\n}\n\n/**\n * The fold aggregate's failures, as its own line: `出错 N`, or undefined when\n * the group has none. The `done` row's bottom bar prints exactly this and\n * nothing else, because the badge above it already carries the count\n * (`✓ N 已完成`) — the same number twice on a 190px card was one of them\n * saying it again.\n */\nexport function foldErrorTally(node: TasksFoldNode): string | undefined {\n  return node.errorCount > 0 ? `${t('tasksStateError')} ${node.errorCount}` : undefined\n}\n\n/**\n * The fold aggregate's full tally (its accessible name and tooltip).\n *\n * The two groups read differently on purpose. The `done` row counts its\n * finished members and calls out failures beside them (`✓ 4 已完成 · 出错 1`\n * — a row of nothing but failures is `出错 N`), because \"✓ N 已完成\" alone\n * would quietly include them. The `idle` row says what the members are doing\n * now: nothing (`N 待命`), which is why they were swept away.\n *\n * The VISIBLE surfaces split this differently: the graph card's badge carries\n * the count and its bar carries {@link foldErrorTally}, so the tally's count\n * half is printed once. This full string stays the accessible name — a screen\n * reader never sees the badge.\n */\nexport function foldTally(node: TasksFoldNode): string {\n  if (node.foldKind === 'idle') return t('tasksFoldIdle', { count: node.count })\n  const parts: string[] = []\n  if (node.doneCount > 0) parts.push(t('tasksFoldCompleted', { count: node.doneCount }))\n  const errors = foldErrorTally(node)\n  if (errors !== undefined) parts.push(errors)\n  return parts.join(' · ')\n}\n","/**\n * The two-segment node card of the Tasks graph: a TOP segment that says WHAT\n * the node is (kind badge, name, mono meta, optional task line) and a BOTTOM\n * bar that says WHAT IT IS DOING (state dot + the merged process activity —\n * or, when there is no activity to show, the state word — plus the fold\n * chevron once the node has settled).\n *\n * The state word YIELDS to the activity line: \"运行中 · 正在读取文件\" and\n * \"已完成 · 已读取文件\" both printed the state twice inside one 22px strip,\n * and the dot beside them already carries it. `idle` and `error` keep their\n * word — neither \"waiting for a turn\" nor \"failed\" is implied by any activity\n * wording, so dropping them would hide the one thing that bar has to say.\n *\n * Both modes share the model but NOT the card: the TREE keeps its compact\n * indent row (its own disclosure, its own keyboard recipe), so this module is\n * graph-only. Its two pieces are separate components because every node kind\n * (agent / workflow run / fold aggregate) composes them differently while the\n * geometry stays identical — the layout reserves the height of exactly these\n * rows (`tasks-graph-layout.ts`).\n *\n * Colour: the group colour of a node is its tree DEPTH, from the plugin's own\n * token-only ramp (`.depth0…3` in tasks-graph.module.css). The host ships no\n * chart palette and the skin contract forbids literal colours, so the ramp is\n * mixed from `--dsw-alias-state-business-primary`; a workflow member's PHASE\n * badge uses the ink family instead, so the two groupings never share a hue.\n */\nimport type { ReactNode } from 'react'\nimport clsx from 'clsx'\nimport { IconChevronUpOutlineRegular, StateDot } from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { TasksNodeState } from './tasks-model.ts'\nimport { nodeDotState, stateLabel } from './tasks-shared.tsx'\nimport { t } from './locales.ts'\nimport css from './tasks-graph.module.css'\n\n/** The five kinds of card the graph draws. */\nexport type CardKind = 'main' | 'subagent' | 'teammate' | 'workflow' | 'fold'\n/** Which aggregate a fold card is (`done` = finished/failed, `idle` = waiting). */\nexport type CardFoldKind = 'done' | 'idle'\n\n/**\n * The kind badge's word: the SAME vocabulary the rest of the page uses (the\n * header already calls the root \"主代理\"), so no sixth word is invented for it.\n *\n * The two aggregates say different things, because they hold different work:\n * `done` keeps \"✓ N 已完成\" (finished and failed rows alike) while `idle`\n * counts its waiting members. One mixed row could only have hedged\n * (\"✓ 2 已完成 · 3 待命\"), which is exactly what splitting them removed.\n *\n * The badge is where an aggregate's COUNT lives, so it interpolates the real\n * number: the idle branch used to print the literal copy 'N 个待命', which\n * read as an unfilled placeholder on every idle aggregate.\n * @param kind - card kind.\n * @param count - folded member count (the fold aggregate's badge only).\n * @param foldKind - which aggregate (`done` unless stated).\n */\nexport function cardKindLabel(kind: CardKind, count = 0, foldKind: CardFoldKind = 'done'): string {\n  switch (kind) {\n    case 'main': return t('subagentMainAgent')\n    case 'subagent': return t('tasksKindSubagent')\n    case 'teammate': return t('tasksKindTeammate')\n    case 'workflow': return t('tasksKindWorkflow')\n    case 'fold': return foldKind === 'idle'\n      ? t('tasksFoldIdleGroup', { count })\n      : t('tasksFoldCompleted', { count })\n  }\n}\n\n/**\n * The depth class of a node's group colour (levels past 3 share the last one).\n * Typed `string | undefined` because the CSS-module map is an open record: a\n * typo'd class name would otherwise pass `tsc` as a `string`.\n */\nexport function depthClass(depth: number): string | undefined {\n  if (depth <= 0) return css.depth0\n  if (depth === 1) return css.depth1\n  if (depth === 2) return css.depth2\n  return css.depth3\n}\n\n/** The phase class of a workflow member's badge (phases past 3 share the last one). */\nexport function phaseClass(index: number): string | undefined {\n  if (index <= 0) return css.phase0\n  if (index === 1) return css.phase1\n  if (index === 2) return css.phase2\n  return css.phase3\n}\n\n/** The top segment: the node's identity. */\nexport function CardTop(props: {\n  kind: CardKind\n  /** Folded member count, for the aggregate's badge. */\n  count?: number\n  /** Which aggregate this card is, when `kind` is `fold`. */\n  foldKind?: CardFoldKind\n  /** Tree depth → the group colour of the badge and the card's left edge. */\n  depth: number\n  /** Workflow phase (a member's badge). */\n  phase?: { index: number; title?: string }\n  /**\n   * The identity CHIP beside the kind badge — the node's own mode word\n   * (一次性 / 可持续) or the one team state the badge cannot express. It shares\n   * the badge row on purpose: as a mono line of its own it repeated the same\n   * word on every card and spent a 16px row saying it.\n   */\n  chip?: string\n  /** The node's name (already resolved by the model). */\n  name: string\n  /** The mono meta line under the name. */\n  meta?: string\n  /**\n   * The newest assistant text of the node's own session, set as a small tail\n   * under the name — the one thing a card could not say before (it lived in the\n   * detail window only). `lines` is the count the LAYOUT reserved for it, so the\n   * card clamps to exactly what its box was sized for and never overflows the\n   * row gutter (see textTailLines).\n   */\n  text?: { value: string; lines: number }\n  /** Extra class for the name (the aggregate recedes one rung). */\n  extraClass?: string\n  /** Extra rows the caller appends (the team task line). */\n  children?: ReactNode\n}): ReactNode {\n  const { kind, count, foldKind, depth, phase, chip, text } = props\n  return (\n    <span className={clsx(css.cardTop, depthClass(depth))}>\n      <span className={css.cardBadges}>\n        <span className={css.kindBadge} data-card-kind={kind}>\n          {cardKindLabel(kind, count ?? 0, foldKind ?? 'done')}\n        </span>\n        {phase !== undefined && (\n          <span\n            className={clsx(css.phaseBadge, phaseClass(phase.index))}\n            title={phase.title ?? t('workflowPhaseUnnamed')}\n          >\n            {phase.title ?? t('workflowPhaseUnnamed')}\n          </span>\n        )}\n        {chip !== undefined && chip !== '' && <span className={css.kindChip}>{chip}</span>}\n      </span>\n      <span className={clsx(css.cardName, props.extraClass)} title={props.name}>{props.name}</span>\n      {props.meta !== undefined && props.meta !== '' && (\n        <span className={css.cardMeta} title={props.meta}>{props.meta}</span>\n      )}\n      {text !== undefined && (\n        <span\n          className={css.cardText}\n          style={{ WebkitLineClamp: text.lines }}\n          title={text.value}\n        >\n          {text.value}\n        </span>\n      )}\n      {props.children}\n    </span>\n  )\n}\n\n/** The bottom bar: the node's activity (or its state word), dot and chevron. */\nexport function CardBar(props: {\n  state: TasksNodeState\n  /** The merged process activity line (running nodes and settled summaries). */\n  activity?: string\n  /** Whether the node is executing (drives the sweep). */\n  running?: boolean\n  /** Fold the node into its parent's completed aggregate (settled nodes only). */\n  onFold?: (event: { stopPropagation(): void }) => void\n  /** The chevron's accessible name (defaults to the per-node fold word). */\n  foldLabel?: string\n  /** Render the state WORD next to the dot (off for the aggregate's action bar). */\n  stateWord?: boolean\n  /** Replace the whole bar's content (the aggregate's action row). */\n  children?: ReactNode\n}): ReactNode {\n  const { state, activity, running } = props\n  // An empty string is not an activity line: it would print a gap where the\n  // state word used to be.\n  const line = activity === undefined || activity === '' ? undefined : activity\n  /**\n   * Which states still print their word. The activity line REPLACES it for\n   * work that the line already describes — a running node's own native status\n   * and a settled node's completed summary. `idle` and `error` keep the word:\n   * a teammate between turns and a failed node both read as \"finished\n   * something\" from their summary alone, which is exactly the misreading the\n   * two states must not allow.\n   */\n  const showStateWord = props.stateWord !== false\n    && (line === undefined || state === 'idle' || state === 'error')\n  return (\n    <span\n      className={css.cardBar}\n      data-card-bar={state}\n      data-running={running === true ? 'true' : undefined}\n    >\n      {props.children ?? (\n        <>\n          <StateDot state={nodeDotState(state)} size={6} className={css.barDot} />\n          {showStateWord && <span className={css.barState}>{stateLabel(state)}</span>}\n          {line !== undefined && (\n            <span className={css.barActivity} title={line}>{line}</span>\n          )}\n          {props.onFold !== undefined && (\n            <button\n              type=\"button\"\n              className={css.barFold}\n              aria-label={props.foldLabel ?? t('tasksFoldOne')}\n              title={props.foldLabel ?? t('tasksFoldOne')}\n              onClick={(event) => {\n                // The card's own click opens the detail popover: folding must\n                // never do both.\n                event.stopPropagation()\n                props.onFold?.(event)\n              }}\n            >\n              {/*\n                The COLLAPSE direction (chevron up = gather into the group): the\n                aggregate card at the other end of the same motion offers the\n                EXPAND one (chevron down). Two opposite actions must not share\n                a glyph — the first cut drew both as a down chevron.\n              */}\n              <IconChevronUpOutlineRegular size={12} />\n            </button>\n          )}\n        </>\n      )}\n    </span>\n  )\n}\n","/**\n * The workflow-graph mode of the Tasks page: layered agent / workflow nodes\n * over bezier edges on a dotted grid, drag-pan from the BACKGROUND only\n * (never from a node — capturing pointers on the container retargets the\n * derived click and silently swallows node clicks), wheel zoom to the cursor,\n * dashed phase frames, fold aggregate nodes, and the bottom-right horizontal\n * control cluster (view toggle / fold / zoom out / level / zoom in / fit)\n * that stays reachable in BOTH modes.\n *\n * Fitting: the canvas auto-fits while the reader has not touched the view,\n * re-running on container resize and layout growth (the sidebar mounts\n * hidden at zero size, so a one-shot fit on mount is not enough), centering\n * on both axes and scaling UP to {@link FIT_MAX_SCALE} so a small tree fills\n * the narrow panel instead of hugging the top-left corner.\n *\n * Cards: the node card recipe of tasks-graph.module.css with a TWO-line\n * clamped title (the card reserve in tasks-graph-layout.ts is sized for that\n * second line, plus one row per live / task line the card renders) and the\n * full name in the `title` attribute. While the root catalog hydrates, an\n * empty canvas shows the same hint as the tree (`loading`).\n */\nimport {\n  memo,\n  useCallback,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n  type PointerEvent as ReactPointerEvent,\n  type ReactNode,\n} from 'react'\nimport clsx from 'clsx'\nimport {\n  Button, IconChevronDownOutlineRegular, IconChevronUpOutlineRegular,\n  IconFullscreenOutlineRegular,\n  IconLoadingOutlineRegular, IconTreeCornerRegular,\n} from '@deepseek-ai/dsh-client-ui-primitives'\nimport type { TasksAgentNode, TasksFoldNode, TasksNode, TasksWorkflowNode } from './tasks-model.ts'\nimport { tasksEdges } from './tasks-model.ts'\nimport {\n  GRAPH_FIT_MIN_SCALE, GRAPH_NODE_H, GRAPH_NODE_W, GRAPH_PAD, layoutTasksGraphForWidth,\n  textTailLines, type GraphBox,\n} from './tasks-graph-layout.ts'\nimport { createFrameBatcher } from './frame-batcher.ts'\nimport { useTweenedLayout } from './tasks-layout-tween.ts'\nimport { easeOut as glideEase } from './tasks-layout-tween.ts'\nimport { fitTransform, GLIDE_MS, lerpTransform, type ViewTransform } from './tasks-view-glide.ts'\n\n/** Whether the reader asked the platform for less motion. */\nfunction prefersReducedMotion(): boolean {\n  return typeof window !== 'undefined'\n    && typeof window.matchMedia === 'function'\n    && window.matchMedia('(prefers-reduced-motion: reduce)').matches\n}\nimport {\n  activityLine, agentChip, agentMeta, flatten, foldErrorTally, foldPreviews, FoldGlyph,\n  foldTally, TaskLine, WorkflowGlyph, workflowMeta,\n} from './tasks-shared.tsx'\nimport { CardBar, CardTop, phaseClass, type CardKind } from './tasks-card.tsx'\nimport { localeSignature, t } from './locales.ts'\nimport css from './tasks-graph.module.css'\nimport canvasCss from './tasks-canvas.module.css'\n\n/** The zoom bounds of the canvas. The upper bound is deliberately above 1: on\n *  a narrow panel the reader zooms IN to read a card, and the fit's own cap\n *  (FIT_MAX_SCALE) is what keeps a two-node tree from ballooning. */\nconst ZOOM_MIN = 0.4\nconst ZOOM_MAX = 2\n/** Upper bound of the auto-fit scale (never balloon a two-node tree). */\nconst FIT_MAX_SCALE = 1.3\n/** Breathing room the fit leaves around the CONTENT box, per axis. */\nconst FIT_MARGIN = 24\n/** How much of the canvas must stay on screen while panning (px). */\nconst PAN_KEEP = 72\n/* The readability floor the fit honours is `GRAPH_FIT_MIN_SCALE` (imported):\n * the layout budgets its columns from the same number, so scaling and wrapping\n * can never disagree. */\n/** The perpendicular stub each connector leaves a card with (px, pre-scale). */\nconst EDGE_STUB = 8\n/** Drag-vs-click separation: pointer travel below this stays a click. */\nconst CLICK_TOLERANCE_PX = 4\n\n/**\n * The card kind of one agent node: the node's own role decides the badge, so a\n * teammate never reads as a plain subagent and the root never reads as a child.\n */\nfunction agentCardKind(node: TasksAgentNode): CardKind {\n  if (node.team?.role === 'teammate') return 'teammate'\n  return node.parentId === undefined ? 'main' : 'subagent'\n}\n\n/** Members of one run that already reported an outcome. */\nfunction doneMembers(node: TasksWorkflowNode): number {\n  let done = 0\n  for (const phase of node.run.phases) {\n    for (const member of phase.members) if (member.outcome !== undefined) done += 1\n  }\n  return done\n}\n\n/** Members of one run across every phase. */\nfunction totalMembers(node: TasksWorkflowNode): number {\n  let total = 0\n  for (const phase of node.run.phases) total += phase.members.length\n  return total\n}\n\n/** One phase frame of a run node (the dashed box behind its members). */\ninterface PhaseFrame {\n  key: string\n  title: string | undefined\n  /** The phase's index within its run — drives the frame's colour, which the\n   *  members' own phase badges repeat (badge + colour, no lines to decode). */\n  index: number\n  x: number\n  y: number\n  w: number\n  h: number\n}\n\nexport interface TasksGraphProps {\n  nodes: readonly TasksNode[]\n  folded: boolean\n  /** Re-fit trigger: the topology root id (a reroot re-centers). */\n  rootId: string | undefined\n  onNodeInfo(node: TasksAgentNode, anchor: HTMLElement): void\n  onWorkflowInfo(node: TasksWorkflowNode, anchor: HTMLElement): void\n  /** Open the shared task window for one task id. */\n  onOpenTask(taskId: string, anchor: HTMLElement): void\n  /** The control cluster's global fold switch (settled leaves). */\n  onToggleFold(): void\n  /** The fold AGGREGATE's click: reveal THIS group's members only. */\n  onExpandGroup(node: TasksFoldNode): void\n  /** Fold ONE settled node into its parent's aggregate (the bar's chevron). */\n  onFoldNode(node: TasksAgentNode): void\n  mode: 'graph' | 'tree'\n  onModeChange(mode: 'graph' | 'tree'): void\n  /** Fallback hint while the root catalog hydrates (the graph twin of\n   *  TasksTree's loading row: the same copy key, the same \"nothing to show\n   *  yet\" condition). */\n  loading?: boolean\n}\n\n/** The shared view-mode toggle (glyph + label) both modes render in their\n *  bottom-right control cluster. */\nexport function ViewModeToggle(props: {\n  mode: 'graph' | 'tree'\n  onModeChange(mode: 'graph' | 'tree'): void\n}): ReactNode {\n  const { mode, onModeChange } = props\n  const toTree = mode === 'graph'\n  const label = toTree ? t('tasksViewTree') : t('tasksViewGraph')\n  return (\n    <Button\n      variant=\"ghost\"\n      size=\"sm\"\n      icon={toTree ? <IconTreeCornerRegular /> : <WorkflowGlyph size={13} />}\n      aria-label={t(toTree ? 'tasksViewSwitchToTree' : 'tasksViewSwitchToGraph')}\n      title={t(toTree ? 'tasksViewSwitchToTree' : 'tasksViewSwitchToGraph')}\n      onClick={() => { onModeChange(toTree ? 'tree' : 'graph') }}\n    >\n      {label}\n    </Button>\n  )\n}\n\n/** The fold toggle (expand / re-collapse the settled aggregates). */\n/**\n * The cluster's fold switch. Its glyph names the action it will take, not the\n * state it is in: while the settled nodes are folded the button offers to\n * EXPAND (chevron down), and while they are open it offers to FOLD (chevron\n * up, the same collapse direction the cards' own bar buttons wear). The old\n * single checklist glyph read identically in both states, which is what the\n * reader reported as \"折叠按钮和展开一样\".\n */\nexport function FoldToggleButton(props: { folded: boolean; onToggleFold(): void }): ReactNode {\n  const { folded, onToggleFold } = props\n  return (\n    <Button\n      variant=\"ghost\"\n      size=\"sm\"\n      className={clsx(css.controlBtn, folded && css.controlBtnActive)}\n      icon={folded\n        ? <IconChevronDownOutlineRegular size={13} />\n        : <IconChevronUpOutlineRegular size={13} />}\n      aria-pressed={folded}\n      aria-label={t(folded ? 'tasksFoldExpand' : 'tasksFoldCollapse')}\n      title={t(folded ? 'tasksFoldExpand' : 'tasksFoldCollapse')}\n      onClick={onToggleFold}\n    />\n  )\n}\n\nexport function TasksGraph(props: TasksGraphProps): ReactNode {\n  const {\n    nodes, folded, rootId, onNodeInfo, onWorkflowInfo, onOpenTask, onToggleFold, onExpandGroup,\n    onFoldNode, mode, onModeChange, loading,\n  } = props\n  const containerRef = useRef<HTMLDivElement>(null)\n  /*\n   * The canvas deliberately runs NO FLIP library: auto-animate pins a leaving\n   * card with absolute `left/top` measured from `getBoundingClientRect()` and\n   * translates the movers in UNSCALED units, while this layer carries the\n   * fit's `transform: scale(k)`. Inside that layer the leaving card's pinned\n   * box cannot even be expressed (its position jumps) and every mover travels\n   * k× its true distance — reproduced live as \"折叠展开的动效都特别怪\".\n   * Cards therefore arrive with the CSS entrance in tasks-graph.module.css\n   * (mount-only, no geometry math) and leave instantly; the edges they hang\n   * from are not animated either, so nothing disagrees with them.\n   */\n  const [tf, setTf] = useState({ x: 0, y: 0, k: 1 })\n  const [dragging, setDragging] = useState(false)\n  /** Pointer travel of the in-flight gesture (click suppression). */\n  const travelRef = useRef(0)\n  /** The reader moved/zoomed: stop auto-fitting over their view. */\n  const touchedRef = useRef(false)\n  const tfRef = useRef(tf)\n  tfRef.current = tf\n\n  /** Container width drives the sibling-band wrap (see bandColsFor). */\n  const [width, setWidth] = useState(0)\n  const layout = useMemo(\n    () => layoutTasksGraphForWidth(nodes, width, GRAPH_FIT_MIN_SCALE),\n    [nodes, width],\n  )\n  /**\n   * What is actually drawn: the layout tweened towards, frame by frame, in the\n   * canvas's OWN coordinates (see tasks-layout-tween.ts — a screen-space FLIP\n   * library cannot work under the fit's scale). Cards, connectors and phase\n   * frames all read it, so the lines travel WITH the cards instead of snapping\n   * to the new geometry.\n   */\n  const drawn = useTweenedLayout(layout)\n  const edges = useMemo(() => tasksEdges(nodes), [nodes])\n  const nodeById = useMemo(() => new Map(nodes.map(node => [node.id, node])), [nodes])\n\n  /** A running view glide (see fit): cancelled by any reader gesture. */\n  const glideRef = useRef(0)\n\n  /** Stop a glide where it is (the reader took the wheel). */\n  const stopGlide = useCallback((): void => {\n    if (glideRef.current !== 0) {\n      cancelAnimationFrame(glideRef.current)\n      glideRef.current = 0\n    }\n  }, [])\n\n  /**\n   * The frame the auto-fit wants right now, or undefined before the container\n   * has been measured (the sidebar mounts hidden at zero size). The arithmetic\n   * lives in tasks-view-glide.ts, where a test can reach it.\n   */\n  const fitTarget = useCallback((): ViewTransform | undefined => {\n    const container = containerRef.current\n    if (container === null) return undefined\n    return fitTransform({\n      containerW: container.clientWidth,\n      containerH: container.clientHeight,\n      layoutW: layout.width,\n      layoutH: layout.height,\n      pad: GRAPH_PAD,\n      minContentW: GRAPH_NODE_W,\n      minContentH: GRAPH_NODE_H,\n      margin: FIT_MARGIN,\n      minScale: GRAPH_FIT_MIN_SCALE,\n      maxScale: FIT_MAX_SCALE,\n    })\n  }, [layout.width, layout.height])\n\n  /**\n   * Put the frame where the fit wants it, either at once (a resize while the\n   * reader drags the panel edge, a fresh session) or as a GLIDE — the layout\n   * tween moves the cards, and the frame has to travel with them instead of\n   * jumping to the new framing a frame later. That glide is what makes \"stay\n   * auto-fitted\" and \"never yank the view\" the same behavior.\n   *\n   * @param animate - glide instead of snapping.\n   */\n  const applyFit = useCallback((animate: boolean): void => {\n    const target = fitTarget()\n    if (target === undefined) return\n    stopGlide()\n    if (!animate || prefersReducedMotion()) {\n      setTf(target)\n      return\n    }\n    const from = tfRef.current\n    const started = performance.now()\n    const step = (): void => {\n      const progress = glideEase((performance.now() - started) / GLIDE_MS)\n      setTf(lerpTransform(from, target, progress))\n      glideRef.current = progress < 1 ? requestAnimationFrame(step) : 0\n    }\n    glideRef.current = requestAnimationFrame(step)\n  }, [fitTarget, stopGlide])\n\n  /** The reader's own re-fit (the ⌂ button and a background double-click). */\n  const fit = useCallback((): void => { applyFit(true) }, [applyFit])\n\n  /**\n   * Keep the canvas reachable: a pan or a zoom-out may never push the whole\n   * graph off screen (the classic \"I dragged it away and cannot find it\").\n   * `PAN_KEEP` px of content stay inside the container on every axis.\n   */\n  const clampTf = useCallback((next: { x: number; y: number; k: number }) => {\n    const container = containerRef.current\n    if (container === null) return next\n    const cw = container.clientWidth\n    const ch = container.clientHeight\n    const w = layout.width * next.k\n    const h = layout.height * next.k\n    const minX = Math.min(PAN_KEEP, cw - PAN_KEEP) - w\n    const maxX = Math.max(PAN_KEEP, cw - PAN_KEEP)\n    const minY = Math.min(PAN_KEEP, ch - PAN_KEEP) - h\n    const maxY = Math.max(PAN_KEEP, ch - PAN_KEEP)\n    return {\n      x: Math.min(maxX, Math.max(minX, next.x)),\n      y: Math.min(maxY, Math.max(minY, next.y)),\n      k: next.k,\n    }\n  }, [layout.width, layout.height])\n\n  /** The ⌂ button: refit AND re-enable auto-fit for later resizes. */\n  const refit = useCallback((): void => {\n    touchedRef.current = false\n    fit()\n  }, [fit])\n\n  /** The newest `applyFit`, so the effects below can depend on WHAT changed. */\n  const fitRef = useRef(applyFit)\n  fitRef.current = applyFit\n\n  // A different tree is a different canvas: re-fit AND hand the view back to the\n  // auto-fit, whatever the reader did to the previous one. Snapped, because the\n  // content changes wholesale.\n  useEffect(() => {\n    touchedRef.current = false\n    fitRef.current(false)\n  }, [rootId])\n\n  // Layout growth while the reader has left the view alone: glide to the new\n  // framing, so expanding a group KEEPS the graph centred and inside the panel\n  // without the frame jumping out from under the cards travelling to it. A\n  // reader who panned or zoomed owns the view, and nothing moves it.\n  useEffect(() => {\n    if (!touchedRef.current) fitRef.current(true)\n  }, [layout.width, layout.height])\n\n  useEffect(() => {\n    const container = containerRef.current\n    if (container === null || typeof ResizeObserver === 'undefined') return\n    const observer = new ResizeObserver((entries) => {\n      const rect = entries[0]?.contentRect\n      if (rect !== undefined) setWidth(current => (Math.abs(current - rect.width) < 2 ? current : rect.width))\n      if (!touchedRef.current) fit()\n    })\n    observer.observe(container)\n    return () => { observer.disconnect() }\n  }, [fit])\n\n  /**\n   * Wheel zoom is applied at most once per animation frame, for the same\n   * reason the pan is: a trackpad (and a high-report-rate mouse) delivers\n   * several wheel events per display frame, and every one of them\n   * used to commit a full canvas re-render. Each event chains off the PENDING\n   * transform rather than the last drawn one, so coalescing never loses a zoom\n   * step — the old code re-read `tfRef` for every event and only one step\n   * survived the frame.\n   */\n  const wheelBatcher = useRef(createFrameBatcher()).current\n  const pendingWheelRef = useRef<{ x: number; y: number; k: number } | null>(null)\n  /**\n   * A background pan gesture owns the transform from pointerdown to release.\n   * Wheel zoom and the pan both commit a WHOLE transform, so a wheel mid-drag\n   * would be overwritten by the pan's next frame (or vice versa); the wheel is\n   * ignored while the gesture is live instead.\n   */\n  const panActiveRef = useRef(false)\n\n  // Wheel-zoom to cursor (non-passive: the page must not scroll).\n  useEffect(() => {\n    const container = containerRef.current\n    if (container === null) return\n    const onWheel = (event: WheelEvent): void => {\n      event.preventDefault()\n      if (panActiveRef.current) return\n      const rect = container.getBoundingClientRect()\n      const mx = event.clientX - rect.left\n      const my = event.clientY - rect.top\n      const base = pendingWheelRef.current ?? tfRef.current\n      // Wheel deltas arrive in pixels, lines or pages depending on the device;\n      // normalise first, or a line-scrolling mouse zooms 30× slower than a\n      // trackpad (and a trackpad pinch, which reports ctrlKey, feels stuck).\n      const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? 100 : 1\n      const next = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, base.k * Math.exp(-event.deltaY * unit * 0.0014)))\n      if (next === base.k) return\n      touchedRef.current = true\n      stopGlide()\n      // Clamp EACH composed step, not just the frame's final value: the old\n      // one-event-per-frame code clamped every step, and a late