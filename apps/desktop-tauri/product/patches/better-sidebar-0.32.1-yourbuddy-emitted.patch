ng edge.\n      return occurrence.offset - shrink + 1\n    }\n    break\n  }\n  return target - shrink\n}\n\n/**\n * The detect-projection offset that appends at the document end, or\n * `undefined` when it cannot be derived.\n *\n * `foldClipboardOffset` alone is not enough: a command chip (`/goal `, present\n * while `phase === 'claimed'`) collapses to one detect character but never\n * appears in `occurrences` — the host only collects reference chips. The chip\n * covers exactly `claim.token`, a prefix of the draft, so its own characters\n * fold away and one placeholder takes their place.\n */\nfunction appendOffset(snapshot: InputState): number | undefined {\n  const { draft, claim } = snapshot\n  const occurrences = snapshot.occurrences ?? []\n  const token = snapshot.phase === 'claimed' && claim !== undefined && draft.startsWith(claim.token)\n    ? claim.token\n    : ''\n  if (token === '') return foldClipboardOffset(draft, occurrences, draft.length)\n  // Fold the arguments behind the token, then add the command chip's one\n  // detect character in front.\n  const rest = draft.slice(token.length)\n  const offsetInRest = occurrences\n    .filter(occurrence => occurrence.offset >= token.length)\n    .map(occurrence => ({ offset: occurrence.offset - token.length, length: occurrence.length }))\n  return 1 + foldClipboardOffset(rest, offsetInRest, rest.length)\n}\n\n/**\n * Insert a chip through the target Session's first accepting editor.\n * The composer shows the compact label; the model receives the reference.\n * Admission-phase and span revision guards can refuse the edit.\n *\n * The chip's `clipboardText` is the compact `label`, not the full payload —\n * see {@link PendingReference.clipboardText}.\n *\n * Returns false when the host refused the insert (stale revision, a frozen\n * submission phase, or no chip channel at all) so the caller can fall back.\n */\nexport function insertDraftReference(\n  ctx: Context,\n  sessionId: string,\n  reference: PendingReference,\n): boolean {\n  let before: number | undefined\n  try {\n    const actx = ctx.sessions.scope(SessionId(sessionId))\n    if (actx === undefined) return false\n    const conversation = ctx.get('conversation')\n    if (conversation === undefined) return false\n    const input = conversation.input.for(actx)\n    const snapshot = input.state.getSnapshot()\n    if (snapshot.draftRev === undefined) return false\n    if (snapshot.phase === 'adjudicating' || snapshot.phase === 'submitting' || snapshot.phase === 'sending') return false\n    before = snapshot.draftRev\n    // Chips always append at the document end (there is no caret API and the\n    // composer is a contenteditable, not a textarea — `probeComposerCaret`\n    // never resolves one), so the span is the folded end position.\n    const at = appendOffset(snapshot)\n    if (at === undefined) return false\n    // The host's insertReference adds a space AFTER the chip but never before\n    // it (client.js:14758), so a chip appended to `hello` would read\n    // `hello[chip]`. Reserve the separator first through the same span\n    // channel — a stray trailing space is harmless if the chip then fails.\n    let rev = snapshot.draftRev\n    let start = at\n    if (leadFor(snapshot.draft) !== '') {\n      actx.bail(actx, 'slash/input-insert-text', {\n        text: ' ',\n        span: { draftRev: rev, start: at, end: at },\n      })\n      const afterSpace = input.state.getSnapshot()\n      if (afterSpace.draftRev === rev) return false\n      rev = afterSpace.draftRev ?? rev\n      start = at + 1\n    }\n    const chip: SidebarReferenceInsert = {\n      source: reference.source ?? 'reference',\n      ref: reference.ref ?? reference.text,\n      label: reference.label,\n      // The built-in source's `ref` is a fenced block, not a path: leaving\n      // `appearance` unset on such a chip keeps the host from marking it\n      // openable (a click would feed that block to the file opener). A\n      // plugin-owned source answers its own clicks, so its chips may declare\n      // one.\n      ...reference.appearance === undefined ? {} : { appearance: reference.appearance },\n      clipboardText: reference.clipboardText ?? reference.label,\n    }\n    return actx.bail(actx, 'slash/input-insert-reference', {\n      reference: chip,\n      span: { draftRev: rev, start, end: start },\n    }) === true\n  } catch (error) {\n    // The host may have applied the edit and THEN thrown from its own update\n    // listeners — reporting false would make the caller insert the same\n    // reference a second time as plain text. A changed revision means the\n    // chip is already in the document.\n    console.warn('[dsh-better-sidebar] reference chip insert failed:', error)\n    return revisionChanged(ctx, sessionId, before)\n  }\n}\n\n/**\n * Whether the session's draft revision moved past `revision` — the only\n * trustworthy success signal after an exception swallowed the host's answer.\n * A missing service or snapshot counts as \"no evidence of success\".\n */\nfunction revisionChanged(ctx: Context, sessionId: string, revision?: number): boolean {\n  try {\n    const actx = ctx.sessions.scope(SessionId(sessionId))\n    if (actx === undefined) return false\n    const conversation = ctx.get('conversation')\n    const input = conversation?.input.for(actx)\n    const now = input?.state.getSnapshot().draftRev\n    if (now === undefined || revision === undefined) return false\n    return now !== revision\n  } catch {\n    return false\n  }\n}\n\n/**\n * Append `text` to the session's composer draft. Returns false — and logs —\n * when the conversation service or the session scope is unavailable.\n *\n * The host composer is a Lexical contenteditable with no caret API on this\n * face, so this appends at the end; a mid-draft insert would need the caret\n * the host does not publish here.\n */\nexport function appendToDraft(ctx: Context, sessionId: string, text: string): boolean {\n  try {\n    const actx = ctx.sessions.scope(SessionId(sessionId))\n    if (actx === undefined) {\n      console.warn('[dsh-better-sidebar] draft insert skipped: no session scope', sessionId)\n      return false\n    }\n    const conversation = ctx.get('conversation')\n    if (conversation === undefined) {\n      console.warn('[dsh-better-sidebar] draft insert skipped: conversation service unavailable')\n      return false\n    }\n    const input = conversation.input.for(actx)\n    const snapshot = input.state.getSnapshot()\n    if (snapshot.phase === 'adjudicating' || snapshot.phase === 'submitting' || snapshot.phase === 'sending') return false\n    const draft = snapshot.draft\n    const occurrences = snapshot.occurrences ?? []\n    // A command chip (`/goal`) is not a reference occurrence, but `setDraft`\n    // flattens it just the same — and flattening it also drops the claim, so\n    // the host re-reads the draft as plain text and cancels the command. Both\n    // chip kinds take the span path.\n    const hasChips = occurrences.length > 0 || snapshot.phase === 'claimed'\n    if (hasChips) {\n      // `setDraft` rebuilds the document from a plain string, which flattens\n      // every existing chip into its text — so on a draft that already\n      // carries chips, insert through the span event instead. The host's\n      // `SessionInput` has no plain-text facade method (`insertText` lives on\n      // the InputBar-private `InputActions`), so this event is the only\n      // channel that preserves chips.\n      const at = appendOffset(snapshot)\n      if (snapshot.draftRev === undefined || at === undefined) {\n        // No revision means no span channel either — the only remaining write\n        // path (`setDraft`) would flatten every chip, so refuse instead.\n        console.warn('[dsh-better-sidebar] draft insert skipped: chip draft without a revision')\n        return false\n      }\n      actx.bail(actx, 'slash/input-insert-text', {\n        text: `${leadFor(draft)}${text}`,\n        span: { draftRev: snapshot.draftRev, start: at, end: at },\n      })\n      return input.state.getSnapshot().draftRev !== snapshot.draftRev\n    }\n    input.setDraft(appendText(draft, text))\n    return true\n  } catch (error) {\n    console.warn('[dsh-better-sidebar] draft insert failed:', error)\n    return false\n  }\n}\n\n/**\n * Insert one reference as a chip, degrading to its plain-text form when the\n * host has no chip channel or refuses the insert. This is the ONE place the\n * fallback policy lives: the explorer's `@` button and the viewer selection\n * popup both come through here.\n */\nexport function insertReferenceOrText(\n  ctx: Context,\n  sessionId: string,\n  reference: PendingReference,\n): boolean {\n  return insertDraftReference(ctx, sessionId, reference) || appendToDraft(ctx, sessionId, reference.text)\n}\n\n/**\n * The DSH `@` spelling for one relative path, mirroring the host grammar\n * (`formatFileMention` in `@deepseek-ai/dsh-file-reference`): plain when\n * there is no whitespace, quoted when there is, and `undefined` when the\n * path contains a control character or an embedded quote the editor grammar\n * cannot represent.\n *\n * Files and folders share this one constructor so the quoting rule cannot\n * drift between them. A folder spells the trailing slash *inside* the quotes\n * (`@\"my dir/\"`, `@docs/`): the host's folder token matcher\n * (`FOLDER_REF_RE` in `dsh-client-ui-conversation`) only accepts a quoted\n * directory once the quote closes, and the message bubble's tokenizer\n * (`@\"[^\"\\n]+\"` in `dsh-client-ui-primitives`) only classifies a closed\n * quoted token as a folder — unquoted `@my dir/` decorates as a file chip\n * covering just `my`. The host's own picker emits the *open* form\n * (`@\"my dir/`) while the user is still descending through completion; a\n * programmatic reference is a finished mention, so it closes the quote.\n */\nexport function mentionFor(\n  relativePath: string,\n  kind: 'file' | 'folder',\n): { mention: string; label: string } | undefined {\n  const path = relativePath.replace(/[\\\\/]+$/, '')\n  // eslint-disable-next-line no-control-regex -- rejecting control characters is the point of this guard\n  if (/[\\u0000-\\u001f\\u007f-\\u009f\"]/u.test(path)) return undefined\n  const target = kind === 'folder' ? `${path}/` : path\n  const mention = /\\s/u.test(target) ? `@\"${target}\"` : `@${target}`\n  return { mention, label: baseName(path) }\n}\n\n/**\n * A complete directory token (`@docs/`, `@\"my dir/\"`): the explorer inserts a\n * finished mention, so the trailing slash sits inside the closing quote.\n * Separators normalize to '/' first (the fs-tree spelling); the spelling\n * itself is {@link mentionFor}'s single job, folder kind — this helper adds no\n * quoting rule of its own.\n */\nexport function directoryMention(relativePath: string): string | undefined {\n  return mentionFor(relativePath.replace(/\\\\/g, '/'), 'folder')?.mention\n}\n\n/**\n * Insert an explorer entry using WorkspaceView.path, selected by exact\n * session membership (the same lookup as the native conversation shell).\n * Read the public workspace snapshot at click time so reconnects and session\n * changes cannot leave a captured root stale. Missing/unready membership or\n * an unrepresentable path is a logged no-op; never guess from session cwd.\n */\nexport function insertWorkspaceReference(ctx: Context, sessionId: string, path: string, isDir: boolean): boolean {\n  try {\n    const snapshot = ctx.get('workspaces')?.list.getSnapshot()\n    const root = snapshot?.phase === 'ready' && snapshot.state === 'idle'\n      ? snapshot.items.find(workspace => workspace.sessionIds.includes(SessionId(sessionId)))?.path\n      : undefined\n    const relative = workspaceRelativePath(root, path)\n    if (relative === undefined) {\n      console.warn('[dsh-better-sidebar] reference insert skipped: workspace root unavailable or path outside workspace')\n      return false\n    }\n    if (isDir) {\n      const mention = directoryMention(relative)\n      if (mention === undefined) {\n        console.warn('[dsh-better-sidebar] reference insert skipped: path cannot be represented as a mention')\n        return false\n      }\n      // The host adds space after a file chip, but not before it. Complete\n      // directory inserts need their own separator for the next @ click.\n      return appendToDraft(ctx, sessionId, `${mention} `)\n    }\n    const file = mentionFor(relative, 'file')\n    if (file === undefined) {\n      console.warn('[dsh-better-sidebar] reference insert skipped: path cannot be represented as a mention')\n      return false\n    }\n    return insertReferenceOrText(ctx, sessionId, {\n      label: file.label,\n      text: file.mention,\n      clipboardText: file.mention,\n      appearance: 'file',\n    })\n  } catch (error) {\n    console.warn('[dsh-better-sidebar] workspace-reference insert failed:', error)\n    return false\n  }\n}\n","/**\n * The floating \"add selection to conversation\" popup shared by the text\n * viewers (markdown preview + the catch-all code viewer): a viewport-anchored\n * button portaled to `document.body`, kept alive across the selection gesture\n * and committed on click.\n *\n * Dismissal contract (fixes upstream issue #425): the popup must never\n * outlive its editor surface. The sidebar keeps every tab MOUNTED — switching\n * tabs only flips the pane cell to `display:none` and collapsing the panel\n * translates it off-screen — while the portaled `position:fixed` button stays\n * pinned to its viewport anchor, ignoring both. The caller already hides on\n * surface scrolls, selection collapse and mode flips; this hook adds the\n * global dismissal that covers everything else:\n *\n * - any `mousedown` outside the button (tab bar, composer, another pane,\n *   the collapse toggle, …) closes it;\n * - `Escape` closes it;\n * - the document going hidden (`visibilitychange`) or the window losing\n *   focus closes it;\n * - an `IntersectionObserver` on the editor surface closes it as soon as the\n *   surface leaves the viewport — the tab-switch (`display:none`) and\n *   panel-collapse (translated off-screen) paths have no DOM events of their\n *   own, so the geometry signal is the only reliable one.\n *\n * The button's own `mousedown` is never treated as an outside click: the\n * caller preventDefaults it to keep the selection/caret alive until the\n * click commits (the hook's capture-phase listener runs first and must not\n * hide for it).\n */\nimport { useEffect, useRef, useState, type RefObject } from 'react'\n\n/**\n * The floating \"add to conversation\" action: payload + viewport anchor.\n * The payload type belongs to the caller; the hook only carries it through.\n */\nexport interface SelectionPopup<T> {\n  insert: T\n  left: number\n  top: number\n}\n\nexport interface SelectionPopupOptions<T> {\n  /** Commit the payload into the composer draft (button click). */\n  onCommit(insert: T): void\n  /**\n   * The DOM surface that must stay on screen for the popup to live: the\n   * markdown preview container in preview mode, the CodeMirror host\n   * otherwise. Called lazily (refs are null until the content loads).\n   */\n  getSurface(): HTMLElement | null\n}\n\nexport interface SelectionPopupControls<T> {\n  /** The current popup (null = hidden). */\n  popup: SelectionPopup<T> | null\n  /** Attach to the portaled button element. */\n  buttonRef: RefObject<HTMLButtonElement>\n  /** Anchor the popup above a selection (viewport-clamped). */\n  show(insert: T, left: number, top: number): void\n  /** Hide the popup (idempotent). */\n  hide(): void\n  /** The button's click: commit the stored payload, then hide. */\n  commit(): void\n}\n\nexport function useSelectionPopup<T>(options: SelectionPopupOptions<T>): SelectionPopupControls<T> {\n  // Latest-callback refs: the dismissal listeners live for the mount's\n  // lifetime, so they must not capture stale closures across renders.\n  const onCommitRef = useRef(options.onCommit)\n  const getSurfaceRef = useRef(options.getSurface)\n  onCommitRef.current = options.onCommit\n  getSurfaceRef.current = options.getSurface\n\n  const [popup, setPopup] = useState<SelectionPopup<T> | null>(null)\n  /** Live mirror for click/event-time reads (no re-render race). */\n  const popupRef = useRef<SelectionPopup<T> | null>(null)\n  /** The portaled button itself (for the outside-click guard). */\n  const buttonRef = useRef<HTMLButtonElement>(null)\n  /** The surface visibility observer (created lazily on open). */\n  const observerRef = useRef<IntersectionObserver | null>(null)\n\n  const show = (insert: T, left: number, top: number): void => {\n    const next: SelectionPopup<T> = {\n      insert,\n      left: Math.min(Math.max(left, 80), window.innerWidth - 80),\n      top,\n    }\n    popupRef.current = next\n    setPopup(next)\n  }\n\n  const hide = (): void => {\n    popupRef.current = null\n    setPopup(null)\n  }\n\n  const commit = (): void => {\n    const current = popupRef.current\n    if (current === null) return\n    onCommitRef.current(current.insert)\n    hide()\n  }\n\n  // Global dismissal listeners, registered once; every handler reads the\n  // live popup ref so it no-ops while no popup is open.\n  useEffect(() => {\n    const onMouseDown = (event: MouseEvent): void => {\n      if (popupRef.current === null) return\n      const button = buttonRef.current\n      if (button !== null && (button === event.target || button.contains(event.target as Node))) return\n      hide()\n    }\n    const onKeyDown = (event: KeyboardEvent): void => {\n      if (event.key === 'Escape' && popupRef.current !== null) hide()\n    }\n    const onVisibilityChange = (): void => {\n      if (document.hidden && popupRef.current !== null) hide()\n    }\n    const onWindowBlur = (): void => {\n      if (popupRef.current !== null) hide()\n    }\n    document.addEventListener('mousedown', onMouseDown, true)\n    document.addEventListener('keydown', onKeyDown, true)\n    document.addEventListener('visibilitychange', onVisibilityChange)\n    window.addEventListener('blur', onWindowBlur)\n    return () => {\n      document.removeEventListener('mousedown', onMouseDown, true)\n      document.removeEventListener('keydown', onKeyDown, true)\n      document.removeEventListener('visibilitychange', onVisibilityChange)\n      window.removeEventListener('blur', onWindowBlur)\n      observerRef.current?.disconnect()\n      observerRef.current = null\n    }\n  }, [])\n\n  // Re-target the visibility observer whenever a popup opens: the surface\n  // refs may have been null at mount (content loads async, mode flips swap\n  // the preview container for the CodeMirror host), so the surface is only\n  // trustworthy at open time. The boolean flip is the only thing that must\n  // re-run this; an anchor move while open keeps the same surface.\n  const popupOpen = popup !== null\n  useEffect(() => {\n    if (!popupOpen) return\n    observerRef.current?.disconnect()\n    observerRef.current = null\n    if (typeof IntersectionObserver === 'undefined') return\n    const surface = getSurfaceRef.current()\n    if (surface === null) return\n    const observer = new IntersectionObserver((entries) => {\n      for (const entry of entries) {\n        if (!entry.isIntersecting) hide()\n      }\n    }, { threshold: 0 })\n    observerRef.current = observer\n    observer.observe(surface)\n  }, [popupOpen])\n\n  return { popup, buttonRef, show, hide, commit }\n}","/**\n * Pure payload builders for the \"add selection to conversation\" popup in the\n * text viewers (markdown preview + the catch-all code viewer). Everything\n * here is string math — no React, no ctx — so the unit tests cover it\n * directly.\n *\n * Insert shape (agreed with the product owner):\n * - Selection ≤ SELECTION_LIMIT characters: a fenced code block whose info\n *   line is `相对路径:起止行` and whose body is the selected text.\n * - Selection over the limit: a single plain-text line `相对路径:起止行`\n *   (no fence, no content).\n * - The path is relative to the session cwd (the same projection the\n *   explorer's @ button uses); an unknown cwd falls back to the absolute\n *   path.\n * - Line numbers: single-line selections write `path:12`, multi-line write\n *   `path:12-15`. The markdown preview cannot map rendered DOM back to\n *   source lines directly, so it reverse-searches the selected text in the\n *   source and only reports lines on an unambiguous hit (see\n *   {@link linesOfSelection}).\n *\n * The two halves travel separately (see {@link PendingReference}).\n */\nimport { relativeTo } from './paths.ts'\nimport type { PendingReference } from './conversation-draft.ts'\n\n/** Max inserted selection length (UTF-16 code units, i.e. JS `.length`). */\nexport const SELECTION_LIMIT = 500\n\n/** The source line span a selection maps to (1-based, inclusive). */\nexport interface SelectionLines {\n  start: number\n  end: number\n}\n\n/**\n * The fence info line: `rel[:start[-end]]` — lines are omitted entirely\n * when unknown (the preview reverse-search missed).\n */\nexport function headerOf(path: string, cwd: string | undefined, lines?: SelectionLines): string {\n  const rel = cwd !== undefined ? relativeTo(cwd, path) : path\n  if (lines === undefined) return rel\n  if (lines.end > lines.start) return `${rel}:${lines.start}-${lines.end}`\n  return `${rel}:${lines.start}`\n}\n\n/**\n * The chip label's identity: `file Lstart[-end]` — the file's basename plus\n * the line span, mirroring the header's line variants (a single line keeps\n * just `Lstart`; unknown lines drop the `L` part). Deliberately NO sequence\n * number: file+lines IS the identity, so deleting a chip from the draft can\n * never leave a numbering gap — the next quote simply names itself again.\n */\nexport function whereOf(path: string, lines?: SelectionLines): string {\n  const file = path.replace(/\\\\/g, '/').split('/').at(-1) ?? path\n  if (lines === undefined) return file\n  if (lines.end > lines.start) return `${file} L${lines.start}-${lines.end}`\n  return `${file} L${lines.start}`\n}\n\n/**\n * The composer payload for one selection: the chip label and the model text.\n * Over the limit the content is dropped and both halves are the plain path\n * line (an empty fenced block would just occupy the draft).\n */\nexport function buildSelectionInsert(\n  path: string,\n  cwd: string | undefined,\n  lines: SelectionLines | undefined,\n  selected: string,\n): PendingReference {\n  const header = headerOf(path, cwd, lines)\n  if (selected.length > SELECTION_LIMIT) return { label: header, text: header }\n  return { label: header, text: `\\`\\`\\`${header}\\n${selected}\\n\\`\\`\\`` }\n}\n\n/** 1-based line number of a character index in a text. */\nfunction lineAt(source: string, index: number): number {\n  let line = 1\n  for (let i = 0; i < index && i < source.length; i++) {\n    if (source[i] === '\\n') line++\n  }\n  return line\n}\n\n/**\n * Reverse-map a rendered-DOM selection back to source line numbers. The\n * preview selection is plain text (block boundaries come out as `\\n`), so\n * this is a best-effort substring search: a single trailing newline is\n * stripped first (DOM block selections tend to carry one), and only an\n * EXACTLY-ONE occurrence yields lines — an ambiguous or missing match\n * returns null (the header then carries the path without line numbers).\n */\nexport function linesOfSelection(source: string, selected: string): SelectionLines | null {\n  const text = selected.endsWith('\\n') ? selected.slice(0, -1) : selected\n  if (text === '') return null\n  const at = source.indexOf(text)\n  if (at === -1) return null\n  if (source.indexOf(text, at + 1) !== -1) return null\n  return {\n    start: lineAt(source, at),\n    end: lineAt(source, at + Math.max(text.length - 1, 0)),\n  }\n}\n","/**\n * The quote chip: \"add to conversation\" on a viewer selection mints a\n * reference chip into the composer draft instead of pasting the fenced text\n * block. The chip reads as `引用 a.md L12-15`, clicking it re-opens the file in\n * the sidebar editor and lands on the quoted lines (with a temporary flash),\n * and sending serializes it back to the same fenced block the pre-chip insert\n * produced — the model sees identical text, byte for byte.\n *\n * Since #1052 the selection popup already inserts a chip through the host's\n * built-in `'reference'` source, whose `ref` IS the payload (the whole fenced\n * block). That chip is inert: the host marks it openable only with an\n * `appearance`, and a click would hand the raw fence to the file opener. What\n * this module adds is the much smaller, source-owned alternative:\n *\n * - The chip's `ref` is a short opaque id ({@link QuoteRecord.id}); the\n *   selection lives in this module's store.\n * - One input-trigger source (`ctx.inputTriggers`, DSH 0.2.1+) owns that\n *   source name: `openReference` answers the click (open the file at the\n *   quoted lines), `codec.serialize` answers send-time expansion. A source\n *   with a `codec` is mandatory for insert outcomes — the host REFUSES a send\n *   whose chip has no serializer rather than silently downgrading it to the\n *   clipboard text.\n * - Records persist in `localStorage` (FIFO, {@link QUOTE_STORE_CAP}): an\n *   unsent draft's chips must stay clickable and serializable across reloads,\n *   and this module ships in BOTH the core bundle and the lazy editor chunk —\n *   two independent module instances whose in-memory maps only see their own\n *   writes, so the shared store is also how they see each other.\n *\n * Degradation: without the input-trigger service (older hosts), before the\n * source registers, or when the record cannot be persisted, {@link\n * insertQuoteChip} reports false and the caller keeps the #1052 behavior — the\n * plain built-in reference chip, or the fenced text on hosts with no chip\n * channel at all. A failed quote insert never leaves a dead chip behind: the\n * record is written BEFORE the chip is inserted, and a store write that does\n * not land (quota, private mode) rolls it back and falls back — the other\n * bundle instance resolves refs through `localStorage`, so an unpersisted\n * record would click into nothing and block the send in the codec. Only a\n * record that PERSISTED and whose source later disappears fails the send\n * loudly (the codec throws), never silently.\n */\nimport type { Context } from '../context-types.ts'\nimport { insertDraftReference, type PendingReference } from './conversation-draft.ts'\nimport { t } from './locales.ts'\nimport { buildSelectionInsert, headerOf, whereOf, type SelectionLines } from './selection-payload.ts'\n\n/** The input-trigger source name the quote chips route by. */\nexport const QUOTE_SOURCE = 'betterSidebarQuote'\n\n/** localStorage key for the quote record store (FIFO, see module doc). */\nexport const QUOTE_STORE_KEY = 'dsh-better-sidebar:quote-refs'\n\n/** Max persisted quote records (the oldest drops first). */\nexport const QUOTE_STORE_CAP = 200\n\n/** Registration retries (× {@link QUOTE_RETRY_MS}) while the host service boots. */\nexport const QUOTE_REGISTER_RETRIES = 20\n\n/** Delay between registration attempts (ms). */\nexport const QUOTE_RETRY_MS = 500\n\n/**\n * The selection a viewer hands over when the popup commits: exactly the facts\n * the fenced insert already encoded, kept structured so the chip can act on\n * them (jump to the lines, re-serialize).\n */\nexport interface QuoteSelection {\n  path: string\n  cwd?: string\n  lines?: SelectionLines\n  text: string\n}\n\n/**\n * One persisted chip: the facts a click-through and a send need.\n *\n * `text` is the payload the model receives, built once at insert time — NOT\n * the raw selection. The raw text is unbounded (a 200-record FIFO of whole\n * selections overflows the localStorage quota), and an unpersisted record is a\n * dead chip in the other bundle instance (see the module doc).\n */\nexport interface QuoteRecord {\n  /** The chip's `ref` — also the store key. */\n  id: string\n  /** The session the chip belongs to (clicks from other sessions refuse). */\n  sessionId: string\n  /** The monotonic chip number (kept across reloads so labels do not collide). */\n  n: number\n  /** The quoted file. */\n  path: string\n  /** The session cwd the header path was relativized with. */\n  cwd?: string\n  /** The quoted source span, when the selection mapped to lines. */\n  lines?: SelectionLines\n  /** The chip's visible text (`引用 a.md L12-15`). */\n  label: string\n  /** What copying the chip yields (the `path:lines` header line). */\n  clipboardText: string\n  /** The fenced block (header only past the limit) `codec.serialize` returns. */\n  text: string\n}\n\n/**\n * The structural face of the host input-trigger service this module needs\n * (`ctx.inputTriggers`, see `context-types.ts`). Declared here so the mirror\n * stays next to its single consumer.\n */\nexport interface SidebarInputTriggerService {\n  registerSource(src: SidebarQuoteSource): () => void\n}\n\n/** The source face (structural mirror of the host's `InputTriggerSource`). */\nexport interface SidebarQuoteSource {\n  trigger: '@'\n  name: string\n  showGroupTitle?: boolean\n  candidates(session: { sessionId: string }, req: object): Promise<readonly unknown[]>\n  onPick(pick: object): unknown\n  openReference?(session: { sessionId: string }, reference: { ref: string; appearance?: string }): boolean\n  codec?: {\n    clipboardText(ref: string): string\n    serialize(ref: string, signal: AbortSignal): Promise<string>\n  }\n}\n\n// ── The record store ────────────────────────────────────────────────────────\n\nconst records = new Map<string, QuoteRecord>()\n/** Monotonic chip numbering; restored from the store so numbers keep growing\n *  across reloads instead of colliding with chips still in old drafts. */\nlet nextN = 1\nlet storeLoaded = false\n\n/**\n * Read the persisted store into memory. Safe to call repeatedly: the merge is\n * idempotent and `nextN` never moves backwards.\n */\nfunction readStoreIntoMemory(): void {\n  try {\n    if (typeof localStorage === 'undefined') return\n    const raw = localStorage.getItem(QUOTE_STORE_KEY)\n    if (raw === null) return\n    const parsed: unknown = JSON.parse(raw)\n    if (!Array.isArray(parsed)) return\n    for (const entry of parsed) {\n      if (!isQuoteRecord(entry)) continue\n      if (!records.has(entry.id)) records.set(entry.id, entry)\n      if (entry.n >= nextN) nextN = entry.n + 1\n    }\n  } catch {\n    // A corrupt store reads as empty — the numbering restart is harmless\n    // (labels repeat, ids stay unique through the random suffix).\n  }\n}\n\n/** First-load wrapper (startup and insert paths). */\nfunction loadStore(): void {\n  if (storeLoaded) return\n  storeLoaded = true\n  readStoreIntoMemory()\n}\n\nfunction isQuoteRecord(value: unknown): value is QuoteRecord {\n  if (typeof value !== 'object' || value === null) return false\n  const record = value as Partial<QuoteRecord>\n  return typeof record.id === 'string'\n    && typeof record.sessionId === 'string'\n    && typeof record.n === 'number'\n    && typeof record.path === 'string'\n    && typeof record.text === 'string'\n    && typeof record.label === 'string'\n    && typeof record.clipboardText === 'string'\n}\n\n/**\n * Persist the store, dropping the oldest records beyond {@link QUOTE_STORE_CAP}.\n * @returns whether the store really reached `localStorage`. `false` means the\n *   record must NOT become a chip: the other module instance (the core bundle\n *   registers the source, the editor chunk inserts) resolves refs through this\n *   store, so an unpersisted record would be a silent dead chip and the codec\n *   would block the send.\n */\nfunction saveStore(): boolean {\n  try {\n    if (typeof localStorage === 'undefined') return false\n    const all = [...records.values()].sort((a, b) => a.n - b.n)\n    const over = Math.max(0, all.length - QUOTE_STORE_CAP)\n    const kept = all.slice(over)\n    // An empty store is no key at all: the first quote (or a rolled-back\n    // record) must not leave an `[]` behind for the next read to interpret.\n    if (kept.length === 0) localStorage.removeItem(QUOTE_STORE_KEY)\n    else localStorage.setItem(QUOTE_STORE_KEY, JSON.stringify(kept))\n    // Evict from MEMORY only after the write landed: a failed write must not\n    // cost this page records it could still resolve.\n    if (over > 0) for (const dropped of all.slice(0, over)) records.delete(dropped.id)\n    return true\n  } catch {\n    // Private mode / quota: report it so the caller falls back instead of\n    // minting a chip no other module instance can resolve.\n    return false\n  }\n}\n\n/** The chip's `ref` — unique across reloads via the number plus a random suffix. */\nfunction quoteId(n: number): string {\n  return `q${n}-${Math.random().toString(36).slice(2, 6)}`\n}\n\n/**\n * Resolve one quote record by chip `ref`. The persisted store is re-read on\n * every resolve: the record may have been written by the other bundle\n * instance, whose in-memory map this instance never sees directly.\n * @param ref - the chip's reference id.\n * @returns the record, or `undefined` when it is not (or no longer) stored.\n */\nexport function resolveQuote(ref: string): QuoteRecord | undefined {\n  loadStore()\n  readStoreIntoMemory()\n  return records.get(ref)\n}\n\n// ── The source ──────────────────────────────────────────────────────────────\n\n/** Build the source object the host registers (one per module instance). */\nfunction createQuoteSource(ctx: Context): SidebarQuoteSource {\n  return {\n    trigger: '@',\n    name: QUOTE_SOURCE,\n    // No @-menu participation: the candidates stay empty so the composer's\n    // picker never lists this group; the source only answers chips.\n    showGroupTitle: false,\n    candidates: () => Promise.resolve([]),\n    onPick: () => 'handled',\n    openReference: (session, reference) => {\n      try {\n        const record = resolveQuote(reference.ref)\n        if (record === undefined || record.sessionId !== session.sessionId) return false\n        ctx.betterSidebar.openFile(\n          { sessionId: session.sessionId, ...(record.cwd === undefined ? {} : { cwd: record.cwd }) },\n          record.path,\n          undefined,\n          record.lines === undefined ? undefined : { line: record.lines.start, lineEnd: record.lines.end },\n        )\n        return true\n      } catch (error) {\n        // A dead ctx (dev hot reload) degrades to the host's own gesture.\n        console.warn('[dsh-better-sidebar] quote open failed:', error)\n        return false\n      }\n    },\n    codec: {\n      clipboardText: ref => resolveQuote(ref)?.clipboardText ?? ref,\n      serialize: async (ref) => {\n        const record = resolveQuote(ref)\n        if (record === undefined) {\n          // Never a silent downgrade: the host blocks the submission instead,\n          // so a dropped record surfaces as an error rather than a wrong text.\n          throw new Error(`[dsh-better-sidebar] quote reference \"${ref}\" is no longer available`)\n        }\n        // The payload was built and size-reduced at insert time (see\n        // `QuoteRecord.text`): no raw selection round-trips through storage.\n        return record.text\n      },\n    },\n  }\n}\n\n// ── Registration (startup) ──────────────────────────────────────────────────\n\n/** Whether a quote source is live (ours or the other bundle instance's). */\nlet sourceReady = false\n/** The disposer of the source THIS instance registered. `undefined` while the\n *  live source is BORROWED (the other module instance owns it — duplicate\n *  registration is a real error in the host, see `tryRegisterOnce`). */\nlet registeredDisposer: (() => void) | undefined\n/** Whether the live source is the other instance's (readiness is a borrow,\n *  and every commit re-probes for the moment that owner releases it). */\nlet borrowed = false\n\n/**\n * One synchronous registration attempt. Duplicate tolerance here is about the\n * BORROWED case, not about calling `registerSource` twice: this module ships\n * in both the core bundle and the editor chunk (two independent module\n * instances), so the host's \"already registered\" error usually means the other\n * instance owns the live source — inserts and click routing work identically\n * either way. But the borrowing instance holds no disposer, so it cannot learn\n * when that owner unregisters (a fiber disposal does not reach it): readiness\n * is therefore re-probed on every commit that does not own the source, and a\n * released slot is taken over instead of leaving a dead chip behind. Every\n * outcome logs; nothing stays silent.\n */\nfunction tryRegisterOnce(ctx: Context): boolean {\n  if (sourceReady && registeredDisposer !== undefined) return true\n  try {\n    const triggers = ctx.get('inputTriggers') as SidebarInputTriggerService | undefined\n    if (triggers === undefined) return false\n    registeredDisposer = triggers.registerSource(createQuoteSource(ctx))\n    sourceReady = true\n    borrowed = false\n    // Positive proof the chip build is live (a silent feature-off reads\n    // exactly like a stale bundle served by the host).\n    console.info('[dsh-better-sidebar] quote chips ready')\n    return true\n  } catch (error) {\n    // The host message (ui-input-trigger service) is `slash source\n    // \"@betterSidebarQuote\" is already registered`; match both that wording\n    // and a generic \"duplicate\" so an upstream rewording cannot silently\n    // turn \"already live\" into a permanent fallback.\n    if (error instanceof Error && /already registered|duplicate/i.test(error.message)) {\n      sourceReady = true\n      // Log the TRANSITION only: a borrowed instance re-probes on every\n      // commit, and a log line per selection would drown the console.\n      if (!borrowed) {\n        borrowed = true\n        console.info('[dsh-better-sidebar] quote chips ready (source already registered by the other bundle instance)')\n      }\n      return true\n    }\n    console.warn('[dsh-better-sidebar] quote source registration failed:', error)\n    return false\n  }\n}\n\n/**\n * Register the quote-chip input-trigger source once the host service shows up,\n * retrying briefly because the plugin's apply can run before the host package\n * provides the service. Returns the disposer (idempotent). A commit that finds\n * the source unregistered re-attempts on the spot (see\n * {@link insertQuoteChip}) — the self-heal covers fiber disposals (session\n * switch, socket reconnect, HMR) that never get a re-apply.\n * @param ctx - the client context.\n * @returns the disposer.\n */\nexport function registerQuoteSource(ctx: Context): () => void {\n  let retries = 0\n  let timer: ReturnType<typeof setTimeout> | undefined\n  let disposed = false\n  const attempt = (): void => {\n    if (disposed) return\n    if (tryRegisterOnce(ctx)) return\n    if (++retries > QUOTE_REGISTER_RETRIES) {\n      console.info('[dsh-better-sidebar] quote chips unavailable: no input-trigger service')\n      return\n    }\n    timer = setTimeout(attempt, QUOTE_RETRY_MS)\n  }\n  attempt()\n  return () => {\n    disposed = true\n    if (timer !== undefined) clearTimeout(timer)\n    if (registeredDisposer !== undefined) {\n      sourceReady = false\n      registeredDisposer()\n      registeredDisposer = undefined\n      console.info('[dsh-better-sidebar] quote source unregistered (fiber disposed; the next commit re-registers)')\n    }\n  }\n}\n\n/** Whether this module instance currently owns a registered quote source. */\nexport function quoteSourceReady(): boolean {\n  return sourceReady\n}\n\n// ── Insert (popup commit) ───────────────────────────────────────────────────\n\n/**\n * The legacy direct insert for one selection — the text #1052's chip carries,\n * and what lands in the draft when chips are unavailable.\n * @param sel - the selection.\n * @returns the fenced block (or the bare header line when over the limit).\n */\nexport function quoteFallbackInsert(sel: QuoteSelection): string {\n  return buildSelectionInsert(sel.path, sel.cwd, sel.lines, sel.text).text\n}\n\n/**\n * Register the selection as a quote record and insert its chip into the\n * session's composer draft. Returns false — leaving the draft untouched —\n * when chips are unavailable, the record cannot be persisted (quota / private\n * mode), or the host refuses the insert; the caller then falls back to\n * {@link quoteFallbackInsert}.\n * @param ctx - the client context.\n * @param sessionId - the session whose composer receives the chip.\n * @param sel - the selection the viewer's popup committed.\n * @returns whether the chip landed in the draft.\n */\nexport function insertQuoteChip(ctx: Context, sessionId: string, sel: QuoteSelection): boolean {\n  if (!sourceReady || registeredDisposer === undefined) {\n    // Self-heal, and the reason registration state lives in module scope\n    // rather than the apply closure: THIS instance (the one the editor's\n    // commit actually calls) may never have gone through apply, and a fiber\n    // disposal unregisters without a re-apply. Registering here fixes both —\n    // whichever instance wins, the source closures are equivalent.\n    //\n    // `registeredDisposer === undefined` also covers the BORROWED source: we\n    // hold no disposer, so re-probe — the owner may have released the slot,\n    // and a readiness flag with no owner is exactly how chips turn dead.\n    if (!sourceReady) console.info('[dsh-better-sidebar] quote source not ready at commit, re-registering')\n    if (!tryRegisterOnce(ctx)) {\n      console.info('[dsh-better-sidebar] quote chips unavailable: source not registered')\n      return false\n    }\n  }\n  loadStore()\n  // `saveStore` rewrites the whole key from this instance's memory, and other\n  // pages of the origin write the same key: merge their records in first, or\n  // the write erases them and their chips block the send in the codec.\n  readStoreIntoMemory()\n  const n = nextN++\n  const clipboardText = headerOf(sel.path, sel.cwd, sel.lines)\n  // Built ONCE and kept in its size-reduced form (a raw selection is\n  // unbounded storage); the chip's fallback text and the send-time payload are\n  // the same bytes the pre-chip insert produced.\n  const insert = buildSelectionInsert(sel.path, sel.cwd, sel.lines, sel.text)\n  const record: QuoteRecord = {\n    id: quoteId(n),\n    sessionId,\n    n,\n    path: sel.path,\n    ...(sel.cwd === undefined ? {} : { cwd: sel.cwd }),\n    ...(sel.lines === undefined ? {} : { lines: sel.lines }),\n    label: t('quoteChip', { where: whereOf(sel.path, sel.lines) }),\n    clipboardText,\n    text: insert.text,\n  }\n  const reference: PendingReference = {\n    source: QUOTE_SOURCE,\n    ref: record.id,\n    label: record.label,\n    appearance: 'file',\n    clipboardText,\n    // Not what the chip carries (`ref` is the id, and the codec expands it on\n    // send), but the plain-text form an ordinary path would fall back to —\n    // and the fenced block itself, so a chip that cannot land still yields\n    // the same payload as the pre-chip insert.\n    text: insert.text,\n  }\n  records.set(record.id, record)\n  if (!saveStore()) {\n    // No persisted record = no chip: the core bundle resolves refs through\n    // localStorage, so a chip whose record never landed would click into\n    // nothing and block the send in the codec. The caller falls back to\n    // #1052's built-in chip (same payload, just not clickable).\n    records.delete(record.id)\n    console.warn('[dsh-better-sidebar] quote chip skipped: the reference store cannot be written (quota/private mode)')\n    return false\n  }\n  const landed = insertDraftReference(ctx, sessionId, reference)\n  if (!landed) {\n    // The record is not referenced by any draft, so drop it rather than leak\n    // an id: the caller's fallback insert carries the same payload.\n    records.delete(record.id)\n    saveStore()\n  }\n  return landed\n}\n","/**\n * Markdown/mermaid fence detection for the markdown preview. The preview\n * renders the WHOLE document through one DSH `MarkdownText` pass (so\n * cross-fence semantics — reference-style links, footnotes, list\n * continuity — stay intact) and the mermaid lazy chunk then swaps the\n * rendered `language-mermaid` code blocks for diagrams. This module's pure\n * splitter exists to detect whether the source contains a mermaid fence at\n * all, so the mermaid chunk is only fetched when needed (unit-tested in\n * tests/mermaid-blocks.spec.ts).\n */\n\nimport type { MarkdownCopyLabels } from './markdown-labels.tsx'\nimport type { MarkdownPathImages } from '@deepseek-ai/dsh-client-ui-primitives'\n\n/** One fenced mermaid diagram lifted out of the markdown source. */\nexport interface MermaidBlock {\n  kind: 'mermaid'\n  /** The raw diagram source between the fences (info string stripped). */\n  code: string\n}\n\n/** A span of plain markdown source (may itself contain non-mermaid fences). */\nexport interface MarkdownBlock {\n  kind: 'markdown'\n  text: string\n}\n\nexport type MdBlock = MarkdownBlock | MermaidBlock\n\n/** Props of the chunk-resident `MermaidMarkdown` component (shared contract). */\nexport interface MermaidMarkdownProps {\n  /** The full markdown source (rendered in a single MarkdownText pass). */\n  text: string\n  codeLabels: MarkdownCopyLabels\n  /** The owner's local-path image vocabulary for the same pass. */\n  pathImages?: MarkdownPathImages | undefined\n}\n\n/** CommonMark opening fence: 0-3 spaces indent + a run of 3+ backticks or tildes. */\nexport const OPEN_FENCE_RE = /^ {0,3}(`{3,}|~{3,})/\n\n/** A closing-fence line: 0-3 spaces indent + 3+ backticks/tildes + trailing\n *  spaces only. The optional `\\r` is a CRLF line's terminator, not content: a\n *  CRLF document reaches this regex with its line endings intact, and without\n *  the `\\r` no fence would ever close (the block would swallow the rest of the\n *  file). */\nexport const CLOSE_FENCE_RE = /^ {0,3}(`{3,}|~{3,})[ \\t]*\\r?$/\n\n/** Parse the info string from the line tail after the fence run; null when invalid. */\nexport function fenceInfo(rest: string, fence: string): string | null {\n  const info = rest.trimStart().split(/\\s+/)[0] ?? ''\n  // CommonMark: a backtick fence's info string may not contain backticks —\n  // such a line is not an opening fence at all.\n  if (fence.charAt(0) === '`' && info.includes('`')) return null\n  return info\n}\n\n/** True when the fence info string names mermaid (bare or `mermaid{...}`). */\nfunction isMermaidInfo(info: string): boolean {\n  const word = info.toLowerCase()\n  return word === 'mermaid' || word.startsWith('mermaid{')\n}\n\n/**\n * Split markdown source into md/mermaid blocks for detection: only fences\n * whose info string names mermaid are lifted; every other line stays in the\n * markdown stream untouched. CommonMark fence rules are honored — opening\n * fences of 3+ backticks OR tildes, and a closing fence must use the same\n * character with at least as many characters as the opening fence. An\n * unterminated mermaid fence swallows the rest of the file (the same\n * recovery CommonMark applies to open fences).\n */\nexport function splitMermaidBlocks(text: string): MdBlock[] {\n  if (text === '') return []\n  const lines = text.split('\\n')\n  const blocks: MdBlock[] = []\n  let markdown: string[] = []\n  let index = 0\n  const flushMarkdown = (): void => {\n    if (markdown.length === 0) return\n    blocks.push({ kind: 'markdown', text: markdown.join('\\n') })\n    markdown = []\n  }\n  while (index < lines.length) {\n    const line = lines[index] ?? ''\n    const fenceMatch = OPEN_FENCE_RE.exec(line)\n    if (fenceMatch === null) {\n      markdown.push(line)\n      index += 1\n      continue\n    }\n    const fence = fenceMatch[1]!\n    // The line tail after the whole matched prefix (indent + fence run).\n    const rest = line.slice(fenceMatch.index + fenceMatch[0].length)\n    const info = fenceInfo(rest, fence)\n    if (info === null || !isMermaidInfo(info)) {\n      markdown.push(line)\n      index += 1\n      continue\n    }\n    flushMarkdown()\n    const char = fence.charAt(0)\n    const length = fence.length\n    const code: string[] = []\n    index += 1\n    while (index < lines.length) {\n      const candidate = lines[index] ?? ''\n      const close = CLOSE_FENCE_RE.exec(candidate)\n      if (close !== null && close[1]!.charAt(0) === char && close[1]!.length >= length) break\n      code.push(candidate)\n      index += 1\n    }\n    // Consume the closing fence (or run off the end on an open fence).\n    index += 1\n    blocks.push({ kind: 'mermaid', code: code.join('\\n') })\n  }\n  flushMarkdown()\n  return blocks\n}\n","/**\n * Raw-HTML block detection for the markdown preview. The shared `MarkdownText`\n * renders raw HTML as literal text (a chat-security stance), so a GitHub-style\n * README (`<div align=\"center\">` badge walls, `<details>` collapsibles with\n * markdown inside, table cells full of inline tags) previews as source soup.\n * This module's pure splitter lifts those HTML runs OUT of the markdown stream\n * before rendering: markdown runs keep flowing through `MarkdownText` (shiki /\n * KaTeX / GFM intact, mermaid chunk path unchanged) while HTML runs render as\n * sanitized DOM (see markdown-html.tsx).\n *\n * Splitting follows CommonMark's shape closely enough for real-world READMEs:\n * a line outside code fences that starts with a block-level tag (type-6 list\n * below) or `<!--` opens an HTML run that extends to the next blank line\n * (comments end at the line containing `-->`). Inline-only tags (`<b>`, `<br>`,\n * `<a>`…) never open a run — they stay in the markdown stream and are handled\n * by the inline pass instead. Unclosed block tags (`<details>` … markdown …\n * `</details>`) are surfaced by {@link analyzeHtmlSegment} as ordered parts so\n * the renderer can nest the in-between markdown inside the open element, the\n * way GitHub's linear HTML output nests.\n */\n\nimport { CLOSE_FENCE_RE, OPEN_FENCE_RE, fenceInfo } from './mermaid-blocks.ts'\n\n/** A run of raw HTML lines lifted out of the markdown stream. */\nexport interface HtmlSegment {\n  kind: 'html'\n  text: string\n}\n\n/** A run of markdown source (may contain non-mermaid fences, inline HTML…). */\nexport interface MarkdownHtmlSegment {\n  kind: 'markdown'\n  text: string\n}\n\nexport type MdHtmlSegment = MarkdownHtmlSegment | HtmlSegment\n\n/** The doc-wide analysis the preview consumes (all pure, unit-tested here). */\nexport interface AnalyzedMarkdownHtml {\n  /** The document split into markdown / html runs (empty input → []). */\n  segments: MdHtmlSegment[]\n  /** True when at least one html run was lifted out. */\n  hasBlockHtml: boolean\n  /** True when the source contains any tag-like text (block OR inline). */\n  hasInlineHtml: boolean\n  /** Every reference definition found in the markdown runs (`[label]: dest`\n   *  lines), joined — appended to each markdown run so `[text][id]` keeps\n   *  resolving across the lifted HTML runs (first-match wins makes the\n   *  appended copy inert inside runs that already define it). */\n  referenceDefinitions: string\n}\n\n/**\n * CommonMark HTML-block type-6 tag names (block-level elements), lowercased.\n * A line starting with one of these (open or close) outside a fence begins an\n * HTML run. `<summary>` is CommonMark-inline but intentionally included: it is\n * the idiomatic first child of a `<details>` run in GitHub-flavored READMEs.\n */\nexport const HTML_BLOCK_TAGS: ReadonlySet<string> = new Set([\n  'address', 'article', 'aside', 'base', 'basefont', 'blockquote', 'body',\n  'capti