eamTaskCreate: 'Neue Aufgabe',\n  teamTaskSubject: 'Titel',\n  teamTaskDescription: 'Beschreibung',\n  teamTaskOwner: 'Verantwortlich',\n  teamTaskUnowned: 'Nicht übernommen',\n  teamTaskPending: 'Offen',\n  teamTaskInProgress: 'In Arbeit',\n  teamTaskCompleted: 'Abgeschlossen',\n  teamTaskBlocked: 'Blockiert',\n  teamTaskClaim: 'Claim',\n  teamTaskComplete: 'Abschließen',\n  teamTaskReopen: 'Wieder öffnen',\n  teamTaskDelete: 'Löschen',\n  teamTaskDeleteConfirm: 'Löschen bestätigen',\n  teamTaskEdit: 'Bearbeiten',\n  teamTaskSave: 'Speichern',\n  teamTaskCancel: 'Abbrechen',\n  teamTaskConflict: 'Die Aufgabe wurde anderweitig geändert; aktualisiert',\n  teamTaskError: 'Vorgang fehlgeschlagen: {message}',\n  teamTaskDeleted: 'Gelöscht',\n  teamTaskActions: 'Aufgabenaktionen',\n  teamTaskDetail: 'Aufgabendetails',\n  teamTaskNoDescription: 'Noch keine Beschreibung – über „Bearbeiten“ ergänzen',\n  teamTaskBlockedBy: 'Blockiert durch',\n  teamTaskSubjectPlaceholder: 'Eine Zeile, die die Arbeit beschreibt',\n  teamTaskDescriptionPlaceholder: 'Zusätzliche Details (optional)',\n  teamFilterAll: 'Alle',\n  tasksNodeTasks: 'Geteilte Aufgaben',\n  jobCopyOutput: 'Ausgabe kopieren',\n  jobCopied: 'Kopiert',\n  jobFollowTail: 'Neuestes verfolgen',\n  jobDragHint: 'Zum Verschieben ziehen',\n  workflowRunning: 'Läuft',\n  workflowCompleted: 'Abgeschlossen',\n  workflowCancelled: 'Abgebrochen',\n  workflowFailed: 'Fehlgeschlagen',\n  workflowPhaseUnnamed: 'Unbenannte Phase',\n  workflowMembers: '{done}/{total} Mitglieder',\n  jobsAutoCollapsed: 'Automatisch eingeklappt (viele Agenten)',\n  contextDiagnostics: 'Kontext-Diagnose',\n  contextDiagnosticsTarget: 'Aktuelle Sitzung',\n  contextDiagnosticsFailed: 'Kontext-Diagnose für „{label}“ konnte nicht geöffnet werden',\n  contextDiagnosticsUnavailable: 'Die Seite „Kontext“ von dsh-context ist nicht verfügbar (nicht installiert oder nicht registriert)',\n  contextDiagnosticsNavigation: 'Diese Unterhaltung konnte nicht gefunden werden',\n  contextDiagnosticsTimeout: 'Zeitüberschreitung beim Öffnen – bitte erneut versuchen',\n  contextDiagnosticsOpenFailed: 'Die Seite konnte nicht geöffnet werden',\n  contextDiagnosticsDismiss: 'Schließen',\n  catalogLoadFailed: '{count} Branches konnten nicht geladen werden',\n  addPluginsTabCard: 'Tab-Plugins hinzufügen',\n  addPluginsTabCardDesc: 'Eine neue Seitenleisten-Seite registrieren',\n  addPluginsViewerCard: 'Vorschau-Plugins hinzufügen',\n  addPluginsViewerCardDesc: 'Eine Dateityp-Vorschau registrieren',\n  addPluginsTabDesc: 'Seitenleisten-Seiten (Tabs) können durch Plugins erweitert werden. Plugins registrieren sich über den ctx.betterSidebar-Dienst; ein Klick auf „Installieren“ kopiert den Installationsbefehl – fügen Sie ihn in einem Terminal ein, in dem Ihr DSH-Profil liegt, und führen Sie ihn aus.',\n  addPluginsViewerDesc: 'Datei-Viewer können durch Plugins erweitert werden. Plugins registrieren sich über den ctx.betterSidebar-Dienst; ein Klick auf „Installieren“ kopiert den Installationsbefehl – fügen Sie ihn in einem Terminal ein, in dem Ihr DSH-Profil liegt, und führen Sie ihn aus.',\n  addPluginsBrowseMore: 'Weitere Plugins auf GitHub durchsuchen (Topic: dsh-better-sidebar)',\n  addPluginsSearch: 'Nach Plugin-Name oder -Beschreibung suchen…',\n  addPluginsNoMatch: 'Keine passenden Plugins',\n  addPluginsRecommended: 'Empfohlene Plugins',\n  addPluginsEmpty: 'Noch keine Plugins katalogisiert – veröffentlichen Sie Ihre Plugin unter dem GitHub-Topic',\n  openPlugin: 'Öffnen',\n  copyInstall: 'Installationsbefehl kopieren',\n  pluginOfficeDesc: 'Office-Suite-Vorschau (.docx / .xlsx / .pptx) für den better-sidebar-Editor, die die schweren Office-Render-Bibliotheken aus dem Kernbundle heraushält',\n  pluginFlowglassDesc: 'Live-Sitzungsflussdiagramm: dreispurige Darstellung von Benutzer, Assistent und Werkzeugaufrufen mit parallelen Gruppen, Subagent-Zweigen, Drill-down und Live-Status; registriert bei installiertem better-sidebar einen nativen „Flowglass“-Tab und behält sonst eine eigenständige Schublade',\n  pluginGitForgeDesc: '„Git-Anmeldedaten“-Tab: Konto-Bibliothek für Forges wie GitHub/Gitea + projektbezogene Freigaben + harte Push-Richtlinie; Tokens liegen nur in lokalen Secrets, nie im Modellkontext; bietet ein schreibgeschütztes GitForge-Werkzeug und einen HTTPS-Credential-Helper für den Agenten',\n  pluginGithubWorkbenchDesc: '„GitHub Workbench“-Tab: Repository-Baum + Issues / Pull requests / Actions mit vollen Schreibrechten — Issue/PR erstellen, kommentieren, bearbeiten, schließen/wieder öffnen, squash·merge·rebase-Merge (mit starker Bestätigung), CI erneut ausführen/abbrechen; der Repo-Umschalter listet automatisch zugreifbare Repos auf und durchsucht öffentliche; ohne better-sidebar fällt er auf ein eigenständiges rechtes Panel zurück',\n  pluginIdeGitDesc: 'Git-Tab für better-sidebar: Branch-Baum (ahead/behind-Badges, Worktree-Markierung), Commit-Graph mit Text-/Branch-/Autor-/Datums-/Pfad-Filtern, Zeilen-Diff pro Datei, Änderungsliste und Commit-Feld, dazu Merge, Rebase, Cherry-Pick, Reset, Stash und Tags; zerstörende Aktionen fragen nach, Löschen und Verwerfen sind umkehrbar. Ohne better-sidebar registriert es sich in der nativen rechten DSH-Seitenleiste und funktioniert allein',\n  pluginAgentPersonaDesc: 'System-Prompt-Personas je Arbeitsbereich oder Sitzung: Eine Persona kann mehrere Arbeitsbereich-Verzeichnisse und mehrere Sitzungen abdecken; Abgleich exakt, per Präfix, als Teilstring oder per Regex – die spezifischste gewinnt, und eine Persona kann als Standard gesetzt werden; verwaltet über eine Einstellungsseite und einen „Persona“-Tab der Konversation, wirksam ab der nächsten Nachricht',\n  pluginMdExportDesc: 'Fügt einen „Export\"-Button zur Markdown-Symbolleiste in better-sidebar hinzu: rendert die aktuelle .md per Klick in eigenständiges HTML (Tabellen/Codeblöcke/Mermaid-Diagramme inline, Layout folgt dem Vorschau-Theme) und speichert es neben der .md, oder exportiert über den Druckdialog als PDF',\n  pluginCodeNavDesc: 'Code-Vorschau-Navigation: erkennt die Sprache am Dateityp und hebt die Syntax hervor, Symbol-Gliederung (Filter für Klassen/Methoden/Variablen + Sprung mit einem Klick) und Suche in der Datei (alle Treffer hervorgehoben, vor/zurück, Groß-/Kleinschreibung) — übernimmt die Code-Dateivorschau im better-sidebar-Editor',\n  pluginSuhuangScrollDesc: 'Verbindet die lokale Suhuang Scroll Runtime mit den DSH-Einstellungen und better-sidebar für Modellkonfiguration, Verbindungstests und fortlaufende Bewertung; benötigt Suhuang Scroll Runtime und dsh-better-sidebar',\n  pluginBetterOverleafDesc: 'Overleaf-Tab für better-sidebar: Login direkt über CDP-Browser (Chromium von Drittanbietern unterstützt), Projekliste/-wechsel, lokale git-Spiegel unter <workspace>/overleaf/, bidirektionaler git-Abgleich mit Read-only-API-Fallback und Dateivorschau über die Sidebar-Workbench',\n  pluginSentinelDesc: 'Bedingungsgesteuertes Wecksystem für Agenten: Datei-/Prozess-/Port-/HTTP-/Befehls-/Webhook-Sensoren wecken ruhende Sitzungen, wenn Bedingungen zutreffen; registriert einen „Sentinel“-Tab mit der serverweiten Überwachungstabelle',\n  pluginServerDeckDesc: 'Server-Karten-Dashboard: eine Karte pro Host mit Onlinestatus, OS, Uptime sowie CPU-/RAM-/Festplattenauslastung und Latenz; ein Klick öffnet ein interaktives xterm.js-Terminal; ~/.ssh/config-Import mit einem Klick (Git-Hosting-Aliase werden übersprungen). Registriert einen nativen „Server“-Tab bei installiertem better-sidebar, sonst bleibt der eigenständige Drawer erhalten',\n  pluginSidebarQaDesc: 'Auswählen-und-Fragen mit Tab-Aufteilung: Text in der Unterhaltung auswählen → rechts im Panel fragen → eine eigene Folgesitzung (❓Nachfrage) im selben Arbeitsbereich; ein schnelles Modell ohne Denkvorgang komprimiert den Hauptkontext und spielt ihn samt Zitat ein, ohne die Hauptunterhaltung zu unterbrechen. Nachfragen lassen sich verschachteln, fortsetzen und archivieren',\n  pluginSidenoteDesc: 'Side-Chat im Codex-Stil + Auswahl-Annotationen: die aktuelle Sitzung per fork in ein dauerhaftes Seiten-Panel auslagern (aus der Sitzungsliste archiviert, mehrere Instanzen gleichzeitig, /side-Befehl, übersteht Neuladen, das Modell folgt der Haupt-Sitzung); assistant-Text markieren → nummeriertes Badge + Annotation-Editor → ein \"N Annotationen\"-Chip wird mit der nächsten Nachricht mitgesendet, oder direkt im Side-Chat fragen',\n  pluginSshTunnelDesc: '„SSH-Tunnel“-Tab: Multi-Host-Inventar + projektbezogene Freigaben + lokale Schlüsselverwahrung; Modellwerkzeug SSHManager (exec/SFTP/Sitzungsstrategien); zentrales interaktives Terminal und zweispaltiges SFTP',\n  pluginVideoPreviewDesc: 'Inline-Videovorschau (.mp4/.webm/.mov/.mkv/.avi usw.) für den better-sidebar-Editor, gestützt auf eine eigene /video-Hostroute mit HTTP-Range-Unterstützung (206) – der Fortschrittsbalken ist ziehbar und die Wiedergabe startet, bevor die ganze Datei geladen ist',\n  pluginAudioDesc: 'Audiodateien (.mp3/.wav/.flac/.ogg/.m4a/.aac/.opus) direkt im better-sidebar-Editor ansehen: zoombarer Wellenform-Player (Klicken/Ziehen zum Spulen, A-B-Schleife, Kanalwechsel), Live-Spektrum und Spektrogramm der ganzen Datei — die eigene Medienroute unterstützt HTTP Range, also in jeder Größe spulbar',\n  pluginDevGitGraphDesc: 'A faithful vscode-git-graph port as a sidebar tab: the only entry is a native better-sidebar tab, auto-bound to the session workspace, full git operations (checkout/merge/rebase/push/tag/stash), light/dark theming, file diffs open in the built-in DiffTab; requires dsh-better-sidebar',\n  pluginDocsPanelDesc: '„Globale Dokumente“ in der DSH-Seitenleiste: eigene Markdown-Notizen aus jedem Arbeitsbereich lesen – Dateiliste, Gliederung, Öffnen in Chrome / VS Code und Kopieren-Buttons; das Dokumentenverzeichnis ist konfigurierbar (Standard ~/.dsh/docs)',\n  pluginTylinaDesc: 'Typst-Dokumenteditor mit gemeinsamem Arbeitsbereich der aktuellen Sitzung: WYSIWYG-Satz für Typst-Dokumente, geeignet zum Schreiben und Setzen von Arbeiten, Berichten, Klausuren, Lebensläufen, Diagrammen, Postern, Notensätzen und als PPTX exportierbaren Folien',\n  pluginEgoBrowserDesc: 'Der Agent-Browser für DeepSeek Harness: 32 ego_*-Tools steuern ein echtes Chromium; ein nativer „ego-Browser“-Tab in der Seitenleiste zeigt live jede Seite, die der Agent besucht – Klicken, Ziehen und Tippen zum Übernehmen. Registriert den Tab automatisch, wenn better-sidebar vorhanden ist, sonst eine schwebende Blase',\n  pluginBilingualReaderDesc: 'PDFs im DSH-Seitenbereich lesen: native PDF-Anzeige, Text auswählen und mit dem LLM übersetzen — mit Kontext, vollständig vom Hauptgespräch isoliert',\n  changesRedactOn: \"Schwärzung aktiv: Geheimnisse als [REDACTED]; Klicken zum Deaktivieren (auf eigenes Risiko)\",\n  changesRedactOff: \"Schwärzung aus: Inhalte werden unverändert angezeigt; Klicken zum Aktivieren\",\n  changesRedactOnLabel: \"Schwärzung\",\n  changesRedactOffLabel: \"Ohne Schwärzung\",\n  changesRedactBanner: \"Geschwärzt\",\n  pluginAgentPersonaName: 'dsh-agent-persona Personas',\n  pluginSentinelName: 'dsh-sentinel Wecksystem',\n  pluginFileTraceName: 'dsh-file-trace Dateiverfolgung',\n  pluginFileTraceDesc: 'Zeichnet jede Datei auf, die das Modell liest, schreibt oder bearbeitet; gruppierte Liste mit Inhalten und Zeilen-Diffs, Markdown-Lesemodus und Geheimnis-Maskierung; ohne better-sidebar eigenständiges schwebendes Fenster',\n  pluginMnemeName: 'dsh-mneme Gedächtnisbibliothek',\n  pluginMnemeDesc: 'Sitzungsübergreifende Gedächtnis-Engine: autoDream-Konsolidierung im Hintergrund, Sitzungszusammenfassungen und Benutzerprofil; SQLite + von Hand bearbeitbare Markdown-Spiegel, vollständig offline und privat. Registriert einen „Gedächtnisbibliothek“-Tab (Ansichten für Erinnerungen/Entitäten/Status/Einstellungen), wenn better-sidebar vorhanden ist, und behält sonst sein eigenständiges Sidebar-Panel als Fallback',\n  pluginEgoBrowserName: 'ego-browser Agent-Browser',\n  pluginBetterOverleafName: 'dsh-better-overleaf Overleaf-Tab',\n  pluginDocsPanelName: 'dsh-docs-panel Globale Dokumente',\n  pluginTylinaName: 'dsh-tylina Typst-Dokumenteditor',\n  pluginFlowglassName: 'dsh-flowglass Flowglass',\n  pluginGitForgeName: 'dsh-git-forge Git-Zugangsdaten',\n  pluginGithubWorkbenchName: 'dsh-github-workbench GitHub-Workbench',\n  pluginIdeGitName: 'dsh-ide-git Git-Fenster',\n  pluginSidebarQaName: 'dsh-sidebar-qa Auswählen & Fragen',\n  pluginSidenoteName: 'dsh-sidenote Seiten-Chat',\n  pluginServerDeckName: 'dsh-server-deck Server-Deck',\n  pluginSuhuangScrollName: 'dsh-suhuang-scroll Suhuang Scroll',\n  pluginSshTunnelName: 'dsh-ssh-tunnel SSH-Tunnel',\n  pluginBilingualReaderName: 'dsh-bilingual-reader Zweisprachiger Reader',\n  pluginOfficeName: 'Office-Vorschau',\n  pluginMdExportName: 'Markdown-Export',\n  pluginCodeNavName: 'Code-Vorschau-Navigation',\n  pluginVideoPreviewName: 'Video-Vorschau',\n  pluginAudioName: 'Audio-Vorschau',\n  pluginTurnOutlineName: \"dsh-turn-outline Runden-Gliederung\",\n  pluginTurnOutlineDesc: \"Faltet die Sitzung in Benutzerrunden (Eingabe + Tool-Schritte + Ausgabe); Klick auf einen Schritt springt an die genaue Stelle im Gespräch — ohne LLM, nur lesend\",\n  pluginDshMemoryDeltaName: 'dsh-memory-delta Gedächtnis',\n  pluginDshMemoryDeltaDesc: 'Sitzungsübergreifendes Gedächtnis: nur Änderungen werden injiziert (nichts, wenn sich nichts geändert hat), mit Erinnerung an den Prüftermin, Relevanz-Suche und Sidebar-Tab.',\n}\n","/**\n * French translation of the better-sidebar copy.\n *\n * Mirrors the key set of the zh dictionary in `locales.ts` (enforced by\n * the `Record<keyof typeof zh, string>` type annotation). The better-locale\n * override store registers this dict under the `betterSidebar` namespace,\n * so it takes effect when the user has selected the `fr` override.\n */\n\n/** fr dictionary for the `betterSidebar` namespace. */\nexport const fr: Record<string, string> = {\n  files: 'Fichiers',\n  guid