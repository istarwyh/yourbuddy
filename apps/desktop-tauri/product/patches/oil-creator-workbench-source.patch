+
+export function mergePreparationHistory(
+  current: PreparePublishResult,
+  previous: PreparePublishResult | undefined,
+  currentArticleFingerprint: string | undefined,
+): PreparePublishResult {
+  if (previous === undefined) return current;
+  const previousArticle = isExactPreparedArticle(
+    previous.wechatOfficialAccount,
+    currentArticleFingerprint,
+  ) ? previous.wechatOfficialAccount : undefined;
+  const mergedArticle = current.wechatOfficialAccount ?? previousArticle;
+  if (current.selectedPlatforms.length === 0) {
+    return {
+      ...current,
+      selectedPlatforms: previous.selectedPlatforms,
+      video: previous.video,
+      ...(mergedArticle === undefined ? {} : { wechatOfficialAccount: mergedArticle }),
+    };
+  }
+  return mergedArticle === undefined
+    ? current
+    : { ...current, wechatOfficialAccount: mergedArticle };
+}
