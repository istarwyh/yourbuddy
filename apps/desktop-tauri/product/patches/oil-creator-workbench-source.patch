+describe("publishing subprocess cancellation", () => {
+  it.skipIf(process.platform === "win32")("kills an owned grandchild that keeps output pipes open", async () => {
+    const root = await mkdtemp(join(tmpdir(), "oil-publisher-abort-"));
+    const script = join(root, "leader.mjs");
+    const pidPath = join(root, "grandchild.pid");
+    await writeFile(script, [
+      'import { spawn } from "node:child_process";',
+      'import { writeFileSync } from "node:fs";',
+      `const child = spawn(process.execPath, ["-e", ${JSON.stringify("process.on('SIGTERM', () => {}); setInterval(() => {}, 1000);")}], { stdio: ["ignore", "inherit", "inherit"] });`,
+      `writeFileSync(${JSON.stringify(pidPath)}, String(child.pid));`,
+    ].join("\n"));
+    const controller = new AbortController();
+    const running = runPublishingCommand(process.execPath, [script], controller.signal, {
+      PATH: process.env.PATH,
+      HOME: process.env.HOME,
+    });
+    let grandchild = 0;
+    try {
+      for (let attempt = 0; attempt < 50; attempt += 1) {
+        grandchild = Number(await readFile(pidPath, "utf8").catch(() => "0"));
+        if (grandchild > 0) break;
+        await new Promise((resolve) => setTimeout(resolve, 20));
+      }
+      expect(grandchild).toBeGreaterThan(0);
+      controller.abort(new Error("cancel test"));
+      await expect(running).rejects.toThrow("cancel test");
+      let gone = false;
+      for (let attempt = 0; attempt < 50; attempt += 1) {
+        try {
+          process.kill(grandchild, 0);
+        } catch {
+          gone = true;
+          break;
+        }
+        await new Promise((resolve) => setTimeout(resolve, 20));
+      }
+      expect(gone).toBe(true);
+    } finally {
+      if (!controller.signal.aborted) controller.abort(new Error("test cleanup"));
+      await running.catch(() => undefined);
+      if (grandchild > 0) {
+        try {
+          process.kill(grandchild, "SIGKILL");
+        } catch {
+          // The owned process already reached quiescence.
+        }
+      }
+    }
+  });
+});
