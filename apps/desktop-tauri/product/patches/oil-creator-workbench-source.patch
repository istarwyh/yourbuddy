@@ -1,5 +1,10 @@
 import { PUBLISH_PLATFORM_DEFINITIONS, PUBLISH_PLATFORMS } from "../platforms.ts";
-import type { PublishPlatform } from "../types.ts";
+import type {
+  ContentCovers,
+  ContentPublish,
+  PreparePublishResult,
+  PublishPlatform,
+} from "../types.ts";
 import type { CreatorKey } from "./locales.ts";
 import type { PlatformId } from "./PlatformMark.tsx";
 
@@ -28,3 +33,91 @@ export function isPublishSyncDisabled(
 ): boolean {
   return busy !== undefined || platformSettingsPending || selectEnabledPublishPlatforms(enabledPlatforms).length === 0;
 }
+
+export function initialPreparePlatforms(
+  enabledPlatforms: readonly PublishPlatform[],
+  persistedPlatforms?: readonly PublishPlatform[],
+): PublishPlatform[] {
+  if (persistedPlatforms === undefined) return [...enabledPlatforms];
+  const persisted = new Set(persistedPlatforms);
+  return enabledPlatforms.filter((platform) => persisted.has(platform));
+}
+
+export function requiresOriginalityConfirmation(platforms: readonly PublishPlatform[]): boolean {
+  return platforms.some((platform) =>
+    platform === "xiaohongshu" || platform === "bilibili" || platform === "wechat"
+  );
+}
+
+export function missingSelectedCoverRatios(
+  covers: ContentCovers,
+  platforms: readonly PublishPlatform[],
+): Array<"3x4" | "4x3"> {
+  const needs3x4 = platforms.some((platform) =>
+    platform === "xiaohongshu" || platform === "douyin" || platform === "wechat"
+  );
+  const needs4x3 = platforms.some((platform) =>
+    platform === "douyin" || platform === "bilibili" || platform === "wechat"
+  );
+  return [
+    ...(needs3x4 && covers["3x4"] === undefined ? ["3x4" as const] : []),
+    ...(needs4x3 && covers["4x3"] === undefined ? ["4x3" as const] : []),
+  ];
+}
+
+export function isPreparePublishDisabled(options: {
+  busy: string | undefined;
+  platformSettingsPending: boolean;
+  selectedPlatforms: readonly PublishPlatform[];
+  hasVideo: boolean;
+  includeWechatArticle: boolean;
+  hasArticle: boolean;
+  originalRightsConfirmed: boolean;
+  uploadCovers: boolean;
+  covers: ContentCovers;
+}): boolean {
+  if (options.busy !== undefined || options.platformSettingsPending) return true;
+  if (options.selectedPlatforms.length === 0 && !options.includeWechatArticle) return true;
+  if (options.selectedPlatforms.length > 0 && !options.hasVideo) return true;
+  if (options.includeWechatArticle && !options.hasArticle) return true;
+  if (
+    requiresOriginalityConfirmation(options.selectedPlatforms)
+    && !options.originalRightsConfirmed
+  ) return true;
+  return options.uploadCovers
+    && missingSelectedCoverRatios(options.covers, options.selectedPlatforms).length > 0;
+}
+
+export type PreparePublishOutcome = "success" | "partial" | "blocked" | "skipped";
+
+export function preparePublishOutcome(
+  result: PreparePublishResult,
+  publish?: ContentPublish,
+): PreparePublishOutcome {
+  const unpublishedPlatforms = result.selectedPlatforms.filter((platform) =>
+    publish?.[platform].status !== "published"
+  );
+  const videoSteps = unpublishedPlatforms.length === 0
+    ? []
+    : result.video.platforms === undefined
+      ? [result.video.status]
+      : unpublishedPlatforms.map((platform) =>
+        result.video.platforms?.[publisherPlatformKey(platform)]?.ready === true
+          ? "readyForReview" as const
+          : "blocked" as const
+      );
+  const steps = [
+    ...videoSteps,
+    ...(result.wechatOfficialAccount === undefined ? [] : [result.wechatOfficialAccount.status]),
+  ];
+  const ready = steps.filter((status) => status === "readyForReview").length;
+  const blocked = steps.filter((status) => status === "blocked").length;
+  if (ready > 0 && blocked > 0) return "partial";
+  if (blocked > 0) return "blocked";
+  if (ready > 0) return "success";
+  return "skipped";
+}
+
+export function publisherPlatformKey(platform: PublishPlatform): string {
+  return platform === "wechat" ? "wechat_channels" : platform;
+}
diff --git a/src/client/selectionGuard.ts b/src/client/selectionGuard.ts
new file mode 100644
index 0000000..8fadef6
--- /dev/null
+++ b/src/client/selectionGuard.ts
@@ -0,0 +1,28 @@
+export interface SelectionToken {
+  readonly id: string;
+  readonly generation: number;
+}
+
+/** Reject async work that started for an earlier content selection. */
+export class SelectionGuard {
+  #id: string | null;
+  #generation = 0;
+
+  constructor(id: string | null) {
+    this.#id = id;
+  }
+
+  update(id: string | null): void {
+    if (id === this.#id) return;
+    this.#id = id;
+    this.#generation += 1;
+  }
+
+  capture(id: string): SelectionToken | undefined {
+    return id === this.#id ? { id, generation: this.#generation } : undefined;
+  }
+
+  current(token: SelectionToken): boolean {
+    return token.id === this.#id && token.generation === this.#generation;
+  }
+}
