+    return { status: "skipped", detail: "No enabled video platforms selected." };
+  }
+  if (options.item.videoSubtitled === undefined && options.item.videoRaw === undefined) {
+    return blockedStep("This episode has no finished video. Export an MP4 or MOV before preparing drafts.", "VIDEO_MISSING");
+  }
