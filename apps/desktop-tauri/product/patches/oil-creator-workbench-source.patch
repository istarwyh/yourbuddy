diff --git a/src/client/openWorkspacePath.ts b/src/client/openWorkspacePath.ts
new file mode 100644
index 0000000..d7210b7
--- /dev/null
+++ b/src/client/openWorkspacePath.ts
@@ -0,0 +1,20 @@
+import type { ClientContext } from "@deepseek-ai/dsh-client-runtime/client";
+
+interface RemoteAnswer {
+  ok: boolean;
+  error?: { message: string };
+}
+
+interface SessionRemote {
+  openWorkspacePath: (request: { path: string; action: "reveal" }) => Promise<RemoteAnswer>;
+}
+
+/** Reveal one Host workspace path through the current Session remote. */
+export async function revealWorkspacePath(ctx: ClientContext, path: string): Promise<void> {
+  const remote = ctx.get("remote.session") as Partial<SessionRemote> | undefined;
+  if (typeof remote?.openWorkspacePath !== "function") {
+    throw new Error("workspace path opener unavailable");
+  }
+  const answer = await remote.openWorkspacePath({ path, action: "reveal" });
+  if (!answer.ok) throw new Error(answer.error?.message ?? "open path failed");
+}
