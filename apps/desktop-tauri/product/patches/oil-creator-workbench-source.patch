+async function publishMetadata(
+  folderPath: string,
+): Promise<{ title: string; tags: string[] } | undefined> {
+  const names = await readdir(folderPath).catch(() => []);
+  const name = names.find((candidate) => candidate === "publish-package.json")
+    ?? names.find((candidate) => candidate.endsWith(".publish-package.json"));
+  if (name === undefined) return undefined;
+  try {
+    const value = JSON.parse(await readFile(join(folderPath, name), "utf8")) as Record<string, unknown>;
+    if (typeof value.title !== "string" || value.title.trim() === "" || !Array.isArray(value.tags)) {
+      return undefined;
+    }
+    const tags = value.tags
+      .filter((tag): tag is string => typeof tag === "string" && tag.trim() !== "")
+      .map((tag) => tag.trim());
+    if (tags.length === 0 || tags.length !== value.tags.length) return undefined;
+    return { title: value.title.trim(), tags };
+  } catch {
+    return undefined;
+  }
+}
