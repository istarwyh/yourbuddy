@@ -0,0 +1,14 @@
+import type { ClientContext } from "@deepseek-ai/dsh-client-runtime/client";
+
+interface DirectoryPicker {
+  pickDirectory: () => Promise<string | null>;
+}
+
+/** Open the current Harness directory picker. */
+export function pickWorkspaceDirectory(ctx: ClientContext): Promise<string | null> {
+  const picker = ctx.get("uiWorkspace") as Partial<DirectoryPicker> | undefined;
+  if (typeof picker?.pickDirectory !== "function") {
+    throw new Error("directory picker unavailable");
+  }
+  return picker.pickDirectory();
+}
