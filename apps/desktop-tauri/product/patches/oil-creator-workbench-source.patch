+
+function privateJson(value: unknown): string {
+  return `${JSON.stringify(value, null, 2)}\n`;
+}
+
+function publisherAssetPaths(payload: Record<string, unknown>): string[] {
+  const paths: string[] = [];
+  if (typeof payload.videoPath === "string") paths.push(payload.videoPath);
+  const cover = payload.cover;
+  if (typeof cover === "object" && cover !== null) {
+    for (const key of ["vertical3x4Path", "horizontal4x3Path", "horizontal16x9Path"]) {
+      const value = Reflect.get(cover, key);
+      if (typeof value === "string") paths.push(value);
+    }
+  }
+  return [...new Set(paths)].sort();
+}
+
+async function publisherInputFingerprint(payload: Record<string, unknown>): Promise<string> {
+  const hasher = createHash("sha256").update(privateJson(payload));
+  for (const path of publisherAssetPaths(payload)) {
+    hasher.update(`\0${path}\0`);
+    for await (const chunk of createReadStream(path)) hasher.update(chunk);
+  }
+  return hasher.digest("hex");
+}
+
+async function writePrivateJson(path: string, value: unknown): Promise<void> {
+  const parent = dirname(path);
+  await mkdir(parent, { recursive: true, mode: 0o700 });
+  await chmod(parent, 0o700);
+  const temp = `${path}.${process.pid}.${randomUUID()}.tmp`;
+  try {
+    await writeFile(temp, privateJson(value), {
+      encoding: "utf8",
+      mode: 0o600,
+      flag: "wx",
+    });
+    await rename(temp, path);
+    await chmod(path, 0o600);
+  } catch (cause) {
+    await unlink(temp).catch(() => undefined);
+    throw cause;
+  }
+}
+
+async function writeImmutablePrivateJson(path: string, value: unknown): Promise<void> {
+  const parent = dirname(path);
+  await mkdir(parent, { recursive: true, mode: 0o700 });
+  await chmod(parent, 0o700);
+  const temp = `${path}.${process.pid}.${randomUUID()}.tmp`;
+  try {
+    await writeFile(temp, privateJson(value), {
+      encoding: "utf8",
+      mode: 0o600,
+      flag: "wx",
+    });
+    try {
+      await link(temp, path);
+    } catch (cause) {
+      if (!(cause instanceof Error && "code" in cause && cause.code === "EEXIST")) throw cause;
+    }
+  } finally {
+    await unlink(temp).catch(() => undefined);
+  }
+}
+
+export async function writeManagedVideoPublisherConfig(
+  dataDir: string,
+  libraryRoot: string,
+  platforms: readonly PublishPlatform[],
+  now = new Date(),
+): Promise<ManagedVideoPublisherPaths> {
+  const paths = managedVideoPublisherPaths(dataDir, `${randomUUID()}.json`);
+  await mkdir(paths.root, { recursive: true, mode: 0o700 });
+  await chmod(paths.root, 0o700);
+  await Promise.all([
+    mkdir(paths.configRoot, { recursive: true, mode: 0o700 }),
+    mkdir(paths.stateRoot, { recursive: true, mode: 0o700 }),
+    mkdir(paths.lockRoot, { recursive: true, mode: 0o700 }),
+    mkdir(paths.packageRoot, { recursive: true, mode: 0o700 }),
+  ]);
+  await Promise.all([
+    chmod(paths.configRoot, 0o700),
+    chmod(paths.stateRoot, 0o700),
+    chmod(paths.lockRoot, 0o700),
+    chmod(paths.packageRoot, 0o700),
+  ]);
+  await writePrivateJson(paths.configPath, managedVideoPublisherConfig(libraryRoot, platforms, now));
+  return paths;
+}
+
+/** Extracts the last complete JSON object without trusting surrounding logs. */
+export function parseLastJsonObject(raw: string): Record<string, unknown> | undefined {
+  let last: Record<string, unknown> | undefined;
+  let start = -1;
+  let depth = 0;
+  let inString = false;
+  let escaped = false;
+  for (let index = 0; index < raw.length; index += 1) {
+    const char = raw[index];
+    if (depth === 0) {
+      if (char !== "{") continue;
+      start = index;
+      depth = 1;
+      inString = false;
+      escaped = false;
+      continue;
+    }
+    if (inString) {
+      if (escaped) escaped = false;
+      else if (char === "\\") escaped = true;
+      else if (char === "\"") inString = false;
+      continue;
+    }
+    if (char === "\"") {
+      inString = true;
+      continue;
+    }
+    if (char === "{") depth += 1;
+    else if (char === "}") depth -= 1;
+    if (depth !== 0 || start < 0) continue;
+    try {
+      const parsed = JSON.parse(raw.slice(start, index + 1)) as unknown;
+      if (typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)) {
+        last = parsed as Record<string, unknown>;
+      }
+    } catch {
+      // Output may contain non-JSON braces before the structured summary.
+    }
+    start = -1;
+  }
+  return last;
+}
+
+async function publishMetadata(
+  folderPath: string,
+): Promise<{ title: string; tags: string[] } | undefined> {
+  const names = await readdir(folderPath).catch(() => []);
+  const name = names.find((candidate) => candidate === "publish-package.json")
+    ?? names.find((candidate) => candidate.endsWith(".publish-package.json"));
+  if (name === undefined) return undefined;
+  try {
+    const value = JSON.parse(await readFile(join(folderPath, name), "utf8")) as Record<string, unknown>;
+    if (typeof value.title !== "string" || value.title.trim() === "" || !Array.isArray(value.tags)) {
+      return undefined;
+    }
+    const tags = value.tags
+      .filter((tag): tag is string => typeof tag === "string" && tag.trim() !== "")
+      .map((tag) => tag.trim());
+    if (tags.length === 0 || tags.length !== value.tags.length) return undefined;
+    return { title: value.title.trim(), tags };
+  } catch {
+    return undefined;
+  }
+}
+
+function requiredCoverRatios(platforms: readonly PublishPlatform[]): Set<"3x4" | "4x3"> {
+  const ratios = new Set<"3x4" | "4x3">();
+  if (platforms.some((platform) => platform === "xiaohongshu" || platform === "douyin" || platform === "wechat")) {
+    ratios.add("3x4");
+  }
+  if (platforms.some((platform) => platform === "douyin" || platform === "bilibili" || platform === "wechat")) {
+    ratios.add("4x3");
+  }
+  return ratios;
+}
+
+export function missingCoverRatios(
+  item: Pick<ContentSummary, "covers">,
+  platforms: readonly PublishPlatform[],
+): Array<"3x4" | "4x3"> {
+  return [...requiredCoverRatios(platforms)].filter((ratio) => item.covers[ratio] === undefined);
+}
+
+function contentPackage(
+  item: ContentSummary,
+  title: string,
+  tags: string[],
+  platforms: readonly PublishPlatform[],
+  uploadCovers: boolean,
+): Record<string, unknown> {
+  const videoPath = item.videoSubtitled ?? item.videoRaw;
+  if (videoPath === undefined) throw new Error(`content has no video: ${item.id}`);
+  const result: Record<string, unknown> = { videoPath, title };
+  if (platforms.includes("xiaohongshu")) {
+    result.xhsTitle = title;
+    result.xhsTopics = tags;
+  }
+  if (platforms.includes("douyin")) {
+    result.douyinDescription = title;
+    result.douyinTopics = tags;
+  }
+  if (platforms.includes("bilibili")) {
+    result.bilibiliDescription = title;
+    result.bilibiliTags = tags;
+  }
+  if (platforms.includes("wechat")) {
+    result.wechatDescription = [title, tags.map((tag) => `#${tag}`).join(" ")]
+      .filter(Boolean)
+      .join("\n\n");
+    result.wechatTags = tags;
+  }
+  result.cover = uploadCovers
+    ? {
+      uploadCustomCover: true,
+      ...(item.covers["3x4"] === undefined ? {} : { vertical3x4Path: item.covers["3x4"] }),
+      ...(item.covers["4x3"] === undefined ? {} : { horizontal4x3Path: item.covers["4x3"] }),
+      ...(item.covers["16x9"] === undefined ? {} : { horizontal16x9Path: item.covers["16x9"] }),
+    }
+    : { uploadCustomCover: false };
+  return result;
+}
+
+function blockedStep(detail: string, code: string): PreparePublishStepResult {
+  return {
+    status: "blocked",
+    detail,
+    blocker: { code },
+  };
+}
+
+function publisherPlatformResult(value: unknown): PreparePublishVideoPlatformResult | undefined {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) return undefined;
+  const raw = value as Record<string, unknown>;
+  const result: PreparePublishVideoPlatformResult = {
+    status: typeof raw.status === "string" ? raw.status : raw.ready === true ? "ready" : "blocked",
+    ready: raw.ready === true,
+    missing: Array.isArray(raw.missing)
+      ? raw.missing.filter((item): item is string => typeof item === "string")
+      : [],
+  };
+  if (typeof raw.taskSpaceId === "number" || raw.taskSpaceId === null) result.taskSpaceId = raw.taskSpaceId;
+  if (typeof raw.blocker === "object" && raw.blocker !== null && !Array.isArray(raw.blocker)) {
+    result.blocker = raw.blocker as Record<string, unknown>;
+  } else if (raw.blocker === null) result.blocker = null;
+  if (typeof raw.evidencePath === "string" || raw.evidencePath === null) result.evidencePath = raw.evidencePath;
+  return result;
+}
+
+function decodePublisherPlatforms(value: unknown): Record<string, PreparePublishVideoPlatformResult> {
+  if (typeof value !== "object" || value === null || Array.isArray(value)) return {};
+  const result: Record<string, PreparePublishVideoPlatformResult> = {};
+  for (const [platform, raw] of Object.entries(value as Record<string, unknown>)) {
+    const decoded = publisherPlatformResult(raw);
+    if (decoded !== undefined) result[platform] = decoded;
+  }
+  return result;
+}
+
+function outputDetail(result: CommandResult): string {
+  return (result.stderr.trim() || result.stdout.trim() || `publisher exited ${result.code}`).slice(-1200);
+}
+
+function platformBlockerDetail(
+  platforms: Record<string, PreparePublishVideoPlatformResult>,
+  fallback: string,
+): string {
+  const details = Object.entries(platforms).flatMap(([platform, result]) => {
+    if (result.ready) return [];
+    const blocker = result.blocker;
+    const code = typeof blocker?.code === "string" ? blocker.code : undefined;
+    const message = typeof blocker?.message === "string"
+      ? blocker.message
+      : typeof blocker?.detail === "string"
+        ? blocker.detail
+        : undefined;
+    const missing = result.missing.length > 0 ? `missing: ${result.missing.join(", ")}` : undefined;
+    return [`${platform}: ${[code, message, missing].filter(Boolean).join(" · ") || result.status}`];
+  });
+  return details.length > 0 ? details.join("\n") : fallback;
+}
+
+export async function prepareVideoDrafts(
+  options: PrepareVideoDraftsOptions,
+  dependencies: PrepareVideoDraftsDependencies = {},
+): Promise<PreparePublishStepResult> {
+  if (options.platforms.length === 0) {
+    return { status: "skipped", detail: "No enabled video platforms selected." };
+  }
+  if (options.item.videoSubtitled === undefined && options.item.videoRaw === undefined) {
+    return blockedStep("This episode has no finished video. Export an MP4 or MOV before preparing drafts.", "VIDEO_MISSING");
+  }
+  const metadata = await publishMetadata(options.item.folderPath);
+  if (!options.item.hasPublishPackage || metadata === undefined) {
+    return blockedStep(
+      "Create a valid publish-package.json containing a non-empty title and at least one non-empty tag before preparing drafts.",
+      "PUBLISH_PACKAGE_MISSING_OR_INVALID",
+    );
+  }
+  if (!options.inspectOnly && options.uploadCovers) {
+    const missing = missingCoverRatios(options.item, options.platforms);
+    if (missing.length > 0) {
+      return blockedStep(
+        `Existing-cover upload needs these missing ratios: ${missing.join(", ")}. Generate the covers or turn off cover upload.`,
+        "COVER_MISSING",
+      );
+    }
+  }
+  const originalityRequired = options.platforms.some((platform) =>
+    platform === "xiaohongshu" || platform === "bilibili" || platform === "wechat"
+  );
+  if (!options.inspectOnly && originalityRequired && !options.originalRightsConfirmed) {
+    return blockedStep(
+      "Confirm that this video may be declared original/self-produced before preparing drafts for the selected platforms.",
+      "ORIGINALITY_CONFIRMATION_REQUIRED",
+    );
+  }
+
+  const envSource = dependencies.env ?? process.env;
+  const findEgo = dependencies.findEgo ?? findExecutable;
+  const ego = await findEgo("ego-browser", envSource);
+  if (ego === undefined) {
+    return blockedStep("ego-browser was not found. Install Ego Lite, add its CLI to PATH, and log in to the creator sites.", "EGO_MISSING");
+  }
+
+  const skillRoot = dependencies.publisherSkillDir ?? bundledSkillDir("video-publisher");
+  const publisher = join(skillRoot, "scripts", "v2", "publisher.mjs");
+  const publisherReady = await access(publisher, constants.R_OK).then(() => true, () => false);
+  if (!publisherReady) {
+    return blockedStep("The bundled video-publisher skill is missing. Repair or update the Oil Creator installation.", "PUBLISHER_SKILL_MISSING");
+  }
+
+  let managedConfigPath: string | undefined;
+  try {
+    const paths = await writeManagedVideoPublisherConfig(
+      options.dataDir,
+      options.libraryRoot,
+      options.platforms,
+      (dependencies.now ?? (() => new Date()))(),
+    );
+    managedConfigPath = paths.configPath;
+    const payload = contentPackage(
+      options.item,
+      metadata.title,
+      metadata.tags,
+      options.platforms,
+      options.uploadCovers,
+    );
+    const itemKey = createHash("sha256").update(options.item.id).digest("hex").slice(0, 12);
+    const payloadKey = await publisherInputFingerprint(payload);
+    const packagePath = join(paths.packageRoot, `${itemKey}-${payloadKey}.json`);
+    await writeImmutablePrivateJson(packagePath, payload);
+
+    const args = [
+      publisher,
+      "--package",
+      packagePath,
+      "--state-root",
+      paths.stateRoot,
+      "--keep-space",
+      "--no-cleanup-stale-spaces",
+    ];
+    for (const platform of options.platforms) args.push("--platform", PUBLISHER_PLATFORM[platform]);
+    const reusableJob = options.jobId !== undefined && options.jobInputFingerprint === payloadKey;
+    if (reusableJob && options.jobId !== undefined) args.push("--job-id", options.jobId);
+    if (options.originalRightsConfirmed) args.push("--confirm-original-rights");
+    if (options.inspectOnly || (options.inspectReadyJob === true && reusableJob)) {
+      args.push("--inspect-only");
+    }
+
+    const runCommand = dependencies.runCommand ?? runPublishingCommand;
+    const result = await runCommand(
+      process.execPath,
+      args,
+      options.signal,
+      publisherEnvironment(envSource, ego, paths.configPath, paths.lockRoot),
+    );
+    const summary = parseLastJsonObject(result.stdout);
+    if (summary === undefined) {
+      return blockedStep(`Video Publisher did not return a structured summary. ${outputDetail(result)}`, "PUBLISHER_OUTPUT_INVALID");
+    }
+    const platforms = decodePublisherPlatforms(summary.platforms);
+    const selectedPublisherPlatforms = mapPublisherPlatforms(options.platforms);
+    const ready = summary.ready === true
+      && selectedPublisherPlatforms.every((platform) => platforms[platform]?.ready === true);
+    const step: PreparePublishStepResult = {
+      status: ready ? "readyForReview" : "blocked",
+      detail: ready
+        ? "Video drafts are ready for review in retained Ego task spaces. Final publication was not performed."
+        : platformBlockerDetail(platforms, outputDetail(result)),
+      inputFingerprint: payloadKey,
+      platforms,
+    };
+    if (typeof summary.jobId === "string") step.jobId = summary.jobId;
+    if (typeof summary.statePath === "string") step.statePath = summary.statePath;
+    if (!ready) {
+      step.blocker = {
+        code: result.code === 0 ? "PLATFORM_BLOCKED" : `PUBLISHER_EXIT_${result.code}`,
+      };
+    }
+    return step;
+  } catch (cause) {
+    if (options.signal.aborted || (cause instanceof Error && cause.name === "AbortError")) throw cause;
+    return blockedStep(
+      cause instanceof Error ? cause.message : "Video draft preparation failed before launch.",
+      "PUBLISHER_LAUNCH_FAILED",
+    );
+  } finally {
+    if (managedConfigPath !== undefined) await unlink(managedConfigPath).catch(() => undefined);
+  }
+}
+
+export async function articleInputFingerprint(path: string, thumbPath?: string): Promise<string> {
+  const hasher = createHash("sha256").update(await readFile(path));
+  if (thumbPath !== undefined) {
+    hasher.update(`\0${thumbPath}\0`);
+    hasher.update(await readFile(thumbPath));
+  }
+  return hasher.digest("hex");
+}
+
+export async function prepareWechatArticleDraft(
+  options: PrepareWechatArticleDraftOptions,
+  dependencies: PrepareWechatArticleDraftDependencies = {},
+): Promise<PreparePublishStepResult> {
+  if (options.item.articlePath === undefined) {
+    return {
+      status: "skipped",
+      detail: "No WeChat Official Account article Markdown exists for this episode.",
+    };
+  }
+  const skillRoot = dependencies.publisherSkillDir ?? bundledSkillDir("wechat-publisher");
+  const cli = join(skillRoot, "wechat-publisher.mjs");
+  const publisherReady = await access(cli, constants.R_OK).then(() => true, () => false);
+  if (!publisherReady) {
+    return blockedStep("The bundled wechat-publisher skill is missing. Repair or update the Oil Creator installation.", "WECHAT_PUBLISHER_SKILL_MISSING");
+  }
+  const args = [cli, "publish-file", options.item.articlePath];
+  const thumb = options.item.covers["16x9"] ?? options.item.covers["4x3"] ?? options.item.covers["3x4"];
+  if (thumb !== undefined) args.push("--thumb", thumb);
+  try {
+    const inputFingerprint = await articleInputFingerprint(options.item.articlePath, thumb);
+    const runCommand = dependencies.runCommand ?? runPublishingCommand;
+    const result = await runCommand(
+      process.execPath,
+      args,
+      options.signal,
+      wechatPublisherEnvironment(dependencies.env ?? process.env),
+    );
+    const detail = (result.stdout.trim() || result.stderr.trim() || `wechat publisher exited ${result.code}`).slice(-1200);
+    return result.code === 0
+      ? {
+        status: "readyForReview",
+        detail: `${detail}\nA WeChat Official Account draft was created. Group-send was not performed.`,
+        inputFingerprint,
+      }
+      : {
+        status: "blocked",
+        detail,
+        blocker: { code: `WECHAT_PUBLISHER_EXIT_${result.code}` },
+        inputFingerprint,
+      };
+  } catch (cause) {
+    if (options.signal.aborted || (cause instanceof Error && cause.name === "AbortError")) throw cause;
+    return blockedStep(
+      cause instanceof Error ? cause.message : "WeChat article draft preparation failed before launch.",
+      "WECHAT_PUBLISHER_LAUNCH_FAILED",
+    );
+  }
+}
