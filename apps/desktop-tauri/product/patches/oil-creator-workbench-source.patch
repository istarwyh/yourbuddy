+/** Extracts the last complete JSON object without trusting surrounding logs. */
+export function parseLastJsonObject(raw: string): Record<string, unknown> | undefined {
+  let last: Record<string, unknown> | undefined;
+  let start = -1;
+  let depth = 0;
+  let inString = false;
+  let escaped = false;
+  for (let index = 0; index < raw.length; index += 1) {
+    const char = raw[index];
+    if (depth === 0) {
+      if (char !== "{") continue;
+      start = index;
+      depth = 1;
+      inString = false;
+      escaped = false;
+      continue;
+    }
+    if (inString) {
+      if (escaped) escaped = false;
+      else if (char === "\\") escaped = true;
+      else if (char === "\"") inString = false;
+      continue;
+    }
+    if (char === "\"") {
+      inString = true;
+      continue;
+    }
+    if (char === "{") depth += 1;
+    else if (char === "}") depth -= 1;
+    if (depth !== 0 || start < 0) continue;
+    try {
+      const parsed = JSON.parse(raw.slice(start, index + 1)) as unknown;
+      if (typeof parsed === "object" && parsed !== null && !Array.isArray(parsed)) {
+        last = parsed as Record<string, unknown>;
+      }
+    } catch {
+      // Output may contain non-JSON braces before the structured summary.
+    }
+    start = -1;
+  }
+  return last;
+}
