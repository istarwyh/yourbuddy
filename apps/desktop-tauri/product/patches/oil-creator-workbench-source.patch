+import { describe, expect, it, vi } from "vitest";
+
+import { revealWorkspacePath } from "../src/client/openWorkspacePath.ts";
+
+describe("revealWorkspacePath", () => {
+  it("uses the current session remote and preserves its method receiver", async () => {
+    const remote = {
+      calls: 0,
+      openWorkspacePath(request: { path: string; action: "reveal" }) {
+        this.calls += 1;
+        return Promise.resolve({ ok: true, request });
+      },
+    };
+    const ctx = { get: (name: string) => name === "remote.session" ? remote : undefined };
+
+    await expect(revealWorkspacePath(ctx as never, "/video/project")).resolves.toBeUndefined();
+    expect(remote.calls).toBe(1);
+  });
+
+  it("surfaces the Host failure message", async () => {
+    const openWorkspacePath = vi.fn(() => Promise.resolve({
+      ok: false,
+      error: { message: "path is unavailable" },
+    }));
+    const ctx = { get: () => ({ openWorkspacePath }) };
+
+    await expect(revealWorkspacePath(ctx as never, "/missing")).rejects.toThrow("path is unavailable");
+  });
+
+  it("fails clearly when the current remote is unavailable", async () => {
+    const ctx = { get: () => undefined };
+
+    await expect(revealWorkspacePath(ctx as never, "/missing")).rejects.toThrow("workspace path opener unavailable");
+  });
+});
