 }
+
+export function initialPreparePlatforms(
+  enabledPlatforms: readonly PublishPlatform[],
+  persistedPlatforms?: readonly PublishPlatform[],
+): PublishPlatform[] {
+  if (persistedPlatforms === undefined) return [...enabledPlatforms];
+  const persisted = new Set(persistedPlatforms);
+  return enabledPlatforms.filter((platform) => persisted.has(platform));
+}
+
+export function requiresOriginalityConfirmation(platforms: readonly PublishPlatform[]): boolean {
+  return platforms.some((platform) =>
+    platform === "xiaohongshu" || platform === "bilibili" || platform === "wechat"
+  );
+}
+
+export function missingSelectedCoverRatios(
+  covers: ContentCovers,
+  platforms: readonly PublishPlatform[],
+): Array<"3x4" | "4x3"> {
+  const needs3x4 = platforms.some((platform) =>
+    platform === "xiaohongshu" || platform === "douyin" || platform === "wechat"
+  );
+  const needs4x3 = platforms.some((platform) =>
+    platform === "douyin" || platform === "bilibili" || platform === "wechat"
+  );
+  return [
+    ...(needs3x4 && covers["3x4"] === undefined ? ["3x4" as const] : []),
+    ...(needs4x3 && covers["4x3"] === undefined ? ["4x3" as const] : []),
+  ];
+}
+
+export function isPreparePublishDisabled(options: {
+  busy: string | undefined;
+  platformSettingsPending: boolean;
+  selectedPlatforms: readonly PublishPlatform[];
+  hasVideo: boolean;
+  includeWechatArticle: boolean;
+  hasArticle: boolean;
+  originalRightsConfirmed: boolean;
+  uploadCovers: boolean;
+  covers: ContentCovers;
+}): boolean {
+  if (options.busy !== undefined || options.platformSettingsPending) return true;
+  if (options.selectedPlatforms.length === 0 && !options.includeWechatArticle) return true;
+  if (options.selectedPlatforms.length > 0 && !options.hasVideo) return true;
+  if (options.includeWechatArticle && !options.hasArticle) return true;
+  if (
+    requiresOriginalityConfirmation(options.selectedPlatforms)
+    && !options.originalRightsConfirmed
+  ) return true;
+  return options.uploadCovers
+    && missingSelectedCoverRatios(options.covers, options.selectedPlatforms).length > 0;
+}
+
+export type PreparePublishOutcome = "success" | "partial" | "blocked" | "skipped";
+
+export function preparePublishOutcome(result: PreparePublishResult): PreparePublishOutcome {
+  const steps = [result.video, result.wechatOfficialAccount].filter((step) => step !== undefined);
+  const ready = steps.filter((step) => step.status === "readyForReview").length;
+  const blocked = steps.filter((step) => step.status === "blocked").length;
+  if (ready > 0 && blocked > 0) return "partial";
+  if (blocked > 0) return "blocked";
+  if (ready > 0) return "success";
+  return "skipped";
+}
+
+export function publisherPlatformKey(platform: PublishPlatform): string {
+  return platform === "wechat" ? "wechat_channels" : platform;
+}
