+describe("SelectionGuard", () => {
+  it("rejects late results after switching away and back", () => {
+    const guard = new SelectionGuard("episode-a");
+    const first = guard.capture("episode-a");
+    expect(first).toBeDefined();
+
+    guard.update("episode-b");
+    expect(guard.current(first!)).toBe(false);
