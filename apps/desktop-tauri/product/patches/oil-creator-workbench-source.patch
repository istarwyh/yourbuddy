@@ -0,0 +1,297 @@
+import { access, mkdir, mkdtemp, readFile, stat, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+import { describe, expect, it, vi } from "vitest";
+
+import {
+  isExactPreparedArticle,
+  managedVideoPublisherConfig,
+  mergePreparationHistory,
+  parseLastJsonObject,
+  prepareVideoDrafts,
+  publisherEnvironment,
+  runPublishingCommand,
+  wechatPublisherEnvironment,
+  writeManagedVideoPublisherConfig,
+} from "../src/publishing.ts";
+import { emptyBurn, emptyPublish } from "../src/publishStatus.ts";
+import type { ContentSummary } from "../src/types.ts";
+
+function item(folderPath: string, videoPath: string): ContentSummary {
+  return {
+    id: "2026-09-01_demo",
+    folderPath,
+    title: "Demo",
+    recordedAt: 1,
+    createdMs: 1,
+    videoRaw: videoPath,
+    covers: { "3x4": join(folderPath, "cover_3x4.png"), "4x3": join(folderPath, "cover_4x3.png") },
+    subtitles: {},
+    hasPublishPackage: true,
+    hasArticle: false,
+    waitingForExport: false,
+    tags: [],
+    pipeline: "packaged",
+    workflow: "publish",
+    publish: emptyPublish(),
+    burn: emptyBurn(),
+    subtitleJob: emptyBurn(),
+    coverJob: emptyBurn(),
+  };
+}
+
+describe("managed Video Publisher configuration", () => {
+  it("maps selected platforms into an onboarded private schema-v2 config", async () => {
+    const dataDir = await mkdtemp(join(tmpdir(), "oil-publisher-config-"));
+    const paths = await writeManagedVideoPublisherConfig(
+      dataDir,
+      "/library",
+      ["xiaohongshu", "wechat"],
+      new Date("2026-09-01T12:00:00.000Z"),
+    );
+    const config = JSON.parse(await readFile(paths.configPath, "utf8")) as Record<string, unknown>;
+    expect(config).toEqual(managedVideoPublisherConfig(
+      "/library",
+      ["xiaohongshu", "wechat"],
+      new Date("2026-09-01T12:00:00.000Z"),
+    ));
+    expect(config).toMatchObject({
+      schemaVersion: 2,
+      onboarding: { completed: true },
+      sourceDirectory: "/library",
+      availablePlatforms: ["xiaohongshu", "wechat_channels"],
+      defaultPlatforms: ["xiaohongshu", "wechat_channels"],
+      declarations: { originalityPolicy: "ask_each_run" },
+      execution: { checkConcurrency: 4, uploadConcurrency: 4 },
+    });
+    expect((await stat(paths.configPath)).mode & 0o777).toBe(0o600);
+    expect((await stat(paths.root)).mode & 0o777).toBe(0o700);
+    await access(paths.stateRoot);
+    await access(paths.lockRoot);
+  });
+
+  it("scrubs ambient credentials while preserving documented child inputs", () => {
+    const ambient = {
+      PATH: "/usr/bin",
+      HOME: "/home/demo",
+      DEEPSEEK_API_KEY: "secret",
+      RANDOM_TOKEN: "secret",
+      VIDEO_PUBLISHER_V2_RUNNER: "/fixture/runner.mjs",
+      WECHAT_APP_ID: "wx-id",
+      WECHAT_APP_SECRET: "wx-secret",
+    };
+    const publisher = publisherEnvironment(ambient, "/opt/ego/ego-browser", "/managed/config.json", "/managed/locks");
+    expect(publisher.PATH).toContain("/opt/ego");
+    expect(publisher.VIDEO_PUBLISHER_CONFIG).toBe("/managed/config.json");
+    expect(publisher.VIDEO_PUBLISHER_V2_RUNNER).toBe("/fixture/runner.mjs");
+    expect(publisher.DEEPSEEK_API_KEY).toBeUndefined();
+    expect(publisher.RANDOM_TOKEN).toBeUndefined();
+    expect(publisher.WECHAT_APP_SECRET).toBeUndefined();
+
+    const wechat = wechatPublisherEnvironment(ambient);
+    expect(wechat.WECHAT_APP_ID).toBe("wx-id");
+    expect(wechat.WECHAT_APP_SECRET).toBe("wx-secret");
+    expect(wechat.DEEPSEEK_API_KEY).toBeUndefined();
+  });
+});
+
+describe("persisted preparation history", () => {
+  const article = {
+    status: "readyForReview" as const,
+    detail: "draft created",
+    inputFingerprint: "article-v1",
+  };
+  const video = {
+    status: "blocked" as const,
+    detail: "one platform blocked",
+    jobId: "job-1",
+  };
+  const previous = {
+    id: "demo",
+    selectedPlatforms: ["xiaohongshu" as const],
+    video,
+    wechatOfficialAccount: article,
+  };
+
+  it("reuses an article only for the exact current fingerprint", () => {
+    expect(isExactPreparedArticle(article, "article-v1")).toBe(true);
+    expect(isExactPreparedArticle(article, "article-v2")).toBe(false);
+    const { inputFingerprint: _fingerprint, ...withoutFingerprint } = article;
+    expect(isExactPreparedArticle(withoutFingerprint, "article-v1")).toBe(false);
+  });
+
+  it("preserves article state on video-only retries and video state on article-only runs", () => {
+    const videoOnly = mergePreparationHistory({
+      id: "demo",
+      selectedPlatforms: ["xiaohongshu"],
+      video: { ...video, detail: "retry" },
+    }, previous, "article-v1");
+    expect(videoOnly.wechatOfficialAccount).toEqual(article);
+
+    const articleOnly = mergePreparationHistory({
+      id: "demo",
+      selectedPlatforms: [],
+      video: { status: "skipped", detail: "no platforms" },
+      wechatOfficialAccount: article,
+    }, previous, "article-v1");
+    expect(articleOnly.selectedPlatforms).toEqual(["xiaohongshu"]);
+    expect(articleOnly.video).toBe(video);
+  });
+});
+
+describe("publishing subprocess cancellation", () => {
+  it.skipIf(process.platform === "win32")("kills an owned grandchild that keeps output pipes open", async () => {
+    const root = await mkdtemp(join(tmpdir(), "oil-publisher-abort-"));
+    const script = join(root, "leader.mjs");
+    const pidPath = join(root, "grandchild.pid");
+    await writeFile(script, [
+      'import { spawn } from "node:child_process";',
+      'import { writeFileSync } from "node:fs";',
+      `const child = spawn(process.execPath, ["-e", ${JSON.stringify("process.on('SIGTERM', () => {}); setInterval(() => {}, 1000);")}], { stdio: ["ignore", "inherit", "inherit"] });`,
+      `writeFileSync(${JSON.stringify(pidPath)}, String(child.pid));`,
+    ].join("\n"));
+    const controller = new AbortController();
+    const running = runPublishingCommand(process.execPath, [script], controller.signal, {
+      PATH: process.env.PATH,
+      HOME: process.env.HOME,
+    });
+    let grandchild = 0;
+    try {
+      for (let attempt = 0; attempt < 50; attempt += 1) {
+        grandchild = Number(await readFile(pidPath, "utf8").catch(() => "0"));
+        if (grandchild > 0) break;
+        await new Promise((resolve) => setTimeout(resolve, 20));
+      }
+      expect(grandchild).toBeGreaterThan(0);
+      controller.abort(new Error("cancel test"));
+      await expect(running).rejects.toThrow("cancel test");
+      let gone = false;
+      for (let attempt = 0; attempt < 50; attempt += 1) {
+        try {
+          process.kill(grandchild, 0);
+        } catch {
+          gone = true;
+          break;
+        }
+        await new Promise((resolve) => setTimeout(resolve, 20));
+      }
+      expect(gone).toBe(true);
+    } finally {
+      if (!controller.signal.aborted) controller.abort(new Error("test cleanup"));
+      await running.catch(() => undefined);
+      if (grandchild > 0) {
+        try {
+          process.kill(grandchild, "SIGKILL");
+        } catch {
+          // The owned process already reached quiescence.
+        }
+      }
+    }
+  });
+});
+
+describe("Video Publisher draft preparation", () => {
+  it("parses the last complete JSON object amid process logs", () => {
+    expect(parseLastJsonObject("log {not json}\n{\"ready\":false}\ntrailing\n{\"ready\":true,\"nested\":{\"ok\":1}}\n"))
+      .toEqual({ ready: true, nested: { ok: 1 } });
+  });
+
+  it("uses managed config/state, resumes safely, and preserves partial blockers", async () => {
+    const root = await mkdtemp(join(tmpdir(), "oil-publisher-run-"));
+    const folder = join(root, "episode");
+    const skill = join(root, "video-publisher");
+    const publisher = join(skill, "scripts", "v2", "publisher.mjs");
+    const video = join(folder, "demo.mp4");
+    await mkdir(join(skill, "scripts", "v2"), { recursive: true });
+    await mkdir(folder);
+    await writeFile(publisher, "export {};\n");
+    await writeFile(video, "video");
+    const exactTitle = "A title that must remain exact beyond the Xiaohongshu limit";
+    await writeFile(join(folder, "publish-package.json"), JSON.stringify({ title: exactTitle, tags: ["AI"] }));
+    let managedConfigPath = "";
+    const run = vi.fn(async (_command, args: readonly string[], _signal, env: NodeJS.ProcessEnv) => {
+      expect(args).toEqual(expect.arrayContaining([
+        "--state-root",
+        "--keep-space",
+        "--no-cleanup-stale-spaces",
+        "--confirm-original-rights",
+      ]));
+      const packageIndex = args.indexOf("--package");
+      const payload = JSON.parse(await readFile(args[packageIndex + 1]!, "utf8")) as { title: string; xhsTitle: string };
+      expect(payload.title).toBe(exactTitle);
+      expect(payload.xhsTitle).toBe(exactTitle);
+      expect(env.VIDEO_PUBLISHER_CONFIG).toContain("video-publisher/configs/");
+      expect(env.VIDEO_PUBLISHER_V2_LOCK_ROOT).toContain("video-publisher/locks");
+      managedConfigPath = env.VIDEO_PUBLISHER_CONFIG ?? "";
+      return {
+        code: 10,
+        stdout: JSON.stringify({
+          jobId: "job-1",
+          ready: false,
+          statePath: "/managed/state.json",
+          platforms: {
+            xiaohongshu: { status: "ready", ready: true, missing: [], blocker: null },
+            wechat_channels: {
+              status: "blocked_user",
+              ready: false,
+              missing: ["login"],
+              blocker: { code: "LOGIN_REQUIRED", requiresUser: true },
+            },
+          },
+        }),
+        stderr: "",
+      };
+    });
