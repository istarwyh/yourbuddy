+/**
+ * Remove a published platform from any persisted draft-preparation diagnosis.
+ * @param item Persisted content overlay entry.
+ * @param platform Platform confirmed as published.
+ */
+export function removePreparedPlatform(item: OverlayItem, platform: PublishPlatform): void {
+  const preparation = item.publishPreparation;
+  if (preparation === undefined) return;
+  const publisherPlatform = platform === "wechat" ? "wechat_channels" : platform;
+  const platforms = { ...preparation.video.platforms };
+  delete platforms[publisherPlatform];
+  const allSelectedPublished = preparation.selectedPlatforms.every((selected) =>
+    item.publish?.[selected]?.status === "published"
+  );
+  if (allSelectedPublished && preparation.wechatOfficialAccount === undefined) {
+    delete item.publishPreparation;
+    return;
+  }
+  if (allSelectedPublished) {
+    item.publishPreparation = {
+      ...preparation,
+      selectedPlatforms: [],
+      video: { status: "skipped", detail: "No unpublished video drafts remain." },
+    };
+    return;
+  }
+  const remaining = Object.values(platforms).filter((result) => result !== undefined);
+  const blocked = remaining.some((result) => result.ready !== true);
+  item.publishPreparation = {
+    ...preparation,
+    video: {
+      ...preparation.video,
+      status: blocked || remaining.length === 0 ? "blocked" : "readyForReview",
+      detail: blocked || remaining.length === 0
+        ? "One or more unpublished video drafts still need attention."
+        : "Unpublished video drafts are ready for review.",
+      platforms,
+    },
+  };
+}
+
 export function isPublishMark(value: unknown): value is PublishMark {
   return value === "unpublished" || value === "draft" || value === "published";
 }
