+  const runtimeMissing = value.code === 'HARBOR_RUNTIME_NOT_READY'
+  const [installation, setInstallation] = useState({ status: 'idle', error: undefined })
+  const install = async () => {
+    setInstallation({ status: 'installing', error: undefined })
+    try {
+      await installHarborRuntime()
+      setInstallation({ status: 'installed', error: undefined })
+      retry?.()
+    } catch (installError) {
+      setInstallation({ status: 'error', error: installError?.message ?? String(installError) })
+    }
+  }
+  const heading = runtimeMissing ? t('runtimeNotReady') : title ?? value.message
+  return <div className="hse-error-state" data-category={value.category} role="alert"><div><b>{heading}</b>{heading !== value.message ? <span>{value.message}</span> : null}<small>{t('errorCode')}: <code>{value.code}</code> · {t('errorAt')}: <time dateTime={value.observedAt}>{new Date(value.observedAt).toLocaleString()}</time></small><small>{t('nextStep')}: {errorNextStep(value, t)}</small>{installation.status === 'installed' ? <small>{t('runtimeInstalled')}</small> : null}{installation.status === 'error' ? <small>{t('runtimeInstallFailed')}: {installation.error}</small> : null}</div>{runtimeMissing ? <button type="button" disabled={installation.status === 'installing'} onClick={() => void install()}>{installation.status === 'installing' ? t('installingRuntime') : t('installRuntime')}</button> : retry ? <button type="button" onClick={retry}>{retryLabel ?? t('retry')}</button> : null}</div>
