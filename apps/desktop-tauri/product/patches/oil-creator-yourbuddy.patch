+  const labels = youtubeVisibility === 'private' ? /不公开|Private/i : youtubeVisibility === 'unlisted' ? /不列出|Unlisted/i : /公开|Public/i;
+  return await ensureYoutubeRadio(names, labels, `set YouTube visibility ${youtubeVisibility}`);
