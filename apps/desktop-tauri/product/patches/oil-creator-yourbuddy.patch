+    editor.blur()
+    const actual = normalized(editor.innerText || editor.textContent || '')
+    return { ok: actual === normalized(value), actual }
+  })(${JSON.stringify(selector)}, ${JSON.stringify(value)}, ${JSON.stringify(label)})`);
+}
