+async function withTempDir(callback) {
+  const root = await fs.promises.mkdtemp(path.join(os.tmpdir(), "video-publisher-package-test-"));
+  try {
+    await callback(root);
+  } finally {
+    await fs.promises.rm(root, { recursive: true, force: true });
