{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YourBuddy",
  "version": "0.3.5",
  "identifier": "io.github.istarwyh.yourbuddy",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": "node scripts/prepare-dist.mjs && node scripts/serve-dist.mjs",
    "beforeBuildCommand": "node scripts/prepare-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "YourBuddy",
        "width": 520,
        "height": 480,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; frame-src http://127.0.0.1:*; object-src 'none'; base-uri 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCREZDNUUyOEVGNTgxRUIKUldUcmdmV080c1hmMjJUck9DMm4wUnE2OWo3b3EwWHQzYlpSWWZXd3Jvdy9uZGprcW54dUxLQU0K",
      "endpoints": [
        "https://github.com/istarwyh/yourbuddy/releases/download/yourbuddy-updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Your models. Your tools. Your way.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundled/harness": "harness-source",
      "../bundled/toolchain": "toolchain",
      "../bundled/yourbuddy-runtime": "yourbuddy-runtime",
      "../overlay/desktop-notify": "desktop-overlay",
      "../sounds/complete.wav": "complete.wav",
      "icons/icon.ico": "yourbuddy-icon-0.3.5.ico"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
